section


namespace GraphCert.Quartic.Polynomial

def conjugate (p : Poly) : Poly := p.map (List.map star)

theorem value_conjugate (p : Poly) (x y : ℤ) :
    value (conjugate p) x y = star (value p x y) := by
  have hd (q : Dense.Poly) : Dense.eval (RingHom.id G) (q.map star) (y : G) =
      star (Dense.eval (RingHom.id G) q (y : G)) := by
    induction q with
    | nil => simp [Dense.eval]
    | cons a q ih => simp [Dense.eval, ih, mul_comm]
  induction p with
  | nil => simp [conjugate, value, eval]
  | cons a p ih =>
      simp only [conjugate, List.map_cons, value, eval] at *
      rw [hd, ih]
      simp [mul_comm]

theorem identity_product {n : ℕ} (neighbors : List (Fin n × ℕ)) (H : Fin n → Poly)
    (c : G) (F A B R W : Poly) (i : Fin n) (D : G)
    (h : equal (sub (mul (constant (D^4)) (row neighbors H c)) (mul R (pow W 4)))
      (add (mul F A) (mul (H i) B)) = true) (x y : ℤ) :
    D^4 * rowProduct neighbors (fun i => value (H i) x y) c -
        value R x y * value W x y^4 =
      value F x y*value A x y + value (H i) x y*value B x y := by
  have h := eval_equal (RingHom.id G) _ _ h (x : G) (y : G)
  simp only [eval_sub, eval_mul, eval_constant, RingHom.id_apply, eval_pow, eval_add] at h
  change D^4 * value (row neighbors H c) x y - value R x y*value W x y^4 =
    value F x y*value A x y + value (H i) x y*value B x y at h
  simpa only [eval_row] using h

end GraphCert.Quartic.Polynomial
end

                  
section


namespace GraphCert.Quartic

theorem real_wild_coordinates {a : G} (ha : a ≠ 0) (hr : star a = a) :
    wildClass a = ![2*(3*wildClass a 1), 3*(3*wildClass a 1), 0, wildClass a 3] := by
  have h : conjugateWild (wildClass a) = wildClass a := by
    rw [←wildClass_star ha, hr]
  have ht : ∀ v : ClassVector, conjugateWild v = v →
      v = ![2*(3*v 1), 3*(3*v 1), 0, v 3] := by decide +kernel
  exact ht _ h

theorem eq_intCast_of_star_eq {a : G} (ha : star a = a) : a = (a.re : G) := by
  have h := congrArg Zsqrtd.im ha
  simp only [Zsqrtd.im_star] at h
  have hi : a.im = 0 := by omega
  ext <;> simp [hi]

theorem real_tame_coordinates (p : PrimaryPrime) (hp : conjugatePrime p = p)
    {a : G} (ha : a ≠ 0) (hr : star a = a) :
    tameClass p.val (primaryPrime_ne_two p) a = ![(multiplicity p.val a : ZMod 4), 0] := by
  have hp' : star p.val = p.val := congrArg Subtype.val hp
  letI : Fact (Prime (star p.val)) := ⟨prime_star p.property.1⟩
  have hs := primeUnit_star p.val ha
  have hs' : primeUnit p.val a = star (primeUnit p.val a) := by
    simpa only [hp', hr] using hs
  have hi := eq_intCast_of_star_eq hs'.symm
  have hl : quarticLog p.val (primaryPrime_ne_two p) (primeUnit p.val a) = 0 := by
    rw [hi]
    apply quarticLog_integer_at_real_prime p hp
    rw [←hi]
    exact (primeUnit_spec p.val ha).2
  simp only [tameClass, hl]

theorem quadratic_sum_zero {n : ℕ} (a L : Fin n → ZMod 4)
    (Q : Fin n → Fin n → ZMod 4)
    (hl : ∀ i, L i + Q i i = 0) (hd : ∀ i, 2*Q i i = 0)
    (ho : ∀ i j, i ≠ j → Q i j + Q j i = 0) :
    (∑ i, a i*L i) + ∑ i, ∑ j, a i*a j*Q i j = 0 := by
  classical
  let off : Fin n × Fin n → ZMod 4 := fun ij =>
    if ij.1 = ij.2 then 0 else a ij.1*a ij.2*Q ij.1 ij.2
  have hoff : (∑ ij, off ij) = 0 := by
    refine Finset.sum_involution (fun ij _ => ij.swap) ?_ ?_
      (fun _ _ => Finset.mem_univ _) (fun ij _ => Prod.swap_swap ij)
    · intro ij _
      rcases ij with ⟨i,j⟩
      by_cases h : i = j
      · simp [off, h]
      · simp only [off, Prod.swap, if_neg h, if_neg (Ne.symm h)]
        linear_combination a i*a j*ho i j h
    · intro ij _ hn he
      have h := congrArg Prod.fst he
      change ij.2 = ij.1 at h
      exact hn (by simp [off, h])
  have hsplit : (∑ i, ∑ j, a i*a j*Q i j) =
      (∑ i, a i*a i*Q i i) + ∑ ij, off ij := by
    rw [Fintype.sum_prod_type, ←Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    have hdiag : (∑ j, if i = j then a i*a j*Q i j else 0) = a i*a i*Q i i := by simp
    rw [←hdiag, ←Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro j _
    by_cases h : i = j <;> simp [off, h]
  rw [hsplit, hoff, add_zero, ←Finset.sum_add_distrib]
  apply Finset.sum_eq_zero
  intro i _
  have hsmall : ∀ t q : ZMod 4, 2*q = 0 → t*t*q = t*q := by decide +kernel
  rw [hsmall (a i) (Q i i) (hd i)]
  rw [←mul_add, hl i, mul_zero]

section SharedDirections
variable {V : Type*} [AddCommGroup V] [Module (ZMod 4) V]

def sharedLinear {n m r : ℕ} (edges : Fin m → GraphEdge n)
    (H C : Fin n → V) (D : Fin r → Fin n → V)
    (B : V →ₗ[ZMod 4] V →ₗ[ZMod 4] ZMod 4) (k : Fin r) : ZMod 4 :=
  ∑ i, B (D k i) (graphStar edges H C i)

def sharedQuadratic {n m r : ℕ} (edges : Fin m → GraphEdge n)
    (D : Fin r → Fin n → V)
    (B : V →ₗ[ZMod 4] V →ₗ[ZMod 4] ZMod 4) (k l : Fin r) : ZMod 4 :=
  ∑ e, (edges e).weight*B (D k (edges e).src) (D l (edges e).dst)

theorem vectorGraph_shared_constant {n m r : ℕ} (edges : Fin m → GraphEdge n)
    (H C : Fin n → V) (D : Fin r → Fin n → V)
    (B : V →ₗ[ZMod 4] V →ₗ[ZMod 4] ZMod 4)
    (hsk : ∀ a b, B a b = -B b a)
    (hl : ∀ k, sharedLinear edges H C D B k + sharedQuadratic edges D B k k = 0)
    (hd : ∀ k, 2*sharedQuadratic edges D B k k = 0)
    (ho : ∀ k l, k ≠ l → sharedQuadratic edges D B k l + sharedQuadratic edges D B l k = 0)
    (a : Fin r → ZMod 4) :
    vectorGraph edges (fun i => H i+∑ k, a k • D k i) C B = vectorGraph edges H C B := by
  rw [vectorGraph_add edges H C _ B hsk]
  have hL : (∑ i, B (∑ k, a k • D k i) (graphStar edges H C i)) =
      ∑ k, a k*sharedLinear edges H C D B k := by
    simp only [sharedLinear, map_sum, LinearMap.sum_apply, map_smul,
      LinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
  have hQ : (∑ e, (edges e).weight * B (∑ k, a k • D k (edges e).src)
      (∑ l, a l • D l (edges e).dst)) =
      ∑ k, ∑ l, a k*a l*sharedQuadratic edges D B k l := by
    conv_rhs => rw [Finset.sum_comm]
    simp only [sharedQuadratic, map_sum, LinearMap.sum_apply, map_smul,
      LinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro k _
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro l _
    apply Finset.sum_congr rfl
    intro e _
    ring
  rw [hL, hQ, add_assoc, quadratic_sum_zero a _ _ hl hd ho, add_zero]

end SharedDirections
end GraphCert.Quartic

end

                         
section


namespace GraphCert.Quartic

noncomputable def contribution (p : PrimaryPrime) (H A : G) : ZMod 4 :=
  (multiplicity p.val H : ZMod 4)*quarticLog p.val (primaryPrime_ne_two p) A

theorem contribution_replace (p : PrimaryPrime) (H A B : G)
    (h : p.val ∣ H → quarticLog p.val (primaryPrime_ne_two p) A =
      quarticLog p.val (primaryPrime_ne_two p) B) :
    contribution p H A = contribution p H B := by
  by_cases hd : p.val ∣ H
  · simp only [contribution, h hd]
  · simp [contribution, multiplicity_eq_zero_of_not_dvd hd]

theorem contribution_zero (p : PrimaryPrime) (H A : G)
    (h : p.val ∣ H → quarticLog p.val (primaryPrime_ne_two p) A = 0) :
    contribution p H A = 0 := by
  by_cases hd : p.val ∣ H
  · simp only [contribution, h hd, mul_zero]
  · simp [contribution, multiplicity_eq_zero_of_not_dvd hd]

theorem conjugatePrime_dvd_star (p : PrimaryPrime) (a : G) :
    (conjugatePrime p).val ∣ star a ↔ p.val ∣ a := by
  constructor
  · intro h; simpa only [conjugatePrime, star_star] using star_dvd_of_dvd h
  · intro h; exact star_dvd_of_dvd h

theorem contribution_pair (p : PrimaryPrime) (H K A B : G)
    (hK : K = star H)
    (hB : p.val ∣ H → ¬(conjugatePrime p).val ∣ B)
    (hlog : p.val ∣ H → quarticLog p.val (primaryPrime_ne_two p) A =
      quarticLog p.val (primaryPrime_ne_two p) (star B)) :
    contribution p H A + contribution (conjugatePrime p) K B = 0 := by
  by_cases hd : p.val ∣ H
  · letI : Fact (Prime (star p.val)) := ⟨prime_star p.property.1⟩
    have hBs : ¬p.val ∣ star B := by
      intro h
      exact hB hd (by simpa only [star_star, conjugatePrime] using star_dvd_of_dvd h)
    have hl := quarticLog_star p.val (primaryPrime_ne_two p)
      (primaryPrime_ne_two (conjugatePrime p)) hBs
    simp only [star_star] at hl
    have hl' : quarticLog (conjugatePrime p).val (primaryPrime_ne_two _) B =
        -quarticLog p.val (primaryPrime_ne_two p) (star B) := by
      simpa only [conjugatePrime] using hl
    have hv : multiplicity (conjugatePrime p).val K = multiplicity p.val H := by
      rw [hK]; exact multiplicity_star _ _
    simp only [contribution, hv, hlog hd, hl']
    ring
  · have hk : ¬(conjugatePrime p).val ∣ K := by
      rw [hK, conjugatePrime_dvd_star]; exact hd
    simp [contribution, multiplicity_eq_zero_of_not_dvd hd,
      multiplicity_eq_zero_of_not_dvd hk]

theorem contribution_real (p : PrimaryPrime) (H A R : G)
    (hH : star H = H) (hR : star R = R)
    (hunit : (conjugatePrime p).val ∣ H → ¬(conjugatePrime p).val ∣ R)
    (hlog : p.val ∣ H → quarticLog p.val (primaryPrime_ne_two p) A =
      quarticLog p.val (primaryPrime_ne_two p) R)
    (hlogs : (conjugatePrime p).val ∣ H →
      quarticLog (conjugatePrime p).val (primaryPrime_ne_two _) A =
      quarticLog (conjugatePrime p).val (primaryPrime_ne_two _) R) :
    contribution p H A + contribution (conjugatePrime p) H A = 0 := by
  rw [contribution_replace p H A R hlog,
    contribution_replace (conjugatePrime p) H A R hlogs]
  apply contribution_pair p H H R R hH.symm
  · intro h
    apply hunit
    rw [←hH, conjugatePrime_dvd_star]
    exact h
  · intro _; rw [hR]

theorem contribution_real_fixed (p : PrimaryPrime) (hp : conjugatePrime p = p)
    (H A R : G) (hR : star R = R)
    (hunit : p.val ∣ H → ¬p.val ∣ R)
    (hlog : p.val ∣ H → quarticLog p.val (primaryPrime_ne_two p) A =
      quarticLog p.val (primaryPrime_ne_two p) R) : contribution p H A = 0 := by
  apply contribution_zero
  intro h
  rw [hlog h, eq_intCast_of_star_eq hR]
  apply quarticLog_integer_at_real_prime p hp
  rw [←eq_intCast_of_star_eq hR]
  exact hunit h

theorem product_identity_factor_not_dvd (p : G) [Fact (Prime p)]
    {A B D W F H R Q : G} (ha : ¬p ∣ A) (hd : ¬p ∣ D)
    (hf : F = 0) (hh : p ∣ H) (hi : D^4*A-B*W^4=F*R+H*Q) : ¬p ∣ B := by
  intro hb
  have he := congrArg (reduction p) hi
  simp only [map_sub, map_mul, map_pow, map_add, hf, map_zero, zero_mul,
    (reduction_zero p H).mpr hh, (reduction_zero p B).mpr hb,
    add_zero, sub_zero] at he
  exact mul_ne_zero (pow_ne_zero 4 (fun h => hd ((reduction_zero p D).mp h)))
    (fun h => ha ((reduction_zero p A).mp h)) he

end GraphCert.Quartic

end

                   
section

namespace GraphCert.Quartic

theorem tameClass_conjugate (p q : G) [Fact (Prime p)] [Fact (Prime q)]
    (h2 : ¬p∣2) (hq2 : ¬q∣2) (hpq : star p=q)
    {a b : G} (ha : a≠0) (hb : b=star a) :
    tameClass q hq2 b=conjugateTame (tameClass p h2 a) := by
  subst q
  subst b
  exact tameClass_star p h2 hq2 ha

def packedTamePair (epsilon : ZMod 4) (split : Bool) (a b : ClassVector) : ZMod 4 :=
  tamePair epsilon ![a 0,a 1] ![b 0,b 1] +
    if split then tamePair epsilon ![a 2,a 3] ![b 2,b 3] else 0

def packedTameBilinear (epsilon : ZMod 4) (split : Bool) :
    ClassVector →ₗ[ZMod 4] ClassVector →ₗ[ZMod 4] ZMod 4 where
  toFun a := {
    toFun := packedTamePair epsilon split a
    map_add' b c := by cases split <;> simp [packedTamePair,tamePair] <;> ring
    map_smul' c b := by cases split <;> simp [packedTamePair,tamePair] <;> ring }
  map_add' a b := by ext c; cases split <;> simp [packedTamePair,tamePair] <;> ring
  map_smul' c a := by ext b; cases split <;> simp [packedTamePair,tamePair] <;> ring

theorem packedTame_skew (epsilon : ZMod 4) (he : 2*epsilon=0) (split : Bool)
    (a b : ClassVector) : packedTameBilinear epsilon split a b = -packedTameBilinear epsilon split b a := by
  change packedTamePair _ _ _ _ = -packedTamePair _ _ _ _
  unfold packedTamePair
  rw [tamePair_skew epsilon he ![a 0,a 1]]
  cases split <;> simp only [Bool.false_eq_true,ite_false,ite_true,add_zero]
  rw [tamePair_skew epsilon he ![a 2,a 3]]
  ring

theorem tameFixed_sound (π : G) [Fact (Prime π)] (h2 : ¬π∣2)
    (p k : ℕ) (hp : π∣(p:G)) (c : TameCertificate) {a b : G}
    (hc : c.check π b) (hk : c.exponent<k) (hd : (p:G)^k∣a-b) :
    tameClass π h2 a = c.vector := by
  have hd' : π^(multiplicity π b+1)∣a-b := by
    rw [TameCertificate.valuation _ _ hc]
    exact (pow_dvd_pow _ (by omega)).trans ((pow_dvd_pow_of_dvd hp k).trans hd)
  rw [tameClass_congr π h2 (TameCertificate.nonzero _ _ hc) hd',TameCertificate.sound _ _ h2 hc]
  rfl

def coordinateMap {n r : ℕ} (spec : Fin n → Fin 4 → List (ZMod 4 × Fin r)) :
    (Fin r → ZMod 4) →ₗ[ZMod 4] (Fin n → ClassVector) where
  toFun q i c := ((spec i c).map (fun t => t.1*q t.2)).sum
  map_add' a b := by
    ext i c
    simp [mul_add,List.sum_map_add]
  map_smul' a b := by
    ext i c
    change ((spec i c).map (fun t => t.1*(a*b t.2))).sum = a*((spec i c).map (fun t => t.1*b t.2)).sum
    induction spec i c with
    | nil => simp
    | cons h t ih => simp [ih,mul_add]; ring

theorem partial_coordinates {r s : ℕ} (u : Fin s → Fin r) (hu : Function.Injective u)
    (q b : Fin r → ZMod 4) (hb : ∀ j,b (u j)=0)
    (hq : ∀ k, (∀ j,u j≠k) → q k=b k) :
    q = b + ∑ j, q (u j) • Pi.single (u j) 1 := by
  classical
  ext k
  by_cases hk : ∃j,u j=k
  · obtain ⟨j,rfl⟩ := hk
    simp only [Pi.add_apply,Finset.sum_apply,Pi.smul_apply,Pi.single_apply,smul_eq_mul]
    simp [hu.eq_iff,hb,eq_comm]
  · have hk' : ∀j,u j≠k := by simpa using hk
    simp only [Pi.add_apply,Finset.sum_apply,Pi.smul_apply,Pi.single_apply,smul_eq_mul]
    simp [Ne.symm (hk' _),hq k hk']

theorem linearMap_partial {r s n : ℕ}
    (A : (Fin r → ZMod 4) →ₗ[ZMod 4] (Fin n → ClassVector))
    (u : Fin s → Fin r) (hu : Function.Injective u)
    (q b : Fin r → ZMod 4) (hb : ∀j,b (u j)=0)
    (hq : ∀k,(∀j,u j≠k)→q k=b k)
    (base : Fin n → ClassVector) (D : Fin s → Fin n → ClassVector)
    (hbase : A b=base) (hD : ∀j,A (Pi.single (u j) 1)=D j) :
    A q = fun i => base i + ∑ j,q (u j) • D j i := by
  conv_lhs => rw [partial_coordinates u hu q b hb hq]
  simp only [map_add,map_sum,map_smul,hbase,hD]
  ext i c
  simp

end GraphCert.Quartic
end

                  
section
namespace GraphCert.Quartic

theorem pointTable_all {α β γ : Type*} {n : ℕ}
    (xs : Array α) (ys : Array β) (zs : Array γ)
    (hx : xs.size=n) (hy : ys.size=n) (hz : zs.size=n)
    (P : α → β → γ → Prop) [∀ a b c, Decidable (P a b c)]
    (hc : ((xs.toList.zip ys.toList).zip zs.toList).all
      (fun z => decide (P z.1.1 z.1.2 z.2))=true) :
    ∀ i : Fin n, P (xs[i.val]'(hx.symm ▸ i.isLt))
      (ys[i.val]'(hy.symm ▸ i.isLt)) (zs[i.val]'(hz.symm ▸ i.isLt)) := by
  intro i
  have hi : i.val < ((xs.toList.zip ys.toList).zip zs.toList).length := by
    simp only [List.length_zip, Array.length_toList, hx, hy, hz, min_self]
    exact i.isLt
  have h := of_decide_eq_true ((List.all_eq_true.mp hc) _ (List.getElem_mem hi))
  simpa only [List.getElem_zip, Array.getElem_toList] using h

theorem dyadicBilinear_coordinates (a b : ClassVector) : dyadicBilinear a b =
    a 0*(3*b 2+b 3)+a 1*(b 2+2*b 3)+
    a 2*(b 0+3*b 1+2*b 2)+a 3*(3*b 0+2*b 1) := by
  change dyadicPair a b=_
  norm_num [dyadicPair,dyadicMatrix,Fin.sum_univ_succ]
  ring

def unpackClass (a : ℕ) : ClassVector :=
  ![(a : ZMod 4),(↑(a/4) : ZMod 4),(↑(a/16) : ZMod 4),(↑(a/64) : ZMod 4)]

def dyadicPairNat (a b : ℕ) : ℕ :=
  a*(3*(b/16)+b/64)+(a/4)*(b/16+2*(b/64))+
  (a/16)*(b+3*(b/4)+2*(b/16))+(a/64)*(3*b+2*(b/4))

theorem dyadicPairNat_cast (a b : ℕ) :
    dyadicBilinear (unpackClass a) (unpackClass b)=(dyadicPairNat a b : ZMod 4) := by
  rw [dyadicBilinear_coordinates]
  simp [unpackClass,dyadicPairNat]


def classGraphNat {n : ℕ} (es : List (GraphEdge n)) (H C : Fin n → ℕ)
    (pair : ℕ → ℕ → ℕ) : ℕ :=
  (es.map (fun e => e.weight.val*pair (H e.src) (H e.dst))).sum+
  ∑ i, pair (H i) (C i)

theorem classGraphNat_cast {V : Type*} [AddCommGroup V] [Module (ZMod 4) V]
    {n m : ℕ} (es : List (GraphEdge n)) (h : es.length=m) (H C : Fin n → ℕ)
    (decode : ℕ → V) (pair : ℕ → ℕ → ℕ) (B : V →ₗ[ZMod 4] V →ₗ[ZMod 4] ZMod 4)
    (hp : ∀ a b, B (decode a) (decode b)=(pair a b : ZMod 4)) :
    vectorGraph (listEdges es h) (fun i => decode (H i))
      (fun i => decode (C i)) B=(classGraphNat es H C pair : ZMod 4) := by
  rw [vectorGraph_listEdges]
  simp [classGraphNat,hp,Nat.cast_list_sum,List.map_map,Function.comp_def,
    Nat.cast_sum,ZMod.natCast_zmod_val]

def packedPairNat (epsilon : ℕ) (split : Bool) (a b : ℕ) : ℕ :=
  a*(b/4)+3*(a/4)*b+epsilon*a*b +
    if split then (a/16)*(b/64)+3*(a/64)*(b/16)+epsilon*(a/16)*(b/16) else 0

theorem packedPairNat_cast (epsilon : ℕ) (split : Bool) (a b : ℕ) :
    packedTameBilinear epsilon split (unpackClass a) (unpackClass b)=
      (packedPairNat epsilon split a b : ZMod 4) := by
  have hn (v:ZMod 4) : -v=3*v := by revert v; decide +kernel
  change packedTamePair _ _ _ _ = _
  cases split <;> simp [packedTamePair,tamePair,unpackClass,packedPairNat,sub_eq_add_neg,hn] <;> ring


def edgePairNat {n : ℕ} (es : List (GraphEdge n)) (L R : Fin n → ℕ)
    (pair : ℕ → ℕ → ℕ) : ℕ :=
  (es.map (fun e => e.weight.val*pair (L e.src) (R e.dst))).sum

theorem edgePairNat_cast {n m : ℕ} (es : List (GraphEdge n)) (h : es.length=m)
    (L R : Fin n → ℕ) (pair : ℕ → ℕ → ℕ)
    (B : ClassVector →ₗ[ZMod 4] ClassVector →ₗ[ZMod 4] ZMod 4)
    (hp : ∀a b,B (unpackClass a) (unpackClass b)=(pair a b : ZMod 4)) :
    (∑e,(listEdges es h e).weight*B (unpackClass (L (listEdges es h e).src))
      (unpackClass (R (listEdges es h e).dst)))=(edgePairNat es L R pair : ZMod 4) := by
  rw [sum_listEdges es h (fun e => e.weight*B (unpackClass (L e.src)) (unpackClass (R e.dst)))]
  simp [edgePairNat,hp,Nat.cast_list_sum,List.map_map,Function.comp_def,ZMod.natCast_zmod_val]

def vertexPairNat {n : ℕ} (L R : Fin n → ℕ) (pair : ℕ → ℕ → ℕ) : ℕ :=
  ∑i,pair (L i) (R i)

theorem vertexPairNat_cast {n : ℕ} (L R : Fin n → ℕ) (pair : ℕ → ℕ → ℕ)
    (B : ClassVector →ₗ[ZMod 4] ClassVector →ₗ[ZMod 4] ZMod 4)
    (hp : ∀a b,B (unpackClass a) (unpackClass b)=(pair a b : ZMod 4)) :
    (∑i,B (unpackClass (L i)) (unpackClass (R i)))=(vertexPairNat L R pair : ZMod 4) := by
  simp [vertexPairNat,hp,Nat.cast_sum]

end GraphCert.Quartic
