namespace GraphCert.Quartic

theorem quarticLog_of_product_identity (p : G) [hp : Fact (Prime p)]
    (h2 : ¬p ∣ 2) {A B D W F H R Q : G}
    (ha : ¬p ∣ A) (hd : ¬p ∣ D) (hf : F = 0) (hh : p ∣ H)
    (hi : D^4*A-B*W^4=F*R+H*Q) :
    quarticLog p h2 A = quarticLog p h2 B := by
  have he := congrArg (reduction p) hi
  simp only [map_sub, map_mul, map_pow, map_add, hf, map_zero, zero_mul,
    (reduction_zero p H).mpr hh, add_zero, sub_eq_zero] at he
  have hw : ¬p ∣ W := by
    intro hw
    have hz := (reduction_zero p W).mpr hw
    rw [hz, zero_pow (by decide : (4 : ℕ) ≠ 0), mul_zero] at he
    exact mul_ne_zero (pow_ne_zero 4 (fun h => hd ((reduction_zero p D).mp h)))
      (fun h => ha ((reduction_zero p A).mp h)) he
  have hs := quarticSymbol_congr p h2 (a := D^4*A) (b := B*W^4)
    (by rw [hi, hf, zero_mul, zero_add]; exact dvd_mul_of_dvd_left hh Q)
  rw [quarticSymbol_mul, quarticSymbol_mul, quarticSymbol_pow,
    quarticSymbol_pow, quarticSymbol_fourth p h2 hd,
    quarticSymbol_fourth p h2 hw, one_mul, mul_one] at hs
  exact congrArg logImaginary hs

theorem quarticLog_integer_at_real_prime (p : PrimaryPrime)
    (hs : conjugatePrime p = p) (a : ℤ) (ha : ¬p.val ∣ (a : G)) :
    quarticLog p.val (primaryPrime_ne_two p) (a : G) = 0 := by
  have he : star p.val = p.val := congrArg Subtype.val hs
  have him : p.val.im = 0 := by
    have h := congrArg Zsqrtd.im he
    simp only [Zsqrtd.im_star] at h
    omega
  have hp : p.val = (p.val.re : G) := by
    ext <;> simp [him]
  have hc : IsCoprime p.val (a : G) := p.property.1.irreducible.coprime_iff_not_dvd.mpr ha
  have h := rational_integer_symbol p.val.re a p.property.2.1 (hp ▸ hc)
  rw [←hp, quarticJacobi_prime p.val (primaryPrime_ne_two p)] at h
  exact (congrArg logImaginary h).trans logImaginary_one

theorem finsum_involution_zero {α : Type*} (f : α → ZMod 4)
    (hf : Function.HasFiniteSupport f) (e : α ≃ α)
    (hee : ∀ a, e (e a) = a)
    (ha : ∀ a, f a + f (e a) = 0)
    (hz : ∀ a, e a = a → f a = 0) : (∑ᶠ a, f a) = 0 := by
  classical
  rw [finsum_eq_sum f hf]
  apply Finset.sum_involution (fun a _ => e a)
  · intro a _
    exact ha a
  · intro a _ hn h
    exact hn (hz a h)
  · intro a hab
    apply hf.mem_toFinset.mpr
    have hn := hf.mem_toFinset.mp hab
    intro he
    exact hn (by simpa [he] using ha a)
  · intro a _
    exact hee a

/-- A conjugation-stable finite set suffices when the omitted prime contributions cancel. -/
theorem finsum_eq_sum_of_conjugate_cancellation (f : PrimaryPrime → ZMod 4)
    (hf : Function.HasFiniteSupport f) (S : Finset PrimaryPrime)
    (hS : ∀ p, p ∈ S ↔ conjugatePrime p ∈ S)
    (ha : ∀ p, p ∉ S → f p + f (conjugatePrime p) = 0)
    (hz : ∀ p, p ∉ S → conjugatePrime p = p → f p = 0) :
    (∑ᶠ p, f p) = ∑ p ∈ S, f p := by
  classical
  let inside : PrimaryPrime → ZMod 4 := fun p => if p ∈ S then f p else 0
  let outside : PrimaryPrime → ZMod 4 := fun p => if p ∈ S then 0 else f p
  have hi : Function.HasFiniteSupport inside := by
    apply Set.Finite.subset S.finite_toSet
    intro p hp
    by_contra hn
    change p ∉ S at hn
    exact hp (by simp [inside, hn])
  have ho : Function.HasFiniteSupport outside := by
    apply hf.subset
    intro p hp h
    exact hp (by simp [outside, h])
  have hout : (∑ᶠ p, outside p) = 0 := by
    apply finsum_involution_zero outside ho conjugatePrimeEquiv conjugatePrime_twice
    · intro p
      by_cases hp : p ∈ S
      · simp [outside, hp, (hS p).mp hp, conjugatePrimeEquiv]
      · simpa [outside, hp, mt (hS p).mpr hp, conjugatePrimeEquiv] using ha p hp
    · intro p he
      by_cases hp : p ∈ S
      · simp [outside, hp]
      · simpa [outside, hp] using hz p hp he
  have hs : (∑ᶠ p, inside p) = ∑ p ∈ S, f p := by
    have hiS : Function.support inside ⊆ (S : Set PrimaryPrime) := by
      intro p hp
      by_contra hn
      change p ∉ S at hn
      exact hp (by simp [inside, hn])
    rw [finsum_eq_sum_of_support_subset inside hiS]
    apply Finset.sum_congr rfl
    intro p hp
    simp [inside, hp]
  have he : f = fun p => inside p + outside p := by
    funext p
    by_cases hp : p ∈ S <;> simp [inside, outside, hp]
  calc
    (∑ᶠ p, f p) = (∑ᶠ p, inside p) + (∑ᶠ p, outside p) := by
      rw [he, finsum_add_distrib hi ho]
    _ = ∑ p ∈ S, f p := by rw [hout, add_zero, hs]

end GraphCert.Quartic

