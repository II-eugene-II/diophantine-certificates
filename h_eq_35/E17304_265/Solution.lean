namespace GraphCert.Quartic

noncomputable def rowContribution {n : ℕ} (p : PrimaryPrime)
    (H A : Fin n → G) (i : Fin n) : ZMod 4 :=
  (multiplicity p.val (H i) : ZMod 4) * quarticLog p.val (primaryPrime_ne_two p) (A i)

theorem graph_tame_rows {n m : ℕ} (edges : Fin m → GraphEdge n)
    (H C : Fin n → G) (rows : Fin n → List (Fin n × ℕ))
    (hrows : ∀ i, rows i = neighborList edges i) (p : PrimaryPrime)
    (hC : ∀ i, ¬p.val ∣ C i)
    (hsep : ∀ i, p.val ∣ H i → ∀ jk ∈ rows i, ¬p.val ∣ H jk.1) :
    graphSum edges H C (tameAt p) =
      ∑ i, rowContribution p H (fun i => rowProduct (rows i) H (C i)) i := by
  let v : Fin n → ZMod 4 := fun i => multiplicity p.val (H i)
  let l : Fin n → ZMod 4 := fun i => quarticLog p.val (primaryPrime_ne_two p) (primeUnit p.val (H i))
  have he (e : Fin m) : ¬(p.val ∣ H (edges e).src ∧ p.val ∣ H (edges e).dst) := by
    rintro ⟨hs, hd⟩
    apply hsep (edges e).src hs ((edges e).dst, (edges e).weight.val) ?_ hd
    rw [hrows]
    apply List.mem_flatMap.mpr
    refine ⟨edges e, List.mem_ofFn.mpr ⟨e, rfl⟩, ?_⟩
    simp [adjacencyEntry]
  have hz (e : Fin m) : v (edges e).src * v (edges e).dst *
      quarticLog p.val (primaryPrime_ne_two p) (-1) = 0 := by
    by_cases hs : p.val ∣ H (edges e).src
    · have hd : ¬p.val ∣ H (edges e).dst := fun h => he e ⟨hs, h⟩
      simp [v, multiplicity_eq_zero_of_not_dvd hd]
    · simp [v, multiplicity_eq_zero_of_not_dvd hs]
  have ht : graphSum edges H C (tameAt p) =
      ∑ i, v i * (quarticLog p.val (primaryPrime_ne_two p) (C i) + incidenceRow edges l i) := by
    simp only [graphSum, tameAt, tame, multiplicity_eq_zero_of_not_dvd (hC _),
      primeUnit_of_not_dvd p.val (hC _), Nat.cast_zero, zero_mul, sub_zero, mul_zero, add_zero]
    change (∑ e, (edges e).weight *
      (v (edges e).src*l (edges e).dst-v (edges e).dst*l (edges e).src+
        v (edges e).src*v (edges e).dst*quarticLog p.val (primaryPrime_ne_two p) (-1))) +
      (∑ i, v i*quarticLog p.val (primaryPrime_ne_two p) (C i)) = _
    simp only [hz, add_zero]
    rw [←incidence_sum edges v l]
    simp only [mul_add, Finset.sum_add_distrib]
    ring
  rw [ht]
  apply Finset.sum_congr rfl
  intro i _
  by_cases hi : p.val ∣ H i
  · rw [rowContribution, rowProduct_log p.val (primaryPrime_ne_two p) (rows i) H
      (hC i) (hsep i hi), ←neighborList_log, ←hrows]
    congr 2
    unfold rowLog
    apply congrArg List.sum
    apply List.map_congr_left
    intro jk hjk
    dsimp [l]
    rw [primeUnit_of_not_dvd p.val (hsep i hi jk hjk)]
  · simp [v, rowContribution, multiplicity_eq_zero_of_not_dvd hi]

theorem graph_tame_finite_support {n m : ℕ} (edges : Fin m → GraphEdge n)
    (H C : Fin n → G) (hH : ∀ i, H i ≠ 0) (hC : ∀ i, C i ≠ 0) :
    Function.HasFiniteSupport (fun p => graphSum edges H C (tameAt p)) := by
  have he (e : Fin m) : Function.HasFiniteSupport (fun p : PrimaryPrime =>
      (edges e).weight*tameAt p (H (edges e).src) (H (edges e).dst)) :=
    (tameAt_finite_support (hH _) (hH _)).fun_comp (mul_zero _)
  exact (Function.HasFiniteSupport.sum he Finset.univ).add
    (Function.HasFiniteSupport.sum (fun i => tameAt_finite_support (hH i) (hC i)) Finset.univ)

theorem graph_finite_prime_reduction_relaxed {n m : ℕ} (edges : Fin m → GraphEdge n)
    (H C : Fin n → G) (hH : ∀ i, H i ≠ 0) (hC : ∀ i, C i ≠ 0)
    (S : Finset PrimaryPrime) (hS : ∀ p, p ∈ S ↔ conjugatePrime p ∈ S)
    (ha : ∀ p, p ∉ S → graphSum edges H C (tameAt p) +
      graphSum edges H C (tameAt (conjugatePrime p)) = 0)
    (hz : ∀ p, p ∉ S → conjugatePrime p = p → graphSum edges H C (tameAt p) = 0) :
    (∑ p ∈ S, graphSum edges H C (tameAt p)) + graphSum edges H C wild = 0 := by
  have h := graph_global_product edges H C hH hC
  rw [finsum_eq_sum_of_conjugate_cancellation _
    (graph_tame_finite_support edges H C hH hC) S hS ha hz] at h
  exact h

theorem sum_conjugate_rows {n : ℕ} (a b : Fin n → ZMod 4)
    (partner : Fin n → Fin n) (hp : Function.Involutive partner)
    (ha : ∀ i, a i + b (partner i) = 0) : (∑ i, a i) + (∑ i, b i) = 0 := by
  have he : (∑ i, b (partner i)) = ∑ i, b i :=
    Equiv.sum_comp (⟨partner, partner, hp, hp⟩ : Fin n ≃ Fin n) b
  rw [←he, ←Finset.sum_add_distrib]
  exact Finset.sum_eq_zero (fun i _ => ha i)

theorem sum_fixed_rows {n : ℕ} (a : Fin n → ZMod 4)
    (partner : Fin n → Fin n) (hp : Function.Involutive partner)
    (ha : ∀ i, a i + a (partner i) = 0)
    (hz : ∀ i, partner i = i → a i = 0) : (∑ i, a i) = 0 := by
  apply Finset.sum_involution (fun i _ => partner i)
  · intro i _; exact ha i
  · intro i _ hn he; exact hn (hz i he)
  · intro i _; exact Finset.mem_univ _
  · intro i _; exact hp i

end GraphCert.Quartic

