theorem values_real (i : Fin 47) (h : real i = true) (x y : ℤ) : (values x y i).im = 0 := by
  fin_cases i <;> simp [real] at h <;> simp [values, GraphCert.Quartic.Polynomial.value, GraphCert.Quartic.Polynomial.eval, GraphCert.Quartic.Dense.eval, nodes]

theorem nonzero_0 {x y : ℤ} (hf : equation x y = 0) : values x y 0 ≠ 0 :=
  nonzero_of_mod F (nodes 0) 4 (by decide +kernel) (curve_zero hf)

