def factor_14 : GraphCert.Quartic.Polynomial.Poly := conjugate (row (neighbors 15) nodes (constants 15))

theorem relation_14 (x y : ℤ) :
    (37 : G)^4*rowProduct (neighbors 14) (values x y) (constants 14) -
      GraphCert.Quartic.Polynomial.value factor_14 x y * GraphCert.Quartic.Polynomial.value root_14 x y^4 =
      GraphCert.Quartic.Polynomial.value F x y*GraphCert.Quartic.Polynomial.value relationA_14 x y + values x y 14*GraphCert.Quartic.Polynomial.value relationB_14 x y :=
  identity_product (neighbors 14) nodes (constants 14) F relationA_14 relationB_14
    factor_14 root_14 14 37 (by decide +kernel) x y

theorem factor_pair_14 (x y : ℤ) : GraphCert.Quartic.Polynomial.value factor_14 x y =
    star (rowProduct (neighbors 15) (values x y) (constants 15)) := by
  rw [factor_14,value_conjugate,eval_row]; rfl

