namespace GraphCert.Quartic

def conjugateWild : ClassVector →ₗ[ZMod 4] ClassVector where
  toFun a := ![a 0, 3*a 0+3*a 1, 3*a 2, a 2+a 3]
  map_add' a b := by ext i; fin_cases i <;> simp <;> ring
  map_smul' r a := by ext i; fin_cases i <;> simp <;> ring

theorem uniformizer_dvd_star_iff (a : G) :
    uniformizer ∣ star a ↔ uniformizer ∣ a := by
  simp only [uniformizer_dvd_iff, Zsqrtd.re_star, Zsqrtd.im_star,
    Int.dvd_iff_emod_eq_zero]
  omega

theorem uniformizer_power_star_congr {a b : G} {k : ℕ}
    (h : uniformizer^k ∣ a-b) : uniformizer^k ∣ star a-star b := by
  have hs := star_dvd_of_dvd h
  rw [star_sub, star_pow] at hs
  have hp : star uniformizer = uniformizer * imaginary^3 := by decide
  rw [hp, mul_pow] at hs
  exact dvd_trans (dvd_mul_right _ _) hs

theorem unit_wildClass_star {a : G} (ha : ¬uniformizer ∣ a) :
    wildClass (star a) = conjugateWild (wildClass a) := by
  have hs : ¬uniformizer ∣ star a := mt (uniformizer_dvd_star_iff a).mp ha
  rw [wildClass_of_not_dvd hs, wildClass_of_not_dvd ha]
  obtain ⟨i,hi⟩ := unit_representative ha
  rw [wildVec_congr 0 (uniformizer_power_star_congr hi), wildVec_congr 0 hi]
  have ht : ∀ i : Fin 64, wildVec 0 (star (representative 7 (2*i.val+1))) =
      conjugateWild (wildVec 0 (representative 7 (2*i.val+1))) := by decide +kernel
  exact ht i

theorem wildClass_pow {a : G} (ha : a ≠ 0) (k : ℕ) :
    wildClass (a^k) = (k : ZMod 4) • wildClass a := by
  induction k with
  | zero => simp [wildClass_of_not_dvd (not_uniformizer_dvd_unit isUnit_one), wildVec, unitLog_one]
  | succ k ih =>
      rw [pow_succ, wildClass_mul (pow_ne_zero k ha) ha, ih]
      push_cast
      simp [add_smul]

theorem wildClass_star_uniformizer :
    wildClass (star uniformizer) = conjugateWild (wildClass uniformizer) := by
  rw [wildClass_uniformizer]
  exact computeWildClass_sound (k := 8) (by decide +kernel)

theorem wildClass_star {a : G} (ha : a ≠ 0) :
    wildClass (star a) = conjugateWild (wildClass a) := by
  obtain ⟨he, hu⟩ := primeUnit_spec uniformizer ha
  have hune : primeUnit uniformizer a ≠ 0 := primeUnit_nonzero uniformizer ha
  have hsune : star (primeUnit uniformizer a) ≠ 0 := by simpa using hune
  have hsp : star uniformizer ≠ 0 := by simpa using uniformizer_prime.ne_zero
  conv_lhs => rw [he, star_mul, star_pow]
  conv_lhs => rw [mul_comm]
  rw [wildClass_mul (pow_ne_zero _ hsp) hsune, wildClass_pow hsp,
    wildClass_star_uniformizer, unit_wildClass_star hu]
  conv_rhs => rw [he, wildClass_mul (pow_ne_zero _ uniformizer_prime.ne_zero) hune,
    wildClass_pow uniformizer_prime.ne_zero]
  rw [map_add, map_smul]

def conjugateTame : (Fin 2 → ZMod 4) →ₗ[ZMod 4] (Fin 2 → ZMod 4) where
  toFun a := ![a 0, -a 1]
  map_add' a b := by ext i; fin_cases i <;> simp [add_comm]
  map_smul' r a := by ext i; fin_cases i <;> simp

theorem tameClass_star (p : G) [Fact (Prime p)] [Fact (Prime (star p))]
    (h2 : ¬p ∣ 2) (hs2 : ¬star p ∣ 2) {a : G} (ha : a ≠ 0) :
    tameClass (star p) hs2 (star a) = conjugateTame (tameClass p h2 a) := by
  simp only [tameClass, multiplicity_star, primeUnit_star p ha,
    quarticLog_star p h2 hs2 (primeUnit_spec p ha).2]
  rfl

end GraphCert.Quartic

