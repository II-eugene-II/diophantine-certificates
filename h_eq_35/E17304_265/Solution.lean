theorem outside_units {x y : ℤ} (hf : equation x y=0)
    (p : PrimaryPrime) (hN : ¬p.val ∣ supportNumber) : ∀i, p.val ∣ values x y i → ¬p.val ∣ products x y i :=
  fun i hi => rowProduct_not_dvd p.val (neighbors i) (values x y)
    (outside_constants p hN i) (outside_separation hf p hN i hi)

theorem conjugate_value_0 (x y : ℤ) : values x y 0=star (values x y 0) := by
  ext <;> simp [values,nodes,GraphCert.Quartic.Polynomial.value,
    GraphCert.Quartic.Polynomial.eval,GraphCert.Quartic.Dense.eval,mul_comm] <;> ring

theorem log_relation_0 {x y : ℤ} (hf : equation x y=0)
    (p : PrimaryPrime) (hN : ¬p.val ∣ supportNumber) (hi : p.val ∣ values x y 0) :
    quarticLog p.val (primaryPrime_ne_two p) (products x y 0) =
      quarticLog p.val (primaryPrime_ne_two p) (GraphCert.Quartic.Polynomial.value factor_0 x y) :=
  quarticLog_of_product_identity p.val (primaryPrime_ne_two p)
    (outside_units hf p hN 0 hi) (outside_denominators p hN 0)
    (curve_zero hf) hi (relation_0 x y)

theorem real_unit_0 {x y : ℤ} (hf : equation x y=0)
    (p : PrimaryPrime) (hN : ¬p.val ∣ supportNumber) (hi : p.val ∣ values x y 0) : ¬p.val ∣ GraphCert.Quartic.Polynomial.value factor_0 x y :=
  product_identity_factor_not_dvd p.val (outside_units hf p hN 0 hi)
    (outside_denominators p hN 0) (curve_zero hf) hi (relation_0 x y)

theorem pair_0 {x y : ℤ} (hf : equation x y=0) (p : PrimaryPrime) (hN : ¬p.val ∣ supportNumber) :
    contribution p (values x y 0) (products x y 0) +
      contribution (conjugatePrime p) (values x y 0) (products x y 0)=0 :=
  contribution_real p _ _ (GraphCert.Quartic.Polynomial.value factor_0 x y) (conjugate_value_0 x y).symm (factor_real_0 x y)
    (real_unit_0 hf _ (support_conjugate p hN)) (log_relation_0 hf p hN)
    (log_relation_0 hf _ (support_conjugate p hN))

theorem fixed_0 {x y : ℤ} (hf : equation x y=0) (p : PrimaryPrime)
    (hN : ¬p.val ∣ supportNumber) (hp : conjugatePrime p=p) : contribution p (values x y 0) (products x y 0)=0 :=
  contribution_real_fixed p hp _ _ (GraphCert.Quartic.Polynomial.value factor_0 x y) (factor_real_0 x y)
    (real_unit_0 hf p hN) (log_relation_0 hf p hN)

