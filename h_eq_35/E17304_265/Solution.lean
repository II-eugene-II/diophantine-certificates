namespace GraphCert.Quartic

/-- Complex conjugation on normalized odd Gaussian primes. -/
def conjugatePrime (p : PrimaryPrime) : PrimaryPrime :=
  ⟨star p.val, prime_star p.property.1, primary_star p.property.2⟩

@[simp] theorem conjugatePrime_twice (p : PrimaryPrime) :
    conjugatePrime (conjugatePrime p) = p := by
  apply Subtype.ext
  exact star_star _

def conjugatePrimeEquiv : PrimaryPrime ≃ PrimaryPrime :=
  ⟨conjugatePrime, conjugatePrime, conjugatePrime_twice, conjugatePrime_twice⟩

theorem multiplicity_star (p a : G) :
    multiplicity (star p) (star a) = multiplicity p a := by
  apply multiplicity_eq_of_emultiplicity_eq
  apply emultiplicity_eq_emultiplicity_iff.mpr
  intro n
  constructor
  · intro h
    simpa only [star_pow, star_star] using star_dvd_of_dvd h
  · intro h
    simpa only [star_pow] using star_dvd_of_dvd h

theorem logImaginary_star {a : G} (ha : a ^ 4 = 1) :
    logImaginary (star a) = -logImaginary a := by
  obtain ⟨i, hi, rfl⟩ := imaginary_primitive.eq_pow_of_pow_eq_one ha
  interval_cases i <;> decide +kernel

theorem quarticLog_star (p : G) [Fact (Prime p)] [Fact (Prime (star p))]
    (h2 : ¬p ∣ 2) (hs2 : ¬star p ∣ 2) {a : G} (ha : ¬p ∣ a) :
    quarticLog (star p) hs2 (star a) = -quarticLog p h2 a := by
  have h := quarticSymbol_star p h2 hs2 (star a)
  rw [star_star] at h
  have he := congrArg star h
  simp only [star_star] at he
  exact (congrArg logImaginary he).trans
    (logImaginary_star (quarticSymbol_fourth p h2 ha))

theorem primeUnit_star (p : G) [hp : Fact (Prime p)]
    [Fact (Prime (star p))] {a : G} (ha : a ≠ 0) :
    primeUnit (star p) (star a) = star (primeUnit p a) := by
  have hs : star a ≠ 0 := fun h => ha (star_injective h)
  apply mul_left_cancel₀ (pow_ne_zero (multiplicity p a) (prime_star hp.out).ne_zero)
  rw [←multiplicity_star p a, ←(primeUnit_spec (star p) hs).1]
  simpa only [star_mul, star_pow, multiplicity_star, mul_comm] using
    congrArg star (primeUnit_spec p ha).1

theorem tame_star (p : G) [hp : Fact (Prime p)] [Fact (Prime (star p))]
    (h2 : ¬p ∣ 2) (hs2 : ¬star p ∣ 2) {a b : G} (ha : a ≠ 0) (hb : b ≠ 0) :
    tame (star p) hs2 (star a) (star b) = -tame p h2 a b := by
  have hn : ¬p ∣ (-1 : G) := not_prime_dvd_unit hp.out isUnit_neg_one
  have hnlog := quarticLog_star p h2 hs2 hn
  simp only [star_neg, star_one] at hnlog
  simp only [tame, multiplicity_star, primeUnit_star p ha, primeUnit_star p hb,
    quarticLog_star p h2 hs2 (primeUnit_spec p ha).2,
    quarticLog_star p h2 hs2 (primeUnit_spec p hb).2, hnlog]
  ring

end GraphCert.Quartic

