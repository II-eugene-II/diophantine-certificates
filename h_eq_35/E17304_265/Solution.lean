namespace CubicSpecial
open MulChar AddChar Polynomial
theorem gauss_frobenius_iter {F R : Type*} [CommRing F] [Fintype F]
    [CommRing R] (p : ℕ) [Fact p.Prime] [CharP R p]
    (χ : MulChar F R) (ψ : AddChar F R) (n : ℕ) :
    gaussSum χ ψ ^ (p ^ n) = gaussSum (χ ^ (p ^ n)) (ψ ^ (p ^ n)) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, pow_mul, ih, gaussSum_frob, ← pow_mul, ← pow_mul]

theorem sum_polynomial_eq_zero {F : Type*} [Field F] [Fintype F]
    (f : F[X]) (h : f.natDegree < Fintype.card F - 1) :
    ∑ x : F, f.eval x = 0 := by
  classical
  simp_rw [Polynomial.eval_eq_sum_range]
  rw [Finset.sum_comm]
  apply Finset.sum_eq_zero
  intro i hi
  rw [← Finset.mul_sum, FiniteField.sum_pow_lt_card_sub_one F i
    (by have := Finset.mem_range.mp hi; omega), mul_zero]


def powerChar (F : Type*) [Field F] (n : ℕ) (hn : n ≠ 0) : MulChar F F where
  toFun x := x ^ n
  map_one' := one_pow n
  map_mul' := fun x y => mul_pow x y n
  map_nonunit' := by
    intro x hx
    have hx' : x = 0 := by simpa [isUnit_iff_ne_zero] using hx
    simp [hx', hn]

theorem finite_field_card_cast_ne_zero (F E : Type*) [Field F] [Fintype F]
    [Field E] [Fintype E] (hchar : ringChar F ≠ ringChar E) :
    (Fintype.card E : F) ≠ 0 := by
  obtain ⟨n, hp, hc⟩ := FiniteField.card E (ringChar E)
  rw [hc, Nat.cast_pow]
  apply pow_ne_zero
  exact fun h => hchar (CharP.ringChar_of_prime_eq_zero hp h)

end CubicSpecial
                                                  
/-!
Exact Gaussian integer polynomial arithmetic.  The executable checks below
produce ordinary kernel-checked equalities; no reciprocity theorem is assumed.
-/
namespace GraphCert.Quartic

abbrev G := GaussianInt
abbrev Poly := List G

def gi (a b : ℤ) : G := ⟨a, b⟩
def imaginary : G := gi 0 1
def uniformizer : G := gi 1 1

def eval : Poly → G → G
  | [], _ => 0
  | a :: p, t => a + t * eval p t

def add : Poly → Poly → Poly
  | [], q => q
  | p, [] => p
  | a :: p, b :: q => (a + b) :: add p q

def scale (a : G) (p : Poly) : Poly := p.map (a * ·)

def mul : Poly → Poly → Poly
  | [], _ => []
  | a :: p, q => add (scale a q) (0 :: mul p q)

def power (p : Poly) : ℕ → Poly
  | 0 => [1]
  | n + 1 => mul (power p n) p

@[simp] theorem eval_add (p q : Poly) (t : G) :
    eval (add p q) t = eval p t + eval q t := by
  induction p generalizing q with
  | nil => simp [add, eval]
  | cons a p ih =>
    cases q with
    | nil => simp [add, eval]
    | cons b q => simp only [add, eval, ih]; ring

@[simp] theorem eval_scale (a : G) (p : Poly) (t : G) :
    eval (scale a p) t = a * eval p t := by
  induction p with
  | nil => simp [scale, eval]
  | cons b p ih => simp only [scale, List.map_cons, eval] at *; rw [ih]; ring

@[simp] theorem eval_mul (p q : Poly) (t : G) :
    eval (mul p q) t = eval p t * eval q t := by
  induction p with
  | nil => simp [mul, eval]
  | cons a p ih => simp only [mul, eval_add, eval_scale, eval, ih]; ring

@[simp] theorem eval_power (p : Poly) (n : ℕ) (t : G) :
    eval (power p n) t = (eval p t)^n := by
  induction n with
  | zero => simp [power, eval]
  | succ n ih => simp [power, eval_mul, ih, pow_succ]

/-- Trailing zeros are irrelevant, but list equality remains executable. -/
def pad (n : ℕ) (p : Poly) : Poly := p ++ List.replicate (n - p.length) 0

@[simp] theorem eval_append (p q : Poly) (t : G) :
    eval (p ++ q) t = eval p t + t^p.length * eval q t := by
  induction p with
  | nil => simp [eval]
  | cons a p ih => simp only [List.cons_append, eval, List.length_cons, ih, pow_succ]; ring

@[simp] theorem eval_zeros (n : ℕ) (t : G) : eval (List.replicate n 0) t = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ, eval, ih]

@[simp] theorem eval_pad (n : ℕ) (p : Poly) (t : G) : eval (pad n p) t = eval p t := by
  simp [pad]

/-- A polynomial equality certificate implies equality at every Gaussian argument. -/
theorem eq_of_pad_eq {p q : Poly} {n : ℕ} (h : pad n p = pad n q) (t : G) :
    eval p t = eval q t := by
  simpa using congrArg (fun r => eval r t) h

/-- Denominator-cleared fourth-power identity; all data are explicit integers. -/
structure StarWitness where
  modulus : Poly
  numerator : Poly
  leftMultiplier : ℕ
  rightMultiplier : ℕ
  product : Poly
  quotient : Poly
  padding : ℕ

def StarWitness.valid (s : StarWitness) : Prop :=
  pad s.padding (scale (s.leftMultiplier : G) (power s.numerator 4)) =
    pad s.padding (add (scale (s.rightMultiplier : G) s.product) (mul s.quotient s.modulus))

instance (s : StarWitness) : Decidable s.valid := inferInstanceAs (Decidable (_ = _))

theorem StarWitness.identity (s : StarWitness) (h : s.valid) (t : G) :
    (s.leftMultiplier : G) * eval s.numerator t ^ 4 =
      (s.rightMultiplier : G) * eval s.product t + eval s.quotient t * eval s.modulus t := by
  simpa only [eval_scale, eval_power, eval_add, eval_mul] using eq_of_pad_eq h t

theorem StarWitness.at_root (s : StarWitness) (h : s.valid) (t : G)
    (ht : eval s.modulus t = 0) :
    (s.leftMultiplier : G) * eval s.numerator t ^ 4 =
      (s.rightMultiplier : G) * eval s.product t := by
  simpa [ht] using s.identity h t

end GraphCert.Quartic

                                              

                                                                          
                                                                            
                                                                     
namespace GraphCert.Quartic

def signature : ℕ → G → ℕ
  | 0, _ => 0
  | k + 1, z =>
    let digit := (z.re + z.im) % 2
    digit.toNat + 2 * signature k (gi ((z.re + z.im - digit) / 2)
      ((z.im - z.re + digit) / 2))

def representative : ℕ → ℕ → G
  | 0, _ => 0
  | k + 1, bits => (if bits % 2 = 1 then 1 else 0) +
      uniformizer * representative k (bits / 2)

def unitRepresentative (k : ℕ) : G :=
  imaginary^(k%4) * (gi 1 2)^((k/4)%4) * (gi 5 0)^(k/16)

def unitSignatures : List ℕ :=
  (List.range 64).map fun k => signature 7 (unitRepresentative k)

theorem unitSignatures_complete : ∀ k : Fin 64,
    2*k.val+1 ∈ unitSignatures := by decide +kernel

theorem unitSignatures_unique : unitSignatures.Nodup := by decide +kernel

theorem representatives_roundtrip : ∀ k : Fin 128,
    signature 7 (representative 7 k.val) = k.val := by decide +kernel

theorem unit_fourth_residues : ∀ k : Fin 64,
    signature 7 ((representative 7 (2*k.val+1))^4) = 1 := by decide +kernel

/-- The polynomial used for Hensel lifting in the principal-unit group. -/
def henselPolynomial (t : G) : G :=
  t + gi (-3) 3*t^2 + gi 0 (-8)*t^3 + gi 4 4*t^4

theorem principal_unit_identity (t : G) :
    (1 + uniformizer^3*t)^4 = 1 + 4*uniformizer^3*henselPolynomial t := by
  rcases t with ⟨a,b⟩
  apply Zsqrtd.ext <;>
    norm_num [uniformizer, gi, henselPolynomial, pow_succ, Zsqrtd.re_mul,
      Zsqrtd.im_mul, Zsqrtd.re_add, Zsqrtd.im_add] <;> ring

abbrev ClassVector := Fin 4 → ZMod 4

def dyadicMatrix : Matrix (Fin 4) (Fin 4) (ZMod 4) :=
  !![0,0,3,1; 0,0,1,2; 1,3,2,0; 3,2,0,0]

theorem dyadicMatrix_skew (i j : Fin 4) : dyadicMatrix i j = -dyadicMatrix j i := by
  fin_cases i <;> fin_cases j <;> decide

def dyadicPair (a b : ClassVector) : ZMod 4 :=
  ∑ i, ∑ j, a i * dyadicMatrix i j * b j

theorem dyadicPair_add_left (a b c : ClassVector) :
    dyadicPair (a+b) c = dyadicPair a c + dyadicPair b c := by
  simp [dyadicPair, add_mul, Finset.sum_add_distrib]

theorem dyadicPair_add_right (a b c : ClassVector) :
    dyadicPair a (b+c) = dyadicPair a b + dyadicPair a c := by
  simp [dyadicPair, mul_add, Finset.sum_add_distrib]

theorem dyadicPair_skew (a b : ClassVector) : dyadicPair a b = -dyadicPair b a := by
  unfold dyadicPair
  rw [Finset.sum_comm]
  simp only [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [dyadicMatrix_skew j i]
  ring

end GraphCert.Quartic

                                              
