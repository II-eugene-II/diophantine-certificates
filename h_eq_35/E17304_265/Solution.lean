without_editor_info def supportPrimes : Fin 19 → PrimaryPrime := ![⟨At3.pi0,(inferInstance : Fact (Prime At3.pi0)).out,At3.primary0⟩,⟨At5.pi0,(inferInstance : Fact (Prime At5.pi0)).out,At5.primary0⟩,⟨At5.pi1,(inferInstance : Fact (Prime At5.pi1)).out,At5.primary1⟩,⟨At7.pi0,(inferInstance : Fact (Prime At7.pi0)).out,At7.primary0⟩,⟨At13.pi0,(inferInstance : Fact (Prime At13.pi0)).out,At13.primary0⟩,⟨At13.pi1,(inferInstance : Fact (Prime At13.pi1)).out,At13.primary1⟩,⟨At17.pi0,(inferInstance : Fact (Prime At17.pi0)).out,At17.primary0⟩,⟨At17.pi1,(inferInstance : Fact (Prime At17.pi1)).out,At17.primary1⟩,⟨At29.pi0,(inferInstance : Fact (Prime At29.pi0)).out,At29.primary0⟩,⟨At29.pi1,(inferInstance : Fact (Prime At29.pi1)).out,At29.primary1⟩,⟨At31.pi0,(inferInstance : Fact (Prime At31.pi0)).out,At31.primary0⟩,⟨At37.pi0,(inferInstance : Fact (Prime At37.pi0)).out,At37.primary0⟩,⟨At37.pi1,(inferInstance : Fact (Prime At37.pi1)).out,At37.primary1⟩,⟨At41.pi0,(inferInstance : Fact (Prime At41.pi0)).out,At41.primary0⟩,⟨At41.pi1,(inferInstance : Fact (Prime At41.pi1)).out,At41.primary1⟩,⟨At61.pi0,(inferInstance : Fact (Prime At61.pi0)).out,At61.primary0⟩,⟨At61.pi1,(inferInstance : Fact (Prime At61.pi1)).out,At61.primary1⟩,⟨At109.pi0,(inferInstance : Fact (Prime At109.pi0)).out,At109.primary0⟩,⟨At109.pi1,(inferInstance : Fact (Prime At109.pi1)).out,At109.primary1⟩]

without_editor_info def primePartner : Fin 19 → Fin 19 := ![0,2,1,3,5,4,7,6,9,8,10,12,11,14,13,16,15,18,17]

without_editor_info theorem primePartner_star (i:Fin 19) : conjugatePrime (supportPrimes i)=supportPrimes (primePartner i) := by
  apply Subtype.ext
  revert i
  decide +kernel

without_editor_info theorem supportPrimes_injective : Function.Injective supportPrimes := by
  intro i j h
  have h := congrArg (fun p:PrimaryPrime=>(p.val.re,p.val.im)) h
  have hi : ∀i j:Fin 19, ((supportPrimes i).val.re,(supportPrimes i).val.im)=
      ((supportPrimes j).val.re,(supportPrimes j).val.im) → i=j := by decide +kernel
  exact hi i j h

without_editor_info theorem support_divides : supportNumber∣2*∏i,(supportPrimes i).val :=
  ⟨-1,by decide +kernel⟩

without_editor_info theorem quartic_reciprocity {x y:ℤ} (hf:equation x y=0) :
    At2.localSum x y + At3.localSum x y + At5.localSum x y + At7.localSum x y + At13.localSum x y + At17.localSum x y + At29.localSum x y + At31.localSum x y + At37.localSum x y + At41.localSum x y + At61.localSum x y + At109.localSum x y=0 := by
  classical
  have hS : ∀p,p∈Finset.univ.image supportPrimes ↔ conjugatePrime p∈Finset.univ.image supportPrimes := by
    have one : ∀p,p∈Finset.univ.image supportPrimes → conjugatePrime p∈Finset.univ.image supportPrimes := by
      intro p hp
      obtain ⟨i,_,rfl⟩ := Finset.mem_image.mp hp
      exact Finset.mem_image.mpr ⟨primePartner i,Finset.mem_univ _,(primePartner_star i).symm⟩
    intro p
    exact ⟨one p,fun h=>by simpa only [conjugatePrime_twice] using one (conjugatePrime p) h⟩
  have h := graph_finite_prime_reduction_relaxed edges (values x y) constants (all_nonzero hf) constants_nonzero
    (Finset.univ.image supportPrimes) hS
    (fun p hp=>outside_pair hf p (support_not_dvd supportPrimes supportNumber support_divides p hp))
    (fun p hp=>outside_fixed hf p (support_not_dvd supportPrimes supportNumber support_divides p hp))
