def equation (x y : ℤ) : ℤ := (GraphCert.Quartic.Polynomial.value F x y).re

def values (x y : ℤ) (i : Fin 47) : G := GraphCert.Quartic.Polynomial.value (nodes i) x y

theorem curve_zero {x y : ℤ} (hf : equation x y = 0) : GraphCert.Quartic.Polynomial.value F x y = 0 := by
  ext
  · exact hf
  · simp [GraphCert.Quartic.Polynomial.value, GraphCert.Quartic.Polynomial.eval, GraphCert.Quartic.Dense.eval, F]

theorem equation_congr {M x y a b : ℤ} (hx : M ∣ x-a) (hy : M ∣ y-b) :
    M ∣ equation x y-equation a b := real_congr F hx hy

theorem values_congr (M : ℕ) (x y a b : ℤ) (hx : (M : ℤ) ∣ x-a) (hy : (M : ℤ) ∣ y-b) :
    ∀ i : Fin 47, (M : G) ∣ values x y i-values a b i :=
  fun i => value_congr (nodes i) M hx hy

