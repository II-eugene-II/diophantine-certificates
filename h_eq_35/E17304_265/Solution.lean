def factor_9 : GraphCert.Quartic.Polynomial.Poly := conjugate (row (neighbors 10) nodes (constants 10))

theorem relation_9 (x y : ℤ) :
    (296 : G)^4*rowProduct (neighbors 9) (values x y) (constants 9) -
      GraphCert.Quartic.Polynomial.value factor_9 x y * GraphCert.Quartic.Polynomial.value root_9 x y^4 =
      GraphCert.Quartic.Polynomial.value F x y*GraphCert.Quartic.Polynomial.value relationA_9 x y + values x y 9*GraphCert.Quartic.Polynomial.value relationB_9 x y :=
  identity_product (neighbors 9) nodes (constants 9) F relationA_9 relationB_9
    factor_9 root_9 9 296 (by decide +kernel) x y

theorem factor_pair_9 (x y : ℤ) : GraphCert.Quartic.Polynomial.value factor_9 x y =
    star (rowProduct (neighbors 10) (values x y) (constants 10)) := by
  rw [factor_9,value_conjugate,eval_row]; rfl

