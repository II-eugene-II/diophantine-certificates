def dyadicBilinear : ClassVector→ₗ[ZMod 4]ClassVector→ₗ[ZMod 4]ZMod 4 where
  toFun a:={
    toFun:=dyadicPair a
    map_add' b c:=dyadicPair_add_right a b c
    map_smul' c b:=by
      simp only [dyadicPair,Pi.smul_apply,smul_eq_mul,RingHom.id_apply,Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      ring }
  map_add' a b:=by apply LinearMap.ext; intro c; exact dyadicPair_add_left a b c
  map_smul' c a:=by
    apply LinearMap.ext
    intro b
    simp only [LinearMap.coe_mk,AddHom.coe_mk,LinearMap.smul_apply,dyadicPair,
      Pi.smul_apply,smul_eq_mul,RingHom.id_apply,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring

def tamePair (epsilon:ZMod 4) (a b:Fin 2→ZMod 4) : ZMod 4 :=
  a 0*b 1-a 1*b 0+epsilon*a 0*b 0

def tameBilinear (epsilon:ZMod 4) :
    (Fin 2→ZMod 4)→ₗ[ZMod 4](Fin 2→ZMod 4)→ₗ[ZMod 4]ZMod 4 where
  toFun a:={
    toFun:=tamePair epsilon a
    map_add' b c:=by simp [tamePair]; ring
    map_smul' c b:=by simp [tamePair]; ring }
  map_add' a b:=by ext c; simp [tamePair]; ring
  map_smul' c a:=by ext b; simp [tamePair]; ring

theorem tamePair_skew (epsilon:ZMod 4) (he:2*epsilon=0) (a b:Fin 2→ZMod 4) :
    tamePair epsilon a b= -tamePair epsilon b a := by
  unfold tamePair
  linear_combination a 0*b 0*he

theorem tame_as_pair (π:G) [Fact (Prime π)] (h2:¬π∣2) (a b:G) :
    tame π h2 a b=tamePair (quarticLog π h2 (-1)) (tameClass π h2 a) (tameClass π h2 b) := by
  simp [tame,tamePair,tameClass]
  ring

theorem vectorGraph_partial {V:Type*} [AddCommGroup V] [Module (ZMod 4) V]
    {n m:ℕ} (edges:Fin m→GraphEdge n) (actual base constants:Fin n→V)
    (B:V→ₗ[ZMod 4]V→ₗ[ZMod 4]ZMod 4) (hsk:∀a b,B a b= -B b a)
    (unknown:Fin n→Bool) (hknown:∀i,unknown i=false→actual i=base i)
    (hstar:∀i,unknown i=true→graphStar edges base constants i=0)
    (hcross:∀e,unknown (edges e).src=false∨unknown (edges e).dst=false) :
    vectorGraph edges actual constants B=vectorGraph edges base constants B := by
  have he:actual=fun i=>base i+(actual i-base i) := by funext i; abel
  rw [he,vectorGraph_add edges base constants _ B hsk]
  have hl (i:Fin n) : B (actual i-base i) (graphStar edges base constants i)=0 := by
    cases hu:unknown i
    · rw [hknown i hu,sub_self]; simp
    · rw [hstar i hu]; exact map_zero _
  have hc (e:Fin m) : B (actual (edges e).src-base (edges e).src)
      (actual (edges e).dst-base (edges e).dst)=0 := by
    rcases hcross e with h | h
    · rw [hknown _ h,sub_self]; simp
    · rw [hknown _ h,sub_self]; exact map_zero _
  simp only [hl,hc,mul_zero,Finset.sum_const_zero,add_zero]

theorem computeWildClass_valuation {k:ℕ} {a:G} {v:ClassVector}
    (h:computeWildClass k a=some v) : a≠0 ∧ multiplicity uniformizer a=(splitUniformizer k a).1 := by
  unfold computeWildClass at h
  dsimp only at h
  split at h
  · contradiction
  · rename_i hn
    have hu:¬uniformizer∣(splitUniformizer k a).2 := fun hd=>hn ((uniformizerDivides_iff _).mpr hd)
    have he:=splitUniformizer_spec k a
    constructor
    · rw [he]
      exact mul_ne_zero (pow_ne_zero _ uniformizer_prime.ne_zero) (nonzero_of_not_uniformizer_dvd hu)
    · exact (primeUnit_factorization uniformizer _ he hu).1

def wildFixedCheck (a:G) (k:ℕ) (v:ClassVector) : Prop :=
  computeWildClass 32 a=some v ∧ (splitUniformizer 32 a).1+7≤2*k

instance (a:G) (k:ℕ) (v:ClassVector) : Decidable (wildFixedCheck a k v) :=
  inferInstanceAs (Decidable (_∧_))

theorem wildFixedCheck_sound (b:G) (k:ℕ) (v:ClassVector) (h:wildFixedCheck b k v)
    {a:G} (hd:(2:G)^k∣a-b) : wildClass a=v := by
  obtain ⟨hb,hval⟩ := computeWildClass_valuation h.1
  rw [wildClass_stable hb k (by rw [hval]; exact h.2) hd]
  exact computeWildClass_sound h.1

theorem wild_cell {n m:ℕ} (edges:Fin m→GraphEdge n)
    (values:ℤ→ℤ→Fin n→G) (constants:Fin n→G)
    (hcongr:∀(M:ℕ) x y a b,(M:ℤ)∣x-a→(M:ℤ)∣y-b→∀i,(M:G)∣values x y i-values a b i)
    (a b:ℤ) (k:ℕ) (base cs:Fin n→ClassVector) (unknown:Fin n→Bool) (target:ZMod 4)
    (hC:∀i,computeWildClass 32 (constants i)=some (cs i))
    (hcheck:∀i,unknown i=false→wildFixedCheck (values a b i) k (base i))
    (hstar:∀i,unknown i=true→graphStar edges base cs i=0)
    (hcross:∀e,unknown (edges e).src=false∨unknown (edges e).dst=false)
    (hval:vectorGraph edges base cs dyadicBilinear=target)
    {x y:ℤ} (hx:(2:ℤ)^k∣x-a) (hy:(2:ℤ)^k∣y-b) :
    graphSum edges (values x y) constants wild=target := by
  have he:graphSum edges (values x y) constants wild=
      vectorGraph edges (fun i=>wildClass (values x y i)) cs dyadicBilinear := by
    simp only [graphSum,wild,vectorGraph,← computeWildClass_sound (hC _)]
    rfl
  rw [he,vectorGraph_partial edges _ base cs dyadicBilinear dyadicPair_skew unknown ?_ hstar hcross,hval]
  intro i hi
  apply wildFixedCheck_sound _ _ _ (hcheck i hi)
  simpa only [Nat.cast_pow,Nat.cast_ofNat] using
    hcongr (2^k) x y a b (by simpa using hx) (by simpa using hy) i

def TameCertificate.vector (c:TameCertificate) : Fin 2→ZMod 4 := ![c.exponent,c.quartic.val]

theorem TameCertificate.nonzero (c:TameCertificate) (π:G) [hp:Fact (Prime π)] {a:G}
    (hc:c.check π a) : a≠0 := by
  intro ha
  have hu:c.unit≠0 := by
    intro h
    have he:=hc.2.1
    rw [h,zero_mul,zero_add] at he
    exact hp.out.not_dvd_one ⟨c.invQuot,he.symm⟩
  exact mul_ne_zero (pow_ne_zero _ hp.out.ne_zero) hu (hc.1.symm.trans ha)

theorem TameCertificate.valuation (c:TameCertificate) (π:G) [hp:Fact (Prime π)] {a:G}
    (hc:c.check π a) : multiplicity π a=c.exponent := by
  apply (primeUnit_factorization π _ hc.1 ?_).1
  intro hd
  have he:π∣1 := by
    rw [← hc.2.1]
    exact dvd_add (dvd_mul_of_dvd_left hd _) (dvd_mul_right _ _)
  exact hp.out.not_dvd_one he

theorem tame_cell {n m:ℕ} (edges:Fin m→GraphEdge n)
    (values:ℤ→ℤ→Fin n→G) (constants:Fin n→G)
    (hcongr:∀(M:ℕ) x y a b,(M:ℤ)∣x-a→(M:ℤ)∣y-b→∀i,(M:G)∣values x y i-values a b i)
    (π:G) [Fact (Prime π)] (h2:¬π∣2) (p:ℕ) (hp:π∣(p:G))
    (epsilon:ZMod 4) (he:quarticLog π h2 (-1)=epsilon)
    (a b:ℤ) (k:ℕ) (cc ds:Fin n→TameCertificate) (base:Fin n→Fin 2→ZMod 4)
    (unknown:Fin n→Bool) (target:ZMod 4)
    (hC:∀i,(cc i).check π (constants i))
    (hcheck:∀i,unknown i=false→(ds i).check π (values a b i) ∧
      (ds i).exponent<k ∧ (ds i).vector=base i)
    (hstar:∀i,unknown i=true→graphStar edges base (fun i=>(cc i).vector) i=0)
    (hcross:∀e,unknown (edges e).src=false∨unknown (edges e).dst=false)
    (hval:vectorGraph edges base (fun i=>(cc i).vector) (tameBilinear epsilon)=target)
    {x y:ℤ} (hx:(p:ℤ)^k∣x-a) (hy:(p:ℤ)^k∣y-b) :
    graphSum edges (values x y) constants (tame π h2)=target := by
  have heq:graphSum edges (values x y) constants (tame π h2)=
      vectorGraph edges (fun i=>tameClass π h2 (values x y i)) (fun i=>(cc i).vector)
        (tameBilinear epsilon) := by
    simp only [graphSum,vectorGraph,tame_as_pair,he,TameCertificate.sound _ _ h2 (hC _)]
    rfl
  rw [heq,vectorGraph_partial edges _ base _ (tameBilinear epsilon)
    (tamePair_skew epsilon (he ▸ quarticLog_neg_one_twice π h2)) unknown ?_ hstar hcross,hval]
  intro i hi
  obtain ⟨hc,hbound,hbase⟩ := hcheck i hi
  have hd:(p:G)^k∣values x y i-values a b i := by
    simpa only [Nat.cast_pow] using hcongr (p^k) x y a b (by simpa using hx) (by simpa using hy) i
  have hd':π^(multiplicity π (values a b i)+1)∣values x y i-values a b i := by
    rw [TameCertificate.valuation _ _ hc]
    exact (pow_dvd_pow _ (by omega)).trans ((pow_dvd_pow_of_dvd hp k).trans hd)
  rw [tameClass_congr π h2 (TameCertificate.nonzero _ _ hc) hd',TameCertificate.sound _ _ h2 hc]
  exact hbase

end GraphCert.Quartic

                                            
namespace GraphCert.Quartic

namespace CompactResidueCover

def children (F : ℤ → ℤ → ℤ) (p : ℕ) (m a b : ℤ) : List (ℤ × ℤ) :=
  ((List.finRange p).flatMap fun i => (List.finRange p).map fun j =>
    (a+m*(i.val : ℤ), b+m*(j.val : ℤ))).filter fun q => decide (m*(p : ℤ)∣F q.1 q.2)

theorem lift_integer (p : ℕ) (hp : 0<p) (m a x : ℤ) (hx : m∣x-a) :
    ∃ i : Fin p, m*(p : ℤ)∣x-(a+m*(i.val : ℤ)) := by
  obtain ⟨t,ht⟩ := hx
  have ht0 : 0≤t%(p : ℤ) := Int.emod_nonneg _ (by exact_mod_cast hp.ne')
  have ht1 : t%(p : ℤ)<p := Int.emod_lt_of_pos _ (by exact_mod_cast hp)
  let i : Fin p := ⟨(t%(p : ℤ)).toNat,by omega⟩
  have hi : (i.val : ℤ)=t%(p : ℤ) := by simp [i,Int.toNat_of_nonneg ht0]
  refine ⟨i,t/(p : ℤ),?_⟩
  rw [hi]
  linear_combination ht-m*(Int.emod_add_mul_ediv t (p : ℤ))

theorem cover (F : ℤ → ℤ → ℤ)
    (congr : ∀ {m x u a b : ℤ}, m∣x-a → m∣u-b → m∣F x u-F a b)
    (P : ℤ → ℤ → Prop) (p : ℕ) (hp : 0<p) (m a b : ℤ) (cs : List (ℤ × ℤ))
    (hc : children F p m a b=cs)
    (step : ∀ q∈cs, ∀ x u : ℤ, F x u=0 → m*(p : ℤ)∣x-q.1 → m*(p : ℤ)∣u-q.2 → P x u)
    {x u : ℤ} (hf : F x u=0) (hx : m∣x-a) (hu : m∣u-b) : P x u := by
  obtain ⟨i,hi⟩ := lift_integer p hp m a x hx
  obtain ⟨j,hj⟩ := lift_integer p hp m b u hu
  have hd : m*(p : ℤ)∣F (a+m*(i.val : ℤ)) (b+m*(j.val : ℤ)) := by
    simpa only [hf,zero_sub,dvd_neg] using congr hi hj
  apply step (a+m*(i.val : ℤ),b+m*(j.val : ℤ)) ?_ x u hf hi hj
  rw [←hc,children,List.mem_filter]
  refine ⟨?_,?_⟩
  · exact List.mem_flatMap.mpr ⟨i,List.mem_finRange i,
      List.mem_map.mpr ⟨j,List.mem_finRange j,rfl⟩⟩
  · exact decide_eq_true hd

end CompactResidueCover

end GraphCert.Quartic

