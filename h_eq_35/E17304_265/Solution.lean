theorem relation_8 (x y : ℤ) :
    (8 : G)^4*rowProduct (neighbors 8) (values x y) (constants 8) -
      GraphCert.Quartic.Polynomial.value factor_8 x y * GraphCert.Quartic.Polynomial.value root_8 x y^4 =
      GraphCert.Quartic.Polynomial.value F x y*GraphCert.Quartic.Polynomial.value relationA_8 x y + values x y 8*GraphCert.Quartic.Polynomial.value relationB_8 x y :=
  identity_product (neighbors 8) nodes (constants 8) F relationA_8 relationB_8
    factor_8 root_8 8 8 (by decide +kernel) x y

