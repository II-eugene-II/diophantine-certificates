  have h : ∀ k : Fin 4, tameForm ((envelopes2 15).directions k)
      (graphStar edges (fun i => (envelopes2 i).base) (fun i => (constantCertificates i).vector) 15)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
