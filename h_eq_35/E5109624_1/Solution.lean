without_editor_info theorem checks36 : ∀ i : Fin 34, jointEnvelopeFastCheck (envelopes36 i) pi rho 7 1353 15453 2 (values 10 10 i) (certificatesC36 i) (certificatesD36 i) := by decide +kernel

without_editor_info theorem linear36 : ∀ i : Fin 34, ∀ j : Fin 4,
    tameForm ((envelopes36 i).directions j)
      (graphStar edges (fun i => (envelopes36 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 34, ∀ j : Fin 4, (envelopes36 i).directions j = 0 ∨
      tameForm ((envelopes36 i).directions j)
        (graphStar edges (fun i => (envelopes36 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross36 : ∀ e : Fin 133, ∀ j k : Fin 4,
    tameForm ((envelopes36 (edges e).src).directions j) ((envelopes36 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 133) edgeList (by decide)
    (fun e => (envelopes36 e.src).directions = 0 ∨
      (envelopes36 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes36 e.src).directions j) ((envelopes36 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes36 (edges e).src).directions = 0 ∨
    (envelopes36 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes36 (edges e).src).directions j) ((envelopes36 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

