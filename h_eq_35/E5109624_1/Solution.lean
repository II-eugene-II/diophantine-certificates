without_editor_info theorem linear5 : ∀ i : Fin 34, ∀ j : Fin 4,
    tameForm ((envelopes5 i).directions j)
      (graphStar edges (fun i => (envelopes5 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 34, ∀ j : Fin 4, (envelopes5 i).directions j = 0 ∨
      tameForm ((envelopes5 i).directions j)
        (graphStar edges (fun i => (envelopes5 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross5 : ∀ e : Fin 133, ∀ j k : Fin 4,
    tameForm ((envelopes5 (edges e).src).directions j) ((envelopes5 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 133) edgeList (by decide)
    (fun e => (envelopes5 e.src).directions = 0 ∨
      (envelopes5 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes5 e.src).directions j) ((envelopes5 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes5 (edges e).src).directions = 0 ∨
    (envelopes5 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes5 (edges e).src).directions j) ((envelopes5 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

