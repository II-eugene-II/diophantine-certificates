without_editor_info theorem checks10 : ∀ i : Fin 34, inertEnvelopeCheck (envelopes10 i) 2 (residueE (2^3) (values 0 5 i)) 3 (real i) (certificates10 i) := by decide +kernel

without_editor_info theorem fixedDirections10 : ∀ i : Fin 34,
    i=4 ∨ (envelopes10 i).directions=0 := by decide +kernel

without_editor_info theorem linear10 : ∀ i : Fin 34, ∀ j : Fin 4,
    tameForm ((envelopes10 i).directions j)
      (graphStar edges (fun i => (envelopes10 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes10 4).directions k)
      (graphStar edges (fun i => (envelopes10 i).base) (fun i => (constantCertificates i).vector) 4)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections10 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross10 : ∀ e : Fin 133, ∀ j k : Fin 4,
    tameForm ((envelopes10 (edges e).src).directions j) ((envelopes10 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections10 (edges e).src with hs | hz
  · rcases fixedDirections10 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value10 : vectorGraph edges (fun i => (envelopes10 i).base) (fun i => (constantCertificates i).vector) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

