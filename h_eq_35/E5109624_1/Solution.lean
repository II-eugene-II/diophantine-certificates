  have h : ∀ i : Fin 37, ∀ j : Fin 4, (envelopes9 i).directions j = 0 ∨
      tameForm ((envelopes9 i).directions j)
        (graphStar edges (fun i => (envelopes9 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

