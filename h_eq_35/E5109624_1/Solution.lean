    (hx : (5 : ℤ)^1 ∣ x-2) (hy : (5 : ℤ)^1 ∣ y-4) : graphSum edges (values x y) constants (tame (5 : Eisenstein) away_three) = 0 :=
  inert_cell edges values constants real values_congr values_real 5 away_three (by decide) 2 4 1 envelopes1 constantCertificates certificates1 0 constants_checked checks1 linear1 cross1 value1 (all_nonzero hf) hx hy

