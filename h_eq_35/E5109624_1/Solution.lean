    tameForm ((envelopes51 i).directions j)
      (graphStar edges (fun i => (envelopes51 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes51 36).directions k)
      (graphStar edges (fun i => (envelopes51 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 36)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections51 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross51 : ∀ e : Fin 155, ∀ j k : Fin 4,
    tameForm ((envelopes51 (edges e).src).directions j) ((envelopes51 (edges e).dst).directions k) = 0 := by
