without_editor_info theorem cell10 {x y : ℤ} (hf : equation x y = 0)
    (hx : (2 : ℤ)^2 ∣ x-0) (hy : (2 : ℤ)^2 ∣ y-1) : graphSum edges (values x y) constants (tame (2 : Eisenstein) away_three) = 0 :=
  inert_cell edges values constants real values_congr values_real 2 away_three (by decide) 0 1 2 envelopes10 constantCertificates certificates10 0 constants_checked checks10 linear10 cross10 value10 (all_nonzero hf) hx hy

