    tameForm ((envelopes42 (edges e).src).directions j) ((envelopes42 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 133) edgeList (by decide)
    (fun e => (envelopes42 e.src).directions = 0 ∨
      (envelopes42 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes42 e.src).directions j) ((envelopes42 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes42 (edges e).src).directions = 0 ∨
    (envelopes42 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes42 (edges e).src).directions j) ((envelopes42 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

