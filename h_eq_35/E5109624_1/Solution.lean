    (fun e => (envelopes9 e.src).directions = 0 ∨
      (envelopes9 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes9 e.src).directions j) ((envelopes9 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes9 (edges e).src).directions = 0 ∨
    (envelopes9 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes9 (edges e).src).directions j) ((envelopes9 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
