without_editor_info theorem checks8 : ∀ i : Fin 37, inertEnvelopeCheck (envelopes8 i) 2 (residueE (2^2) (values 1 2 i)) 2 (real i) (certificates8 i) := by decide +kernel

without_editor_info theorem linear8 : ∀ i : Fin 37, ∀ j : Fin 4,
    tameForm ((envelopes8 i).directions j)
      (graphStar edges (fun i => (envelopes8 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
  have h : ∀ i : Fin 37, ∀ j : Fin 4, (envelopes8 i).directions j = 0 ∨
      tameForm ((envelopes8 i).directions j)
        (graphStar edges (fun i => (envelopes8 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross8 : ∀ e : Fin 155, ∀ j k : Fin 4,
    tameForm ((envelopes8 (edges e).src).directions j) ((envelopes8 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 155) edgeList (by decide)
    (fun e => (envelopes8 e.src).directions = 0 ∨
      (envelopes8 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes8 e.src).directions j) ((envelopes8 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes8 (edges e).src).directions = 0 ∨
    (envelopes8 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes8 (edges e).src).directions j) ((envelopes8 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

