    tameForm ((envelopes8 i).directions j)
      (graphStar edges (fun i => (envelopes8 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
  have h : ∀ i : Fin 34, ∀ j : Fin 4, (envelopes8 i).directions j = 0 ∨
      tameForm ((envelopes8 i).directions j)
        (graphStar edges (fun i => (envelopes8 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

