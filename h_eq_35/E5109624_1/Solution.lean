  have h : ∀ k : Fin 4, tameForm ((envelopes81 27).directions k)
      (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 27)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections81 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross81 : ∀ e : Fin 155, ∀ j k : Fin 4,
    tameForm ((envelopes81 (edges e).src).directions j) ((envelopes81 (edges e).dst).directions k) = 0 := by
