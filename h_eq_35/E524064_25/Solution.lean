without_editor_info theorem checks5 : ∀ i : Fin 44, inertEnvelopeCheck (envelopes5 i) 2 (residueE (2^3) (values 0 5 i)) 3 (real i) (certificates5 i) := by decide +kernel

without_editor_info theorem fixedDirections5 : ∀ i : Fin 44,
    i=33 ∨ (envelopes5 i).directions=0 := by decide +kernel

without_editor_info theorem linear5 : ∀ i : Fin 44, ∀ j : Fin 4,
    tameForm ((envelopes5 i).directions j)
      (graphStar edges (fun i => (envelopes5 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes5 33).directions k)
      (graphStar edges (fun i => (envelopes5 i).base) (fun i => (constantCertificates i).vector) 33)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections5 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross5 : ∀ e : Fin 187, ∀ j k : Fin 4,
    tameForm ((envelopes5 (edges e).src).directions j) ((envelopes5 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections5 (edges e).src with hs | hz
  · rcases fixedDirections5 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value5 : vectorGraph edges (fun i => (envelopes5 i).base) (fun i => (constantCertificates i).vector) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
