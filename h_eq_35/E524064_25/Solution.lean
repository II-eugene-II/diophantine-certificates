without_editor_info theorem linear52 : ∀ i : Fin 44, ∀ j : Fin 4,
    wildForm ((envelopes52 i).directions j)
      (graphStar edges (fun i => (envelopes52 i).base) constantsClass i) = 0 := by
  have h : ∀ k : Fin 4, wildForm ((envelopes52 33).directions k)
      (graphStar edges (fun i => (envelopes52 i).base) constantsClass 33)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections52 i with rfl | hz
  · exact h k
  · rw [hz]; simp [wildForm]

