    (by rwa [Nat.add_sub_of_le hk.le])
  exact ⟨hn,hv⟩

theorem finite_lifts (p : ℕ) [Fact p.Prime] {a b : ℤ} (hb : b≠0) (k : ℕ)
    (hk : padicValInt p b<k) (hd : (p:ℤ)^k ∣ a-b) :
    ∃ i : Fin (p^precision p), localClass p a=localClass p (b+(p:ℤ)^k*i.val) := by
