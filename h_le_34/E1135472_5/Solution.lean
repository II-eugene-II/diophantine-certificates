without_editor_info theorem checks11 : ∀ i : Fin 47, jointEnvelopeFastCheck (envelopes11 i) pi rho 7 324 18 2 (values 11 4 i) (certificatesC11 i) (certificatesD11 i) := by decide +kernel

without_editor_info theorem fixedDirections11 : ∀ i : Fin 47,
    i=15 ∨ (envelopes11 i).directions=0 := by decide +kernel

without_editor_info theorem linear11 : ∀ i : Fin 47, ∀ j : Fin 4,
    tameForm ((envelopes11 i).directions j)
      (graphStar edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes11 15).directions k)
      (graphStar edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 15)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections11 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross11 : ∀ e : Fin 180, ∀ j k : Fin 4,
    tameForm ((envelopes11 (edges e).src).directions j) ((envelopes11 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections11 (edges e).src with hs | hz
  · rcases fixedDirections11 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value11 : vectorGraph edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
