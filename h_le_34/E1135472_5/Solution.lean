  have expand : value (oddH p) (arguments1 x y) = jacobiSym (star1_0 x y) p ^ padicValInt p (eval H2 x y) := by
    simp only [value,arguments1,List.map_cons,List.map_nil,List.prod_cons,List.prod_nil,mul_one]
