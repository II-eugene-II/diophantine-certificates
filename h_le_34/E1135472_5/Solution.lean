without_editor_info theorem linear144 : ∀ i : Fin 47, ∀ j : Fin 4,
    tameForm ((envelopes144 i).directions j)
      (graphStar edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes144 25).directions k)
      (graphStar edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 25)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections144 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross144 : ∀ e : Fin 180, ∀ j k : Fin 4,
    tameForm ((envelopes144 (edges e).src).directions j) ((envelopes144 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections144 (edges e).src with hs | hz
  · rcases fixedDirections144 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value144 : vectorGraph edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell144 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-27) (hy : (13 : ℤ)^2 ∣ y-70) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 27 70 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes144 constantC constantD certificatesC144 certificatesD144 0
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks144 i))
    linear144 cross144 value144 hx hy

