    simp [twoParts,qr,hu,hv,h0,h1] <;> ring

theorem odd_parts (p e f : ℕ) [Fact p.Prime] (hp2 : p≠2) (u v : ℤ)
    (hu : ¬(p:ℤ)∣u) (hv : ¬(p:ℤ)∣v) :
    oddParts p e f u v = sign (form p
      ![(e : ZMod 2),bit (jacobiSym u p),0]
      ![(f : ZMod 2),bit (jacobiSym v p),0]) := by
