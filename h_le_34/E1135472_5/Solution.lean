  have h : ∀ k : Fin 4, tameForm ((envelopes5 5).directions k)
      (graphStar edges (fun i => (envelopes5 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 5)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
