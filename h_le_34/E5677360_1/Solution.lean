private instance : Fact (Nat.Prime 3):=⟨by decide⟩
def exponent3 (c:Fin 4):ℕ:=c.val/2
def unit3 (c:Fin 4):ℕ:=c.val%2+1
def sign3 (c:Fin 4):ℤ:=if c.val%2=0 then 1 else -1
