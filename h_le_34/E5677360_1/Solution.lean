without_editor_info theorem checks128 : ∀ i : Fin 37, jointEnvelopeFastCheck (envelopes128 i) pi rho 7 1353 1047 3 (values 309 60 i) (certificatesC128 i) (certificatesD128 i) := by decide +kernel

without_editor_info theorem fixedDirections128 : ∀ i : Fin 37,
    i=29 ∨ (envelopes128 i).directions=0 := by decide +kernel

without_editor_info theorem linear128 : ∀ i : Fin 37, ∀ j : Fin 4,
    tameForm ((envelopes128 i).directions j)
      (graphStar edges (fun i => (envelopes128 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes128 29).directions k)
      (graphStar edges (fun i => (envelopes128 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 29)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections128 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross128 : ∀ e : Fin 123, ∀ j k : Fin 4,
    tameForm ((envelopes128 (edges e).src).directions j) ((envelopes128 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections128 (edges e).src with hs | hz
  · rcases fixedDirections128 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

