without_editor_info theorem linear15 : ∀ i : Fin 37, ∀ j : Fin 4,
    tameForm ((envelopes15 i).directions j)
      (graphStar edges (fun i => (envelopes15 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes15 30).directions k)
      (graphStar edges (fun i => (envelopes15 i).base) (fun i => (constantCertificates i).vector) 30)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections15 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross15 : ∀ e : Fin 123, ∀ j k : Fin 4,
    tameForm ((envelopes15 (edges e).src).directions j) ((envelopes15 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections15 (edges e).src with hs | hz
  · rcases fixedDirections15 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

