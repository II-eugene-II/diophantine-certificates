    cases b with
    | nil => simp [add, eval]
    | cons b bs => simp only [add, eval, Dense.eval_add, ih]; ring

without_editor_info theorem eval_scale {R : Type*} [CommRing R] (f : ℤ →+* R)
    (a : Dense.Poly) (b : Poly) (x y : R) :
