  have h : ∀ k : Fin 4, tameForm ((envelopes4 0).directions k)
      (graphStar edges (fun i => (envelopes4 i).base) (fun i => (constantCertificates i).vector) 0)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
