  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross4 : ∀ e : Fin 123, ∀ j k : Fin 4,
    tameForm ((envelopes4 (edges e).src).directions j) ((envelopes4 (edges e).dst).directions k) = 0 := by
