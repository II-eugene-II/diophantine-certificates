  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 309 60 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes128 constantC constantD certificatesC128 certificatesD128 0
