        · have hz : (1 * x^6 + 1 * x^5 + 1 * x^3 + 4) = 1 * (((-1) * x + (-2)))^6 + 11 * (((-1) * x + (-2)))^5 + 50 * (((-1) * x + (-2)))^4 + 119 * (((-1) * x + (-2)))^3 + 154 * (((-1) * x + (-2)))^2 + 100 * (((-1) * x + (-2)))^1 + 28 * (((-1) * x + (-2)))^0 := by ring
          rw [hz]; positivity
