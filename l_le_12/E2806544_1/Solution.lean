          rw [hz]; positivity
        · have hz : (3 * x^4 + 4 * x) = 3 * ((1 * x + (-1)))^4 + 12 * ((1 * x + (-1)))^3 + 18 * ((1 * x + (-1)))^2 + 16 * ((1 * x + (-1)))^1 + 7 * ((1 * x + (-1)))^0 := by ring
