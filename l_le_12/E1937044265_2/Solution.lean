  intro i hi
  obtain ⟨hc,hbound,hbase⟩ := hcheck i hi
  have hd:(p:G)^k∣values x y i-values a b i := by
    simpa only [Nat.cast_pow] using hcongr (p^k) x y a b (by simpa using hx) (by simpa using hy) i
