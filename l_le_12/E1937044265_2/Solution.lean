  obtain ⟨hb,hval⟩ := computeWildClass_valuation h.1
  rw [wildClass_stable hb k (by rw [hval]; exact h.2) hd]
  exact computeWildClass_sound h.1

theorem wild_cell {n m:ℕ} (edges:Fin m→GraphEdge n)
    (values:ℤ→ℤ→Fin n→G) (constants:Fin n→G)
    (hcongr:∀(M:ℕ) x y a b,(M:ℤ)∣x-a→(M:ℤ)∣y-b→∀i,(M:G)∣values x y i-values a b i)
    (a b:ℤ) (k:ℕ) (base cs:Fin n→ClassVector) (unknown:Fin n→Bool) (target:ZMod 4)
