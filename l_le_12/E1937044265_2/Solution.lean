    a.val%3=2 → b.val%3=0 → unitLog9 ⟨a,b⟩ 0=0 := by
  decide +kernel

without_editor_info theorem unitLog9_norm_table : ∀ a b : ZMod 9, Unit9 ⟨a,b⟩ →
    unitLog9 ⟨a,b⟩ 1+2*unitLog9 ⟨a,b⟩ 2 =
      ((((QuadraticAlgebra.norm (⟨a,b⟩ : ModE 9)).val-1)/3 : ℕ) : ZMod 3) := by
