without_editor_info theorem unitLog9_omega : unitLog9 (QuadraticAlgebra.omega : ModE 9)=![1,0,0] := by decide +kernel
without_editor_info theorem unitLog9_neg_one : unitLog9 (-1)=0 := by decide +kernel

