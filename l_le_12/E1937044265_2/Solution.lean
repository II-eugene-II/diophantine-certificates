    (H C : Fin n → WildVector) (i : Fin n) :
    graphStar edges H C i = fun k => C i k + rowLog (neighbors i) (fun j => H j k) := by
  rw [graphStar_coordinates]
  funext k
  rw [hn i, neighborList_log]

