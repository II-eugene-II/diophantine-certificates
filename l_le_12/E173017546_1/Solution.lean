without_editor_info theorem checks234 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes234 i) pi rho 7 1353 1047 3 (values 1 290 i) (certificatesC234 i) (certificatesD234 i) := by decide +kernel

without_editor_info theorem fixedDirections234 : ∀ i : Fin 59,
    i=7 ∨ (envelopes234 i).directions=0 := by decide +kernel

without_editor_info theorem linear234 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes234 i).directions j)
      (graphStar edges (fun i => (envelopes234 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes234 7).directions k)
      (graphStar edges (fun i => (envelopes234 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections234 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross234 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes234 (edges e).src).directions j) ((envelopes234 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections234 (edges e).src with hs | hz
  · rcases fixedDirections234 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value234 : vectorGraph edges (fun i => (envelopes234 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell234 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-1) (hy : (7 : ℤ)^3 ∣ y-290) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1 290 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes234 constantC constantD certificatesC234 certificatesD234 1
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks234 i))
    linear234 cross234 value234 hx hy

