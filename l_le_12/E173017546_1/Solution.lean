    tameForm ((envelopes21 i).directions j)
      (graphStar edges (fun i => (envelopes21 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections21 i k]
  simp [tameForm]

