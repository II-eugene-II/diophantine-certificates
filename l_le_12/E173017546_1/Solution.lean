  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 275 3 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes128 constantC constantD certificatesC128 certificatesD128 0
