    i=11 ∨ (envelopes114 i).directions=0 := by decide +kernel

without_editor_info theorem linear114 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes114 i).directions j)
      (graphStar edges (fun i => (envelopes114 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes114 11).directions k)
      (graphStar edges (fun i => (envelopes114 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 11)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections114 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross114 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes114 (edges e).src).directions j) ((envelopes114 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections114 (edges e).src with hs | hz
  · rcases fixedDirections114 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

