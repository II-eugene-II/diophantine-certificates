  · rw [hz]; simp [tameForm]

without_editor_info theorem cross137 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes137 (edges e).src).directions j) ((envelopes137 (edges e).dst).directions k) = 0 := by
