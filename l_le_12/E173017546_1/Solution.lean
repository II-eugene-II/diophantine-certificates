    (hx : (7 : ℤ)^3 ∣ x-11) (hy : (7 : ℤ)^3 ∣ y-39) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
