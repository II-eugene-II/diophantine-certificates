      (∀ j k : Fin 4, tameForm ((envelopes157 e.src).directions j) ((envelopes157 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes157 (edges e).src).directions = 0 ∨
    (envelopes157 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes157 (edges e).src).directions j) ((envelopes157 (edges e).dst).directions k) = 0) at h
