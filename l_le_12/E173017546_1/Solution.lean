    tameForm ((envelopes157 i).directions j)
      (graphStar edges (fun i => (envelopes157 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes157 i).directions j = 0 ∨
      tameForm ((envelopes157 i).directions j)
        (graphStar edges (fun i => (envelopes157 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
