    (envelopes198 i).directions j=0 := by decide +kernel

without_editor_info theorem linear198 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes198 i).directions j)
      (graphStar edges (fun i => (envelopes198 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections198 i k]
  simp [tameForm]

without_editor_info theorem cross198 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes198 (edges e).src).directions j) ((envelopes198 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections198 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value198 : vectorGraph edges (fun i => (envelopes198 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

