without_editor_info theorem checks56 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes56 i) pi rho 19 292 68 2 (values 91 183 i) (certificatesC56 i) (certificatesD56 i) := by decide +kernel

without_editor_info theorem fixedDirections56 : ∀ i : Fin 59,
    i=40 ∨ (envelopes56 i).directions=0 := by decide +kernel

without_editor_info theorem linear56 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes56 i).directions j)
      (graphStar edges (fun i => (envelopes56 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes56 40).directions k)
      (graphStar edges (fun i => (envelopes56 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 40)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections56 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross56 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes56 (edges e).src).directions j) ((envelopes56 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections56 (edges e).src with hs | hz
  · rcases fixedDirections56 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value56 : vectorGraph edges (fun i => (envelopes56 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

