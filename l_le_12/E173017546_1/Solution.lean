without_editor_info theorem checks38 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes38 i) pi rho 13 1160 1036 2 (values 10 21 i) (certificatesC38 i) (certificatesD38 i) := by decide +kernel

without_editor_info theorem fixedDirections38 : ∀ i : Fin 59,
    i=40 ∨ (envelopes38 i).directions=0 := by decide +kernel

without_editor_info theorem linear38 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes38 i).directions j)
      (graphStar edges (fun i => (envelopes38 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes38 40).directions k)
      (graphStar edges (fun i => (envelopes38 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 40)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections38 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross38 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes38 (edges e).src).directions j) ((envelopes38 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections38 (edges e).src with hs | hz
  · rcases fixedDirections38 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value38 : vectorGraph edges (fun i => (envelopes38 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell38 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-10) (hy : (13 : ℤ)^2 ∣ y-21) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 10 21 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes38 constantC constantD certificatesC38 certificatesD38 0
