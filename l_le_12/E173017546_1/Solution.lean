without_editor_info theorem linear81 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes81 i).directions j)
      (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes81 i).directions j = 0 ∨
      tameForm ((envelopes81 i).directions j)
        (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

