    (envelopes33 i).directions j=0 := by decide +kernel

without_editor_info theorem linear33 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes33 i).directions j)
      (graphStar edges (fun i => (envelopes33 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections33 i k]
  simp [tameForm]

without_editor_info theorem cross33 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes33 (edges e).src).directions j) ((envelopes33 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections33 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value33 : vectorGraph edges (fun i => (envelopes33 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
