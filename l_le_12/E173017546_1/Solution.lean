without_editor_info theorem checks45 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes45 i) pi rho 19 292 68 2 (values 300 50 i) (certificatesC45 i) (certificatesD45 i) := by decide +kernel

without_editor_info theorem zeroDirections45 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes45 i).directions j=0 := by decide +kernel

without_editor_info theorem linear45 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes45 i).directions j)
      (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections45 i k]
  simp [tameForm]

without_editor_info theorem cross45 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes45 (edges e).src).directions j) ((envelopes45 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections45 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value45 : vectorGraph edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell45 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-300) (hy : (19 : ℤ)^2 ∣ y-50) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 300 50 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes45 constantC constantD certificatesC45 certificatesD45 0
