  decide +kernel

without_editor_info theorem cell65 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^1 ∣ x-9) (hy : (13 : ℤ)^1 ∣ y-9) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 9 9 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤3)).trans root_rho)
    envelopes65 constantC constantD certificatesC65 certificatesD65 0
