without_editor_info theorem linear19 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes19 i).directions j)
      (graphStar edges (fun i => (envelopes19 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections19 i k]
  simp [tameForm]

without_editor_info theorem cross19 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes19 (edges e).src).directions j) ((envelopes19 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections19 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value19 : vectorGraph edges (fun i => (envelopes19 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
