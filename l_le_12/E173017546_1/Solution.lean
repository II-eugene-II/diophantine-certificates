without_editor_info theorem checks41 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes41 i) pi rho 19 292 68 2 (values 16 288 i) (certificatesC41 i) (certificatesD41 i) := by decide +kernel

without_editor_info theorem fixedDirections41 : ∀ i : Fin 59,
    i=25 ∨ (envelopes41 i).directions=0 := by decide +kernel

without_editor_info theorem linear41 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes41 i).directions j)
      (graphStar edges (fun i => (envelopes41 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes41 25).directions k)
      (graphStar edges (fun i => (envelopes41 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 25)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections41 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross41 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes41 (edges e).src).directions j) ((envelopes41 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections41 (edges e).src with hs | hz
  · rcases fixedDirections41 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value41 : vectorGraph edges (fun i => (envelopes41 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
