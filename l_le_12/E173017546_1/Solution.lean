without_editor_info theorem zeroDirections39 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes39 i).directions j=0 := by decide +kernel

without_editor_info theorem linear39 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes39 i).directions j)
      (graphStar edges (fun i => (envelopes39 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections39 i k]
  simp [tameForm]

without_editor_info theorem cross39 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes39 (edges e).src).directions j) ((envelopes39 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections39 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value39 : vectorGraph edges (fun i => (envelopes39 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

