without_editor_info theorem checks121 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes121 i) pi rho 19 292 68 2 (values 48 194 i) (certificatesC121 i) (certificatesD121 i) := by decide +kernel

without_editor_info theorem fixedDirections121 : ∀ i : Fin 59,
    i=42 ∨ (envelopes121 i).directions=0 := by decide +kernel

without_editor_info theorem linear121 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes121 i).directions j)
      (graphStar edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes121 42).directions k)
      (graphStar edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 42)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections121 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross121 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes121 (edges e).src).directions j) ((envelopes121 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections121 (edges e).src with hs | hz
  · rcases fixedDirections121 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value121 : vectorGraph edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
