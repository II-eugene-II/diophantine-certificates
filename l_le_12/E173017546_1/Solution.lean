    tameForm ((envelopes6 (edges e).src).directions j) ((envelopes6 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections6 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value6 : vectorGraph edges (fun i => (envelopes6 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
