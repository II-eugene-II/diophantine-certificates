without_editor_info theorem checks52 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes52 i) pi rho 13 1160 1036 2 (values 165 166 i) (certificatesC52 i) (certificatesD52 i) := by decide +kernel

without_editor_info theorem fixedDirections52 : ∀ i : Fin 59,
    i=26 ∨ (envelopes52 i).directions=0 := by decide +kernel

without_editor_info theorem linear52 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes52 i).directions j)
      (graphStar edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes52 26).directions k)
      (graphStar edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 26)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections52 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross52 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes52 (edges e).src).directions j) ((envelopes52 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections52 (edges e).src with hs | hz
  · rcases fixedDirections52 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value52 : vectorGraph edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell52 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-165) (hy : (13 : ℤ)^2 ∣ y-166) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 165 166 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes52 constantC constantD certificatesC52 certificatesD52 0
