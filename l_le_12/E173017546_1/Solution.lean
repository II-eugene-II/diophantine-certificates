without_editor_info theorem checks133 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes133 i) pi rho 19 292 68 2 (values 180 231 i) (certificatesC133 i) (certificatesD133 i) := by decide +kernel

without_editor_info theorem fixedDirections133 : ∀ i : Fin 59,
    i=10 ∨ (envelopes133 i).directions=0 := by decide +kernel

without_editor_info theorem linear133 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes133 i).directions j)
      (graphStar edges (fun i => (envelopes133 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes133 10).directions k)
      (graphStar edges (fun i => (envelopes133 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 10)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections133 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross133 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes133 (edges e).src).directions j) ((envelopes133 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections133 (edges e).src with hs | hz
  · rcases fixedDirections133 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value133 : vectorGraph edges (fun i => (envelopes133 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
