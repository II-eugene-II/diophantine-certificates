without_editor_info theorem zeroDirections90 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes90 i).directions j=0 := by decide +kernel

without_editor_info theorem linear90 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes90 i).directions j)
      (graphStar edges (fun i => (envelopes90 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections90 i k]
  simp [tameForm]

without_editor_info theorem cross90 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes90 (edges e).src).directions j) ((envelopes90 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections90 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value90 : vectorGraph edges (fun i => (envelopes90 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell90 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-258) (hy : (19 : ℤ)^2 ∣ y-135) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 258 135 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes90 constantC constantD certificatesC90 certificatesD90 0
