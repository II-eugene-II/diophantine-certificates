  decide +kernel

without_editor_info theorem cell61 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^1 ∣ x-15) (hy : (19 : ℤ)^1 ∣ y-6) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 15 6 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤2)).trans root_rho)
    envelopes61 constantC constantD certificatesC61 certificatesD61 0
