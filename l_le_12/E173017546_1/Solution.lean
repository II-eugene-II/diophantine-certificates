without_editor_info theorem checks16 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes16 i) pi rho 7 1353 1047 3 (values 271 272 i) (certificatesC16 i) (certificatesD16 i) := by decide +kernel

without_editor_info theorem fixedDirections16 : ∀ i : Fin 59,
    i=26 ∨ (envelopes16 i).directions=0 := by decide +kernel

without_editor_info theorem linear16 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes16 i).directions j)
      (graphStar edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes16 26).directions k)
      (graphStar edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 26)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections16 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross16 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes16 (edges e).src).directions j) ((envelopes16 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections16 (edges e).src with hs | hz
  · rcases fixedDirections16 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value16 : vectorGraph edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell16 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-271) (hy : (7 : ℤ)^3 ∣ y-272) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 271 272 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes16 constantC constantD certificatesC16 certificatesD16 1
