without_editor_info theorem checks65 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes65 i) pi rho 13 1160 1036 1 (values 9 9 i) (certificatesC65 i) (certificatesD65 i) := by decide +kernel

without_editor_info theorem linear65 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes65 i).directions j)
      (graphStar edges (fun i => (envelopes65 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes65 i).directions j = 0 ∨
      tameForm ((envelopes65 i).directions j)
        (graphStar edges (fun i => (envelopes65 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross65 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes65 (edges e).src).directions j) ((envelopes65 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes65 e.src).directions = 0 ∨
      (envelopes65 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes65 e.src).directions j) ((envelopes65 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes65 (edges e).src).directions = 0 ∨
    (envelopes65 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes65 (edges e).src).directions j) ((envelopes65 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value65 : vectorGraph edges (fun i => (envelopes65 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
