without_editor_info theorem zeroDirections54 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes54 i).directions j=0 := by decide +kernel

without_editor_info theorem linear54 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes54 i).directions j)
      (graphStar edges (fun i => (envelopes54 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections54 i k]
  simp [tameForm]

without_editor_info theorem cross54 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes54 (edges e).src).directions j) ((envelopes54 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections54 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value54 : vectorGraph edges (fun i => (envelopes54 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

