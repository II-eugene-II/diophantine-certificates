    (envelopes31 i).directions j=0 := by decide +kernel

without_editor_info theorem linear31 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes31 i).directions j)
      (graphStar edges (fun i => (envelopes31 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections31 i k]
  simp [tameForm]

without_editor_info theorem cross31 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes31 (edges e).src).directions j) ((envelopes31 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections31 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value31 : vectorGraph edges (fun i => (envelopes31 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
