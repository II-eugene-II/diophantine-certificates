without_editor_info theorem checks55 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes55 i) pi rho 13 1160 1036 2 (values 126 88 i) (certificatesC55 i) (certificatesD55 i) := by decide +kernel

without_editor_info theorem linear55 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes55 i).directions j)
      (graphStar edges (fun i => (envelopes55 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes55 i).directions j = 0 ∨
      tameForm ((envelopes55 i).directions j)
        (graphStar edges (fun i => (envelopes55 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross55 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes55 (edges e).src).directions j) ((envelopes55 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes55 e.src).directions = 0 ∨
      (envelopes55 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes55 e.src).directions j) ((envelopes55 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes55 (edges e).src).directions = 0 ∨
    (envelopes55 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes55 (edges e).src).directions j) ((envelopes55 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value55 : vectorGraph edges (fun i => (envelopes55 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell55 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-126) (hy : (13 : ℤ)^2 ∣ y-88) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 126 88 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes55 constantC constantD certificatesC55 certificatesD55 0
