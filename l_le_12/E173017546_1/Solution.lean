without_editor_info theorem checks74 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes74 i) pi rho 13 1160 1036 2 (values 61 136 i) (certificatesC74 i) (certificatesD74 i) := by decide +kernel

without_editor_info theorem fixedDirections74 : ∀ i : Fin 59,
    i=34 ∨ (envelopes74 i).directions=0 := by decide +kernel

without_editor_info theorem linear74 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes74 i).directions j)
      (graphStar edges (fun i => (envelopes74 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes74 34).directions k)
      (graphStar edges (fun i => (envelopes74 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 34)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections74 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross74 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes74 (edges e).src).directions j) ((envelopes74 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections74 (edges e).src with hs | hz
  · rcases fixedDirections74 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value74 : vectorGraph edges (fun i => (envelopes74 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell74 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-61) (hy : (13 : ℤ)^2 ∣ y-136) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 61 136 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes74 constantC constantD certificatesC74 certificatesD74 0
