without_editor_info theorem checks112 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes112 i) pi rho 19 292 68 2 (values 219 99 i) (certificatesC112 i) (certificatesD112 i) := by decide +kernel

without_editor_info theorem fixedDirections112 : ∀ i : Fin 59,
    i=16 ∨ (envelopes112 i).directions=0 := by decide +kernel

without_editor_info theorem linear112 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes112 i).directions j)
      (graphStar edges (fun i => (envelopes112 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes112 16).directions k)
      (graphStar edges (fun i => (envelopes112 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 16)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections112 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross112 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes112 (edges e).src).directions j) ((envelopes112 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections112 (edges e).src with hs | hz
  · rcases fixedDirections112 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value112 : vectorGraph edges (fun i => (envelopes112 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell112 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-219) (hy : (19 : ℤ)^2 ∣ y-99) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 219 99 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes112 constantC constantD certificatesC112 certificatesD112 0
