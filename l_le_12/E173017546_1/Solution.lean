  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross169 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes169 (edges e).src).directions j) ((envelopes169 (edges e).dst).directions k) = 0 := by
