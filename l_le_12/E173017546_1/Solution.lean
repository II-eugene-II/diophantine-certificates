without_editor_info theorem checks4 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes4 i) pi rho 19 292 68 2 (values 359 125 i) (certificatesC4 i) (certificatesD4 i) := by decide +kernel

without_editor_info theorem noLoops : ∀ e : Fin 352, (edges e).src ≠ (edges e).dst := by
  exact listEdges_all (m := 352) edgeList (by decide)
    (fun e => e.src ≠ e.dst) (by decide +kernel)

without_editor_info theorem fixedDirections4 : ∀ i : Fin 59,
    i=57 ∨ (envelopes4 i).directions=0 := by decide +kernel

without_editor_info theorem linear4 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes4 i).directions j)
      (graphStar edges (fun i => (envelopes4 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes4 57).directions k)
      (graphStar edges (fun i => (envelopes4 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 57)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections4 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross4 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes4 (edges e).src).directions j) ((envelopes4 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections4 (edges e).src with hs | hz
  · rcases fixedDirections4 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value4 : vectorGraph edges (fun i => (envelopes4 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell4 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-359) (hy : (19 : ℤ)^2 ∣ y-125) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 359 125 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes4 constantC constantD certificatesC4 certificatesD4 0
