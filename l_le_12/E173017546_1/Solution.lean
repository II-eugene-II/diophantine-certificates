without_editor_info theorem checks121 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes121 i) pi rho 7 1353 1047 3 (values 270 340 i) (certificatesC121 i) (certificatesD121 i) := by decide +kernel

without_editor_info theorem linear121 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes121 i).directions j)
      (graphStar edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes121 i).directions j = 0 ∨
      tameForm ((envelopes121 i).directions j)
        (graphStar edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross121 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes121 (edges e).src).directions j) ((envelopes121 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes121 e.src).directions = 0 ∨
      (envelopes121 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes121 e.src).directions j) ((envelopes121 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes121 (edges e).src).directions = 0 ∨
    (envelopes121 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes121 (edges e).src).directions j) ((envelopes121 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value121 : vectorGraph edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell121 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-270) (hy : (7 : ℤ)^3 ∣ y-340) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 270 340 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes121 constantC constantD certificatesC121 certificatesD121 1
