  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 48 194 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes121 constantC constantD certificatesC121 certificatesD121 0
