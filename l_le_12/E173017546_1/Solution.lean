    tameForm ((envelopes233 i).directions j)
      (graphStar edges (fun i => (envelopes233 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections233 i k]
  simp [tameForm]

without_editor_info theorem cross233 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes233 (edges e).src).directions j) ((envelopes233 (edges e).dst).directions k) = 0 := by
