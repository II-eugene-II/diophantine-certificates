without_editor_info theorem checks95 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes95 i) pi rho 13 1160 1036 2 (values 112 166 i) (certificatesC95 i) (certificatesD95 i) := by decide +kernel

without_editor_info theorem fixedDirections95 : ∀ i : Fin 59,
    i=48 ∨ (envelopes95 i).directions=0 := by decide +kernel

without_editor_info theorem linear95 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes95 i).directions j)
      (graphStar edges (fun i => (envelopes95 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes95 48).directions k)
      (graphStar edges (fun i => (envelopes95 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 48)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections95 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross95 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes95 (edges e).src).directions j) ((envelopes95 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections95 (edges e).src with hs | hz
  · rcases fixedDirections95 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value95 : vectorGraph edges (fun i => (envelopes95 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell95 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-112) (hy : (13 : ℤ)^2 ∣ y-166) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 112 166 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes95 constantC constantD certificatesC95 certificatesD95 0
