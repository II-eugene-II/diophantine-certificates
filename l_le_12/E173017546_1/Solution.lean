without_editor_info theorem checks203 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes203 i) pi rho 7 1353 1047 3 (values 296 198 i) (certificatesC203 i) (certificatesD203 i) := by decide +kernel

without_editor_info theorem fixedDirections203 : ∀ i : Fin 59,
    i=50 ∨ (envelopes203 i).directions=0 := by decide +kernel

without_editor_info theorem linear203 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes203 i).directions j)
      (graphStar edges (fun i => (envelopes203 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes203 50).directions k)
      (graphStar edges (fun i => (envelopes203 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 50)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections203 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross203 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes203 (edges e).src).directions j) ((envelopes203 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections203 (edges e).src with hs | hz
  · rcases fixedDirections203 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value203 : vectorGraph edges (fun i => (envelopes203 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

