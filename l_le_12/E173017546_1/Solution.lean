    (hx : (19 : ℤ)^2 ∣ x-187) (hy : (19 : ℤ)^2 ∣ y-22) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 187 22 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes32 constantC constantD certificatesC32 certificatesD32 0
