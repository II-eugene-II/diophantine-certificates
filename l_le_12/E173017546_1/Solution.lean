without_editor_info theorem checks11 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes11 i) pi rho 7 1353 1047 3 (values 180 111 i) (certificatesC11 i) (certificatesD11 i) := by decide +kernel

without_editor_info theorem zeroDirections11 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes11 i).directions j=0 := by decide +kernel

without_editor_info theorem linear11 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes11 i).directions j)
      (graphStar edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections11 i k]
  simp [tameForm]

without_editor_info theorem cross11 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes11 (edges e).src).directions j) ((envelopes11 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections11 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value11 : vectorGraph edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell11 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-180) (hy : (7 : ℤ)^3 ∣ y-111) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 180 111 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes11 constantC constantD certificatesC11 certificatesD11 1
