without_editor_info theorem checks85 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes85 i) pi rho 7 1353 1047 4 (values 1698 613 i) (certificatesC85 i) (certificatesD85 i) := by decide +kernel

without_editor_info theorem zeroDirections85 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes85 i).directions j=0 := by decide +kernel

without_editor_info theorem linear85 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes85 i).directions j)
      (graphStar edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections85 i k]
  simp [tameForm]

without_editor_info theorem cross85 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes85 (edges e).src).directions j) ((envelopes85 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections85 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value85 : vectorGraph edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell85 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1698) (hy : (7 : ℤ)^4 ∣ y-613) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1698 613 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes85 constantC constantD certificatesC85 certificatesD85 1
