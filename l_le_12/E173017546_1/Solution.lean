without_editor_info theorem linear153 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes153 i).directions j)
      (graphStar edges (fun i => (envelopes153 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections153 i k]
  simp [tameForm]

without_editor_info theorem cross153 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes153 (edges e).src).directions j) ((envelopes153 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections153 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value153 : vectorGraph edges (fun i => (envelopes153 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
