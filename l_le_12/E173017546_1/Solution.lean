without_editor_info theorem checks104 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes104 i) pi rho 13 1160 1036 3 (values 1867 2012 i) (certificatesC104 i) (certificatesD104 i) := by decide +kernel

without_editor_info theorem fixedDirections104 : ∀ i : Fin 59,
    i=34 ∨ (envelopes104 i).directions=0 := by decide +kernel

without_editor_info theorem linear104 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes104 i).directions j)
      (graphStar edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes104 34).directions k)
      (graphStar edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 34)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections104 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross104 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes104 (edges e).src).directions j) ((envelopes104 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections104 (edges e).src with hs | hz
  · rcases fixedDirections104 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value104 : vectorGraph edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell104 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1867) (hy : (13 : ℤ)^3 ∣ y-2012) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1867 2012 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes104 constantC constantD certificatesC104 certificatesD104 0
