  rw [zeroDirections51 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value51 : vectorGraph edges (fun i => (envelopes51 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
