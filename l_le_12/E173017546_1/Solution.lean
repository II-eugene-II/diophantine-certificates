  intro e j k
  have h := h e
  change (envelopes154 (edges e).src).directions = 0 ∨
    (envelopes154 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes154 (edges e).src).directions j) ((envelopes154 (edges e).dst).directions k) = 0) at h
