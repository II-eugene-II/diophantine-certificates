    (envelopes43 i).directions j=0 := by decide +kernel

without_editor_info theorem linear43 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes43 i).directions j)
      (graphStar edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections43 i k]
  simp [tameForm]

without_editor_info theorem cross43 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes43 (edges e).src).directions j) ((envelopes43 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections43 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value43 : vectorGraph edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
