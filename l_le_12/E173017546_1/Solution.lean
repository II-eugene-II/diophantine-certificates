      tameForm ((envelopes129 i).directions j)
        (graphStar edges (fun i => (envelopes129 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
