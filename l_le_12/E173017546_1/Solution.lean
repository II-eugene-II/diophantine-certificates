without_editor_info theorem checks224 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes224 i) pi rho 7 1353 1047 3 (values 113 199 i) (certificatesC224 i) (certificatesD224 i) := by decide +kernel

without_editor_info theorem linear224 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes224 i).directions j)
      (graphStar edges (fun i => (envelopes224 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes224 i).directions j = 0 ∨
      tameForm ((envelopes224 i).directions j)
        (graphStar edges (fun i => (envelopes224 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross224 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes224 (edges e).src).directions j) ((envelopes224 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes224 e.src).directions = 0 ∨
      (envelopes224 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes224 e.src).directions j) ((envelopes224 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes224 (edges e).src).directions = 0 ∨
    (envelopes224 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes224 (edges e).src).directions j) ((envelopes224 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value224 : vectorGraph edges (fun i => (envelopes224 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
