without_editor_info theorem linear154 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes154 i).directions j)
      (graphStar edges (fun i => (envelopes154 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections154 i k]
  simp [tameForm]

without_editor_info theorem cross154 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes154 (edges e).src).directions j) ((envelopes154 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections154 ((edges e).src) i]
  simp [tameForm]

