without_editor_info theorem checks40 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes40 i) pi rho 7 1353 1047 3 (values 236 242 i) (certificatesC40 i) (certificatesD40 i) := by decide +kernel

without_editor_info theorem fixedDirections40 : ∀ i : Fin 59,
    i=16 ∨ (envelopes40 i).directions=0 := by decide +kernel

without_editor_info theorem linear40 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes40 i).directions j)
      (graphStar edges (fun i => (envelopes40 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes40 16).directions k)
      (graphStar edges (fun i => (envelopes40 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 16)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections40 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross40 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes40 (edges e).src).directions j) ((envelopes40 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections40 (edges e).src with hs | hz
  · rcases fixedDirections40 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value40 : vectorGraph edges (fun i => (envelopes40 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell40 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-236) (hy : (7 : ℤ)^3 ∣ y-242) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 236 242 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes40 constantC constantD certificatesC40 certificatesD40 1
