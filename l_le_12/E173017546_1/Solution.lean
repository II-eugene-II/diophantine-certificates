without_editor_info theorem checks36 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes36 i) pi rho 19 292 68 2 (values 111 60 i) (certificatesC36 i) (certificatesD36 i) := by decide +kernel

without_editor_info theorem fixedDirections36 : ∀ i : Fin 59,
    i=58 ∨ (envelopes36 i).directions=0 := by decide +kernel

without_editor_info theorem linear36 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes36 i).directions j)
      (graphStar edges (fun i => (envelopes36 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes36 58).directions k)
      (graphStar edges (fun i => (envelopes36 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 58)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections36 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross36 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes36 (edges e).src).directions j) ((envelopes36 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections36 (edges e).src with hs | hz
  · rcases fixedDirections36 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value36 : vectorGraph edges (fun i => (envelopes36 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell36 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-111) (hy : (19 : ℤ)^2 ∣ y-60) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 111 60 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes36 constantC constantD certificatesC36 certificatesD36 0
