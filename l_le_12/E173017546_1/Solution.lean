without_editor_info theorem checks148 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes148 i) pi rho 7 1353 1047 3 (values 171 323 i) (certificatesC148 i) (certificatesD148 i) := by decide +kernel

without_editor_info theorem fixedDirections148 : ∀ i : Fin 59,
    i=10 ∨ (envelopes148 i).directions=0 := by decide +kernel

without_editor_info theorem linear148 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes148 i).directions j)
      (graphStar edges (fun i => (envelopes148 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes148 10).directions k)
      (graphStar edges (fun i => (envelopes148 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 10)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections148 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross148 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes148 (edges e).src).directions j) ((envelopes148 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections148 (edges e).src with hs | hz
  · rcases fixedDirections148 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value148 : vectorGraph edges (fun i => (envelopes148 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell148 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-171) (hy : (7 : ℤ)^3 ∣ y-323) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 171 323 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes148 constantC constantD certificatesC148 certificatesD148 1
