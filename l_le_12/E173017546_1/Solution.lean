without_editor_info theorem checks67 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes67 i) pi rho 19 292 68 2 (values 262 285 i) (certificatesC67 i) (certificatesD67 i) := by decide +kernel

without_editor_info theorem fixedDirections67 : ∀ i : Fin 59,
    i=39 ∨ (envelopes67 i).directions=0 := by decide +kernel

without_editor_info theorem linear67 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes67 i).directions j)
      (graphStar edges (fun i => (envelopes67 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes67 39).directions k)
      (graphStar edges (fun i => (envelopes67 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 39)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections67 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross67 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes67 (edges e).src).directions j) ((envelopes67 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections67 (edges e).src with hs | hz
  · rcases fixedDirections67 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value67 : vectorGraph edges (fun i => (envelopes67 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell67 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-262) (hy : (19 : ℤ)^2 ∣ y-285) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 262 285 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes67 constantC constantD certificatesC67 certificatesD67 0
