  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross183 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes183 (edges e).src).directions j) ((envelopes183 (edges e).dst).directions k) = 0 := by
