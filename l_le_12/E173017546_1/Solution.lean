    tameForm ((envelopes197 i).directions j)
      (graphStar edges (fun i => (envelopes197 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes197 58).directions k)
      (graphStar edges (fun i => (envelopes197 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 58)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections197 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross197 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes197 (edges e).src).directions j) ((envelopes197 (edges e).dst).directions k) = 0 := by
