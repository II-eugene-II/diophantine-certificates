without_editor_info theorem checks106 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes106 i) pi rho 7 1353 1047 4 (values 1845 1544 i) (certificatesC106 i) (certificatesD106 i) := by decide +kernel

without_editor_info theorem fixedDirections106 : ∀ i : Fin 59,
    i=51 ∨ (envelopes106 i).directions=0 := by decide +kernel

without_editor_info theorem linear106 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes106 i).directions j)
      (graphStar edges (fun i => (envelopes106 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes106 51).directions k)
      (graphStar edges (fun i => (envelopes106 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections106 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross106 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes106 (edges e).src).directions j) ((envelopes106 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections106 (edges e).src with hs | hz
  · rcases fixedDirections106 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value106 : vectorGraph edges (fun i => (envelopes106 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

