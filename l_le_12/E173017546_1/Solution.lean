    (envelopes124 i).directions j=0 := by decide +kernel

without_editor_info theorem linear124 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes124 i).directions j)
      (graphStar edges (fun i => (envelopes124 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections124 i k]
  simp [tameForm]

without_editor_info theorem cross124 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes124 (edges e).src).directions j) ((envelopes124 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections124 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value124 : vectorGraph edges (fun i => (envelopes124 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
