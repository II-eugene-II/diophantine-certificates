without_editor_info theorem checks58 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes58 i) pi rho 19 292 68 2 (values 53 240 i) (certificatesC58 i) (certificatesD58 i) := by decide +kernel

without_editor_info theorem linear58 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes58 i).directions j)
      (graphStar edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes58 i).directions j = 0 ∨
      tameForm ((envelopes58 i).directions j)
        (graphStar edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross58 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes58 (edges e).src).directions j) ((envelopes58 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes58 e.src).directions = 0 ∨
      (envelopes58 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes58 e.src).directions j) ((envelopes58 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes58 (edges e).src).directions = 0 ∨
    (envelopes58 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes58 (edges e).src).directions j) ((envelopes58 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value58 : vectorGraph edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell58 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-53) (hy : (19 : ℤ)^2 ∣ y-240) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 53 240 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes58 constantC constantD certificatesC58 certificatesD58 0
