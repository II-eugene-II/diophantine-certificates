without_editor_info theorem zeroDirections20 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes20 i).directions j=0 := by decide +kernel

without_editor_info theorem linear20 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes20 i).directions j)
      (graphStar edges (fun i => (envelopes20 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections20 i k]
  simp [tameForm]

without_editor_info theorem cross20 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes20 (edges e).src).directions j) ((envelopes20 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections20 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value20 : vectorGraph edges (fun i => (envelopes20 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

