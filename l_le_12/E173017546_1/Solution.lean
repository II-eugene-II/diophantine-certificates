without_editor_info theorem checks164 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes164 i) pi rho 7 1353 1047 3 (values 59 127 i) (certificatesC164 i) (certificatesD164 i) := by decide +kernel

without_editor_info theorem fixedDirections164 : ∀ i : Fin 59,
    i=58 ∨ (envelopes164 i).directions=0 := by decide +kernel

without_editor_info theorem linear164 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes164 i).directions j)
      (graphStar edges (fun i => (envelopes164 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes164 58).directions k)
      (graphStar edges (fun i => (envelopes164 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 58)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections164 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross164 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes164 (edges e).src).directions j) ((envelopes164 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections164 (edges e).src with hs | hz
  · rcases fixedDirections164 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value164 : vectorGraph edges (fun i => (envelopes164 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
