without_editor_info theorem checks67 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes67 i) pi rho 7 1353 1047 2 (values 12 38 i) (certificatesC67 i) (certificatesD67 i) := by decide +kernel

without_editor_info theorem linear67 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes67 i).directions j)
      (graphStar edges (fun i => (envelopes67 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes67 i).directions j = 0 ∨
      tameForm ((envelopes67 i).directions j)
        (graphStar edges (fun i => (envelopes67 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross67 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes67 (edges e).src).directions j) ((envelopes67 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes67 e.src).directions = 0 ∨
      (envelopes67 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes67 e.src).directions j) ((envelopes67 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes67 (edges e).src).directions = 0 ∨
    (envelopes67 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes67 (edges e).src).directions j) ((envelopes67 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value67 : vectorGraph edges (fun i => (envelopes67 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell67 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-12) (hy : (7 : ℤ)^2 ∣ y-38) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 12 38 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes67 constantC constantD certificatesC67 certificatesD67 1
