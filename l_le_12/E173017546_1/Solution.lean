without_editor_info theorem checks55 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes55 i) pi rho 7 1353 1047 3 (values 173 221 i) (certificatesC55 i) (certificatesD55 i) := by decide +kernel

without_editor_info theorem zeroDirections55 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes55 i).directions j=0 := by decide +kernel

without_editor_info theorem linear55 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes55 i).directions j)
      (graphStar edges (fun i => (envelopes55 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections55 i k]
  simp [tameForm]

without_editor_info theorem cross55 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes55 (edges e).src).directions j) ((envelopes55 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections55 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value55 : vectorGraph edges (fun i => (envelopes55 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell55 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-173) (hy : (7 : ℤ)^3 ∣ y-221) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 173 221 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes55 constantC constantD certificatesC55 certificatesD55 1
