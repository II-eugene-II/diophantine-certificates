without_editor_info theorem checks16 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes16 i) pi rho 19 292 68 2 (values 131 68 i) (certificatesC16 i) (certificatesD16 i) := by decide +kernel

without_editor_info theorem linear16 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes16 i).directions j)
      (graphStar edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes16 i).directions j = 0 ∨
      tameForm ((envelopes16 i).directions j)
        (graphStar edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross16 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes16 (edges e).src).directions j) ((envelopes16 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes16 e.src).directions = 0 ∨
      (envelopes16 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes16 e.src).directions j) ((envelopes16 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes16 (edges e).src).directions = 0 ∨
    (envelopes16 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes16 (edges e).src).directions j) ((envelopes16 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value16 : vectorGraph edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

