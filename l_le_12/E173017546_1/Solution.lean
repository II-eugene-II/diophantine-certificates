    (envelopes217 i).directions j=0 := by decide +kernel

without_editor_info theorem linear217 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes217 i).directions j)
      (graphStar edges (fun i => (envelopes217 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections217 i k]
  simp [tameForm]

without_editor_info theorem cross217 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes217 (edges e).src).directions j) ((envelopes217 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections217 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value217 : vectorGraph edges (fun i => (envelopes217 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
