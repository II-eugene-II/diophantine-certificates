  decide +kernel

without_editor_info theorem cell100 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-68) (hy : (19 : ℤ)^2 ∣ y-192) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 68 192 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes100 constantC constantD certificatesC100 certificatesD100 0
