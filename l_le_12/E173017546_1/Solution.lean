    i=48 ∨ (envelopes126 i).directions=0 := by decide +kernel

without_editor_info theorem linear126 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes126 i).directions j)
      (graphStar edges (fun i => (envelopes126 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes126 48).directions k)
      (graphStar edges (fun i => (envelopes126 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 48)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections126 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross126 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes126 (edges e).src).directions j) ((envelopes126 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections126 (edges e).src with hs | hz
  · rcases fixedDirections126 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

