without_editor_info theorem checks79 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes79 i) pi rho 13 1160 1036 2 (values 164 88 i) (certificatesC79 i) (certificatesD79 i) := by decide +kernel

without_editor_info theorem fixedDirections79 : ∀ i : Fin 59,
    i=25 ∨ (envelopes79 i).directions=0 := by decide +kernel

without_editor_info theorem linear79 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes79 i).directions j)
      (graphStar edges (fun i => (envelopes79 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes79 25).directions k)
      (graphStar edges (fun i => (envelopes79 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 25)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections79 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross79 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes79 (edges e).src).directions j) ((envelopes79 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections79 (edges e).src with hs | hz
  · rcases fixedDirections79 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value79 : vectorGraph edges (fun i => (envelopes79 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

