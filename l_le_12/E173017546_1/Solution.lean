    i=12 ∨ (envelopes43 i).directions=0 := by decide +kernel

without_editor_info theorem linear43 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes43 i).directions j)
      (graphStar edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes43 12).directions k)
      (graphStar edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 12)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections43 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross43 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes43 (edges e).src).directions j) ((envelopes43 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections43 (edges e).src with hs | hz
  · rcases fixedDirections43 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

