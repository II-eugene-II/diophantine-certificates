without_editor_info theorem checks62 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes62 i) pi rho 7 1353 1047 2 (values 47 31 i) (certificatesC62 i) (certificatesD62 i) := by decide +kernel

without_editor_info theorem fixedDirections62 : ∀ i : Fin 59,
    i=2 ∨ (envelopes62 i).directions=0 := by decide +kernel

without_editor_info theorem linear62 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes62 i).directions j)
      (graphStar edges (fun i => (envelopes62 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes62 2).directions k)
      (graphStar edges (fun i => (envelopes62 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 2)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections62 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross62 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes62 (edges e).src).directions j) ((envelopes62 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections62 (edges e).src with hs | hz
  · rcases fixedDirections62 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value62 : vectorGraph edges (fun i => (envelopes62 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell62 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-47) (hy : (7 : ℤ)^2 ∣ y-31) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 47 31 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes62 constantC constantD certificatesC62 certificatesD62 1
