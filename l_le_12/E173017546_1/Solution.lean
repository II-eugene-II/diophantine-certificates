without_editor_info theorem checks153 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes153 i) pi rho 19 292 68 2 (values 270 217 i) (certificatesC153 i) (certificatesD153 i) := by decide +kernel

without_editor_info theorem fixedDirections153 : ∀ i : Fin 59,
    i=52 ∨ (envelopes153 i).directions=0 := by decide +kernel

without_editor_info theorem linear153 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes153 i).directions j)
      (graphStar edges (fun i => (envelopes153 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes153 52).directions k)
      (graphStar edges (fun i => (envelopes153 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 52)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections153 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross153 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes153 (edges e).src).directions j) ((envelopes153 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections153 (edges e).src with hs | hz
  · rcases fixedDirections153 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value153 : vectorGraph edges (fun i => (envelopes153 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

