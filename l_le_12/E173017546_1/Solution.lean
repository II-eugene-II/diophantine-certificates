    (envelopes57 i).directions j=0 := by decide +kernel

without_editor_info theorem linear57 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes57 i).directions j)
      (graphStar edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections57 i k]
  simp [tameForm]

without_editor_info theorem cross57 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes57 (edges e).src).directions j) ((envelopes57 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections57 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value57 : vectorGraph edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
