without_editor_info theorem checks165 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes165 i) pi rho 19 292 68 2 (values 42 27 i) (certificatesC165 i) (certificatesD165 i) := by decide +kernel

without_editor_info theorem linear165 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes165 i).directions j)
      (graphStar edges (fun i => (envelopes165 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes165 i).directions j = 0 ∨
      tameForm ((envelopes165 i).directions j)
        (graphStar edges (fun i => (envelopes165 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross165 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes165 (edges e).src).directions j) ((envelopes165 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes165 e.src).directions = 0 ∨
      (envelopes165 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes165 e.src).directions j) ((envelopes165 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes165 (edges e).src).directions = 0 ∨
    (envelopes165 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes165 (edges e).src).directions j) ((envelopes165 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value165 : vectorGraph edges (fun i => (envelopes165 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
