    (hx : (7 : ℤ)^2 ∣ x-31) (hy : (7 : ℤ)^2 ∣ y-29) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
