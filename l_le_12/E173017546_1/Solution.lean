without_editor_info theorem checks6 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes6 i) pi rho 13 1160 1036 3 (values 1974 1449 i) (certificatesC6 i) (certificatesD6 i) := by decide +kernel

without_editor_info theorem noLoops : ∀ e : Fin 352, (edges e).src ≠ (edges e).dst := by
  exact listEdges_all (m := 352) edgeList (by decide)
    (fun e => e.src ≠ e.dst) (by decide +kernel)

without_editor_info theorem fixedDirections6 : ∀ i : Fin 59,
    i=52 ∨ (envelopes6 i).directions=0 := by decide +kernel

without_editor_info theorem linear6 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes6 i).directions j)
      (graphStar edges (fun i => (envelopes6 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes6 52).directions k)
      (graphStar edges (fun i => (envelopes6 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 52)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections6 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross6 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes6 (edges e).src).directions j) ((envelopes6 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections6 (edges e).src with hs | hz
  · rcases fixedDirections6 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value6 : vectorGraph edges (fun i => (envelopes6 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell6 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1974) (hy : (13 : ℤ)^3 ∣ y-1449) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1974 1449 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes6 constantC constantD certificatesC6 certificatesD6 0
