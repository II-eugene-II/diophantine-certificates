    (envelopes47 i).directions j=0 := by decide +kernel

without_editor_info theorem linear47 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes47 i).directions j)
      (graphStar edges (fun i => (envelopes47 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections47 i k]
  simp [tameForm]

without_editor_info theorem cross47 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes47 (edges e).src).directions j) ((envelopes47 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections47 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value47 : vectorGraph edges (fun i => (envelopes47 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
