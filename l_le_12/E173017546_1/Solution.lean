without_editor_info theorem checks162 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes162 i) pi rho 19 292 68 2 (values 99 255 i) (certificatesC162 i) (certificatesD162 i) := by decide +kernel

without_editor_info theorem fixedDirections162 : ∀ i : Fin 59,
    i=54 ∨ (envelopes162 i).directions=0 := by decide +kernel

without_editor_info theorem linear162 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes162 i).directions j)
      (graphStar edges (fun i => (envelopes162 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes162 54).directions k)
      (graphStar edges (fun i => (envelopes162 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 54)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections162 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross162 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes162 (edges e).src).directions j) ((envelopes162 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections162 (edges e).src with hs | hz
  · rcases fixedDirections162 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value162 : vectorGraph edges (fun i => (envelopes162 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
