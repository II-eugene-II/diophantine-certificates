without_editor_info theorem checks86 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes86 i) pi rho 19 292 68 2 (values 334 40 i) (certificatesC86 i) (certificatesD86 i) := by decide +kernel

without_editor_info theorem linear86 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes86 i).directions j)
      (graphStar edges (fun i => (envelopes86 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes86 i).directions j = 0 ∨
      tameForm ((envelopes86 i).directions j)
        (graphStar edges (fun i => (envelopes86 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross86 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes86 (edges e).src).directions j) ((envelopes86 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes86 e.src).directions = 0 ∨
      (envelopes86 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes86 e.src).directions j) ((envelopes86 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes86 (edges e).src).directions = 0 ∨
    (envelopes86 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes86 (edges e).src).directions j) ((envelopes86 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

