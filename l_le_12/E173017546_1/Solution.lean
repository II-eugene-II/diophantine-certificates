without_editor_info theorem linear146 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes146 i).directions j)
      (graphStar edges (fun i => (envelopes146 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes146 i).directions j = 0 ∨
      tameForm ((envelopes146 i).directions j)
        (graphStar edges (fun i => (envelopes146 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross146 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes146 (edges e).src).directions j) ((envelopes146 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes146 e.src).directions = 0 ∨
      (envelopes146 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes146 e.src).directions j) ((envelopes146 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes146 (edges e).src).directions = 0 ∨
    (envelopes146 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes146 (edges e).src).directions j) ((envelopes146 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

