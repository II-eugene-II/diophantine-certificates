    i=42 ∨ (envelopes119 i).directions=0 := by decide +kernel

without_editor_info theorem linear119 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes119 i).directions j)
      (graphStar edges (fun i => (envelopes119 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes119 42).directions k)
      (graphStar edges (fun i => (envelopes119 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 42)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections119 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross119 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes119 (edges e).src).directions j) ((envelopes119 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections119 (edges e).src with hs | hz
  · rcases fixedDirections119 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

