without_editor_info theorem fixedDirections156 : ∀ i : Fin 59,
    i=51 ∨ (envelopes156 i).directions=0 := by decide +kernel

without_editor_info theorem linear156 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes156 i).directions j)
      (graphStar edges (fun i => (envelopes156 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes156 51).directions k)
      (graphStar edges (fun i => (envelopes156 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections156 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross156 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes156 (edges e).src).directions j) ((envelopes156 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections156 (edges e).src with hs | hz
  · rcases fixedDirections156 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

