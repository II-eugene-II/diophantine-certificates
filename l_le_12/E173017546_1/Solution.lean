without_editor_info theorem checks143 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes143 i) pi rho 19 292 68 1 (values 8 16 i) (certificatesC143 i) (certificatesD143 i) := by decide +kernel

without_editor_info theorem linear143 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes143 i).directions j)
      (graphStar edges (fun i => (envelopes143 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes143 i).directions j = 0 ∨
      tameForm ((envelopes143 i).directions j)
        (graphStar edges (fun i => (envelopes143 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross143 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes143 (edges e).src).directions j) ((envelopes143 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes143 e.src).directions = 0 ∨
      (envelopes143 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes143 e.src).directions j) ((envelopes143 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes143 (edges e).src).directions = 0 ∨
    (envelopes143 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes143 (edges e).src).directions j) ((envelopes143 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

