without_editor_info theorem checks35 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes35 i) pi rho 7 1353 1047 3 (values 54 69 i) (certificatesC35 i) (certificatesD35 i) := by decide +kernel

without_editor_info theorem fixedDirections35 : ∀ i : Fin 59,
    i=17 ∨ (envelopes35 i).directions=0 := by decide +kernel

without_editor_info theorem linear35 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes35 i).directions j)
      (graphStar edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes35 17).directions k)
      (graphStar edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 17)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections35 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross35 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes35 (edges e).src).directions j) ((envelopes35 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections35 (edges e).src with hs | hz
  · rcases fixedDirections35 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value35 : vectorGraph edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell35 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-54) (hy : (7 : ℤ)^3 ∣ y-69) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 54 69 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes35 constantC constantD certificatesC35 certificatesD35 1
