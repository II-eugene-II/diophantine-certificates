    tameForm ((envelopes230 i).directions j)
      (graphStar edges (fun i => (envelopes230 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections230 i k]
  simp [tameForm]

