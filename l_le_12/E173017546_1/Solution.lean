without_editor_info theorem fixedDirections212 : ∀ i : Fin 59,
    i=58 ∨ (envelopes212 i).directions=0 := by decide +kernel

without_editor_info theorem linear212 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes212 i).directions j)
      (graphStar edges (fun i => (envelopes212 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes212 58).directions k)
      (graphStar edges (fun i => (envelopes212 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 58)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections212 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross212 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes212 (edges e).src).directions j) ((envelopes212 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections212 (edges e).src with hs | hz
  · rcases fixedDirections212 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value212 : vectorGraph edges (fun i => (envelopes212 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
