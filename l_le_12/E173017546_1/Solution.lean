  decide +kernel

without_editor_info theorem cell2 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^1 ∣ x-17) (hy : (19 : ℤ)^1 ∣ y-14) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 17 14 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤2)).trans root_rho)
    envelopes2 constantC constantD certificatesC2 certificatesD2 0
