without_editor_info theorem checks144 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes144 i) pi rho 19 292 68 1 (values 8 15 i) (certificatesC144 i) (certificatesD144 i) := by decide +kernel

without_editor_info theorem linear144 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes144 i).directions j)
      (graphStar edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes144 i).directions j = 0 ∨
      tameForm ((envelopes144 i).directions j)
        (graphStar edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross144 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes144 (edges e).src).directions j) ((envelopes144 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes144 e.src).directions = 0 ∨
      (envelopes144 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes144 e.src).directions j) ((envelopes144 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes144 (edges e).src).directions = 0 ∨
    (envelopes144 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes144 (edges e).src).directions j) ((envelopes144 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

