  split_cell edges values constants values_congr pi rho away_pi away_rho 19 292 68 91 183 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes56 constantC constantD certificatesC56 certificatesD56 0
