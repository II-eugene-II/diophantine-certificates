without_editor_info theorem checks34 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes34 i) pi rho 7 1353 1047 3 (values 103 314 i) (certificatesC34 i) (certificatesD34 i) := by decide +kernel

without_editor_info theorem zeroDirections34 : ∀ i : Fin 59, ∀ j : Fin 4,
    (envelopes34 i).directions j=0 := by decide +kernel

without_editor_info theorem linear34 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes34 i).directions j)
      (graphStar edges (fun i => (envelopes34 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections34 i k]
  simp [tameForm]

without_editor_info theorem cross34 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes34 (edges e).src).directions j) ((envelopes34 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections34 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value34 : vectorGraph edges (fun i => (envelopes34 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell34 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-103) (hy : (7 : ℤ)^3 ∣ y-314) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 103 314 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes34 constantC constantD certificatesC34 certificatesD34 1
