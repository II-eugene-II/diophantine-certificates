without_editor_info theorem checks64 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes64 i) pi rho 13 1160 1036 2 (values 9 23 i) (certificatesC64 i) (certificatesD64 i) := by decide +kernel

without_editor_info theorem linear64 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes64 i).directions j)
      (graphStar edges (fun i => (envelopes64 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 59, ∀ j : Fin 4, (envelopes64 i).directions j = 0 ∨
      tameForm ((envelopes64 i).directions j)
        (graphStar edges (fun i => (envelopes64 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross64 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes64 (edges e).src).directions j) ((envelopes64 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 352) edgeList (by decide)
    (fun e => (envelopes64 e.src).directions = 0 ∨
      (envelopes64 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes64 e.src).directions j) ((envelopes64 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes64 (edges e).src).directions = 0 ∨
    (envelopes64 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes64 (edges e).src).directions j) ((envelopes64 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value64 : vectorGraph edges (fun i => (envelopes64 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell64 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-9) (hy : (13 : ℤ)^2 ∣ y-23) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 9 23 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes64 constantC constantD certificatesC64 certificatesD64 0
