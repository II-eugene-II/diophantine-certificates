without_editor_info theorem checks68 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes68 i) pi rho 13 1160 1036 2 (values 139 45 i) (certificatesC68 i) (certificatesD68 i) := by decide +kernel

without_editor_info theorem fixedDirections68 : ∀ i : Fin 59,
    i=15 ∨ (envelopes68 i).directions=0 := by decide +kernel

without_editor_info theorem linear68 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes68 i).directions j)
      (graphStar edges (fun i => (envelopes68 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes68 15).directions k)
      (graphStar edges (fun i => (envelopes68 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 15)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections68 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross68 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes68 (edges e).src).directions j) ((envelopes68 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections68 (edges e).src with hs | hz
  · rcases fixedDirections68 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value68 : vectorGraph edges (fun i => (envelopes68 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell68 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-139) (hy : (13 : ℤ)^2 ∣ y-45) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 139 45 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes68 constantC constantD certificatesC68 certificatesD68 0
