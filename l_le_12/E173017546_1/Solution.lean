without_editor_info theorem checks231 : ∀ i : Fin 59, jointEnvelopeFastCheck (envelopes231 i) pi rho 7 1353 1047 3 (values 148 192 i) (certificatesC231 i) (certificatesD231 i) := by decide +kernel

without_editor_info theorem fixedDirections231 : ∀ i : Fin 59,
    i=57 ∨ (envelopes231 i).directions=0 := by decide +kernel

without_editor_info theorem linear231 : ∀ i : Fin 59, ∀ j : Fin 4,
    tameForm ((envelopes231 i).directions j)
      (graphStar edges (fun i => (envelopes231 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes231 57).directions k)
      (graphStar edges (fun i => (envelopes231 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 57)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections231 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross231 : ∀ e : Fin 352, ∀ j k : Fin 4,
    tameForm ((envelopes231 (edges e).src).directions j) ((envelopes231 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections231 (edges e).src with hs | hz
  · rcases fixedDirections231 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value231 : vectorGraph edges (fun i => (envelopes231 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell231 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-148) (hy : (7 : ℤ)^3 ∣ y-192) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 148 192 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes231 constantC constantD certificatesC231 certificatesD231 1
