  have h : ∀ k : Fin 4, tameForm ((envelopes169 17).directions k)
      (graphStar edges (fun i => (envelopes169 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 17)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
