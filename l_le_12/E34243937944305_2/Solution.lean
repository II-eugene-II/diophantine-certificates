without_editor_info theorem linear32 : ∀ i : Fin 44, ∀ j : Fin 4,
    wildForm ((envelopes32 i).directions j)
      (graphStar edges (fun i => (envelopes32 i).base) constantsClass i) = 0 := by
  have h : ∀ k : Fin 4, wildForm ((envelopes32 4).directions k)
      (graphStar edges (fun i => (envelopes32 i).base) constantsClass 4)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections32 i with rfl | hz
  · exact h k
  · rw [hz]; simp [wildForm]

