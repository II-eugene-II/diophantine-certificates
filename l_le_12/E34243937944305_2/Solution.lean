    wildForm ((envelopes32 (edges e).src).directions j) ((envelopes32 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections32 (edges e).src with hs | hz
  · rcases fixedDirections32 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [wildForm]
  · rw [hz]; simp [wildForm]

