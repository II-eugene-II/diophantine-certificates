    Unit9 ⟨a,b⟩ →
    let z : ModE 9 := 1-(1-QuadraticAlgebra.omega)^(e:ℕ)*⟨a,b⟩
    Unit9 z ∧ wildForm (wildVec e ⟨a,b⟩) (wildVec 0 z)=0 := by
