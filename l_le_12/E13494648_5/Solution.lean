theorem quartic_reciprocity (π ρ:G) [hπ:Fact (Prime π)] [hρ:Fact (Prime ρ)]
    (hπ2:¬π∣2) (hρ2:¬ρ∣2) (hp:Primary π) (hr:Primary ρ) :
