    rw [B.mul_left _ _ _ (nonzero_of_not_uniformizer_dvd hc) (nonzero_of_not_uniformizer_dvd hd)
      (nonzero_of_not_uniformizer_dvd hb), hBc b hb,hBd b hb,add_zero]

omit hp in
theorem diagonal {a:G} (ha:a≠0) : B.val a a=0 := by
  rw [B.self a ha,B.unit_right hw ha isUnit_neg_one]

end QuarticPairing

namespace QuarticPairing
variable (B:QuarticPairing) (hw:∀a,a≠0→B.val imaginary a=0)
variable (hp:∀π ρ,Prime π→Prime ρ→Primary π→Primary ρ→B.val π ρ=0)
include hw hp

theorem uniformizer_right_exact_three {a : G} (ha : ¬uniformizer ∣ a)
    (h2 : uniformizer^3 ∣ 1-a) (h3 : ¬uniformizer^4 ∣ 1-a) : B.val a uniformizer=0 := by
  obtain ⟨c,hc⟩ := h2
  have hcn : ¬uniformizer ∣ c := by
    rintro ⟨d,hd⟩
    apply h3
    refine ⟨d, ?_⟩
    rw [hc,hd]
    ring
  have hne : 1-a≠0 := fun h => h3 (h ▸ dvd_zero _)
  have h := B.steinberg a (nonzero_of_not_uniformizer_dvd ha) hne
  rw [hc, B.mul_right _ _ _ (nonzero_of_not_uniformizer_dvd ha)
    (pow_ne_zero 3 uniformizer_prime.ne_zero) (nonzero_of_not_uniformizer_dvd hcn),
    B.pow_right (nonzero_of_not_uniformizer_dvd ha) uniformizer_prime.ne_zero,
    B.away_uniformizer hw hp ha hcn, add_zero] at h
  exact (by decide +kernel : ∀ z : ZMod 4, 3*z=0 → z=0) _ h

theorem uniformizer_right_primary {a:G} (ha:Primary a) : B.val a uniformizer=0 := by
  have han := primary_not_uniformizer_dvd ha
  have h3 : uniformizer^3∣1-a := by
    simpa only [neg_sub] using dvd_neg.mpr ((primary_iff_cube a).mp ha)
  by_cases h4:uniformizer^4∣1-a
  · let c:G := gi (-1) 2
    have hc:Primary c := by norm_num [Primary,c,gi]
    have hce:¬uniformizer^4∣1-c := by
      rintro ⟨w,hw⟩
      have hr := congrArg Zsqrtd.re hw
      norm_num [c,uniformizer,gi,pow_succ,Zsqrtd.re_mul,Zsqrtd.im_mul] at hr
      omega
    have hBc:B.val c uniformizer=0 := B.uniformizer_right_exact_three hw hp
      (primary_not_uniformizer_dvd hc)
      (by simpa only [neg_sub] using dvd_neg.mpr ((primary_iff_cube c).mp hc)) hce
    have hprod : B.val (c*a) uniformizer=0 := by
      apply B.uniformizer_right_exact_three hw hp
      · exact fun h => (uniformizer_prime.dvd_or_dvd h).elim
          (primary_not_uniformizer_dvd hc) han
      · have hd := dvd_add (dvd_mul_of_dvd_right h3 c)
          (show uniformizer^3∣1-c by
            simpa only [neg_sub] using dvd_neg.mpr ((primary_iff_cube c).mp hc))
        convert hd using 1 <;> ring
      · intro hd
        apply hce
        have hsub := dvd_sub hd (dvd_mul_of_dvd_right h4 c)
        convert hsub using 1 <;> ring
    rw [B.mul_left _ _ _ (nonzero_of_not_uniformizer_dvd
      (primary_not_uniformizer_dvd hc)) (nonzero_of_not_uniformizer_dvd han)
      uniformizer_prime.ne_zero,hBc,zero_add] at hprod
    exact hprod
  · exact B.uniformizer_right_exact_three hw hp han h3 h4

theorem uniformizer_right {a : G} (ha : a≠0) : B.val a uniformizer=0 := by
  apply induction_uniformizer_primary (P := fun a => B.val a uniformizer=0)
    (fun u hu => B.unit_left hw hu uniformizer_prime.ne_zero)
    (B.diagonal hw uniformizer_prime.ne_zero) (fun π _ hπ => B.uniformizer_right_primary hw hp hπ) ?_ a ha
  intro c d hc hd hBc hBd
  rw [B.mul_left _ _ _ hc hd uniformizer_prime.ne_zero,hBc,hBd,add_zero]

/- A reduction of the global product formula to ordinary primary-prime
reciprocity and the root-of-unity supplement. The Steinberg relation removes
the need for a separately assumed ramified-prime supplement. -/
theorem zero_of_primary_reciprocity {a b : G} (ha : a≠0) (hb : b≠0) :
    B.val a b=0 := by
  apply induction_uniformizer_primary (P := fun a => ∀ b, b≠0 → B.val a b=0)
    (fun u hu b hb => B.unit_left hw hu hb) ?_ ?_ ?_ a ha b hb
  · intro b hb
    rw [B.skew, B.uniformizer_right hw hp hb, neg_zero]
  · intro π hπ hprimary b hb
    apply induction_uniformizer_primary (P := fun b => B.val π b=0)
      (fun u hu => B.unit_right hw hπ.ne_zero hu)
      (B.uniformizer_right hw hp hπ.ne_zero)
      (fun ρ hρ hρprimary => hp π ρ hπ hρ hprimary hρprimary) ?_ b hb
    intro c d hc hd hBc hBd
    rw [B.mul_right _ _ _ hπ.ne_zero hc hd,hBc,hBd,add_zero]
  · intro c d hc hd hBc hBd b hb
    rw [B.mul_left _ _ _ hc hd hb,hBc b hb,hBd b hb,add_zero]


end QuarticPairing

