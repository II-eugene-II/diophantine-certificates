noncomputable instance gaussian_units_finite : Finite Gˣ := by
  let w:Gˣ := (imaginary_primitive.isUnit (by decide)).unit
  have hw:(w:G)=imaginary := (imaginary_primitive.isUnit (by decide)).unit_spec
  let f:Fin 4→Gˣ := fun e=>w^e.val
  apply Finite.of_surjective f
  intro u
  obtain ⟨e,he⟩ := unit_power_imaginary u.isUnit
  refine ⟨e,Units.ext ?_⟩
  simpa only [f,Units.val_pow_eq_pow_val,hw] using he.symm

noncomputable instance gaussian_units_fintype : Fintype Gˣ := Fintype.ofFinite _

def PrimaryPrime := {π : G // Prime π ∧ Primary π}

instance primaryPrime_fact (π : PrimaryPrime) : Fact (Prime π.val) := ⟨π.property.1⟩

theorem primaryPrime_ne_two (π : PrimaryPrime) : ¬π.val ∣ (2 : G) :=
  primary_not_dvd_two π.property.1 π.property.2

noncomputable def tameAt (π : PrimaryPrime) (a b : G) : ZMod 4 :=
  tame π.val (primaryPrime_ne_two π) a b

theorem finite_primary_divisors {a : G} (ha : a≠0) :
    {π : PrimaryPrime | π.val ∣ a}.Finite := by
  have hdiv : Fintype {d : G // d ∣ a} := UniqueFactorizationMonoid.fintypeSubtypeDvd a ha
  let f : {π : PrimaryPrime // π.val ∣ a} → {d : G // d ∣ a} :=
    fun π => ⟨π.val.val,π.property⟩
  have hf : Function.Injective f := by
    intro π ρ h
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun t : {d : G // d ∣ a} => t.val) h
  have hfin : Finite {π : PrimaryPrime // π.val ∣ a} := Finite.of_injective f hf
  exact Set.finite_coe_iff.mp hfin

theorem tameAt_finite_support {a b : G} (ha : a≠0) (hb : b≠0) :
    Function.HasFiniteSupport (fun π : PrimaryPrime => tameAt π a b) := by
  apply ((finite_primary_divisors ha).union (finite_primary_divisors hb)).subset
  intro π hπ
  by_contra h
  have hs : ¬π.val ∣ a ∧ ¬π.val ∣ b := by simpa using h
  exact hπ (tame_of_not_dvd π.val (primaryPrime_ne_two π) hs.1 hs.2)

noncomputable def tameTotal (a b : G) : ZMod 4 := ∑ᶠ π : PrimaryPrime, tameAt π a b

theorem tameTotal_skew (a b : G) : tameTotal a b = -tameTotal b a := by
  unfold tameTotal
  simp_rw [tameAt, tame_skew _ _ a b]
  rw [finsum_neg_distrib]

theorem tameTotal_mul_left {a b c : G} (ha : a≠0) (hb : b≠0) (hc : c≠0) :
    tameTotal (a*b) c=tameTotal a c+tameTotal b c := by
  unfold tameTotal
  have he (π : PrimaryPrime) : tameAt π (a*b) c=tameAt π a c+tameAt π b c :=
    tame_mul_left π.val (primaryPrime_ne_two π) ha hb hc
  simp_rw [he]
  exact finsum_add_distrib (tameAt_finite_support ha hc) (tameAt_finite_support hb hc)

theorem tameTotal_steinberg (a : G) : tameTotal a (1-a)=0 := by
  unfold tameTotal
  have he (π : PrimaryPrime) : tameAt π a (1-a)=0 :=
    tame_steinberg π.val (primaryPrime_ne_two π) a
  simp_rw [he]
  exact finsum_zero

theorem tameTotal_self (a:G) : tameTotal a a=tameTotal a (-1) := by
  unfold tameTotal
  congr 1
  funext π
  exact tame_self π.val (primaryPrime_ne_two π) a

noncomputable def tamePairing : QuarticPairing where
  val := tameTotal
  mul_left := fun _ _ _ => tameTotal_mul_left
  skew := tameTotal_skew
  steinberg := fun a _ _ => tameTotal_steinberg a
  self := fun a _ => tameTotal_self a

end GraphCert.Quartic

