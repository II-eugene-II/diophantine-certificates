/- Source module: GraphCert.GaussianArithmetic. -/
/-!
Exact Gaussian integer polynomial arithmetic.  The executable checks below
produce ordinary kernel-checked equalities; no reciprocity theorem is assumed.
-/
namespace GraphCert.Quartic

abbrev G := GaussianInt
abbrev Poly := List G

def gi (a b : ℤ) : G := ⟨a, b⟩
def imaginary : G := gi 0 1
def uniformizer : G := gi 1 1

def eval : Poly → G → G
  | [], _ => 0
  | a :: p, t => a + t * eval p t

def add : Poly → Poly → Poly
  | [], q => q
  | p, [] => p
  | a :: p, b :: q => (a + b) :: add p q

def scale (a : G) (p : Poly) : Poly := p.map (a * ·)

def mul : Poly → Poly → Poly
  | [], _ => []
  | a :: p, q => add (scale a q) (0 :: mul p q)

def power (p : Poly) : ℕ → Poly
  | 0 => [1]
  | n + 1 => mul (power p n) p

@[simp] theorem eval_add (p q : Poly) (t : G) :
    eval (add p q) t = eval p t + eval q t := by
  induction p generalizing q with
  | nil => simp [add, eval]
  | cons a p ih =>
    cases q with
    | nil => simp [add, eval]
    | cons b q => simp only [add, eval, ih]; ring

@[simp] theorem eval_scale (a : G) (p : Poly) (t : G) :
    eval (scale a p) t = a * eval p t := by
  induction p with
  | nil => simp [scale, eval]
  | cons b p ih => simp only [scale, List.map_cons, eval] at *; rw [ih]; ring

@[simp] theorem eval_mul (p q : Poly) (t : G) :
    eval (mul p q) t = eval p t * eval q t := by
  induction p with
  | nil => simp [mul, eval]
  | cons a p ih => simp only [mul, eval_add, eval_scale, eval, ih]; ring

@[simp] theorem eval_power (p : Poly) (n : ℕ) (t : G) :
    eval (power p n) t = (eval p t)^n := by
  induction n with
  | zero => simp [power, eval]
  | succ n ih => simp [power, eval_mul, ih, pow_succ]

/-- Trailing zeros are irrelevant, but list equality remains executable. -/
def pad (n : ℕ) (p : Poly) : Poly := p ++ List.replicate (n - p.length) 0

@[simp] theorem eval_append (p q : Poly) (t : G) :
    eval (p ++ q) t = eval p t + t^p.length * eval q t := by
  induction p with
  | nil => simp [eval]
  | cons a p ih => simp only [List.cons_append, eval, List.length_cons, ih, pow_succ]; ring

@[simp] theorem eval_zeros (n : ℕ) (t : G) : eval (List.replicate n 0) t = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ, eval, ih]

@[simp] theorem eval_pad (n : ℕ) (p : Poly) (t : G) : eval (pad n p) t = eval p t := by
  simp [pad]

/-- A polynomial equality certificate implies equality at every Gaussian argument. -/
theorem eq_of_pad_eq {p q : Poly} {n : ℕ} (h : pad n p = pad n q) (t : G) :
    eval p t = eval q t := by
  simpa using congrArg (fun r => eval r t) h

/-- Denominator-cleared fourth-power identity; all data are explicit integers. -/
structure StarWitness where
  modulus : Poly
  numerator : Poly
  leftMultiplier : ℕ
  rightMultiplier : ℕ
  product : Poly
  quotient : Poly
  padding : ℕ

def StarWitness.valid (s : StarWitness) : Prop :=
  pad s.padding (scale (s.leftMultiplier : G) (power s.numerator 4)) =
    pad s.padding (add (scale (s.rightMultiplier : G) s.product) (mul s.quotient s.modulus))

instance (s : StarWitness) : Decidable s.valid := inferInstanceAs (Decidable (_ = _))

theorem StarWitness.identity (s : StarWitness) (h : s.valid) (t : G) :
    (s.leftMultiplier : G) * eval s.numerator t ^ 4 =
      (s.rightMultiplier : G) * eval s.product t + eval s.quotient t * eval s.modulus t := by
  simpa only [eval_scale, eval_power, eval_add, eval_mul] using eq_of_pad_eq h t

theorem StarWitness.at_root (s : StarWitness) (h : s.valid) (t : G)
    (ht : eval s.modulus t = 0) :
    (s.leftMultiplier : G) * eval s.numerator t ^ 4 =
      (s.rightMultiplier : G) * eval s.product t := by
  simpa [ht] using s.identity h t

end GraphCert.Quartic

