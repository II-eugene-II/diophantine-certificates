/- Source module: GraphCert.QuarticJacobiSymbol. -/
/-! Multiplicative extension of the prime quartic symbol to odd moduli. -/

namespace GraphCert.Quartic
open UniqueFactorizationMonoid
noncomputable section

theorem quarticSymbol_associated (π ρ:G) [Fact (Prime π)] [Fact (Prime ρ)]
    (hπ:¬π∣2) (hρ:¬ρ∣2) (h:Associated π ρ) (a:G) :
    quarticSymbol π hπ a=quarticSymbol ρ hρ a := by
  let g : Residue ρ →+* Residue π := Ideal.Quotient.lift _ (reduction π) (by
    intro z hz
    exact (reduction_zero π _).mpr (h.dvd.trans (Ideal.mem_span_singleton.mp hz)))
  have hg (z:G) : g (reduction ρ z)=reduction π z := rfl
  have hcard : Fintype.card (Residue ρ)=Fintype.card (Residue π) := by
    rw [← Nat.card_eq_fintype_card,← Nat.card_eq_fintype_card,residue_card,residue_card,
      Zsqrtd.norm_eq_of_associated (by decide) h]
  apply quartic_value_injective (reduction π) (residue_imaginary_primitive π hπ)
    (quarticSymbol_value π hπ a) (quarticSymbol_value ρ hρ a)
  have he := congrArg g (quarticSymbol_reduction ρ hρ a)
  rw [quarticSymbol_reduction]
  simpa only [map_pow,hg,hcard] using he.symm

local instance gaussianNormalization : StrongNormalizationMonoid G :=
  UniqueFactorizationMonoid.strongNormalizationMonoid

def primeFactorSymbol (π a:G) : G := by
  classical
  exact if h:Prime π ∧ ¬π∣2 then
    haveI : Fact (Prime π) := ⟨h.1⟩
    quarticSymbol π h.2 a
  else 1

def quarticJacobi (b a:G) : G :=
  ((normalizedFactors b).map (fun π => primeFactorSymbol π a)).prod

theorem primeFactorSymbol_mul (π a b:G) :
    primeFactorSymbol π (a*b)=primeFactorSymbol π a*primeFactorSymbol π b := by
  unfold primeFactorSymbol
  split_ifs with h
  · have : Fact (Prime π) := ⟨h.1⟩
    exact quarticSymbol_mul π h.2 a b
  · simp

theorem quarticJacobi_mul_left {b c:G} (hb:b≠0) (hc:c≠0) (a:G) :
    quarticJacobi (b*c) a=quarticJacobi b a*quarticJacobi c a := by
  simp [quarticJacobi,normalizedFactors_mul hb hc]

theorem quarticJacobi_mul_right (b a c:G) :
    quarticJacobi b (a*c)=quarticJacobi b a*quarticJacobi b c := by
  simp [quarticJacobi,primeFactorSymbol_mul,Multiset.prod_map_mul]

theorem quarticJacobi_unit {u:G} (hu:IsUnit u) (a:G) : quarticJacobi u a=1 := by
  simp [quarticJacobi,normalizedFactors_of_isUnit hu]

theorem quarticJacobi_associated {b c:G} (h:Associated b c) (a:G) :
    quarticJacobi b a=quarticJacobi c a := by
  rw [quarticJacobi,quarticJacobi,h.normalizedFactors_eq]

theorem quarticJacobi_prime (π:G) [hπ:Fact (Prime π)] (h2:¬π∣2) (a:G) :
    quarticJacobi π a=quarticSymbol π h2 a := by
  have hn : Prime (normalize π) := (normalize_associated π).symm.prime hπ.out
  have h2n : ¬normalize π∣2 := fun h => h2 ((normalize_associated π).symm.dvd.trans h)
  haveI : Fact (Prime (normalize π)) := ⟨hn⟩
  rw [quarticJacobi,normalizedFactors_irreducible hπ.out.irreducible,
    Multiset.map_singleton,Multiset.prod_singleton,primeFactorSymbol,dif_pos ⟨hn,h2n⟩]
  exact quarticSymbol_associated _ _ h2n h2 (normalize_associated π) a

theorem quarticJacobi_one (b:G) : quarticJacobi b 1=1 := by
  apply Multiset.prod_eq_one
  intro z hz
  obtain ⟨π,_,rfl⟩ := Multiset.mem_map.mp hz
  unfold primeFactorSymbol
  split_ifs with h
  · simp [quarticSymbol]
  · rfl

theorem quarticJacobi_pow_right (b a:G) (n:ℕ) :
    quarticJacobi b (a^n)=quarticJacobi b a^n := by
  induction n with
  | zero => simp [quarticJacobi_one]
  | succ n ih => rw [pow_succ,quarticJacobi_mul_right,ih,pow_succ]

theorem primeFactorSymbol_associated {π ρ:G} (h:Associated π ρ) (a:G) :
    primeFactorSymbol π a=primeFactorSymbol ρ a := by
  classical
  unfold primeFactorSymbol
  have hiff : (Prime π ∧ ¬π∣2) ↔ (Prime ρ ∧ ¬ρ∣2) := by
    rw [h.prime_iff,h.dvd_iff_dvd_left]
  by_cases hπ : Prime π ∧ ¬π∣2
  · have hρ := hiff.mp hπ
    rw [dite_eq_left hπ,dite_eq_left hρ]
    have : Fact (Prime π) := ⟨hπ.1⟩
    have : Fact (Prime ρ) := ⟨hρ.1⟩
    exact quarticSymbol_associated π ρ hπ.2 hρ.2 h a
  · rw [dite_eq_right hπ,dite_eq_right (mt hiff.mpr hπ)]

theorem quarticJacobi_irreducible {π:G} (hπ:Irreducible π) (a:G) :
    quarticJacobi π a=primeFactorSymbol π a := by
  rw [quarticJacobi,normalizedFactors_irreducible hπ,
    Multiset.map_singleton,Multiset.prod_singleton]
  exact primeFactorSymbol_associated (normalize_associated π) a

theorem quarticJacobi_congr (b:G) {a c:G} (h:b∣a-c) :
    quarticJacobi b a=quarticJacobi b c := by
  classical
  unfold quarticJacobi
  congr 1
  apply Multiset.map_congr rfl
  intro π hπ
  unfold primeFactorSymbol
  split_ifs with hp
  · have : Fact (Prime π) := ⟨hp.1⟩
    exact quarticSymbol_congr π hp.2 ((dvd_of_mem_normalizedFactors hπ).trans h)
  · rfl

theorem quarticJacobi_fourth (b a:G) (h:IsCoprime b a) : quarticJacobi b a^4=1 := by
  classical
  unfold quarticJacobi
  rw [← Multiset.prod_map_pow]
  apply Multiset.prod_eq_one
  intro z hz
  obtain ⟨π,hπ,rfl⟩ := Multiset.mem_map.mp hz
  unfold primeFactorSymbol
  split_ifs with hp
  · have : Fact (Prime π) := ⟨hp.1⟩
    apply quarticSymbol_fourth π hp.2
    intro hd
    exact hp.1.not_unit (h.isUnit_of_dvd' (dvd_of_mem_normalizedFactors hπ) hd)
  · simp

theorem primeFactorSymbol_star (π a:G) :
    primeFactorSymbol (star π) a=star (primeFactorSymbol π (star a)) := by
  classical
  unfold primeFactorSymbol
  have hiff : (Prime π ∧ ¬π∣2) ↔ (Prime (star π) ∧ ¬star π∣2) := by
    constructor <;> rintro ⟨hp,h2⟩
    · exact ⟨prime_star hp,fun h => h2 (by simpa using star_dvd_of_dvd h)⟩
    · exact ⟨by simpa using prime_star hp,fun h => h2 (by simpa using star_dvd_of_dvd h)⟩
  by_cases hp : Prime π ∧ ¬π∣2
  · have hs := hiff.mp hp
    rw [dite_eq_left hp,dite_eq_left hs]
    have : Fact (Prime π) := ⟨hp.1⟩
    have : Fact (Prime (star π)) := ⟨hs.1⟩
    have h := congrArg star (quarticSymbol_star π hp.2 hs.2 a)
    simpa only [star_star] using h
  · rw [dite_eq_right hp,dite_eq_right (mt hiff.mpr hp),star_one]

theorem quarticJacobi_star (b a:G) : quarticJacobi (star b) a=star (quarticJacobi b (star a)) := by
  classical
  induction b using UniqueFactorizationMonoid.induction_on_prime with
  | h₁ => simp [quarticJacobi]
  | h₂ u hu =>
      have hs : IsUnit (star u) := hu.map (starRingEnd G)
      rw [quarticJacobi_unit hs,quarticJacobi_unit hu,star_one]
  | h₃ b p hb hp ih =>
      rw [star_mul,quarticJacobi_mul_left (by simpa using hb) (prime_star hp).ne_zero,
        quarticJacobi_mul_left hp.ne_zero hb,star_mul,ih,
        quarticJacobi_irreducible (prime_star hp).irreducible,
        quarticJacobi_irreducible hp.irreducible,primeFactorSymbol_star]

end
end GraphCert.Quartic

/- Source module: GraphCert.QuarticRationalPrimes. -/
/-! Reciprocity for a rational prime in the numerator. -/

namespace GraphCert.Quartic
open MulChar

theorem quartic_value_star_cube {a:G} (h:QuarticValue a) : star a=a^3 := by
  rcases h with rfl | h
  · simp
  · obtain ⟨k,_,rfl⟩ := imaginary_primitive.eq_pow_of_pow_eq_one h
    rw [star_pow,star_imaginary,← pow_mul,← pow_mul,Nat.mul_comm]

theorem quartic_value_mul {a b:G} (ha:QuarticValue a) (hb:QuarticValue b) :
    QuarticValue (a*b) := by
  rcases ha with rfl | ha <;> rcases hb with rfl | hb <;> simp_all [QuarticValue,mul_pow]

theorem quartic_value_ninth {a:G} (ha:QuarticValue a) : (a^3)^3=a := by
  rcases ha with rfl | ha
  · simp
  · calc (a^3)^3=(a^4)^2*a := by ring
         _=a := by rw [ha]; simp

theorem quartic_cube_injective {a b:G} (ha:QuarticValue a) (hb:QuarticValue b)
    (h:a^3=b^3) : a=b := by
  have hh := congrArg (fun z:G => z^3) h
  simpa only [quartic_value_ninth ha,quartic_value_ninth hb] using hh

theorem prime_of_norm_prime {z:G} (hn:(Zsqrtd.norm z).natAbs.Prime) : Prime z := by
  apply irreducible_iff_prime.mp
  refine ⟨fun hu => hn.ne_one (Zsqrtd.norm_eq_one_iff.mpr hu),?_⟩
  intro a b he
  have hN : (Zsqrtd.norm z).natAbs=(Zsqrtd.norm a).natAbs*(Zsqrtd.norm b).natAbs := by
    rw [he,Zsqrtd.norm_mul,Int.natAbs_mul]
  obtain h | h := hn.prime.irreducible.isUnit_or_isUnit hN
  · exact Or.inl (Zsqrtd.norm_eq_one_iff.mp (Nat.isUnit_iff.mp h))
  · exact Or.inr (Zsqrtd.norm_eq_one_iff.mp (Nat.isUnit_iff.mp h))

theorem rational_prime_split (q:ℕ) [Fact q.Prime] (hq:q%4=1) :
    ∃ ρ:G,Zsqrtd.norm ρ=q ∧ Prime ρ := by
  have hn : ¬Irreducible (q:G) := by
    rw [irreducible_iff_prime,GaussianInt.prime_iff_mod_four_eq_three_of_nat_prime]
    omega
  obtain ⟨a,b,hab⟩ := GaussianInt.sq_add_sq_of_nat_prime_of_not_irreducible q hn
  let ρ := gi a b
  have hN : Zsqrtd.norm ρ=q := by
    change (a:ℤ)*(a:ℤ)-(-1)*(b:ℤ)*(b:ℤ)=(q:ℤ)
    norm_num only [neg_mul,one_mul,sub_neg_eq_add]
    rw [← pow_two,← pow_two]
    exact_mod_cast hab
  refine ⟨ρ,hN,prime_of_norm_prime ?_⟩
  simpa only [hN,Int.natAbs_natCast] using (Fact.out : q.Prime)

theorem norm_prime_not_dvd_two (q:ℕ) [hq:Fact q.Prime] (hq2:q≠2)
    {ρ:G} (hN:Zsqrtd.norm ρ=q) : ¬ρ∣2 := by
  rintro ⟨a,ha⟩
  have hn := congrArg (fun z:G => (Zsqrtd.norm z).natAbs) ha
  simp only [Zsqrtd.norm_mul,Int.natAbs_mul,hN,Int.natAbs_natCast] at hn
  have hd : q∣4 := ⟨_,hn⟩
  have hd2 : q∣2 := hq.out.dvd_of_dvd_pow (by simpa using hd : q∣2^2)
  exact hq2 (Nat.le_antisymm (Nat.le_of_dvd (by decide) hd2) hq.out.two_le)

theorem rational_prime_not_dvd_two (q:ℕ) [hq:Fact q.Prime] (hq2:q≠2) : ¬(q:G)∣2 := by
  intro h
  have hd : (q:ℤ)∣2 := (Zsqrtd.intCast_dvd_intCast _ _).mp h
  have hd' : q∣2 := by exact_mod_cast hd
  exact hq2 (Nat.le_antisymm (Nat.le_of_dvd (by decide) hd') hq.out.two_le)

theorem characteristic_of_prime_dvd (q:ℕ) [hq:Fact q.Prime]
    (π:G) [Fact (Prime π)] (h:π∣(q:G)) : ringChar (Residue π)=q := by
  apply CharP.ringChar_of_prime_eq_zero hq.out
  simpa only [map_natCast] using (reduction_zero π _).mpr h

theorem characteristic_ne (π:G) [Fact (Prime π)] (q:ℕ) (h:¬π∣(q:G)) :
    q≠ringChar (Residue π) := by
  rintro rfl
  apply h
  apply (reduction_zero π _).mp
  rw [map_natCast,CharP.cast_eq_zero]

theorem norm_eq_product (z:G) : (Zsqrtd.norm z:G)=z*star z := Zsqrtd.norm_eq_mul_conj z

theorem rational_prime_reciprocity_inert (π:G) [Fact (Prime π)] (h2:¬π∣2)
    (hp:(2:G)∣π-1) (q:ℕ) [hq:Fact q.Prime] (hq3:q%4=3) (hne:¬π∣(q:G)) :
    quarticJacobi (q:G) π=quarticSymbol π h2 (-(q:G)) := by
  have hqG : Fact (Prime (q:G)) := ⟨GaussianInt.prime_of_nat_prime_of_mod_four_eq_three q hq3⟩
  have hq2 := rational_prime_not_dvd_two q (by omega)
  have hchar : ringChar (Residue (q:G))=q := characteristic_of_prime_dvd q (q:G) dvd_rfl
  have hcard : Fintype.card (Residue (q:G))=q^2 := by
    have hn := residue_norm (q:G)
    simp only [Zsqrtd.norm_natCast] at hn
    simpa only [pow_two] using (by exact_mod_cast hn.symm : Fintype.card (Residue (q:G))=q*q)
  rw [quarticJacobi_prime (q:G) hq2]
  have h := inert_reciprocity (reduction (q:G)) (residue_imaginary_primitive (q:G) hq2) π
    (primeCharacter_spec π h2).1 (primeCharacter_spec (q:G) hq2).1
    (residue_norm π) (primeCharacter_jacobi_square π h2 hp)
    (by rw [hchar]; exact characteristic_ne π q hne)
    (by rw [hchar]; exact hq3) (by rw [hchar]; exact hcard)
    (primeCharacter_spec (q:G) hq2).2
  simpa only [quarticSymbol,map_neg,map_natCast,hchar] using h

theorem rational_prime_reciprocity_split (π:G) [Fact (Prime π)] (h2:¬π∣2)
    (hp:(2:G)∣π-1) (q:ℕ) [hq:Fact q.Prime] (hq1:q%4=1) (hne:¬π∣(q:G)) :
    quarticJacobi (q:G) π=quarticSymbol π h2 (q:G) := by
  obtain ⟨ρ,hN,hρ⟩ := rational_prime_split q hq1
  have hρFact : Fact (Prime ρ) := ⟨hρ⟩
  have hsFact : Fact (Prime (star ρ)) := ⟨prime_star hρ⟩
  have hρ2 := norm_prime_not_dvd_two q (by omega) hN
  have hs2 : ¬star ρ∣2 := fun h => hρ2 (by simpa using star_dvd_of_dvd h)
  have heq : (q:G)=ρ*star ρ := by simpa only [hN,Int.cast_natCast] using norm_eq_product ρ
  have hchar : ringChar (Residue ρ)=q := characteristic_of_prime_dvd q ρ (heq ▸ dvd_mul_right _ _)
  have hcard : Fintype.card (Residue ρ)=q := by
    exact_mod_cast (residue_norm ρ).symm.trans hN
  have h := jacobi_reciprocity_relation (reduction ρ) (residue_imaginary_primitive ρ hρ2)
    (primeCharacter_spec π h2).1 (primeCharacter_spec ρ hρ2).1
    (by rw [hchar]; exact characteristic_ne π q hne) (primeCharacter_spec ρ hρ2).2
  rw [primeCharacter_jacobi_square π h2 hp] at h
  have hn : (Fintype.card (Residue π):G)=π*star π := by
    simpa only [residue_norm π,Int.cast_natCast] using norm_eq_product π
  rw [hn,hcard] at h
  change quarticSymbol ρ hρ2 (π*star π*π^2)=quarticSymbol π h2 (q:G)^3 at h
  have hr : π*star π*π^2=π^3*star π := by ring
  rw [hr,quarticSymbol_mul,quarticSymbol_pow,← quarticSymbol_star ρ hρ2 hs2,
    quartic_value_star_cube (quarticSymbol_value (star ρ) hs2 π),← mul_pow] at h
  rw [heq,quarticJacobi_mul_left hρ.ne_zero (prime_star hρ).ne_zero,
    quarticJacobi_prime ρ hρ2,quarticJacobi_prime (star ρ) hs2]
  apply quartic_cube_injective (quartic_value_mul (quarticSymbol_value ρ hρ2 π)
    (quarticSymbol_value (star ρ) hs2 π)) (quarticSymbol_value π h2 _)
  simpa only [heq] using h

end GraphCert.Quartic

/- Source module: GraphCert.QuarticRationalReciprocity. -/
/-! Rational-numerator reciprocity extended multiplicatively to odd integers. -/

namespace GraphCert.Quartic

def oddSign (a:ℤ) : ℤ := if a%4=1 then 1 else -1
def oddSigned (a:ℤ) : ℤ := oddSign a*a

theorem odd_mod_four {a:ℤ} (ha:a%2=1) : a%4=1 ∨ a%4=3 := by omega

theorem oddSign_mul {a b:ℤ} (ha:a%2=1) (hb:b%2=1) :
    oddSign (a*b)=oddSign a*oddSign b := by
  rcases odd_mod_four ha with ha | ha <;> rcases odd_mod_four hb with hb | hb <;>
    simp [oddSign,Int.mul_emod,ha,hb]

theorem oddSigned_mul {a b:ℤ} (ha:a%2=1) (hb:b%2=1) :
    oddSigned (a*b)=oddSigned a*oddSigned b := by
  simp only [oddSigned,oddSign_mul ha hb]
  ring

theorem oddSigned_neg {a:ℤ} (ha:a%2=1) : oddSigned (-a)=oddSigned a := by
  rcases odd_mod_four ha with h | h
  · have hn : (-a)%4=3 := by omega
    simp [oddSigned,oddSign,h,hn]
  · have hn : (-a)%4=1 := by omega
    simp [oddSigned,oddSign,h,hn]

theorem oddSigned_mod_four {a:ℤ} (ha:a%2=1) : oddSigned a%4=1 := by
  rcases odd_mod_four ha with h | h
  · simp [oddSigned,oddSign,h]
  · have hn : (-a)%4=1 := by omega
    simp [oddSigned,oddSign,h,hn]

theorem quarticJacobi_neg_left (b a:G) : quarticJacobi (-b) a=quarticJacobi b a := by
  apply quarticJacobi_associated
  exact ⟨-1,by simp⟩

theorem rational_reciprocity_nat (π:G) [Fact (Prime π)] (h2:¬π∣2) (hp:(2:G)∣π-1)
    (n:ℕ) (hn:n%2=1) (hne:¬π∣(n:G)) :
    quarticJacobi (n:G) π=quarticSymbol π h2 (oddSigned (n:ℤ):G) := by
  induction n using Nat.recOnMul with
  | zero => simp at hn
  | one => simp [oddSigned,oddSign,quarticJacobi_unit isUnit_one,quarticSymbol]
  | prime q hq =>
      have : Fact q.Prime := ⟨hq⟩
      have hcases : q%4=1 ∨ q%4=3 := by omega
      rcases hcases with h | h
      · have hi : (q:ℤ)%4=1 := by exact_mod_cast h
        simpa only [oddSigned,oddSign,hi,ite_true,one_mul,Int.cast_natCast] using
          rational_prime_reciprocity_split π h2 hp q h hne
      · have hi : (q:ℤ)%4=3 := by exact_mod_cast h
        simpa only [oddSigned,oddSign,hi,show ¬(3:ℤ)=1 by decide,ite_false,
          neg_one_mul,Int.cast_neg,Int.cast_natCast] using
          rational_prime_reciprocity_inert π h2 hp q h hne
  | mul a b iha ihb =>
      have ha : a%2=1 := by
        by_contra h
        have hz : a%2=0 := by omega
        simp [Nat.mul_mod,hz] at hn
      have hb : b%2=1 := by
        by_contra h
        have hz : b%2=0 := by omega
        simp [Nat.mul_mod,hz] at hn
      have hna : ¬π∣(a:G) := fun h => hne (by
        rw [Nat.cast_mul]; exact dvd_mul_of_dvd_left h _)
      have hnb : ¬π∣(b:G) := fun h => hne (by
        rw [Nat.cast_mul]; exact dvd_mul_of_dvd_right h _)
      have ha0 : (a:G)≠0 := by exact_mod_cast (show a≠0 by omega)
      have hb0 : (b:G)≠0 := by exact_mod_cast (show b≠0 by omega)
      rw [Nat.cast_mul,quarticJacobi_mul_left ha0 hb0,iha ha hna,ihb hb hnb,
        Nat.cast_mul,oddSigned_mul (by exact_mod_cast ha) (by exact_mod_cast hb),
        Int.cast_mul,quarticSymbol_mul]

theorem rational_reciprocity_int (π:G) [Fact (Prime π)] (h2:¬π∣2) (hp:(2:G)∣π-1)
    (n:ℤ) (hn:n%2=1) (hne:¬π∣(n:G)) :
    quarticJacobi (n:G) π=quarticSymbol π h2 (oddSigned n:G) := by
  have ha : (n.natAbs:ℤ)=n ∨ (n.natAbs:ℤ)= -n := by
    rw [Int.natCast_natAbs]
    exact abs_choice n
  rcases ha with ha | ha
  · have hn' : n.natAbs%2=1 := by exact_mod_cast (ha ▸ hn : (n.natAbs:ℤ)%2=1)
    have hnG : (n.natAbs:G)=(n:G) := by
      simpa only [Int.cast_natCast] using congrArg (fun z:ℤ => (z:G)) ha
    have h := rational_reciprocity_nat π h2 hp n.natAbs hn' (by simpa only [hnG] using hne)
    simpa only [hnG,ha] using h
  · have hn' : n.natAbs%2=1 := by
      have he : (-n)%2=1 := by omega
      exact_mod_cast (ha ▸ he : (n.natAbs:ℤ)%2=1)
    have hnG : (n.natAbs:G)= -(n:G) := by
      simpa only [Int.cast_natCast,Int.cast_neg] using congrArg (fun z:ℤ => (z:G)) ha
    have h := rational_reciprocity_nat π h2 hp n.natAbs hn' (by simpa only [hnG,dvd_neg] using hne)
    simpa only [hnG,ha,quarticJacobi_neg_left,oddSigned_neg hn] using h

theorem rational_reciprocity_primary (π:G) [Fact (Prime π)] (h2:¬π∣2) (hp:(2:G)∣π-1)
    (n:ℤ) (hn:n%4=1) (hne:¬π∣(n:G)) :
    quarticJacobi (n:G) π=quarticSymbol π h2 (n:G) := by
  simpa only [oddSigned,oddSign,hn,ite_true,one_mul] using
    rational_reciprocity_int π h2 hp n (by omega) hne

end GraphCert.Quartic

/- Source module: GraphCert.QuarticIntegerSymbol. -/
/-! Symbols with rational integer numerator and denominator. -/

namespace GraphCert.Quartic

theorem quartic_value_mul_star {a:G} (ha:QuarticValue a) (hn:a≠0) : a*star a=1 := by
  rw [quartic_value_star_cube ha,← pow_succ']
  exact ha.resolve_left hn

theorem inert_symbol_exponent {q:ℕ} (hq:q%4=3) :
    (q^2-1)/4=(q-1)*((q+1)/4) := by
  have hq1 : 1≤q := by omega
  have hs : q-1+1=q := Nat.sub_add_cancel hq1
  have h4 : 4*((q+1)/4)=q+1 := by omega
  have hm := congrArg (fun n:ℕ => n*(q-1)) h4
  have hq2 : 1≤q^2 := by nlinarith
  have hs2 : q^2-1+1=q^2 := Nat.sub_add_cancel hq2
