namespace GraphCert.Quartic
open Polynomial IsLocalRing Function List
open scoped Ring

/-- The simple-root form for an arbitrary polynomial in an adically complete ring.
The monicity hypothesis in Mathlib's HenselianRing API is unnecessary here. -/
theorem hensel_simple {R : Type*} [CommRing R] (I : Ideal R) [IsAdicComplete I R]
    (f : R[X]) (a₀ : R) (h₁ : f.eval a₀ ∈ I)
    (h₂ : IsUnit (Ideal.Quotient.mk I (f.derivative.eval a₀))) :
    ∃ a : R, f.IsRoot a ∧ a-a₀ ∈ I := by
  classical
    let f' := derivative f
    -- we define a sequence `c n` by starting at `a₀` and then continually
    -- applying the function sending `b` to `b - f(b)/f'(b)` (Newton's method).
    -- Note that `f'.eval b` is a unit, because `b` has the same residue as `a₀` modulo `I`.
    let c : ℕ → R := fun n => Nat.recOn n a₀ fun _ b => b - f.eval b * (f'.eval b)⁻¹ʳ
    have hc : ∀ n, c (n + 1) = c n - f.eval (c n) * (f'.eval (c n))⁻¹ʳ := by
      intro n
      simp only [c]
    -- we now spend some time determining properties of the sequence `c : ℕ → R`
    -- `hc_mod`: for every `n`, we have `c n ≡ a₀ [SMOD I]`
    -- `hf'c`  : for every `n`, `f'.eval (c n)` is a unit
    -- `hfcI`  : for every `n`, `f.eval (c n)` is contained in `I ^ (n+1)`
    have hc_mod : ∀ n, c n ≡ a₀ [SMOD I] := by
      intro n
      induction n with
      | zero => rfl
      | succ n ih => ?_
      rw [hc, sub_eq_add_neg, ← add_zero a₀]
      refine ih.add ?_
      rw [SModEq.zero, Ideal.neg_mem_iff]
      refine I.mul_mem_right _ ?_
      rw [← SModEq.zero] at h₁ ⊢
      exact (ih.eval f).trans h₁
    have hf'c : ∀ n, IsUnit (f'.eval (c n)) := by
      intro n
      haveI := isLocalHom_of_le_jacobson_bot I (IsAdicComplete.le_jacobson_bot I)
      apply IsUnit.of_map (Ideal.Quotient.mk I)
      convert! h₂ using 1
      exact SModEq.def.mp ((hc_mod n).eval _)
    have hfcI : ∀ n, f.eval (c n) ∈ I ^ (n + 1) := by
      intro n
      induction n with
      | zero => simpa only [Nat.rec_zero, zero_add, pow_one] using! h₁
      | succ n ih => ?_
      rw [← taylor_eval_sub (c n), hc, sub_eq_add_neg, sub_eq_add_neg,
        add_neg_cancel_comm]
      rw [eval_eq_sum, sum_over_range' _ _ _ (lt_add_of_pos_right _ zero_lt_two), ←
        Finset.sum_range_add_sum_Ico _ (Nat.le_add_left _ _)]
      swap
      · intro i
        rw [zero_mul]
      refine Ideal.add_mem _ ?_ ?_
      · rw [← one_add_one_eq_two, Finset.sum_range_succ, Finset.range_one, Finset.sum_singleton,
          taylor_coeff_zero, taylor_coeff_one, pow_zero, pow_one, mul_one, mul_neg,
          mul_left_comm, Ring.mul_inverse_cancel _ (hf'c n), mul_one, add_neg_cancel]
        exact Ideal.zero_mem _
      · refine Submodule.sum_mem _ ?_
        simp only [Finset.mem_Ico]
        rintro i ⟨h2i, _⟩
        have aux : n + 2 ≤ i * (n + 1) := by trans 2 * (n + 1) <;> nlinarith only [h2i]
        refine Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right aux ?_)
        rw [pow_mul']
        exact Ideal.pow_mem_pow ((Ideal.neg_mem_iff _).2 <| Ideal.mul_mem_right _ _ ih) _
    -- we are now in the position to show that `c : ℕ → R` is a Cauchy sequence
    have aux : ∀ m n, m ≤ n → c m ≡ c n [SMOD (I ^ m • ⊤ : Ideal R)] := by
      intro m n hmn
      rw [← Ideal.one_eq_top, Ideal.smul_eq_mul, mul_one]
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hmn
      clear hmn
      induction k with
      | zero => rw [add_zero]
      | succ k ih => ?_
      rw [← add_assoc, hc, ← add_zero (c m), sub_eq_add_neg]
      refine ih.add ?_
      symm
      rw [SModEq.zero, Ideal.neg_mem_iff]
      refine Ideal.mul_mem_right _ _ (Ideal.pow_le_pow_right ?_ (hfcI _))
      rw [add_assoc]
      exact le_self_add
    -- hence the sequence converges to some limit point `a`, which is the `a` we are looking for
    obtain ⟨a, ha⟩ := IsPrecomplete.prec' c (aux _ _)
    refine ⟨a, ?_, ?_⟩
    · show f.IsRoot a
      suffices ∀ n, f.eval a ≡ 0 [SMOD (I ^ n • ⊤ : Ideal R)] by exact IsHausdorff.haus' _ this
      intro n
      specialize ha n
      rw [← Ideal.one_eq_top, Ideal.smul_eq_mul, mul_one] at ha ⊢
      refine (ha.symm.eval f).trans ?_
      rw [SModEq.zero]
      exact Ideal.pow_le_pow_right le_self_add (hfcI _)
    · show a - a₀ ∈ I
      specialize ha (0 + 1)
      rw [hc, pow_one, ← Ideal.one_eq_top, Ideal.smul_eq_mul, mul_one, sub_eq_add_neg] at ha
      rw [← SModEq.sub_mem, ← add_zero a₀]
      refine ha.symm.trans (SModEq.rfl.add ?_)
      rw [SModEq.zero, Ideal.neg_mem_iff]
      exact Ideal.mul_mem_right _ _ h₁

section PrincipalUnits
variable {R : Type*} [CommRing R]

noncomputable def fourthLiftPolynomial (j a : R) : R[X] :=
  X + C (3*(j-1))*X^2 - C (8*j)*X^3 + C (4*(1+j))*X^4 - C a

theorem fourthLift_identity (j t : R) (hj : j^2 = -1) :
    (1+(1+j)^3*t)^4 = 1+4*(1+j)^3*
      (t + 3*(j-1)*t^2 - 8*j*t^3 + 4*(1+j)*t^4) := by
  have h3 : j^3 = -j := by calc
    j^3 = j^2*j := by ring
    _ = -j := by rw [hj]; ring
  have h4 : j^4 = 1 := by calc
    j^4 = (j^2)^2 := by ring
    _ = 1 := by rw [hj]; ring
  ring_nf
  simp only [show j^12 = 1 by rw [show 12 = 4*3 by decide, pow_mul, h4, one_pow],
    show j^11 = -j by rw [show 11 = 4*2+3 by decide, pow_add, pow_mul, h4, one_pow, one_mul, h3],
    show j^10 = -1 by rw [show 10 = 4*2+2 by decide, pow_add, pow_mul, h4, one_pow, one_mul, hj],
    show j^9 = j by rw [show 9 = 4*2+1 by decide, pow_add, pow_mul, h4, one_pow, one_mul, pow_one],
    show j^8 = 1 by rw [show 8 = 4*2 by decide, pow_mul, h4, one_pow],
    show j^7 = -j by rw [show 7 = 4+3 by decide, pow_add, h4, one_mul, h3],
    show j^6 = -1 by rw [show 6 = 4+2 by decide, pow_add, h4, one_mul, hj],
    show j^5 = j by rw [show 5 = 4+1 by decide, pow_add, h4, one_mul, pow_one], h4, h3, hj]
  ring

/-- Principal Gaussian units congruent to one modulo `4(1+i)^3` are fourth powers.
Since `4(1+i)^3` is associated to `(1+i)^7`, this is exactly the depth-seven
fourth-power threshold used in the dyadic finite table. -/
theorem principal_unit_fourth_power (I : Ideal R) [IsAdicComplete I R]
    (j : R) (hj : j^2 = -1) (h2 : (2:R) ∈ I) (hpi : 1+j ∈ I) (a : R) :
    ∃ b : R, b^4 = 1+4*(1+j)^3*a := by
  let q := Ideal.Quotient.mk I
  have hq2 : q 2 = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h2
  have hqpi : q (1+j) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hpi
  have hqj : q j = -1 := by
    have he : 1 + q j = 0 := by simpa only [map_add, map_one] using hqpi
    linear_combination he
  have hc2 : q (3*(j-1)) = 0 := by
    have ht : q (j-1) = 0 := by
      rw [map_sub, hqj, map_one]
      have htwo : (2 : R ⧸ I) = 0 := by simpa only [map_ofNat] using hq2
      linear_combination -htwo
    rw [map_mul, ht, mul_zero]
  have hc3 : q (8*j) = 0 := by
    have h8 : q (8:R) = 0 := by
      have : (8:R) = 4*2 := by ring
      rw [this, map_mul, hq2, mul_zero]
    rw [map_mul, h8, zero_mul]
  have hc4 : q (4*(1+j)) = 0 := by rw [map_mul, hqpi, mul_zero]
  have hmap : (fourthLiftPolynomial j a).map q = X - C (q a) := by
    simp only [fourthLiftPolynomial, Polynomial.map_add, Polynomial.map_sub,
      Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C,
      hc2, hc3, hc4, C_0, zero_mul, add_zero, sub_zero]
  have hroot : (fourthLiftPolynomial j a).eval a ∈ I := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [← Polynomial.eval_map_apply, hmap]
    simp [q]
  have hsimple : IsUnit (q ((fourthLiftPolynomial j a).derivative.eval a)) := by
    rw [← Polynomial.eval_map_apply, ← derivative_map, hmap]
    simpa using (isUnit_one : IsUnit (1 : R ⧸ I))
  obtain ⟨t,ht,-⟩ := hensel_simple I (fourthLiftPolynomial j a) a hroot hsimple
  have he : t + 3*(j-1)*t^2 - 8*j*t^3 + 4*(1+j)*t^4 = a := by
    simpa [Polynomial.IsRoot.def, fourthLiftPolynomial, sub_eq_zero] using ht
  exact ⟨1+(1+j)^3*t, (fourthLift_identity j t hj).trans (by rw [he])⟩
end PrincipalUnits

end GraphCert.Quartic

/- Source module: GraphCert.GaussianResidue. -/
/-! The executable dyadic signature represents the actual residue modulo π^k,
not just an encoding checked on finitely many examples. -/
namespace GraphCert.Quartic

def nextDigit (z : G) : ℤ := (z.re+z.im)%2
def afterDigit (z : G) : G :=
  gi ((z.re+z.im-nextDigit z)/2) ((z.im-z.re+nextDigit z)/2)

theorem nextDigit_cases (z : G) : nextDigit z = 0 ∨ nextDigit z = 1 := by
  dsimp [nextDigit]
  omega

theorem digit_reconstruction (z : G) :
    z = (nextDigit z : G) + uniformizer * afterDigit z := by
  rcases z with ⟨a,b⟩
  apply Zsqrtd.ext <;>
    simp [nextDigit, afterDigit, uniformizer, gi, Zsqrtd.re_mul, Zsqrtd.im_mul] <;> omega

theorem signature_lt (k : ℕ) (z : G) : signature k z < 2^k := by
  induction k generalizing z with
  | zero => simp [signature]
  | succ k ih =>
    change (nextDigit z).toNat+2*signature k (afterDigit z) < 2^(k+1)
    have h := ih (afterDigit z)
    rcases nextDigit_cases z with hz | hz <;> rw [hz] <;> simp only [Int.toNat_zero,
      Int.toNat_one, pow_succ] <;> omega

theorem representative_signature_step (k : ℕ) (z : G) :
    representative (k+1) (signature (k+1) z) =
      (nextDigit z : G) + uniformizer * representative k (signature k (afterDigit z)) := by
  change representative (k+1)
    ((nextDigit z).toNat + 2*signature k (afterDigit z)) = _
  rcases nextDigit_cases z with hz | hz <;> rw [hz] <;>
    simp [representative, Nat.add_mod, Nat.mul_mod, Nat.add_div, Nat.mul_div_right]

theorem signature_represents (k : ℕ) (z : G) :
    ∃ q : G, z = representative k (signature k z) + uniformizer^k*q := by
  induction k generalizing z with
  | zero => exact ⟨z, by simp [signature, representative]⟩
  | succ k ih =>
    obtain ⟨q,hq⟩ := ih (afterDigit z)
    refine ⟨q, ?_⟩
    rw [representative_signature_step]
    calc
      z = (nextDigit z : G) + uniformizer * afterDigit z := digit_reconstruction z
      _ = (nextDigit z : G) + uniformizer *
          (representative k (signature k (afterDigit z)) + uniformizer^k*q) :=
        congrArg (fun t : G => (nextDigit z : G) + uniformizer*t) hq
      _ = _ := by rw [pow_succ]; ring

theorem signature_eq_implies_dvd {k : ℕ} {a b : G}
    (h : signature k a = signature k b) : uniformizer^k ∣ a-b := by
  obtain ⟨u,hu⟩ := signature_represents k a
  obtain ⟨v,hv⟩ := signature_represents k b
  refine ⟨u-v, ?_⟩
  rw [hu,hv,h]
  ring

theorem nextDigit_add_uniformizer (a b : G) :
    nextDigit (a+uniformizer*b) = nextDigit a := by
  rcases a with ⟨ar,ai⟩
  rcases b with ⟨br,bi⟩
  simp [nextDigit,uniformizer,gi,Zsqrtd.re_mul,Zsqrtd.im_mul]
  omega

theorem afterDigit_add_uniformizer (a b : G) :
    afterDigit (a+uniformizer*b) = afterDigit a+b := by
  rcases a with ⟨ar,ai⟩
  rcases b with ⟨br,bi⟩
  apply Zsqrtd.ext <;>
    simp [afterDigit,nextDigit,uniformizer,gi,Zsqrtd.re_mul,Zsqrtd.im_mul] <;> omega

theorem signature_add_pow (k : ℕ) (a b : G) :
    signature k (a+uniformizer^k*b) = signature k a := by
  induction k generalizing a with
  | zero => rfl
  | succ k ih =>
    rw [pow_succ',mul_assoc]
    change (nextDigit (a+uniformizer*(uniformizer^k*b))).toNat +
      2*signature k (afterDigit (a+uniformizer*(uniformizer^k*b))) =
      (nextDigit a).toNat+2*signature k (afterDigit a)
    rw [nextDigit_add_uniformizer,afterDigit_add_uniformizer,ih]

theorem signature_eq_iff_dvd {k : ℕ} {a b : G} :
    signature k a = signature k b ↔ uniformizer^k ∣ a-b := by
  refine ⟨signature_eq_implies_dvd, ?_⟩
  rintro ⟨c,hc⟩
  have he : a = b+uniformizer^k*c := by linear_combination hc
  rw [he,signature_add_pow]

theorem imaginary_square : imaginary^2 = (-1 : G) := by decide +kernel

theorem uniformizer_seventh : uniformizer^7 = -4*uniformizer^3 := by decide +kernel

/-- Equal signatures have equal fourth-power classes in the actual complete ring,
provided the comparison element is a unit there. -/
theorem same_signature_fourth_class {R : Type*} [CommRing R]
    (I : Ideal R) [IsAdicComplete I R] (f : G →+* R)
    (h2 : (2:R) ∈ I) (hpi : f uniformizer ∈ I)
    {a b : G} (hab : signature 7 a = signature 7 b) (hb : IsUnit (f b)) :
    ∃ c : R, f a = f b*c^4 := by
  obtain ⟨q,hq⟩ := signature_eq_implies_dvd hab
  have hj : (f imaginary)^2 = -1 := by
    rw [← map_pow,imaginary_square,map_neg,map_one]
  have hepi : f uniformizer = 1+f imaginary := by
    have he : uniformizer = 1+imaginary := by decide +kernel
    rw [he,map_add,map_one]
  rcases hb with ⟨u,hu⟩
  have hinv : f b * (↑u⁻¹ : R) = 1 := by rw [← hu]; exact u.val_inv
  obtain ⟨c,hc⟩ := principal_unit_fourth_power I (f imaginary) hj h2
    (hepi ▸ hpi) (-f q*(↑u⁻¹ : R))
  refine ⟨c, ?_⟩
  have he := congrArg f hq
  simp only [map_sub,uniformizer_seventh,map_mul,map_neg,map_ofNat,map_pow] at he
  rw [hc]
  rw [hepi] at he
  linear_combination he +
    (4*(1+f imaginary)^3*f q) * hinv

theorem signature_unit_coordinates (z : G) (hz : nextDigit z = 1) :
    ∃ k : Fin 64, signature 7 z = signature 7 (unitRepresentative k) := by
  let t := signature 6 (afterDigit z)
  have ht : t < 64 := by simpa [t] using signature_lt 6 (afterDigit z)
  have hs : signature 7 z = 2*t+1 := by
    change (nextDigit z).toNat+2*t = 2*t+1
    rw [hz]
    simp [Nat.add_comm]
  have hc := unitSignatures_complete ⟨t,ht⟩
  change 2*t+1 ∈ (List.range 64).map (fun k => signature 7 (unitRepresentative k)) at hc
  obtain ⟨k,hk,he⟩ := List.mem_map.mp hc
  exact ⟨⟨k,List.mem_range.mp hk⟩, hs.trans he.symm⟩

theorem unitRepresentative_isUnit {R : Type*} [CommRing R]
    (I : Ideal R) [IsAdicComplete I R] (f : G →+* R)
    (h2 : (2:R) ∈ I) (k : ℕ) : IsUnit (f (unitRepresentative k)) := by
  letI := isLocalHom_of_le_jacobson_bot I (IsAdicComplete.le_jacobson_bot I)
  have hi : IsUnit (f imaginary) := by
    apply isUnit_iff_exists_inv.mpr
    refine ⟨f (-imaginary), ?_⟩
    have he : imaginary*(-imaginary) = (1:G) := by decide +kernel
    rw [← map_mul,he,map_one]
  have h2q : (Ideal.Quotient.mk I) (2:R) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h2
  have hu : IsUnit (f (gi 1 2)) := by
    apply IsUnit.of_map (Ideal.Quotient.mk I)
    have he : gi 1 2 = 1+2*imaginary := by decide +kernel
    rw [he,map_add,map_one,map_mul,map_ofNat,map_add,map_one,map_mul,h2q,zero_mul,add_zero]
    exact isUnit_one
  have hv : IsUnit (f (gi 5 0)) := by
    apply IsUnit.of_map (Ideal.Quotient.mk I)
    have he : gi 5 0 = 1+2*(2:G) := by decide +kernel
    rw [he,map_add,map_one,map_mul,map_ofNat,map_add,map_one,map_mul,h2q,zero_mul,add_zero]
    exact isUnit_one
  simpa only [unitRepresentative,map_mul,map_pow] using
    ((hi.pow (k%4)).mul (hu.pow ((k/4)%4))).mul (hv.pow (k/16))

theorem unit_fourth_classes_complete {R : Type*} [CommRing R]
    (I : Ideal R) [IsAdicComplete I R] (f : G →+* R)
    (h2 : (2:R) ∈ I) (hpi : f uniformizer ∈ I)
    (z : G) (hz : nextDigit z = 1) :
    ∃ k : Fin 64, ∃ c : R, f z = f (unitRepresentative k)*c^4 := by
  obtain ⟨k,hk⟩ := signature_unit_coordinates z hz
  exact ⟨k, same_signature_fourth_class I f h2 hpi hk
    (unitRepresentative_isUnit I f h2 k)⟩

end GraphCert.Quartic

/- Source module: GraphCert.PowerResidueCharacter. -/
/-! Power-residue characters obtained from a primitive root in a finite field.
The construction works for composite powers as well as prime powers. -/

namespace GraphCert
open MulChar

theorem exists_power_residue_character {F R : Type*} [Field F] [Fintype F]
    [CommRing R] [IsDomain R] (f : R →+* F) {n : ℕ} (hn : 1<n) {μ : R}
    (hμ : IsPrimitiveRoot μ n) (hμf : IsPrimitiveRoot (f μ) n)
    (hq : Fintype.card F % n = 1) :
    ∃ χ : MulChar F R, orderOf χ = n ∧
      ∀ x, f (χ x) = x ^ ((Fintype.card F-1)/n) := by
  classical
  letI : NeZero n := ⟨by omega⟩
  let d := (Fintype.card F-1)/n
  have hqpos := Fintype.one_lt_card (α := F)
  have hcard : 1+n*(Fintype.card F/n)=Fintype.card F := by
    simpa only [hq] using Nat.mod_add_div (Fintype.card F) n
  have hdivn : n ∣ Fintype.card F-1 := ⟨Fintype.card F/n,by omega⟩
  have hdn : d*n=Fintype.card F-1 := Nat.div_mul_cancel hdivn
  have hd : d≠0 := by intro hz; rw [hz,zero_mul] at hdn; omega
  obtain ⟨g,hg⟩ := IsCyclic.exists_generator (α := Fˣ)
  have hgn : ((g:F)^d)^n=1 := by
    rw [← pow_mul,hdn]
    exact FiniteField.pow_card_sub_one_eq_one _ g.ne_zero
  obtain ⟨k,_,hk⟩ := hμf.eq_pow_of_pow_eq_one hgn
  have hunit : IsUnit (μ^k) := (hμ.isUnit (by omega)).pow k
  let v : Rˣ := hunit.unit
  have hv : (v:R)=μ^k := hunit.unit_spec
  have hvn : v^n=1 := by
    apply Units.ext
    simp only [Units.val_pow_eq_pow_val,Units.val_one,hv,← pow_mul]
    rw [Nat.mul_comm,pow_mul,hμ.pow_eq_one,one_pow]
  have hvq : v ∈ rootsOfUnity (Fintype.card Fˣ) R := by
    apply (mem_rootsOfUnity _ _).mpr
    rw [Fintype.card_units,← hdn,Nat.mul_comm,pow_mul,hvn,one_pow]
  let χ := MulChar.ofRootOfUnity hvq hg
  have hχg : χ (g:F)=v := MulChar.ofRootOfUnity_spec hvq hg
  have hχn : χ^n=1 := by
    apply (MulChar.eq_iff hg _ _).mpr
    simpa only [MulChar.pow_apply_coe,MulChar.one_apply_coe,hχg,
      ← Units.val_pow_eq_pow_val,hvn,Units.val_one]
  have hcomp : χ.ringHomComp f=CubicSpecial.powerChar F d hd := by
    apply (MulChar.eq_iff hg _ _).mpr
    change f (χ (g:F))=(g:F)^d
    rw [hχg,hv,map_pow]
    exact hk
  have he (x:F) : f (χ x)=x^d := DFunLike.congr_fun hcomp x
  refine ⟨χ,?_,he⟩
  apply Nat.dvd_antisymm (orderOf_dvd_of_pow_eq_one hχn)
  have hp : ((g:F)^d)^orderOf χ=1 := by
    rw [← he]
    have h := DFunLike.congr_fun (pow_orderOf_eq_one χ) (g:F)
    simpa only [MulChar.pow_apply_coe,MulChar.one_apply_coe,map_pow,map_one]
      using congrArg f h
  have ho : orderOf g=Fintype.card F-1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg,Nat.card_eq_fintype_card,
      Fintype.card_units]
  have hdiv : d*n ∣ d*orderOf χ := by
    rw [hdn,← ho]
    apply orderOf_dvd_of_pow_eq_one
    apply Units.ext
    simpa only [Units.val_pow_eq_pow_val,Units.val_one,pow_mul] using hp
  exact (Nat.mul_dvd_mul_iff_left (Nat.pos_of_ne_zero hd)).mp hdiv

end GraphCert

/- Source module: GraphCert.QuarticCore. -/
/-! Elementary Gauss and Jacobi sum foundations for quartic reciprocity. -/

namespace GraphCert.Quartic
open MulChar AddChar

theorem gauss_fourth {F R : Type*} [Field F] [Fintype F]
    [CommRing R] [IsDomain R] {χ : MulChar F R} {ψ : AddChar F R}
    (hχ : orderOf χ=4) (hψ : ψ.IsPrimitive) :
    gaussSum χ ψ^4=Fintype.card F*jacobiSum χ χ^2 := by
  have hfour : χ^4=1 := hχ ▸ pow_orderOf_eq_one χ
  have htwo : χ^2≠1 := pow_ne_one_of_lt_orderOf (by decide) (by omega)
  have hquad : (χ^2).IsQuadratic := by
    apply MulChar.isQuadratic_iff_sq_eq_one.mpr
    simpa only [← pow_mul] using hfour
  have hneg : (χ^2) (-1)=1 := by
    rw [pow_two,MulChar.mul_apply,← map_mul]
    simp
  have hs := gaussSum_sq htwo hquad hψ
  rw [hneg,one_mul] at hs
  have hj := jacobiSum_mul_nontrivial (χ:=χ) (φ:=χ)
    (by simpa only [pow_two] using htwo) ψ
  calc
    gaussSum χ ψ^4=(gaussSum (χ^2) ψ*jacobiSum χ χ)^2 := by
      rw [pow_two χ,hj]
      ring
    _=Fintype.card F*jacobiSum χ χ^2 := by rw [mul_pow,hs]

theorem imaginary_primitive : IsPrimitiveRoot imaginary 4 := by
  apply IsPrimitiveRoot.mk_of_lt
  · decide
  · decide
  · intro k hk hk4
    interval_cases k <;> decide

theorem star_imaginary : star imaginary=imaginary^3 := by decide

theorem quartic_char_star {F : Type*} [Field F] [Fintype F]
    {χ : MulChar F G} (hχ : orderOf χ=4) :
    χ.ringHomComp (starRingEnd G)=χ⁻¹ := by
  have hc : χ^4=1 := hχ ▸ pow_orderOf_eq_one χ
  have hi : χ⁻¹=χ^3 := by
    apply inv_eq_of_mul_eq_one_right
    rw [← pow_succ']
    exact hc
  rw [hi]
  apply MulChar.ext
  intro x
  obtain ⟨k,_,hk⟩ := MulChar.exists_apply_eq_pow hc imaginary_primitive x.ne_zero
  simp only [MulChar.ringHomComp_apply,starRingEnd_apply,
    MulChar.pow_apply_coe,hk,star_pow,star_imaginary,← pow_mul]
  rw [Nat.mul_comm]

theorem jacobi_mul_star {F : Type*} [Field F] [Fintype F]
    {χ : MulChar F G} (hχ : orderOf χ=4) :
    jacobiSum χ χ*star (jacobiSum χ χ)=(Fintype.card F:G) := by
  let K := FractionRing G
  let f := algebraMap G K
  have hf : Function.Injective f := IsFractionRing.injective G K
  have hn : χ≠1 := by intro h; simp [h] at hχ
  have hnn : χ*χ≠1 := by
    rw [← pow_two]
    exact pow_ne_one_of_lt_orderOf (by decide) (by omega)
  have hchar : ringChar K≠ringChar F := by
    obtain ⟨n,hp,_⟩ := FiniteField.card F (ringChar F)
    rw [ringChar.eq_zero]
    exact hp.ne_zero.symm
  have h := jacobiSum_mul_jacobiSum_inv hchar
    ((MulChar.ringHomComp_ne_one_iff hf).mpr hn)
    ((MulChar.ringHomComp_ne_one_iff hf).mpr hn)
    (χ:=χ.ringHomComp f) (φ:=χ.ringHomComp f)
    (by rw [← MulChar.ringHomComp_mul]; exact (MulChar.ringHomComp_ne_one_iff hf).mpr hnn)
  have hs : star (jacobiSum χ χ)=jacobiSum χ⁻¹ χ⁻¹ := by
    rw [← quartic_char_star hχ,jacobiSum_ringHomComp]
    rfl
  rw [hs]
  apply hf
  simpa only [map_mul,map_natCast,← jacobiSum_ringHomComp,
    MulChar.ringHomComp_inv] using h

end GraphCert.Quartic

/- Source module: GraphCert.QuarticPrimeCharacter. -/
/-! Gaussian prime residue fields and their fourth-power characters. -/

namespace GraphCert.Quartic

def gaussianQuadratic : G ≃ₐ[ℤ] QuadraticAlgebra ℤ (-1) 0 where
  toFun z := ⟨z.re,z.im⟩
  invFun z := gi z.re z.im
  left_inv z := by cases z; rfl
  right_inv z := by cases z; rfl
  map_add' z w := by ext <;> rfl
  map_mul' z w := by
    ext <;> simp [Zsqrtd.re_mul,Zsqrtd.im_mul]
  commutes' z := by rfl

instance : Module.Finite ℤ G := Module.Finite.equiv gaussianQuadratic.toLinearEquiv.symm
instance : Module.Free ℤ G := Module.Free.of_equiv gaussianQuadratic.toLinearEquiv.symm

theorem algebra_norm (z:G) : Algebra.norm ℤ z=Zsqrtd.norm z := by
  rw [← Algebra.norm_eq_of_algEquiv gaussianQuadratic,Algebra.norm_apply]
  change LinearMap.det (DistribSMul.toLinearMap ℤ (QuadraticAlgebra ℤ (-1) 0)
    (gaussianQuadratic z))=Zsqrtd.norm z
  rw [QuadraticAlgebra.det_toLinearMap_eq_norm]
  change z.re*z.re+0*z.re*z.im-(-1)*z.im*z.im=Zsqrtd.norm z
  simp [Zsqrtd.norm]

abbrev Residue (π:G) := G ⧸ Ideal.span {π}

theorem residue_card (π:G) : Nat.card (Residue π)=(Zsqrtd.norm π).natAbs := by
  rw [← Submodule.cardQuot_apply,← Ideal.absNorm_apply,Ideal.absNorm_span_singleton,
    algebra_norm]

noncomputable instance residue_field (π:G) [hπ:Fact (Prime π)] : Field (Residue π) := by
  have hm : (Ideal.span {π}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hπ.out.irreducible
  exact Ideal.Quotient.field (Ideal.span {π})

instance residue_finite (π:G) [hπ:Fact (Prime π)] : Finite (Residue π) := by
  apply Nat.finite_of_card_ne_zero
  rw [residue_card,Int.natAbs_ne_zero]
  exact fun h => hπ.out.ne_zero (GaussianInt.norm_eq_zero.mp h)

noncomputable instance residue_fintype (π:G) [Fact (Prime π)] : Fintype (Residue π) :=
  Fintype.ofFinite _

def reduction (π:G) : G →+* Residue π := Ideal.Quotient.mk (Ideal.span {π})

theorem reduction_zero (π z:G) : reduction π z=0 ↔ π∣z := by
  rw [reduction,Ideal.Quotient.eq_zero_iff_mem,Ideal.mem_span_singleton]

theorem residue_imaginary_primitive (π:G) [Fact (Prime π)] (h2:¬π∣2) :
    IsPrimitiveRoot (reduction π imaginary) 4 := by
  have hpow : (reduction π imaginary)^4=1 := by
    rw [← map_pow,imaginary_primitive.pow_eq_one,map_one]
  have hneg : (-1:Residue π)≠1 := by
    intro h
    apply h2
    apply (reduction_zero π 2).mp
    have : (2:Residue π)=0 := by linear_combination -h
    simpa only [map_ofNat] using this
  have hs : (reduction π imaginary)^2=-1 := by
    rw [← map_pow,show imaginary^2=(-1:G) by decide,map_neg,map_one]
  apply IsPrimitiveRoot.mk_of_lt _ (by decide) hpow
  intro k hk hk4
  interval_cases k
  · intro h; simp only [pow_one] at h; rw [h,one_pow] at hs; exact hneg hs.symm
  · simpa only [hs] using hneg
  · intro h
    have hh : reduction π imaginary=1 := by
      calc reduction π imaginary = (reduction π imaginary)^4 := by
             rw [pow_succ,h,one_mul]
           _=1 := hpow
    rw [hh,one_pow] at hs
    exact hneg hs.symm

theorem exists_prime_character (π:G) [Fact (Prime π)] (h2:¬π∣2) :
    ∃ χ:MulChar (Residue π) G, orderOf χ=4 ∧
      ∀ x, reduction π (χ x)=x^((Fintype.card (Residue π)-1)/4) := by
  have hi := residue_imaginary_primitive π h2
  have hd : 4∣Fintype.card (Residue π)-1 := hi.dvd_of_pow_eq_one _
    (FiniteField.pow_card_sub_one_eq_one _ (hi.ne_zero (by decide)))
  apply GraphCert.exists_power_residue_character (reduction π) (by decide)
    imaginary_primitive hi
  have := Fintype.one_lt_card (α:=Residue π)
  omega

end GraphCert.Quartic

/- Source module: GraphCert.QuarticJacobi. -/
/-! Finite-field identities for fourth-power residue characters. -/

namespace GraphCert.Quartic
open MulChar AddChar

theorem gauss_frobenius_quartic {F R : Type*} [CommRing F] [Fintype F]
    [CommRing R] (p n : ℕ) [Fact p.Prime] [CharP R p]
    {χ : MulChar F R} (ψ : AddChar F R) (hχ : orderOf χ=4)
    (hn : p^n%4=1) (hp : IsUnit ((p:F)^n)) :
    gaussSum χ ψ^(p^n)=χ ((p:F)^n)^3*gaussSum χ ψ := by
  have hpow : χ^(p^n)=χ := by
    rw [← pow_mod_orderOf,hχ,hn,pow_one]
  have hinv : χ⁻¹=χ^3 := by
    apply inv_eq_of_mul_eq_one_right
    rw [← pow_succ']
    simpa only [hχ] using pow_orderOf_eq_one χ
  rw [CubicSpecial.gauss_frobenius_iter,hpow,pow_mulShift]
  rw [Nat.cast_pow,← hp.unit_spec,gaussSum_mulShift_eq,hinv,pow_apply_coe]

theorem jacobi_power {F R : Type*} [Field F] [Fintype F]
    [Field R] (p n : ℕ) [Fact p.Prime] [CharP R p]
    {χ : MulChar F R} {ψ : AddChar F R} (hχ : orderOf χ=4)
    (hψ : ψ.IsPrimitive) (hn : p^n%4=1)
    (hp : IsUnit ((p:F)^n)) (hc : (Fintype.card F:R)≠0) :
    (Fintype.card F*jacobiSum χ χ^2)^((p^n-1)/4)=χ ((p:F)^n)^3 := by
  have hχ0 : χ≠1 := by intro h; simp [h] at hχ
  have hg : gaussSum χ ψ≠0 := gaussSum_ne_zero_of_nontrivial hc hχ0 hψ
  have he : 4*((p^n-1)/4)+1=p^n := by omega
  apply mul_right_cancel₀ hg
  rw [← gauss_fourth hχ hψ,← pow_mul,← pow_succ,he]
  exact gauss_frobenius_quartic p n ψ hχ hn hp

theorem jacobi_quartic_residue {F E : Type*} [Field F] [Fintype F]
    [Field E] [Fintype E] {χ : MulChar F E} (hχ : orderOf χ=4)
    (hchar : ringChar E≠ringChar F) (hcard : Fintype.card E%4=1) :
    (Fintype.card F*jacobiSum χ χ^2)^((Fintype.card E-1)/4)=
      χ (Fintype.card E)^3 := by
  let ψ := FiniteField.primitiveChar F E hchar
  let L := CyclotomicField ψ.n E
  let ι : E →+* L := algebraMap E L
  let χ' := χ.ringHomComp ι
  have hχ' : orderOf χ'=4 :=
    (orderOf_injective (ringHomCompHom ι) (injective_ringHomComp ι.injective) χ).trans hχ
  obtain ⟨n,hp,hc⟩ := FiniteField.card E (ringChar E)
  have hpFact : Fact (ringChar E).Prime := ⟨hp⟩
  have hL : ringChar L=ringChar E := (Algebra.ringChar_eq E L).symm
  have hCharPL : CharP L (ringChar E) :=
    hL ▸ (inferInstance : CharP L (ringChar L))
