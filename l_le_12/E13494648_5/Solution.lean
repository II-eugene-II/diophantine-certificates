def dyadicBilinear : ClassVector→ₗ[ZMod 4]ClassVector→ₗ[ZMod 4]ZMod 4 where
  toFun a:={
    toFun:=dyadicPair a
    map_add' b c:=dyadicPair_add_right a b c
    map_smul' c b:=by
      simp only [dyadicPair,Pi.smul_apply,smul_eq_mul,RingHom.id_apply,Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      ring }
  map_add' a b:=by apply LinearMap.ext; intro c; exact dyadicPair_add_left a b c
  map_smul' c a:=by
    apply LinearMap.ext
    intro b
    simp only [LinearMap.coe_mk,AddHom.coe_mk,LinearMap.smul_apply,dyadicPair,
      Pi.smul_apply,smul_eq_mul,RingHom.id_apply,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring

def tamePair (epsilon:ZMod 4) (a b:Fin 2→ZMod 4) : ZMod 4 :=
  a 0*b 1-a 1*b 0+epsilon*a 0*b 0

def tameBilinear (epsilon:ZMod 4) :
    (Fin 2→ZMod 4)→ₗ[ZMod 4](Fin 2→ZMod 4)→ₗ[ZMod 4]ZMod 4 where
  toFun a:={
    toFun:=tamePair epsilon a
    map_add' b c:=by simp [tamePair]; ring
    map_smul' c b:=by simp [tamePair]; ring }
  map_add' a b:=by ext c; simp [tamePair]; ring
  map_smul' c a:=by ext b; simp [tamePair]; ring

theorem tamePair_skew (epsilon:ZMod 4) (he:2*epsilon=0) (a b:Fin 2→ZMod 4) :
