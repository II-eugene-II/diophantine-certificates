  by_cases hv:v<7
  · obtain ⟨k,hk⟩ := unit_representative hu
    have hcomp:uniformizer^7∣(1-a)-(1-uniformizer^v*representative 7 (2*k.val+1)) := by
      rw [he]
      convert dvd_mul_of_dvd_right hk (-uniformizer^v) using 1 <;> ring
    rw [wildVec_congr v hk,wildVec_congr 0 hcomp]
    exact wild_ramified_table ⟨v,hv⟩ (by intro h; exact hne (congrArg Fin.val h)) k
  · have hd7:uniformizer^7∣a := by
      rw [he]
      exact dvd_mul_of_dvd_left (pow_dvd_pow _ (by omega)) _
    have hc:uniformizer^7∣(1-a)-1 := by simpa using dvd_neg.mpr hd7
    rw [wildVec_congr 0 hc]
