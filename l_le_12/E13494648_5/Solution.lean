    MulChar (Residue π) G := (exists_prime_character π h2).choose

theorem primeCharacter_spec (π:G) [Fact (Prime π)] (h2:¬π∣2) :
    orderOf (primeCharacter π h2)=4 ∧
      ∀ x,reduction π (primeCharacter π h2 x)=x^((Fintype.card (Residue π)-1)/4) :=
