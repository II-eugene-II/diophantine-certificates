    (hp:(2:G)∣π-1) : jacobiSum (primeCharacter π h2) (primeCharacter π h2)^2=π^2 :=
  jacobi_square (reduction π) π hp (residue_norm π) (reduction_zero π)
    (residue_card_mod_four π h2) (primeCharacter_spec π h2).1 (primeCharacter_spec π h2).2

