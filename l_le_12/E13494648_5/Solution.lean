  let u:=primeUnit uniformizer a
  have hu:¬uniformizer∣u := (primeUnit_spec uniformizer ha).2
  have hne:v≠0 := (multiplicity_ne_zero (FiniteMultiplicity.of_prime_left uniformizer_prime ha)).mpr hd
  have he:a=uniformizer^v*u := (primeUnit_spec uniformizer ha).1
  unfold wild
  rw [wildClass_of_not_dvd hb]
