/-! Finite arithmetic underlying the dyadic quartic table.  This file does
not identify the table with a local Hilbert symbol: that separate comparison
requires normalized reciprocity and a fourth-power Hensel theorem. -/
namespace GraphCert.Quartic

def signature : ℕ → G → ℕ
  | 0, _ => 0
  | k + 1, z =>
    let digit := (z.re + z.im) % 2
    digit.toNat + 2 * signature k (gi ((z.re + z.im - digit) / 2)
      ((z.im - z.re + digit) / 2))

def representative : ℕ → ℕ → G
  | 0, _ => 0
  | k + 1, bits => (if bits % 2 = 1 then 1 else 0) +
      uniformizer * representative k (bits / 2)

def unitRepresentative (k : ℕ) : G :=
  imaginary^(k%4) * (gi 1 2)^((k/4)%4) * (gi 5 0)^(k/16)

def unitSignatures : List ℕ :=
  (List.range 64).map fun k => signature 7 (unitRepresentative k)

theorem unitSignatures_complete : ∀ k : Fin 64,
    2*k.val+1 ∈ unitSignatures := by decide +kernel

theorem unitSignatures_unique : unitSignatures.Nodup := by decide +kernel

theorem representatives_roundtrip : ∀ k : Fin 128,
    signature 7 (representative 7 k.val) = k.val := by decide +kernel

theorem unit_fourth_residues : ∀ k : Fin 64,
    signature 7 ((representative 7 (2*k.val+1))^4) = 1 := by decide +kernel

/-- The polynomial used for Hensel lifting in the principal-unit group. -/
def henselPolynomial (t : G) : G :=
  t + gi (-3) 3*t^2 + gi 0 (-8)*t^3 + gi 4 4*t^4

theorem principal_unit_identity (t : G) :
    (1 + uniformizer^3*t)^4 = 1 + 4*uniformizer^3*henselPolynomial t := by
  rcases t with ⟨a,b⟩
  apply Zsqrtd.ext <;>
    norm_num [uniformizer, gi, henselPolynomial, pow_succ, Zsqrtd.re_mul,
      Zsqrtd.im_mul, Zsqrtd.re_add, Zsqrtd.im_add] <;> ring

abbrev ClassVector := Fin 4 → ZMod 4

def dyadicMatrix : Matrix (Fin 4) (Fin 4) (ZMod 4) :=
  !![0,0,3,1; 0,0,1,2; 1,3,2,0; 3,2,0,0]

theorem dyadicMatrix_skew (i j : Fin 4) : dyadicMatrix i j = -dyadicMatrix j i := by
  fin_cases i <;> fin_cases j <;> decide

def dyadicPair (a b : ClassVector) : ZMod 4 :=
  ∑ i, ∑ j, a i * dyadicMatrix i j * b j

theorem dyadicPair_add_left (a b c : ClassVector) :
    dyadicPair (a+b) c = dyadicPair a c + dyadicPair b c := by
  simp [dyadicPair, add_mul, Finset.sum_add_distrib]

theorem dyadicPair_add_right (a b c : ClassVector) :
    dyadicPair a (b+c) = dyadicPair a b + dyadicPair a c := by
  simp [dyadicPair, mul_add, Finset.sum_add_distrib]

theorem dyadicPair_skew (a b : ClassVector) : dyadicPair a b = -dyadicPair b a := by
  unfold dyadicPair
  rw [Finset.sum_comm]
  simp only [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [dyadicMatrix_skew j i]
  ring

end GraphCert.Quartic

