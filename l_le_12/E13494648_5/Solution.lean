    QuarticValue (quarticSymbol π h2 a) := char_quartic_value (primeCharacter_spec π h2).1 _

theorem quarticSymbol_eq_zero (π:G) [Fact (Prime π)] (h2:¬π∣2) (a:G) :
    quarticSymbol π h2 a=0 ↔ π∣a := by
  rw [quarticSymbol,MulChar.apply_eq_zero_iff]
