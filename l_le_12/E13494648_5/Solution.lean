    apply induction_away_uniformizer (P := fun b => B.val π b=0)
      (fun u hu => B.unit_right hw hπ.ne_zero hu)
      (fun ρ hρ hρprimary => hp π ρ hπ hρ hπprimary hρprimary) ?_ b hb
    intro c d hc hd hBc hBd
    rw [B.mul_right _ _ _ hπ.ne_zero (nonzero_of_not_uniformizer_dvd hc)
      (nonzero_of_not_uniformizer_dvd hd), hBc,hBd,add_zero]
