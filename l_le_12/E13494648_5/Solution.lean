namespace GraphCert.Quartic

theorem uniformizer_prime : Prime uniformizer := by
  exact prime_of_norm_prime (by decide)

theorem uniformizer_dvd_iff (z:G) : uniformizer∣z ↔ (2:ℤ)∣z.re+z.im := by
  constructor
  · rintro ⟨w,rfl⟩
    refine ⟨w.re,?_⟩
    simp [uniformizer,gi,Zsqrtd.re_mul,Zsqrtd.im_mul]
    ring
  · rintro ⟨k,hk⟩
    refine ⟨gi k (z.im-k),?_⟩
    ext <;> simp [uniformizer,gi,Zsqrtd.re_mul,Zsqrtd.im_mul] <;> omega

theorem primary_iff_cube (z:G) : Primary z ↔ uniformizer^3∣z-1 := by
  constructor
  · rintro ⟨ha,hb,hab⟩
    have hdiv : (z.re+z.im-1)%4=0 := by omega
    have hdiv' : (z.re-z.im-1)%4=0 := by omega
    refine ⟨gi ((z.im-z.re+1)/4) ((1-z.re-z.im)/4),?_⟩
    ext <;> norm_num [uniformizer,gi,pow_succ,Zsqrtd.re_mul,Zsqrtd.im_mul]
    all_goals omega
  · rintro ⟨w,hw⟩
    have hr := congrArg Zsqrtd.re hw
    have hi := congrArg Zsqrtd.im hw
    norm_num [uniformizer,gi,pow_succ,Zsqrtd.re_mul,Zsqrtd.im_mul] at hr hi
    unfold Primary
    omega

theorem primary_not_uniformizer_dvd {z:G} (hz:Primary z) : ¬uniformizer∣z := by
  rw [uniformizer_dvd_iff,Int.dvd_iff_emod_eq_zero]
  obtain ⟨ha,hb,_⟩ := hz
  omega

theorem exists_primary_associate {z:G} (hz:¬uniformizer∣z) :
    ∃ w:G,Associated z w ∧ Primary w := by
  rw [uniformizer_dvd_iff,Int.dvd_iff_emod_eq_zero] at hz
  have hunit := imaginary_primitive.isUnit (by decide : 4≠0)
  have h0 : 0≤z.re%4 := Int.emod_nonneg _ (by decide)
  have h1 : z.re%4<4 := Int.emod_lt_of_pos _ (by decide)
  have h2 : 0≤z.im%4 := Int.emod_nonneg _ (by decide)
  have h3 : z.im%4<4 := Int.emod_lt_of_pos _ (by decide)
  interval_cases hr : z.re%4 <;> interval_cases hi : z.im%4
  all_goals first | omega | skip
  all_goals first
    | (refine ⟨z,Associated.refl _,?_⟩; unfold Primary; omega)
    | (refine ⟨imaginary*z,associated_unit_mul_right z imaginary hunit,?_⟩
       unfold Primary; norm_num [imaginary,gi,Zsqrtd.re_mul,Zsqrtd.im_mul]; omega)
    | (refine ⟨imaginary^2*z,associated_unit_mul_right z (imaginary^2) (hunit.pow 2),?_⟩
       unfold Primary; norm_num [imaginary,gi,pow_succ,Zsqrtd.re_mul,Zsqrtd.im_mul]; omega)
    | (refine ⟨imaginary^3*z,associated_unit_mul_right z (imaginary^3) (hunit.pow 3),?_⟩
       unfold Primary; norm_num [imaginary,gi,pow_succ,Zsqrtd.re_mul,Zsqrtd.im_mul]; omega)

theorem not_uniformizer_dvd_unit {z:G} (hz:IsUnit z) : ¬uniformizer∣z :=
  fun h => uniformizer_prime.not_unit (isUnit_of_dvd_unit h hz)

theorem nonzero_of_not_uniformizer_dvd {z:G} (hz:¬uniformizer∣z) : z≠0 := by
  intro h; exact hz (h ▸ dvd_zero _)

theorem induction_away_uniformizer {P:G→Prop}
    (hu:∀a,IsUnit a→P a) (hp:∀a,Prime a→Primary a→P a)
    (hm:∀a b,¬uniformizer∣a→¬uniformizer∣b→P a→P b→P (a*b))
    (a:G) (ha:¬uniformizer∣a) : P a := by
  apply UniqueFactorizationMonoid.induction_on_prime (P:=fun z=>¬uniformizer∣z→P z) a ?_ ?_ ?_ ha
  · exact fun h => False.elim (h (dvd_zero _))
  · intro u hu' _; exact hu u hu'
  · intro b p hb hprime ih hnot
    have hnp : ¬uniformizer∣p := fun h => hnot (dvd_mul_of_dvd_left h b)
    have hnb : ¬uniformizer∣b := fun h => hnot (dvd_mul_of_dvd_right h p)
    obtain ⟨q,hpq,hq⟩ := exists_primary_associate hnp
    have hqprime : Prime q := hpq.prime hprime
    obtain ⟨u,huq⟩ := hpq.symm
    have hpp : P p := by
      rw [← huq]
      exact hm q u (primary_not_uniformizer_dvd hq) (not_uniformizer_dvd_unit u.isUnit)
        (hp q hqprime hq) (hu u u.isUnit)
    exact hm p b hnp hnb hpp (ih hnb)

theorem induction_uniformizer_primary {P:G→Prop}
    (hu:∀a,IsUnit a→P a) (hl:P uniformizer) (hp:∀a,Prime a→Primary a→P a)
    (hm:∀a b,a≠0→b≠0→P a→P b→P (a*b)) (a:G) (ha:a≠0) : P a := by
  apply UniqueFactorizationMonoid.induction_on_prime (P:=fun z=>z≠0→P z) a ?_ ?_ ?_ ha
  · exact fun h => False.elim (h rfl)
  · intro u hu' _; exact hu u hu'
  · intro b p hb hprime ih hnot
    have hpp : P p := by
      by_cases hld:uniformizer∣p
      · obtain ⟨u,huq⟩ := uniformizer_prime.associated_of_dvd hprime hld
        rw [← huq]
        exact hm uniformizer u uniformizer_prime.ne_zero u.ne_zero hl (hu u u.isUnit)
      · obtain ⟨q,hpq,hq⟩ := exists_primary_associate hld
        have hqprime := hpq.prime hprime
        obtain ⟨u,huq⟩ := hpq.symm
        rw [← huq]
        exact hm q u hqprime.ne_zero u.ne_zero (hp q hqprime hq) (hu u u.isUnit)
    exact hm p b hprime.ne_zero hb hpp (ih hb)

end GraphCert.Quartic

