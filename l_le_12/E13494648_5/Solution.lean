    quarticSymbol π h2 (a*b)=quarticSymbol π h2 a*quarticSymbol π h2 b := by
  simp [quarticSymbol,map_mul]

theorem quarticSymbol_pow (π:G) [Fact (Prime π)] (h2:¬π∣2) (a:G) (n:ℕ) :
    quarticSymbol π h2 (a^n)=quarticSymbol π h2 a^n := by
  simp [quarticSymbol,map_pow]

