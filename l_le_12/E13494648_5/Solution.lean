instance uniformizer_fact : Fact (Prime uniformizer) := ⟨uniformizer_prime⟩

theorem unit_representative {z:G} (hz:¬uniformizer∣z) :
    ∃k:Fin 64,uniformizer^7∣z-representative 7 (2*k.val+1) := by
  have hd:nextDigit z=1 := by
    rw [uniformizer_dvd_iff,Int.dvd_iff_emod_eq_zero] at hz
    unfold nextDigit
    omega
  let k:=signature 6 (afterDigit z)
  have hk:k<64 := by simpa [k] using signature_lt 6 (afterDigit z)
  refine ⟨⟨k,hk⟩,?_⟩
  have hs:signature 7 z=2*k+1 := by
    change (nextDigit z).toNat+2*k=2*k+1
    rw [hd]; omega
  obtain ⟨w,hw⟩ := signature_represents 7 z
  exact ⟨w,by rw [hw,hs]; ring⟩

theorem unitLog_mul {a b:G} (ha:¬uniformizer∣a) (hb:¬uniformizer∣b) :
    unitLog (a*b)=unitLog a+unitLog b := by
  obtain ⟨i,hi⟩ := unit_representative ha
  obtain ⟨j,hj⟩ := unit_representative hb
  have hprod:uniformizer^7∣a*b-
      representative 7 (2*i.val+1)*representative 7 (2*j.val+1) := by
    convert dvd_add (dvd_mul_of_dvd_left hi b)
      (dvd_mul_of_dvd_right hj (representative 7 (2*i.val+1))) using 1 <;> ring
  rw [unitLog_congr hprod,unitLog_congr hi,unitLog_congr hj]
  exact unitLog_mul_table i j

noncomputable def wildClass (a:G) : ClassVector :=
