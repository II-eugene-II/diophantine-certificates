noncomputable def primeUnit (π : G) [hp : Fact (Prime π)] (a : G) :
    G := if ha : a=0 then 0 else
      (FiniteMultiplicity.of_prime_left hp.out ha).exists_eq_pow_mul_and_not_dvd.choose

theorem primeUnit_spec (π : G) [hp : Fact (Prime π)] {a : G} (ha : a≠0) :
    a = π^multiplicity π a * primeUnit π a ∧ ¬π ∣ primeUnit π a := by
  simpa only [primeUnit, dif_neg ha] using
    (FiniteMultiplicity.of_prime_left hp.out ha).exists_eq_pow_mul_and_not_dvd.choose_spec

theorem primeUnit_nonzero (π : G) [Fact (Prime π)] {a : G} (ha : a≠0) :
    primeUnit π a≠0 := by
  intro h
  have h' := (primeUnit_spec π ha).1
  rw [h,mul_zero] at h'
  exact ha h'

theorem primeUnit_of_not_dvd (π : G) [Fact (Prime π)] {a : G}
    (ha : ¬π ∣ a) : primeUnit π a=a := by
  have hne : a≠0 := fun h => ha (h ▸ dvd_zero _)
  have h := (primeUnit_spec π hne).1
  rw [multiplicity_eq_zero_of_not_dvd ha, pow_zero,one_mul] at h
  exact h.symm

theorem primeUnit_mul (π : G) [hp : Fact (Prime π)] {a b : G}
    (ha : a≠0) (hb : b≠0) : primeUnit π (a*b)=primeUnit π a * primeUnit π b := by
  have hv := multiplicity_mul hp.out (FiniteMultiplicity.of_prime_left hp.out (mul_ne_zero ha hb))
  apply mul_left_cancel₀ (pow_ne_zero (multiplicity π (a*b)) hp.out.ne_zero)
  calc π^multiplicity π (a*b) * primeUnit π (a*b) = a*b := (primeUnit_spec π (mul_ne_zero ha hb)).1.symm
    _ = (π^multiplicity π a * primeUnit π a)*(π^multiplicity π b*primeUnit π b) :=
      congrArg₂ (·*·) (primeUnit_spec π ha).1 (primeUnit_spec π hb).1
    _ = π^multiplicity π (a*b)*(primeUnit π a*primeUnit π b) := by rw [hv,pow_add]; ring

def logImaginary (a : G) : ZMod 4 := if a=1 then 0 else if a=imaginary then 1 else if a = -1 then 2 else 3

theorem logImaginary_mul {a b : G} (ha : a^4=1) (hb : b^4=1) :
    logImaginary (a*b)=logImaginary a+logImaginary b := by
  obtain ⟨i,hi,rfl⟩ := imaginary_primitive.eq_pow_of_pow_eq_one ha
  obtain ⟨j,hj,rfl⟩ := imaginary_primitive.eq_pow_of_pow_eq_one hb
  interval_cases i <;> interval_cases j <;> decide +kernel

theorem logImaginary_one : logImaginary 1=0 := by decide

noncomputable def quarticLog (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2) (a : G) : ZMod 4 :=
  logImaginary (quarticSymbol π h2 a)

theorem quarticLog_mul (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2)
    {a b : G} (ha : ¬π ∣ a) (hb : ¬π ∣ b) :
    quarticLog π h2 (a*b) = quarticLog π h2 a+quarticLog π h2 b := by
  exact (congrArg logImaginary (quarticSymbol_mul π h2 a b)).trans
    (logImaginary_mul (quarticSymbol_fourth π h2 ha) (quarticSymbol_fourth π h2 hb))

theorem quarticLog_one (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2) :
    quarticLog π h2 1=0 := by
  simp only [quarticLog,quarticSymbol,map_one,logImaginary_one]

theorem quarticLog_congr (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2)
    {a b : G} (h : reduction π a = reduction π b) :
    quarticLog π h2 a = quarticLog π h2 b := by
  simp only [quarticLog,quarticSymbol,h]

noncomputable def tame (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2)
    (a b : G) : ZMod 4 :=
  multiplicity π a * quarticLog π h2 (primeUnit π b) -
    multiplicity π b * quarticLog π h2 (primeUnit π a) +
    multiplicity π a * multiplicity π b * quarticLog π h2 (-1)

theorem quarticLog_neg_one_twice (π:G) [Fact (Prime π)] (h2:¬π∣2) :
    2*quarticLog π h2 (-1)=0 := by
  have hn:¬π∣(-1:G) := fun h => (Fact.out : Prime π).not_unit (isUnit_of_dvd_unit h isUnit_neg_one)
  have h := quarticLog_mul π h2 hn hn
  rw [neg_one_mul,neg_neg,quarticLog_one] at h
  linear_combination -h

theorem tame_skew (π:G) [Fact (Prime π)] (h2:¬π∣2) (a b:G) :
    tame π h2 a b = -tame π h2 b a := by
  unfold tame
  linear_combination (multiplicity π a:ZMod 4)*multiplicity π b*quarticLog_neg_one_twice π h2

theorem tame_mul_left (π : G) [hp : Fact (Prime π)] (h2 : ¬π ∣ 2)
    {a b c : G} (ha : a≠0) (hb : b≠0) (hc : c≠0) :
    tame π h2 (a*b) c=tame π h2 a c+tame π h2 b c := by
  unfold tame
  rw [multiplicity_mul hp.out (FiniteMultiplicity.of_prime_left hp.out (mul_ne_zero ha hb)),
    primeUnit_mul π ha hb,
    quarticLog_mul π h2 (primeUnit_spec π ha).2 (primeUnit_spec π hb).2]
  push_cast
  ring

theorem tame_of_not_dvd (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2)
    {a b : G} (ha : ¬π ∣ a) (hb : ¬π ∣ b) : tame π h2 a b=0 := by
  simp only [tame,multiplicity_eq_zero_of_not_dvd ha,multiplicity_eq_zero_of_not_dvd hb,
    Nat.cast_zero,zero_mul,sub_zero,mul_zero,add_zero]

theorem tame_steinberg (π : G) [hp : Fact (Prime π)] (h2 : ¬π ∣ 2)
    (a : G) : tame π h2 a (1-a)=0 := by
  have hnotboth : ¬(π ∣ a ∧ π ∣ 1-a) := by
    rintro ⟨ha,hb⟩
    have h := dvd_add ha hb
    have hd : π ∣ (1 : G) := by convert h using 1 <;> ring
    exact hp.out.not_unit (isUnit_of_dvd_one hd)
  by_cases ha : π ∣ a
  · have hb : ¬π ∣ 1-a := fun h => hnotboth ⟨ha,h⟩
    have hlog : quarticLog π h2 (1-a)=0 := by
      rw [quarticLog_congr π h2 (b := 1) (by
        rw [map_sub, (reduction_zero π a).mpr ha,sub_zero]), quarticLog_one]
    simp only [tame,multiplicity_eq_zero_of_not_dvd hb,primeUnit_of_not_dvd π hb,
      hlog,mul_zero,Nat.cast_zero,zero_mul,sub_zero,mul_zero,add_zero]
  · by_cases hb : π ∣ 1-a
    · have hlog : quarticLog π h2 a=0 := by
        apply (quarticLog_congr π h2 (b := 1) ?_).trans (quarticLog_one π h2)
        have h := (reduction_zero π (1-a)).mpr hb
        rw [map_sub,sub_eq_zero] at h
        exact h.symm
      simp only [tame,multiplicity_eq_zero_of_not_dvd ha,primeUnit_of_not_dvd π ha,
        hlog,mul_zero,Nat.cast_zero,zero_mul,sub_zero,mul_zero,add_zero]
    · exact tame_of_not_dvd π h2 ha hb


theorem tame_self (π:G) [hp:Fact (Prime π)] (h2:¬π∣2) (a:G) :
    tame π h2 a a=tame π h2 a (-1) := by
  have hn:¬π∣(-1:G) := fun h => hp.out.not_unit (isUnit_of_dvd_unit h isUnit_neg_one)
  simp only [tame,multiplicity_eq_zero_of_not_dvd hn,primeUnit_of_not_dvd π hn,
    Nat.cast_zero,zero_mul,mul_zero,sub_zero,add_zero,sub_self,zero_add]
  have ht := quarticLog_neg_one_twice π h2
  have hv : ∀v z:ZMod 4, 2*z=0 → v*v*z=v*z := by decide +kernel
  exact hv _ _ ht

