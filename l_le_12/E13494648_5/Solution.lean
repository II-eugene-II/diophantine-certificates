theorem primeUnit_factorization (π : G) [hp : Fact (Prime π)]
    (e : ℕ) {a u : G} (he : a=π^e*u) (hu : ¬π ∣ u) :
    multiplicity π a=e ∧ primeUnit π a=u := by
  have hun : u≠0 := fun h => hu (h ▸ dvd_zero _)
  have han : a≠0 := by rw [he]; exact mul_ne_zero (pow_ne_zero e hp.out.ne_zero) hun
  have hv : multiplicity π a=e := by
    rw [he,multiplicity_mul hp.out (FiniteMultiplicity.of_prime_left hp.out
      (mul_ne_zero (pow_ne_zero e hp.out.ne_zero) hun)),
      multiplicity_pow_self_of_prime hp.out,multiplicity_eq_zero_of_not_dvd hu,add_zero]
  refine ⟨hv,?_⟩
  apply mul_left_cancel₀ (pow_ne_zero e hp.out.ne_zero)
  have h := (primeUnit_spec π han).1
  rw [hv] at h
  exact h.symm.trans he

theorem primeUnit_congruence (π : G) [hp : Fact (Prime π)]
    {a b : G} (hb : b≠0) {r : ℕ} (hr : 0<r)
    (hd : π^(multiplicity π b+r) ∣ a-b) :
    multiplicity π a=multiplicity π b ∧ π^r ∣ primeUnit π a-primeUnit π b := by
  obtain ⟨t,ht⟩ := hd
  let u := primeUnit π b
  have hu : ¬π ∣ u := (primeUnit_spec π hb).2
  have he : a=π^multiplicity π b*(u+π^r*t) := by
    have h := (primeUnit_spec π hb).1
    rw [pow_add] at ht
    dsimp only [u]
    linear_combination ht+h
  have hdt : π ∣ π^r*t := dvd_mul_of_dvd_left (dvd_pow_self π hr.ne') t
  have hun : ¬π ∣ u+π^r*t := by
    intro h
    have h' := dvd_sub h hdt
    exact hu (by simpa only [add_sub_cancel_right] using h')
  obtain ⟨hval,hunit⟩ := primeUnit_factorization π (multiplicity π b) he hun
  refine ⟨hval,t,?_⟩
  rw [hunit]
  change u+π^r*t-u=π^r*t
  ring

theorem wildClass_congr {a b:G} (hb:b≠0)
    (hd:uniformizer^(multiplicity uniformizer b+7)∣a-b) : wildClass a=wildClass b := by
  obtain ⟨hv,hu⟩ := primeUnit_congruence uniformizer hb (by decide : 0<7) hd
  unfold wildClass
  rw [hv,wildVec_congr _ hu]

theorem uniformizer_pow_dvd_two_pow (k:ℕ) : uniformizer^(2*k)∣(2:G)^k := by
  have h:uniformizer^2∣(2:G) := ⟨gi 0 (-1),by decide⟩
  simpa only [pow_mul] using pow_dvd_pow_of_dvd h k

theorem wildClass_stable {a b:G} (hb:b≠0) (k:ℕ)
    (hbound:multiplicity uniformizer b+7≤2*k) (hd:(2:G)^k∣a-b) : wildClass a=wildClass b := by
  apply wildClass_congr hb
  exact (pow_dvd_pow _ hbound).trans ((uniformizer_pow_dvd_two_pow k).trans hd)

def uniformizerDivides (a : G) : Bool := decide ((a.re+a.im)%2=0)
def divideUniformizer (a : G) : G := ⟨(a.re+a.im)/2,(a.im-a.re)/2⟩

theorem uniformizerDivides_iff (a : G) : uniformizerDivides a=true ↔ uniformizer ∣ a := by
  simp only [uniformizerDivides,decide_eq_true_eq,uniformizer_dvd_iff,Int.dvd_iff_emod_eq_zero]

theorem divideUniformizer_spec {a : G} (ha : uniformizerDivides a=true) : a=uniformizer*divideUniformizer a := by
  have h : (a.re+a.im)%2=0 := by simpa only [uniformizerDivides,decide_eq_true_eq] using ha
  change a=(⟨1,1⟩ : G)*divideUniformizer a
  ext <;> simp [divideUniformizer,Zsqrtd.re_mul,Zsqrtd.im_mul] <;> omega

def splitUniformizer : ℕ → G → ℕ × G
  | 0,a => (0,a)
  | k+1,a => if uniformizerDivides a then
      let eu := splitUniformizer k (divideUniformizer a)
      (eu.1+1,eu.2)
    else (0,a)

theorem splitUniformizer_spec (k : ℕ) (a : G) :
    a=uniformizer^(splitUniformizer k a).1*(splitUniformizer k a).2 := by
  induction k generalizing a with
  | zero => simp [splitUniformizer]
  | succ k ih =>
    by_cases h : uniformizerDivides a=true
    · rw [splitUniformizer,if_pos h]
      simp only
      calc a=uniformizer*divideUniformizer a := divideUniformizer_spec h
        _=uniformizer*(uniformizer^(splitUniformizer k (divideUniformizer a)).1*(splitUniformizer k (divideUniformizer a)).2) :=
          congrArg (uniformizer*·) (ih (divideUniformizer a))
        _=uniformizer^((splitUniformizer k (divideUniformizer a)).1+1)*(splitUniformizer k (divideUniformizer a)).2 := by
          rw [pow_succ]; ring
    · simp [splitUniformizer,h]

def computeWildClass (k : ℕ) (a : G) : Option (Fin 4 → ZMod 4) :=
  let eu := splitUniformizer k a
  if uniformizerDivides eu.2 then none else some (wildVec eu.1 eu.2)

theorem computeWildClass_sound {k : ℕ} {a : G} {v : Fin 4 → ZMod 4}
    (h : computeWildClass k a=some v) : wildClass a=v := by
  unfold computeWildClass at h
  dsimp only at h
  split at h
  · contradiction
  · rename_i hn
    have hunit : ¬uniformizer ∣ (splitUniformizer k a).2 := by
      intro hd
      exact hn ((uniformizerDivides_iff _).mpr hd)
    obtain ⟨hv,hu⟩ := primeUnit_factorization uniformizer _ (splitUniformizer_spec k a) hunit
    have he := Option.some.inj h
    simpa only [wildClass,hv,hu] using he

theorem prime_dvd_normNat (π:G) : π∣(normNat π:G) := by
  have hn:(normNat π:ℤ)=Zsqrtd.norm π := by
    simp [normNat,Int.natCast_natAbs,abs_of_nonneg (GaussianInt.norm_nonneg π)]
  refine ⟨star π,?_⟩
  rw [← Int.cast_natCast,hn]
  ext <;> simp [Zsqrtd.norm,Zsqrtd.re_mul,Zsqrtd.im_mul] <;> ring

theorem coeffMod_eq_reduction (π : G) [Fact (Prime π)] {a b : G}
    (h : coeffMod (normNat π) a=coeffMod (normNat π) b) : reduction π a=reduction π b := by
  have hn : (normNat π : G) ∣ a-b := (coeffMod_zero _ _).mp (by rw [map_sub,h,sub_self])
  have he := (reduction_zero π _).mpr ((prime_dvd_normNat π).trans hn)
  rwa [map_sub,sub_eq_zero] at he

theorem quarticLog_of_euler_witness (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2)
    {u w : G} (hu : ¬π ∣ u) (e : Fin 4)
    (he : coeffMod (normNat π) u ^ ((normNat π-1)/4)=
      coeffMod (normNat π) (imaginary^e.val+π*w)) : quarticLog π h2 u=(e.val : ZMod 4) := by
  have hq : Fintype.card (Residue π)=normNat π := by
    simpa only [Nat.card_eq_fintype_card,normNat] using residue_card π
  have hred : reduction π u ^ ((normNat π-1)/4)=reduction π (imaginary^e.val) := by
    have h := coeffMod_eq_reduction π (a := u^((normNat π-1)/4)) (b := imaginary^e.val+π*w)
      (by simpa only [map_pow] using he)
    simpa only [map_pow,map_add,map_mul,(reduction_zero π π).mpr dvd_rfl,zero_mul,add_zero] using h
  have hs : quarticSymbol π h2 u=imaginary^e.val := by
    have he3 : (imaginary^e.val)^4=1 := by
      rw [←pow_mul,mul_comm e.val 4,pow_mul,imaginary_primitive.pow_eq_one,one_pow]
    apply quartic_value_injective (reduction π) (residue_imaginary_primitive π h2)
      (Or.inr (quarticSymbol_fourth π h2 hu)) (Or.inr he3)
    change reduction π (primeCharacter π h2 (reduction π u))=_
    rw [(primeCharacter_spec π h2).2,hq]
    exact hred
  exact (congrArg logImaginary hs).trans (logImaginary_pow e.val)

structure TameCertificate where
  exponent : ℕ
  unit : G
  inv : G
  invQuot : G
  quartic : Fin 4
  quarticQuot : G

def TameCertificate.check (c : TameCertificate) (π a : G) : Prop :=
  a=π^c.exponent*c.unit ∧ c.unit*c.inv+π*c.invQuot=1 ∧
  coeffMod (normNat π) c.unit ^ ((normNat π-1)/4)=
    coeffMod (normNat π) (imaginary^c.quartic.val+π*c.quarticQuot)

instance (c : TameCertificate) (π a : G) : Decidable (c.check π a) := by
  unfold TameCertificate.check
  infer_instance

noncomputable def tameClass (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2) (a : G) :
    Fin 2 → ZMod 4 := ![multiplicity π a,quarticLog π h2 (primeUnit π a)]

theorem TameCertificate.sound (c : TameCertificate) (π : G) [hp : Fact (Prime π)]
    (h2 : ¬π ∣ 2) {a : G} (hc : c.check π a) :
    tameClass π h2 a=![(c.exponent : ZMod 4),(c.quartic.val : ZMod 4)] := by
  obtain ⟨he,hi,hl⟩ := hc
  have hu : ¬π ∣ c.unit := by
    intro h
    have h1 : π ∣ (1 : G) := by
      rw [←hi]
      exact dvd_add (dvd_mul_of_dvd_left h c.inv) (dvd_mul_right _ _)
    exact hp.out.not_dvd_one h1
  obtain ⟨hv,hu'⟩ := primeUnit_factorization π c.exponent he hu
  simp only [tameClass,hv,hu',quarticLog_of_euler_witness π h2 hu c.quartic hl]

theorem tameClass_congr (π : G) [Fact (Prime π)] (h2 : ¬π ∣ 2)
    {a b : G} (hb : b≠0) (hd : π^(multiplicity π b+1) ∣ a-b) :
    tameClass π h2 a=tameClass π h2 b := by
  obtain ⟨hv,hu⟩ := primeUnit_congruence π hb (by decide : 0<1) hd
  have hl : quarticLog π h2 (primeUnit π a)=quarticLog π h2 (primeUnit π b) := by
    apply quarticLog_congr
    have he := (reduction_zero π _).mpr (by simpa only [pow_one] using hu)
    rwa [map_sub,sub_eq_zero] at he
  simp only [tameClass,hv,hl]


