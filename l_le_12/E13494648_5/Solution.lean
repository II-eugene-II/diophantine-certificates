  conv_lhs => rw [gaussian_coordinates z]
  conv_rhs => rw [gaussian_coordinates (star z)]
  simp only [map_add,map_mul,map_intCast,add_pow_char,mul_pow,hcast,hi,
    Zsqrtd.re_star,Zsqrtd.im_star,Int.cast_neg,map_neg]
