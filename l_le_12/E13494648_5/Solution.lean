  refine ⟨by simpa using ha.ne_zero,?_,?_⟩
  · intro hu
    apply ha.not_unit
    simpa only [starRingEnd_apply,star_star] using hu.map (starRingEnd G)
  · intro b c h
    have h' : a∣star b*star c := by
      simpa only [star_mul,star_star,mul_comm] using star_dvd_of_dvd h
