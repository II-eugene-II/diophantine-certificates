  have h1 : 4*((p+1)/4)=p+1 := by omega
  have hp1 : 1≤p^2 := by
    have : 1≤p := by omega
    nlinarith
  have hpmod : p^2%4=1 := by norm_num [Nat.pow_mod,hp]
  have hmod : (p^2-1)%4=0 := by omega
  have h2 : 4*((p^2-1)/4)=p^2-1 := by omega
  have h3 := congrArg (fun n:ℕ => n*(p+3)) h1
  have hsub : p^2-1+1=p^2 := Nat.sub_add_cancel hp1
  nlinarith

