theorem wildClass_mul {a b:G} (ha:a≠0) (hb:b≠0) :
    wildClass (a*b)=wildClass a+wildClass b := by
  have hu := unitLog_mul (primeUnit_spec uniformizer ha).2 (primeUnit_spec uniformizer hb).2
  unfold wildClass
  rw [multiplicity_mul uniformizer_prime
    (FiniteMultiplicity.of_prime_left uniformizer_prime (mul_ne_zero ha hb)),
    primeUnit_mul uniformizer ha hb]
  ext i
  fin_cases i <;> simp [wildVec,hu,Nat.cast_add]

theorem wildClass_of_not_dvd {a:G} (ha:¬uniformizer∣a) : wildClass a=wildVec 0 a := by
  simp only [wildClass,multiplicity_eq_zero_of_not_dvd ha,primeUnit_of_not_dvd uniformizer ha]

theorem wildVec_congr (v:ℕ) {a b:G} (h:uniformizer^7∣a-b) : wildVec v a=wildVec v b := by
  simp only [wildVec,unitLog_congr h]

noncomputable def wild (a b:G) : ZMod 4 := dyadicPair (wildClass a) (wildClass b)

theorem wild_skew (a b:G) : wild a b = -wild b a := dyadicPair_skew _ _

theorem wild_mul_left {a b c:G} (ha:a≠0) (hb:b≠0) : wild (a*b) c=wild a c+wild b c := by
  rw [wild,wildClass_mul ha hb,dyadicPair_add_left]
  rfl

theorem wild_steinberg_ramified {a:G} (ha:a≠0) (hd:uniformizer∣a) : wild a (1-a)=0 := by
  have hb:¬uniformizer∣1-a := by
    intro h
    have h':uniformizer∣(1:G) := by convert dvd_add hd h using 1 <;> ring
    exact uniformizer_prime.not_unit (isUnit_of_dvd_one h')
