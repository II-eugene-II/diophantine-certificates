namespace GraphCert.Quartic

structure QuarticPairing where
  val : G → G → ZMod 4
  mul_left : ∀ a b c, a≠0 → b≠0 → c≠0 → val (a*b) c=val a c+val b c
  skew : ∀ a b, val a b = -val b a
  steinberg : ∀ a, a≠0 → 1-a≠0 → val a (1-a)=0
  self : ∀ a, a≠0 → val a a=val a (-1)

namespace QuarticPairing
variable (B : QuarticPairing)

theorem mul_right (a b c : G) (ha : a≠0) (hb : b≠0) (hc : c≠0) :
    B.val a (b*c) = B.val a b+B.val a c := by
  rw [B.skew a (b*c), B.mul_left b c a hb hc ha,
    B.skew b a, B.skew c a]
  ring

theorem one_left {a : G} (ha : a≠0) : B.val 1 a=0 := by
  have h := B.mul_left 1 1 a one_ne_zero one_ne_zero ha
  simp only [one_mul] at h
  linear_combination -h

theorem pow_left {a b : G} (ha : a≠0) (hb : b≠0) (n : ℕ) :
    B.val (a^n) b = (n : ZMod 4)*B.val a b := by
  induction n with
  | zero => simp [B.one_left hb]
  | succ n ih =>
      rw [pow_succ, B.mul_left _ _ _ (pow_ne_zero n ha) ha hb, ih]
      push_cast; ring

theorem pow_right {a b : G} (ha : a≠0) (hb : b≠0) (n : ℕ) :
    B.val a (b^n) = (n : ZMod 4)*B.val a b := by
  rw [B.skew, B.pow_left hb ha, B.skew b a]
  ring

variable (hw : ∀ a, a≠0 → B.val imaginary a=0)
include hw

theorem unit_left {u a:G} (hu:IsUnit u) (ha:a≠0) : B.val u a=0 := by
  obtain ⟨k,rfl⟩ := unit_power_imaginary hu
  rw [B.pow_left (imaginary_primitive.ne_zero (by decide)) ha,hw a ha,mul_zero]

theorem unit_right {a u : G} (ha : a≠0) (hu : IsUnit u) : B.val a u=0 := by
  rw [B.skew, B.unit_left hw hu ha, neg_zero]

theorem associated_left {a b c : G} (hab : Associated a b)
    (ha : a≠0) (hc : c≠0) : B.val a c=B.val b c := by
  obtain ⟨u,rfl⟩ := hab
  rw [B.mul_left _ _ _ ha u.ne_zero hc, B.unit_left hw u.isUnit hc, add_zero]

variable (hp : ∀ π ρ, Prime π → Prime ρ → Primary π →
  Primary ρ → B.val π ρ=0)
include hp

theorem away_uniformizer {a b : G} (ha : ¬uniformizer ∣ a) (hb : ¬uniformizer ∣ b) :
