  exact jacobi_power (ringChar E) n hχ' ψ.prim (hc ▸ hcard) hpn hnonzero

def QuarticValue (a:G) : Prop := a=0 ∨ a^4=1

theorem quartic_value_pow {a:G} (h:QuarticValue a) (n:ℕ) : QuarticValue (a^n) := by
  rcases h with rfl | h
  · cases n <;> simp [QuarticValue]
  · right; rw [← pow_mul,Nat.mul_comm,pow_mul,h,one_pow]

theorem char_quartic_value {F:Type*} [Field F] [Fintype F]
    {χ:MulChar F G} (hχ:orderOf χ=4) (x:F) : QuarticValue (χ x) := by
  by_cases hx : x=0
  · left; rw [hx]; exact χ.map_zero
  · right
    have h := DFunLike.congr_fun (hχ ▸ pow_orderOf_eq_one χ : χ^4=1) x
    simpa only [MulChar.pow_apply' χ (by decide : 4≠0),
      MulChar.one_apply (isUnit_iff_ne_zero.mpr hx)] using h

theorem quartic_value_injective {F:Type*} [Field F]
    (f:G →+* F) (hi:IsPrimitiveRoot (f imaginary) 4)
    {a b:G} (ha:QuarticValue a) (hb:QuarticValue b) (he:f a=f b) : a=b := by
  rcases ha with rfl | ha <;> rcases hb with rfl | hb
  · rfl
  · have h := congrArg f hb
    rw [map_pow,← he,map_zero,zero_pow (by decide : 4≠0),map_one] at h
    exact False.elim (zero_ne_one h)
  · have h := congrArg f ha
    rw [map_pow,he,map_zero,zero_pow (by decide : 4≠0),map_one] at h
    exact False.elim (zero_ne_one h)
  · obtain ⟨i,hi',rfl⟩ := imaginary_primitive.eq_pow_of_pow_eq_one ha
    obtain ⟨j,hj',rfl⟩ := imaginary_primitive.eq_pow_of_pow_eq_one hb
    simp only [map_pow] at he
    rw [hi.pow_inj hi' hj' he]

theorem mapped_char_order {F E:Type*} [Field F] [Fintype F] [Field E]
    (f:G →+* E) (hi:IsPrimitiveRoot (f imaginary) 4)
    {χ:MulChar F G} (hχ:orderOf χ=4) : orderOf (χ.ringHomComp f)=4 := by
  apply Nat.dvd_antisymm
  · apply orderOf_dvd_of_pow_eq_one
    rw [MulChar.ringHomComp_pow]
    simp only [show χ^4=1 from hχ ▸ pow_orderOf_eq_one χ,MulChar.ringHomComp_one]
  · rw [← hχ]
    apply orderOf_dvd_of_pow_eq_one
    apply MulChar.ext
    intro x
    have h := DFunLike.congr_fun (pow_orderOf_eq_one (χ.ringHomComp f)) (x:F)
    simp only [MulChar.pow_apply_coe,MulChar.one_apply_coe]
    apply quartic_value_injective f hi
      (quartic_value_pow (char_quartic_value hχ _) _) (by right; simp)
    simpa only [MulChar.pow_apply_coe,MulChar.ringHomComp_apply,
      MulChar.one_apply_coe,map_pow,map_one] using h

theorem jacobi_reciprocity_relation {F E:Type*} [Field F] [Fintype F]
    [Field E] [Fintype E] (g:G →+* E) (hi:IsPrimitiveRoot (g imaginary) 4)
    {χ:MulChar F G} {ψ:MulChar E G} (hχ:orderOf χ=4) (hψ:orderOf ψ=4)
    (hchar:ringChar E≠ringChar F)
    (he:∀ x,g (ψ x)=x^((Fintype.card E-1)/4)) :
    ψ (g (Fintype.card F*jacobiSum χ χ^2))=χ (Fintype.card E)^3 := by
  have hd : 4∣Fintype.card E-1 := hψ ▸ ψ.orderOf_dvd_card_sub_one
  have hq : Fintype.card E%4=1 := by
    have := Fintype.one_lt_card (α:=E); omega
  have h := jacobi_quartic_residue (mapped_char_order g hi hχ) hchar hq
  apply quartic_value_injective g hi (char_quartic_value hψ _)
    (quartic_value_pow (char_quartic_value hχ _) 3)
  simpa only [he,map_mul,map_natCast,map_pow,jacobiSum_ringHomComp,
    mul_pow,MulChar.ringHomComp_apply,← pow_mul,Nat.mul_comm] using h

theorem jacobi_reduction_zero {F R:Type*} [Field F] [Fintype F] [CommRing R]
    (f:R →+* F) (χ:MulChar F R) (hq:Fintype.card F%4=1)
    (he:∀ x,f (χ x)=x^((Fintype.card F-1)/4)) : f (jacobiSum χ χ)=0 := by
  let d := (Fintype.card F-1)/4
  have hd : 2*d<Fintype.card F-1 := by
    have := Fintype.one_lt_card (α:=F); dsimp [d]; omega
  have h := CubicSpecial.sum_polynomial_eq_zero
    ((Polynomial.X : _root_.Polynomial F)^d*(1-Polynomial.X)^d) (by
      apply lt_of_le_of_lt Polynomial.natDegree_mul_le ?_
      simp only [Polynomial.natDegree_pow,Polynomial.natDegree_X,mul_one]
      have hle : (1-Polynomial.X : _root_.Polynomial F).natDegree≤1 := by
        apply (Polynomial.natDegree_sub_le _ _).trans
        simp
      nlinarith)
  simpa [jacobiSum,map_sum,map_mul,he,d] using h

theorem jacobi_norm {F:Type*} [Field F] [Fintype F]
    {χ:MulChar F G} (hχ:orderOf χ=4) : Zsqrtd.norm (jacobiSum χ χ)=Fintype.card F := by
  have h := congrArg Zsqrtd.re (jacobi_mul_star hχ)
  simpa [Zsqrtd.norm,Zsqrtd.re_mul] using h

end GraphCert.Quartic

/- Source module: GraphCert.QuarticJacobiSquare. -/
/-! The square of the quartic Jacobi sum determines its Gaussian prime.
Only congruence modulo two is needed, avoiding a choice of its sign. -/

namespace GraphCert.Quartic
open MulChar

theorem jacobi_congruent_neg_one {F:Type*} [Field F] [Fintype F]
    {χ:MulChar F G} (hχ:orderOf χ=4) : (2:G)∣jacobiSum χ χ+1 := by
  have hc : χ^4=1 := hχ ▸ pow_orderOf_eq_one χ
  have hd : 4∣Fintype.card F-1 := hχ ▸ χ.orderOf_dvd_card_sub_one
  obtain ⟨z,_,hz⟩ := exists_jacobiSum_eq_neg_one_add (by decide : 2<4)
    hc hc hd imaginary_primitive
  refine ⟨-z*imaginary,?_⟩
  rw [hz,show (imaginary-1)^2=(-2:G)*imaginary by decide]
  ring

theorem norm_one_square {z:G} (hn:Zsqrtd.norm z=1) (h2:(2:G)∣z+1) : z^2=1 := by
  have hn' := hn
  simp only [Zsqrtd.norm] at hn'
  have hb : -1≤z.im ∧ z.im≤1 := by
    constructor <;> nlinarith [sq_nonneg z.re]
  obtain ⟨w,hw⟩ := h2
  have hi := congrArg Zsqrtd.im hw
  simp [Zsqrtd.im_mul] at hi
  have hz : z.im=0 := by omega
  apply Zsqrtd.ext <;> simp [pow_two,Zsqrtd.re_mul,Zsqrtd.im_mul,hz]
  simpa [hz] using hn'

theorem jacobi_square {F:Type*} [Field F] [Fintype F]
    (f:G →+* F) (π:G) (hπ:(2:G)∣π-1)
    (hN:Zsqrtd.norm π=Fintype.card F) (hk:∀ z,f z=0 ↔ π∣z)
    (hq:Fintype.card F%4=1) {χ:MulChar F G} (hχ:orderOf χ=4)
    (he:∀ x,f (χ x)=x^((Fintype.card F-1)/4)) : jacobiSum χ χ^2=π^2 := by
  obtain ⟨w,hw⟩ := (hk _).mp (jacobi_reduction_zero f χ hq he)
  have hjn := jacobi_norm hχ
  have hnpos : (0:ℤ)<Fintype.card F := by exact_mod_cast Fintype.card_pos
  have hwN : Zsqrtd.norm w=1 := by
    rw [hw,Zsqrtd.norm_mul,hN] at hjn
    nlinarith
  obtain ⟨a,ha⟩ := hπ
  obtain ⟨b,hb⟩ := jacobi_congruent_neg_one hχ
  have hw2 : (2:G)∣w+1 := by
    refine ⟨b-a*w,?_⟩
    calc w+1=(jacobiSum χ χ+1)-(π-1)*w := by rw [hw]; ring
      _=2*(b-a*w) := by rw [ha,hb]; ring
  rw [hw,mul_pow,norm_one_square hwN hw2,mul_one]

end GraphCert.Quartic

/- Source module: GraphCert.QuarticGaussInert. -/
/-! The Frobenius identity at primes congruent to three modulo four. -/

namespace GraphCert.Quartic
open MulChar AddChar

theorem gauss_frobenius_inert {F R:Type*} [Field F] [Fintype F]
    [CommRing R] [IsDomain R] (p:ℕ) [Fact p.Prime] [CharP R p]
    {χ:MulChar F R} {ψ:AddChar F R} (hχ:orderOf χ=4)
    (hψ:ψ.IsPrimitive) (hp:p%4=3) (hpF:IsUnit (p:F)) :
    gaussSum χ ψ^(p+1)=χ (-(p:F))*Fintype.card F := by
  have hpow : χ^p=χ^3 := by rw [← pow_mod_orderOf,hχ,hp]
  have hinv : (χ^3)⁻¹=χ := by
    apply inv_eq_of_mul_eq_one_right
    rw [← pow_succ]
    simpa only [hχ] using pow_orderOf_eq_one χ
  have h := gaussSum_mul_gaussSum_pow_orderOf_sub_one
    (show χ≠1 by intro h; simp [h] at hχ) hψ
  rw [hχ] at h
  calc
    gaussSum χ ψ^(p+1)=gaussSum χ ψ*
        (χ (p:F)*gaussSum (χ^3) ψ) := by
          rw [pow_succ',gaussSum_frob,hpow,pow_mulShift,
            ← hpF.unit_spec,gaussSum_mulShift_eq,hinv]
    _=χ (-(p:F))*Fintype.card F := by
      rw [mul_left_comm,h]
      rw [show -(p:F)=(-1)*(p:F) by ring,map_mul]
      ring

theorem jacobi_power_inert {F R:Type*} [Field F] [Fintype F]
    [CommRing R] [IsDomain R] (p:ℕ) [Fact p.Prime] [CharP R p]
    {χ:MulChar F R} {ψ:AddChar F R} (hχ:orderOf χ=4)
    (hψ:ψ.IsPrimitive) (hp:p%4=3) (hpF:IsUnit (p:F)) :
    (Fintype.card F*jacobiSum χ χ^2)^((p+1)/4)=
      χ (-(p:F))*Fintype.card F := by
  rw [← gauss_fourth hχ hψ,← pow_mul,show 4*((p+1)/4)=p+1 by omega]
  exact gauss_frobenius_inert p hχ hψ hp hpF

theorem jacobi_inert_residue {F E:Type*} [Field F] [Fintype F]
    [Field E] [Fintype E] {χ:MulChar F E} (hχ:orderOf χ=4)
    (hchar:ringChar E≠ringChar F) (hp:ringChar E%4=3) :
    (Fintype.card F*jacobiSum χ χ^2)^((ringChar E+1)/4)=
      χ (-(ringChar E:F))*Fintype.card F := by
  let ψ := FiniteField.primitiveChar F E hchar
  let L := CyclotomicField ψ.n E
  let ι : E →+* L := algebraMap E L
  let χ' := χ.ringHomComp ι
  have hχ' : orderOf χ'=4 :=
    (orderOf_injective (ringHomCompHom ι) (injective_ringHomComp ι.injective) χ).trans hχ
  obtain ⟨_,hprime,_⟩ := FiniteField.card E (ringChar E)
  have hpFact : Fact (ringChar E).Prime := ⟨hprime⟩
  have hL : ringChar L=ringChar E := (Algebra.ringChar_eq E L).symm
  have hCharPL : CharP L (ringChar E) :=
    hL ▸ (inferInstance : CharP L (ringChar L))
  have hpF : IsUnit (ringChar E:F) := by
    apply isUnit_iff_ne_zero.mpr
    intro hz
    exact hchar (CharP.ringChar_of_prime_eq_zero hprime hz).symm
  apply ι.injective
  rw [map_pow,map_mul,map_natCast,map_pow,← jacobiSum_ringHomComp,
    map_mul,map_natCast]
  exact jacobi_power_inert (ringChar E) hχ' ψ.prim hp hpF

end GraphCert.Quartic

