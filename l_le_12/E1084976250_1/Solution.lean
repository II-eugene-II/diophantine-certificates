    eval (RingHom.id ℤ) (ofCoeffs cs) x y = QuadraticNorm.eval cs x y := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    obtain ⟨i,j,a⟩ := c
    simpa [ofCoeffs, eval_add, eval_monomial, QuadraticNorm.eval] using ih

