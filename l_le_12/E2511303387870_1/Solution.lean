  have h : ∀ k : Fin 4, tameForm ((envelopes121 49).directions k)
      (graphStar edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 49)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
