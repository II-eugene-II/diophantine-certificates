without_editor_info theorem linear53 : ∀ i : Fin 51, ∀ j : Fin 4,
    tameForm ((envelopes53 i).directions j)
      (graphStar edges (fun i => (envelopes53 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 51, ∀ j : Fin 4, (envelopes53 i).directions j = 0 ∨
      tameForm ((envelopes53 i).directions j)
        (graphStar edges (fun i => (envelopes53 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

