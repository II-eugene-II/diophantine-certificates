without_editor_info theorem linear103 : ∀ i : Fin 51, ∀ j : Fin 4,
    tameForm ((envelopes103 i).directions j)
      (graphStar edges (fun i => (envelopes103 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 51, ∀ j : Fin 4, (envelopes103 i).directions j = 0 ∨
      tameForm ((envelopes103 i).directions j)
        (graphStar edges (fun i => (envelopes103 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
