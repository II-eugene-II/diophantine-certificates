  · rw [hz]; simp [tameForm]

without_editor_info theorem cross121 : ∀ e : Fin 216, ∀ j k : Fin 4,
    tameForm ((envelopes121 (edges e).src).directions j) ((envelopes121 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections121 (edges e).src with hs | hz
  · rcases fixedDirections121 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

