    tameForm ((envelopes53 (edges e).src).directions j) ((envelopes53 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 216) edgeList (by decide)
    (fun e => (envelopes53 e.src).directions = 0 ∨
      (envelopes53 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes53 e.src).directions j) ((envelopes53 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes53 (edges e).src).directions = 0 ∨
    (envelopes53 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes53 (edges e).src).directions j) ((envelopes53 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
