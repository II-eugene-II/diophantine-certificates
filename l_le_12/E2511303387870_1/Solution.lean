without_editor_info theorem checks257 : ∀ i : Fin 51, jointEnvelopeFastCheck (envelopes257 i) pi rho 7 1353 15453 3 (values 267 325 i) (certificatesC257 i) (certificatesD257 i) := by decide +kernel

without_editor_info theorem linear257 : ∀ i : Fin 51, ∀ j : Fin 4,
    tameForm ((envelopes257 i).directions j)
      (graphStar edges (fun i => (envelopes257 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 51, ∀ j : Fin 4, (envelopes257 i).directions j = 0 ∨
      tameForm ((envelopes257 i).directions j)
        (graphStar edges (fun i => (envelopes257 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross257 : ∀ e : Fin 216, ∀ j k : Fin 4,
    tameForm ((envelopes257 (edges e).src).directions j) ((envelopes257 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 216) edgeList (by decide)
    (fun e => (envelopes257 e.src).directions = 0 ∨
      (envelopes257 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes257 e.src).directions j) ((envelopes257 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes257 (edges e).src).directions = 0 ∨
    (envelopes257 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes257 (edges e).src).directions j) ((envelopes257 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

