    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤5)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤5)).trans root_rho)
    envelopes155 constantC constantD certificatesC155 certificatesD155 2
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks155 i))
