    ((pow_dvd_pow rho (by decide : 4≤5)).trans root_rho)
    envelopes137 constantC constantD certificatesC137 certificatesD137 2
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks137 i))
    linear137 cross137 value137 hx hy

