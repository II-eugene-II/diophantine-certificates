  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 15453 876 2201 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤5)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤5)).trans root_rho)
    envelopes152 constantC constantD certificatesC152 certificatesD152 2
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks152 i))
    linear152 cross152 value152 hx hy

