  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 15453 192 199 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤5)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤5)).trans root_rho)
    envelopes67 constantC constantD certificatesC67 certificatesD67 2
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks67 i))
    linear67 cross67 value67 hx hy

