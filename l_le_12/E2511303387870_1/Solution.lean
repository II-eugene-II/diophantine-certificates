    tameForm ((envelopes296 i).directions j)
      (graphStar edges (fun i => (envelopes296 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes296 19).directions k)
      (graphStar edges (fun i => (envelopes296 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 19)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
