        · have hz : (12 * x^4 + (-48) * x^3 + 24 * x^2 + 48 * x + 268) = 12 * ((1 * x + (-3)))^4 + 96 * ((1 * x + (-3)))^3 + 240 * ((1 * x + (-3)))^2 + 192 * ((1 * x + (-3)))^1 + 304 * ((1 * x + (-3)))^0 := by ring
