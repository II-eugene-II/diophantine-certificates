    have hpd : (0 : ℤ) < (1 * x^6 + 2 * x^5 + 9 * x^4 + 4 * x^3 + 7 * x^2 + (-30) * x + (-9)) ∧ (0 : ℤ) < (12 * x^4 + (-48) * x^3 + 24 * x^2 + 48 * x + 268) := by
      by_cases hx : x ≤ -1
      · have harg : 0 ≤ ((-1) * x + (-1)) := by omega
        constructor
