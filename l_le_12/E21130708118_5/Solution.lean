    (envelopes204 i).directions j=0 := by decide +kernel

without_editor_info theorem linear204 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes204 i).directions j)
      (graphStar edges (fun i => (envelopes204 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections204 i k]
  simp [tameForm]

