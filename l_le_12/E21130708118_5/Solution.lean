without_editor_info theorem checks95 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes95 i) pi rho 7 1353 1047 3 (values 25 113 i) (certificatesC95 i) (certificatesD95 i) := by decide +kernel

without_editor_info theorem zeroDirections95 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes95 i).directions j=0 := by decide +kernel

without_editor_info theorem linear95 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes95 i).directions j)
      (graphStar edges (fun i => (envelopes95 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections95 i k]
  simp [tameForm]

without_editor_info theorem cross95 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes95 (edges e).src).directions j) ((envelopes95 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections95 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value95 : vectorGraph edges (fun i => (envelopes95 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell95 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-25) (hy : (7 : ℤ)^3 ∣ y-113) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 25 113 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes95 constantC constantD certificatesC95 certificatesD95 1
