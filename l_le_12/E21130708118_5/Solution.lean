    (envelopes246 i).directions j=0 := by decide +kernel

without_editor_info theorem linear246 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes246 i).directions j)
      (graphStar edges (fun i => (envelopes246 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections246 i k]
  simp [tameForm]

without_editor_info theorem cross246 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes246 (edges e).src).directions j) ((envelopes246 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections246 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value246 : vectorGraph edges (fun i => (envelopes246 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
