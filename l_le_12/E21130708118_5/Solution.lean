  simp [tameForm]

without_editor_info theorem cross174 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes174 (edges e).src).directions j) ((envelopes174 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections174 ((edges e).src) i]
  simp [tameForm]

