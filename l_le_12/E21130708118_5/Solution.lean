    i=7 ∨ (envelopes188 i).directions=0 := by decide +kernel

without_editor_info theorem linear188 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes188 i).directions j)
      (graphStar edges (fun i => (envelopes188 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes188 7).directions k)
      (graphStar edges (fun i => (envelopes188 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections188 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross188 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes188 (edges e).src).directions j) ((envelopes188 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections188 (edges e).src with hs | hz
  · rcases fixedDirections188 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

