without_editor_info theorem checks255 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes255 i) pi rho 13 1160 1036 3 (values 495 626 i) (certificatesC255 i) (certificatesD255 i) := by decide +kernel

without_editor_info theorem zeroDirections255 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes255 i).directions j=0 := by decide +kernel

without_editor_info theorem linear255 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes255 i).directions j)
      (graphStar edges (fun i => (envelopes255 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections255 i k]
  simp [tameForm]

without_editor_info theorem cross255 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes255 (edges e).src).directions j) ((envelopes255 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections255 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value255 : vectorGraph edges (fun i => (envelopes255 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell255 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-495) (hy : (13 : ℤ)^3 ∣ y-626) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 495 626 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes255 constantC constantD certificatesC255 certificatesD255 2
