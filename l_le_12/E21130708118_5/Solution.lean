    (hx : (13 : ℤ)^2 ∣ x-88) (hy : (13 : ℤ)^2 ∣ y-15) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 88 15 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes107 constantC constantD certificatesC107 certificatesD107 2
