without_editor_info theorem checks37 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes37 i) pi rho 7 1353 1047 4 (values 2014 985 i) (certificatesC37 i) (certificatesD37 i) := by decide +kernel

without_editor_info theorem zeroDirections37 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes37 i).directions j=0 := by decide +kernel

without_editor_info theorem linear37 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes37 i).directions j)
      (graphStar edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections37 i k]
  simp [tameForm]

without_editor_info theorem cross37 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes37 (edges e).src).directions j) ((envelopes37 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections37 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value37 : vectorGraph edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell37 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-2014) (hy : (7 : ℤ)^4 ∣ y-985) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 2014 985 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes37 constantC constantD certificatesC37 certificatesD37 1
