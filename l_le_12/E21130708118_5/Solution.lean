without_editor_info theorem zeroDirections14 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes14 i).directions j=0 := by decide +kernel

without_editor_info theorem linear14 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes14 i).directions j)
      (graphStar edges (fun i => (envelopes14 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections14 i k]
  simp [tameForm]

without_editor_info theorem cross14 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes14 (edges e).src).directions j) ((envelopes14 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections14 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value14 : vectorGraph edges (fun i => (envelopes14 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

