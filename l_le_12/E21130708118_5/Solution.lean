    i=51 ∨ (envelopes88 i).directions=0 := by decide +kernel

without_editor_info theorem linear88 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes88 i).directions j)
      (graphStar edges (fun i => (envelopes88 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes88 51).directions k)
      (graphStar edges (fun i => (envelopes88 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections88 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross88 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes88 (edges e).src).directions j) ((envelopes88 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections88 (edges e).src with hs | hz
  · rcases fixedDirections88 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

