without_editor_info theorem checks45 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes45 i) pi rho 7 1353 1047 3 (values 152 5 i) (certificatesC45 i) (certificatesD45 i) := by decide +kernel

without_editor_info theorem zeroDirections45 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes45 i).directions j=0 := by decide +kernel

without_editor_info theorem linear45 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes45 i).directions j)
      (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections45 i k]
  simp [tameForm]

without_editor_info theorem cross45 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes45 (edges e).src).directions j) ((envelopes45 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections45 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value45 : vectorGraph edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell45 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-152) (hy : (7 : ℤ)^3 ∣ y-5) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 152 5 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes45 constantC constantD certificatesC45 certificatesD45 1
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks45 i))
