without_editor_info theorem checks63 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes63 i) pi rho 13 1160 1036 2 (values 167 78 i) (certificatesC63 i) (certificatesD63 i) := by decide +kernel

without_editor_info theorem fixedDirections63 : ∀ i : Fin 55,
    i=26 ∨ (envelopes63 i).directions=0 := by decide +kernel

without_editor_info theorem linear63 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes63 i).directions j)
      (graphStar edges (fun i => (envelopes63 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes63 26).directions k)
      (graphStar edges (fun i => (envelopes63 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 26)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections63 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross63 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes63 (edges e).src).directions j) ((envelopes63 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections63 (edges e).src with hs | hz
  · rcases fixedDirections63 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value63 : vectorGraph edges (fun i => (envelopes63 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

