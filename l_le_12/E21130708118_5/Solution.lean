without_editor_info theorem zeroDirections36 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes36 i).directions j=0 := by decide +kernel

without_editor_info theorem linear36 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes36 i).directions j)
      (graphStar edges (fun i => (envelopes36 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections36 i k]
  simp [tameForm]

without_editor_info theorem cross36 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes36 (edges e).src).directions j) ((envelopes36 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections36 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value36 : vectorGraph edges (fun i => (envelopes36 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
