    (envelopes253 i).directions j=0 := by decide +kernel

without_editor_info theorem linear253 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes253 i).directions j)
      (graphStar edges (fun i => (envelopes253 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections253 i k]
  simp [tameForm]

without_editor_info theorem cross253 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes253 (edges e).src).directions j) ((envelopes253 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections253 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value253 : vectorGraph edges (fun i => (envelopes253 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
