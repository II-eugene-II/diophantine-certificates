without_editor_info theorem checks254 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes254 i) pi rho 13 1160 1036 3 (values 664 1471 i) (certificatesC254 i) (certificatesD254 i) := by decide +kernel

without_editor_info theorem zeroDirections254 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes254 i).directions j=0 := by decide +kernel

without_editor_info theorem linear254 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes254 i).directions j)
      (graphStar edges (fun i => (envelopes254 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections254 i k]
  simp [tameForm]

without_editor_info theorem cross254 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes254 (edges e).src).directions j) ((envelopes254 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections254 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value254 : vectorGraph edges (fun i => (envelopes254 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell254 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-664) (hy : (13 : ℤ)^3 ∣ y-1471) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 664 1471 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes254 constantC constantD certificatesC254 certificatesD254 2
