without_editor_info theorem checks64 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes64 i) pi rho 13 1160 1036 2 (values 154 13 i) (certificatesC64 i) (certificatesD64 i) := by decide +kernel

without_editor_info theorem fixedDirections64 : ∀ i : Fin 55,
    i=49 ∨ (envelopes64 i).directions=0 := by decide +kernel

without_editor_info theorem linear64 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes64 i).directions j)
      (graphStar edges (fun i => (envelopes64 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes64 49).directions k)
      (graphStar edges (fun i => (envelopes64 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 49)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections64 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross64 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes64 (edges e).src).directions j) ((envelopes64 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections64 (edges e).src with hs | hz
  · rcases fixedDirections64 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value64 : vectorGraph edges (fun i => (envelopes64 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell64 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-154) (hy : (13 : ℤ)^2 ∣ y-13) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 154 13 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes64 constantC constantD certificatesC64 certificatesD64 2
