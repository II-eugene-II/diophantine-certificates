without_editor_info theorem checks38 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes38 i) pi rho 7 1353 1047 4 (values 1671 299 i) (certificatesC38 i) (certificatesD38 i) := by decide +kernel

without_editor_info theorem zeroDirections38 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes38 i).directions j=0 := by decide +kernel

without_editor_info theorem linear38 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes38 i).directions j)
      (graphStar edges (fun i => (envelopes38 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections38 i k]
  simp [tameForm]

without_editor_info theorem cross38 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes38 (edges e).src).directions j) ((envelopes38 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections38 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value38 : vectorGraph edges (fun i => (envelopes38 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell38 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1671) (hy : (7 : ℤ)^4 ∣ y-299) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1671 299 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes38 constantC constantD certificatesC38 certificatesD38 1
