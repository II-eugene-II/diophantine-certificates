without_editor_info theorem checks35 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes35 i) pi rho 13 1160 1036 2 (values 37 35 i) (certificatesC35 i) (certificatesD35 i) := by decide +kernel

without_editor_info theorem zeroDirections35 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes35 i).directions j=0 := by decide +kernel

without_editor_info theorem linear35 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes35 i).directions j)
      (graphStar edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections35 i k]
  simp [tameForm]

without_editor_info theorem cross35 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes35 (edges e).src).directions j) ((envelopes35 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections35 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value35 : vectorGraph edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

