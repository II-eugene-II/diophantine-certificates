without_editor_info theorem checks180 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes180 i) pi rho 7 1353 1047 2 (values 42 16 i) (certificatesC180 i) (certificatesD180 i) := by decide +kernel

without_editor_info theorem zeroDirections180 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes180 i).directions j=0 := by decide +kernel

without_editor_info theorem linear180 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes180 i).directions j)
      (graphStar edges (fun i => (envelopes180 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections180 i k]
  simp [tameForm]

without_editor_info theorem cross180 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes180 (edges e).src).directions j) ((envelopes180 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections180 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value180 : vectorGraph edges (fun i => (envelopes180 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell180 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-42) (hy : (7 : ℤ)^2 ∣ y-16) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 42 16 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes180 constantC constantD certificatesC180 certificatesD180 1
