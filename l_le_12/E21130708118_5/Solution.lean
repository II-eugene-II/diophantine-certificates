without_editor_info theorem checks146 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes146 i) pi rho 13 1160 1036 2 (values 96 116 i) (certificatesC146 i) (certificatesD146 i) := by decide +kernel

without_editor_info theorem fixedDirections146 : ∀ i : Fin 55,
    i=40 ∨ (envelopes146 i).directions=0 := by decide +kernel

without_editor_info theorem linear146 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes146 i).directions j)
      (graphStar edges (fun i => (envelopes146 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes146 40).directions k)
      (graphStar edges (fun i => (envelopes146 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 40)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections146 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross146 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes146 (edges e).src).directions j) ((envelopes146 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections146 (edges e).src with hs | hz
  · rcases fixedDirections146 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value146 : vectorGraph edges (fun i => (envelopes146 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell146 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-96) (hy : (13 : ℤ)^2 ∣ y-116) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 96 116 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes146 constantC constantD certificatesC146 certificatesD146 2
