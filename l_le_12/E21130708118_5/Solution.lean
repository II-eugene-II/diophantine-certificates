    tameForm ((envelopes123 i).directions j)
      (graphStar edges (fun i => (envelopes123 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections123 i k]
  simp [tameForm]

without_editor_info theorem cross123 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes123 (edges e).src).directions j) ((envelopes123 (edges e).dst).directions k) = 0 := by
  intro e i k
