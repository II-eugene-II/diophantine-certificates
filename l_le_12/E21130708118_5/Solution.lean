without_editor_info theorem checks21 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes21 i) pi rho 7 1353 1047 4 (values 362 327 i) (certificatesC21 i) (certificatesD21 i) := by decide +kernel

without_editor_info theorem zeroDirections21 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes21 i).directions j=0 := by decide +kernel

without_editor_info theorem linear21 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes21 i).directions j)
      (graphStar edges (fun i => (envelopes21 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections21 i k]
  simp [tameForm]

without_editor_info theorem cross21 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes21 (edges e).src).directions j) ((envelopes21 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections21 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value21 : vectorGraph edges (fun i => (envelopes21 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell21 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-362) (hy : (7 : ℤ)^4 ∣ y-327) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 362 327 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes21 constantC constantD certificatesC21 certificatesD21 1
