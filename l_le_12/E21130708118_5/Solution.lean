without_editor_info theorem checks28 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes28 i) pi rho 7 1353 1047 4 (values 649 362 i) (certificatesC28 i) (certificatesD28 i) := by decide +kernel

without_editor_info theorem fixedDirections28 : ∀ i : Fin 55,
    i=37 ∨ (envelopes28 i).directions=0 := by decide +kernel

without_editor_info theorem linear28 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes28 i).directions j)
      (graphStar edges (fun i => (envelopes28 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes28 37).directions k)
      (graphStar edges (fun i => (envelopes28 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 37)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections28 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross28 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes28 (edges e).src).directions j) ((envelopes28 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections28 (edges e).src with hs | hz
  · rcases fixedDirections28 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value28 : vectorGraph edges (fun i => (envelopes28 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell28 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-649) (hy : (7 : ℤ)^4 ∣ y-362) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 649 362 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes28 constantC constantD certificatesC28 certificatesD28 1
