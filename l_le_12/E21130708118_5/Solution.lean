without_editor_info theorem zeroDirections161 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes161 i).directions j=0 := by decide +kernel

without_editor_info theorem linear161 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes161 i).directions j)
      (graphStar edges (fun i => (envelopes161 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections161 i k]
  simp [tameForm]

without_editor_info theorem cross161 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes161 (edges e).src).directions j) ((envelopes161 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections161 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value161 : vectorGraph edges (fun i => (envelopes161 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell161 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1317) (hy : (13 : ℤ)^3 ∣ y-1725) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1317 1725 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes161 constantC constantD certificatesC161 certificatesD161 2
