without_editor_info theorem checks17 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes17 i) pi rho 7 1353 1047 4 (values 1734 670 i) (certificatesC17 i) (certificatesD17 i) := by decide +kernel

without_editor_info theorem zeroDirections17 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes17 i).directions j=0 := by decide +kernel

without_editor_info theorem linear17 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes17 i).directions j)
      (graphStar edges (fun i => (envelopes17 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections17 i k]
  simp [tameForm]

without_editor_info theorem cross17 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes17 (edges e).src).directions j) ((envelopes17 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections17 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value17 : vectorGraph edges (fun i => (envelopes17 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell17 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1734) (hy : (7 : ℤ)^4 ∣ y-670) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1734 670 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes17 constantC constantD certificatesC17 certificatesD17 1
