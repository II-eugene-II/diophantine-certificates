without_editor_info theorem checks106 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes106 i) pi rho 7 1353 1047 2 (values 38 34 i) (certificatesC106 i) (certificatesD106 i) := by decide +kernel

without_editor_info theorem fixedDirections106 : ∀ i : Fin 55,
    i=18 ∨ (envelopes106 i).directions=0 := by decide +kernel

without_editor_info theorem linear106 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes106 i).directions j)
      (graphStar edges (fun i => (envelopes106 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes106 18).directions k)
      (graphStar edges (fun i => (envelopes106 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 18)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections106 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross106 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes106 (edges e).src).directions j) ((envelopes106 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections106 (edges e).src with hs | hz
  · rcases fixedDirections106 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value106 : vectorGraph edges (fun i => (envelopes106 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell106 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-38) (hy : (7 : ℤ)^2 ∣ y-34) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 38 34 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes106 constantC constantD certificatesC106 certificatesD106 1
