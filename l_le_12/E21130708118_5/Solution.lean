  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 231 1012 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes95 constantC constantD certificatesC95 certificatesD95 2
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks95 i))
