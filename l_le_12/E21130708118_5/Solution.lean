without_editor_info theorem checks202 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes202 i) pi rho 13 1160 1036 3 (values 340 1399 i) (certificatesC202 i) (certificatesD202 i) := by decide +kernel

without_editor_info theorem fixedDirections202 : ∀ i : Fin 55,
    i=8 ∨ (envelopes202 i).directions=0 := by decide +kernel

without_editor_info theorem linear202 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes202 i).directions j)
      (graphStar edges (fun i => (envelopes202 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes202 8).directions k)
      (graphStar edges (fun i => (envelopes202 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 8)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections202 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross202 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes202 (edges e).src).directions j) ((envelopes202 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections202 (edges e).src with hs | hz
  · rcases fixedDirections202 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value202 : vectorGraph edges (fun i => (envelopes202 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell202 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-340) (hy : (13 : ℤ)^3 ∣ y-1399) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 340 1399 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes202 constantC constantD certificatesC202 certificatesD202 2
