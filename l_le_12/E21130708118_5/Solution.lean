without_editor_info theorem linear135 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes135 i).directions j)
      (graphStar edges (fun i => (envelopes135 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections135 i k]
  simp [tameForm]

without_editor_info theorem cross135 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes135 (edges e).src).directions j) ((envelopes135 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections135 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value135 : vectorGraph edges (fun i => (envelopes135 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
