    (hx : (7 : ℤ)^4 ∣ x-1936) (hy : (7 : ℤ)^4 ∣ y-2073) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1936 2073 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes86 constantC constantD certificatesC86 certificatesD86 1
