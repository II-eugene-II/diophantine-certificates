without_editor_info theorem checks99 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes99 i) pi rho 13 1160 1036 2 (values 23 37 i) (certificatesC99 i) (certificatesD99 i) := by decide +kernel

without_editor_info theorem linear99 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes99 i).directions j)
      (graphStar edges (fun i => (envelopes99 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes99 i).directions j = 0 ∨
      tameForm ((envelopes99 i).directions j)
        (graphStar edges (fun i => (envelopes99 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross99 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes99 (edges e).src).directions j) ((envelopes99 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes99 e.src).directions = 0 ∨
      (envelopes99 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes99 e.src).directions j) ((envelopes99 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes99 (edges e).src).directions = 0 ∨
    (envelopes99 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes99 (edges e).src).directions j) ((envelopes99 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value99 : vectorGraph edges (fun i => (envelopes99 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell99 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-23) (hy : (13 : ℤ)^2 ∣ y-37) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 23 37 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes99 constantC constantD certificatesC99 certificatesD99 2
