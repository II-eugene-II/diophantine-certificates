without_editor_info theorem checks7 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes7 i) pi rho 13 1160 1036 2 (values 77 29 i) (certificatesC7 i) (certificatesD7 i) := by decide +kernel

without_editor_info theorem fixedDirections7 : ∀ i : Fin 55,
    i=48 ∨ (envelopes7 i).directions=0 := by decide +kernel

without_editor_info theorem linear7 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes7 i).directions j)
      (graphStar edges (fun i => (envelopes7 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes7 48).directions k)
      (graphStar edges (fun i => (envelopes7 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 48)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections7 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross7 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes7 (edges e).src).directions j) ((envelopes7 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections7 (edges e).src with hs | hz
  · rcases fixedDirections7 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value7 : vectorGraph edges (fun i => (envelopes7 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell7 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-77) (hy : (13 : ℤ)^2 ∣ y-29) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 77 29 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes7 constantC constantD certificatesC7 certificatesD7 2
