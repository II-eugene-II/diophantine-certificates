without_editor_info theorem zeroDirections151 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes151 i).directions j=0 := by decide +kernel

without_editor_info theorem linear151 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes151 i).directions j)
      (graphStar edges (fun i => (envelopes151 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections151 i k]
  simp [tameForm]

without_editor_info theorem cross151 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes151 (edges e).src).directions j) ((envelopes151 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections151 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value151 : vectorGraph edges (fun i => (envelopes151 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

