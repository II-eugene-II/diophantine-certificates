  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 37 2076 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes171 constantC constantD certificatesC171 certificatesD171 1
