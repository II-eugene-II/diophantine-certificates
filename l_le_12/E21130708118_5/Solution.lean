without_editor_info theorem checks105 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes105 i) pi rho 7 1353 1047 2 (values 45 48 i) (certificatesC105 i) (certificatesD105 i) := by decide +kernel

without_editor_info theorem fixedDirections105 : ∀ i : Fin 55,
    i=6 ∨ (envelopes105 i).directions=0 := by decide +kernel

without_editor_info theorem linear105 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes105 i).directions j)
      (graphStar edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes105 6).directions k)
      (graphStar edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 6)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections105 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross105 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes105 (edges e).src).directions j) ((envelopes105 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections105 (edges e).src with hs | hz
  · rcases fixedDirections105 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value105 : vectorGraph edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell105 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-45) (hy : (7 : ℤ)^2 ∣ y-48) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 45 48 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes105 constantC constantD certificatesC105 certificatesD105 1
