without_editor_info theorem zeroDirections156 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes156 i).directions j=0 := by decide +kernel

without_editor_info theorem linear156 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes156 i).directions j)
      (graphStar edges (fun i => (envelopes156 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections156 i k]
  simp [tameForm]

without_editor_info theorem cross156 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes156 (edges e).src).directions j) ((envelopes156 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections156 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value156 : vectorGraph edges (fun i => (envelopes156 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
