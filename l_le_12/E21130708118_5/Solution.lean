without_editor_info theorem checks87 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes87 i) pi rho 7 1353 1047 4 (values 1593 1044 i) (certificatesC87 i) (certificatesD87 i) := by decide +kernel

without_editor_info theorem zeroDirections87 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes87 i).directions j=0 := by decide +kernel

without_editor_info theorem linear87 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes87 i).directions j)
      (graphStar edges (fun i => (envelopes87 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections87 i k]
  simp [tameForm]

without_editor_info theorem cross87 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes87 (edges e).src).directions j) ((envelopes87 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections87 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value87 : vectorGraph edges (fun i => (envelopes87 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell87 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1593) (hy : (7 : ℤ)^4 ∣ y-1044) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1593 1044 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes87 constantC constantD certificatesC87 certificatesD87 1
