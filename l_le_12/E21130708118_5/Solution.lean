    i=19 ∨ (envelopes192 i).directions=0 := by decide +kernel

without_editor_info theorem linear192 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes192 i).directions j)
      (graphStar edges (fun i => (envelopes192 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes192 19).directions k)
      (graphStar edges (fun i => (envelopes192 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 19)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections192 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross192 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes192 (edges e).src).directions j) ((envelopes192 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections192 (edges e).src with hs | hz
  · rcases fixedDirections192 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

