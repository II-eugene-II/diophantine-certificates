without_editor_info theorem checks155 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes155 i) pi rho 7 1353 1047 3 (values 86 88 i) (certificatesC155 i) (certificatesD155 i) := by decide +kernel

without_editor_info theorem fixedDirections155 : ∀ i : Fin 55,
    i=17 ∨ (envelopes155 i).directions=0 := by decide +kernel

without_editor_info theorem linear155 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes155 i).directions j)
      (graphStar edges (fun i => (envelopes155 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes155 17).directions k)
      (graphStar edges (fun i => (envelopes155 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 17)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections155 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross155 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes155 (edges e).src).directions j) ((envelopes155 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections155 (edges e).src with hs | hz
  · rcases fixedDirections155 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value155 : vectorGraph edges (fun i => (envelopes155 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell155 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-86) (hy : (7 : ℤ)^3 ∣ y-88) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 86 88 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes155 constantC constantD certificatesC155 certificatesD155 1
