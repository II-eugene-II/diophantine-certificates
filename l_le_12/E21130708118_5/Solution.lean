without_editor_info theorem checks244 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes244 i) pi rho 13 1160 1036 2 (values 1 161 i) (certificatesC244 i) (certificatesD244 i) := by decide +kernel

without_editor_info theorem fixedDirections244 : ∀ i : Fin 55,
    i=24 ∨ (envelopes244 i).directions=0 := by decide +kernel

without_editor_info theorem linear244 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes244 i).directions j)
      (graphStar edges (fun i => (envelopes244 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes244 24).directions k)
      (graphStar edges (fun i => (envelopes244 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 24)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections244 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross244 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes244 (edges e).src).directions j) ((envelopes244 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections244 (edges e).src with hs | hz
  · rcases fixedDirections244 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value244 : vectorGraph edges (fun i => (envelopes244 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

