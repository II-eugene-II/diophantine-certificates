      tameForm ((envelopes22 i).directions j)
        (graphStar edges (fun i => (envelopes22 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
