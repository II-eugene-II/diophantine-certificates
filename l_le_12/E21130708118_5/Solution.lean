without_editor_info theorem checks125 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes125 i) pi rho 7 1353 1047 3 (values 121 125 i) (certificatesC125 i) (certificatesD125 i) := by decide +kernel

without_editor_info theorem zeroDirections125 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes125 i).directions j=0 := by decide +kernel

without_editor_info theorem linear125 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes125 i).directions j)
      (graphStar edges (fun i => (envelopes125 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections125 i k]
  simp [tameForm]

without_editor_info theorem cross125 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes125 (edges e).src).directions j) ((envelopes125 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections125 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value125 : vectorGraph edges (fun i => (envelopes125 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell125 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-121) (hy : (7 : ℤ)^3 ∣ y-125) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 121 125 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes125 constantC constantD certificatesC125 certificatesD125 1
