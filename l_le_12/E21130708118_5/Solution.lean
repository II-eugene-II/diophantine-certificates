without_editor_info theorem checks121 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes121 i) pi rho 13 1160 1036 3 (values 1179 1831 i) (certificatesC121 i) (certificatesD121 i) := by decide +kernel

without_editor_info theorem zeroDirections121 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes121 i).directions j=0 := by decide +kernel

without_editor_info theorem linear121 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes121 i).directions j)
      (graphStar edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections121 i k]
  simp [tameForm]

without_editor_info theorem cross121 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes121 (edges e).src).directions j) ((envelopes121 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections121 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value121 : vectorGraph edges (fun i => (envelopes121 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell121 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1179) (hy : (13 : ℤ)^3 ∣ y-1831) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1179 1831 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes121 constantC constantD certificatesC121 certificatesD121 2
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks121 i))
