without_editor_info theorem checks39 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes39 i) pi rho 7 1353 1047 4 (values 1328 2014 i) (certificatesC39 i) (certificatesD39 i) := by decide +kernel

without_editor_info theorem zeroDirections39 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes39 i).directions j=0 := by decide +kernel

without_editor_info theorem linear39 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes39 i).directions j)
      (graphStar edges (fun i => (envelopes39 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections39 i k]
  simp [tameForm]

without_editor_info theorem cross39 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes39 (edges e).src).directions j) ((envelopes39 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections39 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value39 : vectorGraph edges (fun i => (envelopes39 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell39 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1328) (hy : (7 : ℤ)^4 ∣ y-2014) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1328 2014 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes39 constantC constantD certificatesC39 certificatesD39 1
