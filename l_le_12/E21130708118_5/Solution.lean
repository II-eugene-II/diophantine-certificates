without_editor_info theorem checks81 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes81 i) pi rho 7 1353 1047 2 (values 39 8 i) (certificatesC81 i) (certificatesD81 i) := by decide +kernel

without_editor_info theorem linear81 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes81 i).directions j)
      (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes81 i).directions j = 0 ∨
      tameForm ((envelopes81 i).directions j)
        (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross81 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes81 (edges e).src).directions j) ((envelopes81 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes81 e.src).directions = 0 ∨
      (envelopes81 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes81 e.src).directions j) ((envelopes81 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes81 (edges e).src).directions = 0 ∨
    (envelopes81 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes81 (edges e).src).directions j) ((envelopes81 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

