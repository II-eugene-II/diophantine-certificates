  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1002 964 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes252 constantC constantD certificatesC252 certificatesD252 2
