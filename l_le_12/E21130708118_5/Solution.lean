without_editor_info theorem checks93 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes93 i) pi rho 7 1353 1047 3 (values 123 64 i) (certificatesC93 i) (certificatesD93 i) := by decide +kernel

without_editor_info theorem fixedDirections93 : ∀ i : Fin 55,
    i=29 ∨ (envelopes93 i).directions=0 := by decide +kernel

without_editor_info theorem linear93 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes93 i).directions j)
      (graphStar edges (fun i => (envelopes93 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes93 29).directions k)
      (graphStar edges (fun i => (envelopes93 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 29)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections93 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross93 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes93 (edges e).src).directions j) ((envelopes93 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections93 (edges e).src with hs | hz
  · rcases fixedDirections93 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value93 : vectorGraph edges (fun i => (envelopes93 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell93 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-123) (hy : (7 : ℤ)^3 ∣ y-64) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 123 64 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes93 constantC constantD certificatesC93 certificatesD93 1
