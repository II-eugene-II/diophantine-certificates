without_editor_info theorem linear191 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes191 i).directions j)
      (graphStar edges (fun i => (envelopes191 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes191 i).directions j = 0 ∨
      tameForm ((envelopes191 i).directions j)
        (graphStar edges (fun i => (envelopes191 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross191 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes191 (edges e).src).directions j) ((envelopes191 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes191 e.src).directions = 0 ∨
      (envelopes191 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes191 e.src).directions j) ((envelopes191 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes191 (edges e).src).directions = 0 ∨
    (envelopes191 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes191 (edges e).src).directions j) ((envelopes191 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

