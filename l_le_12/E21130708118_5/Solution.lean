  simp [tameForm]

without_editor_info theorem cross6 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes6 (edges e).src).directions j) ((envelopes6 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections6 ((edges e).src) i]
  simp [tameForm]

