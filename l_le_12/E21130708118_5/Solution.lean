    (hx : (13 : ℤ)^2 ∣ x-66) (hy : (13 : ℤ)^2 ∣ y-2) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 66 2 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes264 constantC constantD certificatesC264 certificatesD264 2
