without_editor_info theorem checks76 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes76 i) pi rho 7 1353 1047 3 (values 208 106 i) (certificatesC76 i) (certificatesD76 i) := by decide +kernel

without_editor_info theorem linear76 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes76 i).directions j)
      (graphStar edges (fun i => (envelopes76 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes76 i).directions j = 0 ∨
      tameForm ((envelopes76 i).directions j)
        (graphStar edges (fun i => (envelopes76 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross76 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes76 (edges e).src).directions j) ((envelopes76 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes76 e.src).directions = 0 ∨
      (envelopes76 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes76 e.src).directions j) ((envelopes76 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes76 (edges e).src).directions = 0 ∨
    (envelopes76 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes76 (edges e).src).directions j) ((envelopes76 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

