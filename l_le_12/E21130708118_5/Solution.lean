without_editor_info theorem zeroDirections257 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes257 i).directions j=0 := by decide +kernel

without_editor_info theorem linear257 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes257 i).directions j)
      (graphStar edges (fun i => (envelopes257 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections257 i k]
  simp [tameForm]

without_editor_info theorem cross257 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes257 (edges e).src).directions j) ((envelopes257 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections257 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value257 : vectorGraph edges (fun i => (envelopes257 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

