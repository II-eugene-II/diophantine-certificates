    (envelopes251 i).directions j=0 := by decide +kernel

without_editor_info theorem linear251 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes251 i).directions j)
      (graphStar edges (fun i => (envelopes251 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections251 i k]
  simp [tameForm]

without_editor_info theorem cross251 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes251 (edges e).src).directions j) ((envelopes251 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections251 ((edges e).src) i]
  simp [tameForm]

