    tameForm ((envelopes186 i).directions j)
      (graphStar edges (fun i => (envelopes186 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes186 36).directions k)
      (graphStar edges (fun i => (envelopes186 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 36)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections186 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross186 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes186 (edges e).src).directions j) ((envelopes186 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections186 (edges e).src with hs | hz
  · rcases fixedDirections186 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

