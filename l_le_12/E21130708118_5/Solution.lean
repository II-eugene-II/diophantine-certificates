without_editor_info theorem checks25 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes25 i) pi rho 7 1353 1047 4 (values 1678 19 i) (certificatesC25 i) (certificatesD25 i) := by decide +kernel

without_editor_info theorem zeroDirections25 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes25 i).directions j=0 := by decide +kernel

without_editor_info theorem linear25 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes25 i).directions j)
      (graphStar edges (fun i => (envelopes25 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections25 i k]
  simp [tameForm]

without_editor_info theorem cross25 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes25 (edges e).src).directions j) ((envelopes25 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections25 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value25 : vectorGraph edges (fun i => (envelopes25 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell25 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1678) (hy : (7 : ℤ)^4 ∣ y-19) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1678 19 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes25 constantC constantD certificatesC25 certificatesD25 1
