    (envelopes118 i).directions j=0 := by decide +kernel

without_editor_info theorem linear118 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes118 i).directions j)
      (graphStar edges (fun i => (envelopes118 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections118 i k]
  simp [tameForm]

without_editor_info theorem cross118 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes118 (edges e).src).directions j) ((envelopes118 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections118 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value118 : vectorGraph edges (fun i => (envelopes118 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
