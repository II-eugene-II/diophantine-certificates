without_editor_info theorem zeroDirections250 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes250 i).directions j=0 := by decide +kernel

without_editor_info theorem linear250 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes250 i).directions j)
      (graphStar edges (fun i => (envelopes250 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections250 i k]
  simp [tameForm]

without_editor_info theorem cross250 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes250 (edges e).src).directions j) ((envelopes250 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections250 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value250 : vectorGraph edges (fun i => (envelopes250 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell250 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1340) (hy : (13 : ℤ)^3 ∣ y-457) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1340 457 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes250 constantC constantD certificatesC250 certificatesD250 2
