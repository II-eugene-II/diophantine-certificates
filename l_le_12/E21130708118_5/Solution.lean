without_editor_info theorem checks148 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes148 i) pi rho 7 1353 1047 3 (values 282 95 i) (certificatesC148 i) (certificatesD148 i) := by decide +kernel

without_editor_info theorem zeroDirections148 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes148 i).directions j=0 := by decide +kernel

without_editor_info theorem linear148 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes148 i).directions j)
      (graphStar edges (fun i => (envelopes148 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections148 i k]
  simp [tameForm]

without_editor_info theorem cross148 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes148 (edges e).src).directions j) ((envelopes148 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections148 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value148 : vectorGraph edges (fun i => (envelopes148 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

