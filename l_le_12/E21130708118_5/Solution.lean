    (hx : (7 : ℤ)^4 ∣ x-37) (hy : (7 : ℤ)^4 ∣ y-361) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
