without_editor_info theorem checks216 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes216 i) pi rho 13 1160 1036 2 (values 40 32 i) (certificatesC216 i) (certificatesD216 i) := by decide +kernel

without_editor_info theorem fixedDirections216 : ∀ i : Fin 55,
    i=7 ∨ (envelopes216 i).directions=0 := by decide +kernel

without_editor_info theorem linear216 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes216 i).directions j)
      (graphStar edges (fun i => (envelopes216 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes216 7).directions k)
      (graphStar edges (fun i => (envelopes216 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections216 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross216 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes216 (edges e).src).directions j) ((envelopes216 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections216 (edges e).src with hs | hz
  · rcases fixedDirections216 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value216 : vectorGraph edges (fun i => (envelopes216 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell216 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-40) (hy : (13 : ℤ)^2 ∣ y-32) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 40 32 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes216 constantC constantD certificatesC216 certificatesD216 2
