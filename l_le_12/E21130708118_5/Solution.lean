without_editor_info theorem checks165 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes165 i) pi rho 7 1353 1047 3 (values 37 312 i) (certificatesC165 i) (certificatesD165 i) := by decide +kernel

without_editor_info theorem zeroDirections165 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes165 i).directions j=0 := by decide +kernel

without_editor_info theorem linear165 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes165 i).directions j)
      (graphStar edges (fun i => (envelopes165 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections165 i k]
  simp [tameForm]

without_editor_info theorem cross165 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes165 (edges e).src).directions j) ((envelopes165 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections165 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value165 : vectorGraph edges (fun i => (envelopes165 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell165 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-37) (hy : (7 : ℤ)^3 ∣ y-312) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 37 312 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes165 constantC constantD certificatesC165 certificatesD165 1
