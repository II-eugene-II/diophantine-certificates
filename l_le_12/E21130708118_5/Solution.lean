    tameForm ((envelopes184 i).directions j)
      (graphStar edges (fun i => (envelopes184 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes184 46).directions k)
      (graphStar edges (fun i => (envelopes184 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 46)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
