without_editor_info theorem checks83 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes83 i) pi rho 13 1160 1036 2 (values 75 154 i) (certificatesC83 i) (certificatesD83 i) := by decide +kernel

without_editor_info theorem fixedDirections83 : ∀ i : Fin 55,
    i=14 ∨ (envelopes83 i).directions=0 := by decide +kernel

without_editor_info theorem linear83 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes83 i).directions j)
      (graphStar edges (fun i => (envelopes83 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes83 14).directions k)
      (graphStar edges (fun i => (envelopes83 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 14)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections83 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross83 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes83 (edges e).src).directions j) ((envelopes83 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections83 (edges e).src with hs | hz
  · rcases fixedDirections83 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value83 : vectorGraph edges (fun i => (envelopes83 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

