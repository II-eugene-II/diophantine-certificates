    (envelopes49 i).directions j=0 := by decide +kernel

without_editor_info theorem linear49 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes49 i).directions j)
      (graphStar edges (fun i => (envelopes49 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections49 i k]
  simp [tameForm]

without_editor_info theorem cross49 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes49 (edges e).src).directions j) ((envelopes49 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections49 ((edges e).src) i]
  simp [tameForm]

