  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 0 331 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes192 constantC constantD certificatesC192 certificatesD192 1
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks192 i))
    linear192 cross192 value192 hx hy

