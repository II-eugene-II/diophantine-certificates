  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 2357 1671 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes36 constantC constantD certificatesC36 certificatesD36 1
