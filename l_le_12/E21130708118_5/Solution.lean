without_editor_info theorem checks131 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes131 i) pi rho 7 1353 1047 3 (values 205 104 i) (certificatesC131 i) (certificatesD131 i) := by decide +kernel

without_editor_info theorem zeroDirections131 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes131 i).directions j=0 := by decide +kernel

without_editor_info theorem linear131 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes131 i).directions j)
      (graphStar edges (fun i => (envelopes131 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections131 i k]
  simp [tameForm]

without_editor_info theorem cross131 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes131 (edges e).src).directions j) ((envelopes131 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections131 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value131 : vectorGraph edges (fun i => (envelopes131 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell131 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-205) (hy : (7 : ℤ)^3 ∣ y-104) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 205 104 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes131 constantC constantD certificatesC131 certificatesD131 1
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks131 i))
