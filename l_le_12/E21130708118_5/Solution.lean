without_editor_info theorem checks57 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes57 i) pi rho 7 1353 1047 4 (values 649 2381 i) (certificatesC57 i) (certificatesD57 i) := by decide +kernel

without_editor_info theorem linear57 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes57 i).directions j)
      (graphStar edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes57 i).directions j = 0 ∨
      tameForm ((envelopes57 i).directions j)
        (graphStar edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross57 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes57 (edges e).src).directions j) ((envelopes57 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes57 e.src).directions = 0 ∨
      (envelopes57 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes57 e.src).directions j) ((envelopes57 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes57 (edges e).src).directions = 0 ∨
    (envelopes57 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes57 (edges e).src).directions j) ((envelopes57 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value57 : vectorGraph edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell57 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-649) (hy : (7 : ℤ)^4 ∣ y-2381) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 649 2381 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes57 constantC constantD certificatesC57 certificatesD57 1
