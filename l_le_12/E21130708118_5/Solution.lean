without_editor_info theorem checks84 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes84 i) pi rho 13 1160 1036 3 (values 2090 1350 i) (certificatesC84 i) (certificatesD84 i) := by decide +kernel

without_editor_info theorem zeroDirections84 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes84 i).directions j=0 := by decide +kernel

without_editor_info theorem linear84 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes84 i).directions j)
      (graphStar edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections84 i k]
  simp [tameForm]

without_editor_info theorem cross84 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes84 (edges e).src).directions j) ((envelopes84 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections84 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value84 : vectorGraph edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell84 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-2090) (hy : (13 : ℤ)^3 ∣ y-1350) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 2090 1350 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes84 constantC constantD certificatesC84 certificatesD84 2
