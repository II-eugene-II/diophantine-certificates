    (envelopes103 i).directions j=0 := by decide +kernel

without_editor_info theorem linear103 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes103 i).directions j)
      (graphStar edges (fun i => (envelopes103 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections103 i k]
  simp [tameForm]

without_editor_info theorem cross103 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes103 (edges e).src).directions j) ((envelopes103 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections103 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value103 : vectorGraph edges (fun i => (envelopes103 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
