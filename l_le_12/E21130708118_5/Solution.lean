without_editor_info theorem checks10 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes10 i) pi rho 7 1353 1047 3 (values 313 229 i) (certificatesC10 i) (certificatesD10 i) := by decide +kernel

without_editor_info theorem zeroDirections10 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes10 i).directions j=0 := by decide +kernel

without_editor_info theorem linear10 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes10 i).directions j)
      (graphStar edges (fun i => (envelopes10 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections10 i k]
  simp [tameForm]

without_editor_info theorem cross10 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes10 (edges e).src).directions j) ((envelopes10 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections10 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value10 : vectorGraph edges (fun i => (envelopes10 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

