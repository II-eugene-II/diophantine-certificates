  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 649 2038 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes58 constantC constantD certificatesC58 certificatesD58 1
