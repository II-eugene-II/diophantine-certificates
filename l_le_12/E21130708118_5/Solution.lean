without_editor_info theorem zeroDirections252 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes252 i).directions j=0 := by decide +kernel

without_editor_info theorem linear252 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes252 i).directions j)
      (graphStar edges (fun i => (envelopes252 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections252 i k]
  simp [tameForm]

without_editor_info theorem cross252 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes252 (edges e).src).directions j) ((envelopes252 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections252 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value252 : vectorGraph edges (fun i => (envelopes252 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
