without_editor_info theorem checks41 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes41 i) pi rho 7 1353 1047 4 (values 642 642 i) (certificatesC41 i) (certificatesD41 i) := by decide +kernel

without_editor_info theorem fixedDirections41 : ∀ i : Fin 55,
    i=28 ∨ (envelopes41 i).directions=0 := by decide +kernel

without_editor_info theorem linear41 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes41 i).directions j)
      (graphStar edges (fun i => (envelopes41 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes41 28).directions k)
      (graphStar edges (fun i => (envelopes41 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 28)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections41 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross41 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes41 (edges e).src).directions j) ((envelopes41 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections41 (edges e).src with hs | hz
  · rcases fixedDirections41 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value41 : vectorGraph edges (fun i => (envelopes41 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell41 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-642) (hy : (7 : ℤ)^4 ∣ y-642) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 642 642 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes41 constantC constantD certificatesC41 certificatesD41 1
