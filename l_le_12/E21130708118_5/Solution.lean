without_editor_info theorem checks53 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes53 i) pi rho 13 1160 1036 2 (values 128 108 i) (certificatesC53 i) (certificatesD53 i) := by decide +kernel

without_editor_info theorem zeroDirections53 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes53 i).directions j=0 := by decide +kernel

without_editor_info theorem linear53 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes53 i).directions j)
      (graphStar edges (fun i => (envelopes53 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections53 i k]
  simp [tameForm]

without_editor_info theorem cross53 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes53 (edges e).src).directions j) ((envelopes53 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections53 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value53 : vectorGraph edges (fun i => (envelopes53 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell53 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-128) (hy : (13 : ℤ)^2 ∣ y-108) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 128 108 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes53 constantC constantD certificatesC53 certificatesD53 2
