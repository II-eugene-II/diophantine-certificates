without_editor_info theorem checks190 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes190 i) pi rho 7 1353 1047 3 (values 98 282 i) (certificatesC190 i) (certificatesD190 i) := by decide +kernel

without_editor_info theorem fixedDirections190 : ∀ i : Fin 55,
    i=53 ∨ (envelopes190 i).directions=0 := by decide +kernel

without_editor_info theorem linear190 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes190 i).directions j)
      (graphStar edges (fun i => (envelopes190 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes190 53).directions k)
      (graphStar edges (fun i => (envelopes190 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 53)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections190 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross190 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes190 (edges e).src).directions j) ((envelopes190 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections190 (edges e).src with hs | hz
  · rcases fixedDirections190 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value190 : vectorGraph edges (fun i => (envelopes190 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

