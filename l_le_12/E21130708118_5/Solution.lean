without_editor_info theorem checks40 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes40 i) pi rho 13 1160 1036 3 (values 1857 238 i) (certificatesC40 i) (certificatesD40 i) := by decide +kernel

without_editor_info theorem zeroDirections40 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes40 i).directions j=0 := by decide +kernel

without_editor_info theorem linear40 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes40 i).directions j)
      (graphStar edges (fun i => (envelopes40 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections40 i k]
  simp [tameForm]

without_editor_info theorem cross40 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes40 (edges e).src).directions j) ((envelopes40 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections40 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value40 : vectorGraph edges (fun i => (envelopes40 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell40 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1857) (hy : (13 : ℤ)^3 ∣ y-238) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1857 238 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes40 constantC constantD certificatesC40 certificatesD40 2
