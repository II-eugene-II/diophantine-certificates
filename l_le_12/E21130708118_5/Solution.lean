without_editor_info theorem checks200 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes200 i) pi rho 13 1160 1036 3 (values 678 216 i) (certificatesC200 i) (certificatesD200 i) := by decide +kernel

without_editor_info theorem fixedDirections200 : ∀ i : Fin 55,
    i=53 ∨ (envelopes200 i).directions=0 := by decide +kernel

without_editor_info theorem linear200 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes200 i).directions j)
      (graphStar edges (fun i => (envelopes200 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes200 53).directions k)
      (graphStar edges (fun i => (envelopes200 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 53)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections200 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross200 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes200 (edges e).src).directions j) ((envelopes200 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections200 (edges e).src with hs | hz
  · rcases fixedDirections200 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value200 : vectorGraph edges (fun i => (envelopes200 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell200 {x y : ℤ} (hf : equation x y = 0)
