without_editor_info theorem checks74 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes74 i) pi rho 13 1160 1036 2 (values 24 39 i) (certificatesC74 i) (certificatesD74 i) := by decide +kernel

without_editor_info theorem zeroDirections74 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes74 i).directions j=0 := by decide +kernel

without_editor_info theorem linear74 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes74 i).directions j)
      (graphStar edges (fun i => (envelopes74 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections74 i k]
  simp [tameForm]

without_editor_info theorem cross74 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes74 (edges e).src).directions j) ((envelopes74 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections74 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value74 : vectorGraph edges (fun i => (envelopes74 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

