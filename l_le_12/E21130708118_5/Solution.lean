without_editor_info theorem fixedDirections230 : ∀ i : Fin 55,
    i=18 ∨ (envelopes230 i).directions=0 := by decide +kernel

without_editor_info theorem linear230 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes230 i).directions j)
      (graphStar edges (fun i => (envelopes230 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes230 18).directions k)
      (graphStar edges (fun i => (envelopes230 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 18)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections230 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross230 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes230 (edges e).src).directions j) ((envelopes230 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections230 (edges e).src with hs | hz
  · rcases fixedDirections230 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value230 : vectorGraph edges (fun i => (envelopes230 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

