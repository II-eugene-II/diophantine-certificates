without_editor_info theorem checks88 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes88 i) pi rho 7 1353 1047 4 (values 1250 15 i) (certificatesC88 i) (certificatesD88 i) := by decide +kernel

without_editor_info theorem fixedDirections88 : ∀ i : Fin 55,
    i=17 ∨ (envelopes88 i).directions=0 := by decide +kernel

without_editor_info theorem linear88 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes88 i).directions j)
      (graphStar edges (fun i => (envelopes88 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes88 17).directions k)
      (graphStar edges (fun i => (envelopes88 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 17)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections88 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross88 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes88 (edges e).src).directions j) ((envelopes88 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections88 (edges e).src with hs | hz
  · rcases fixedDirections88 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value88 : vectorGraph edges (fun i => (envelopes88 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell88 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1250) (hy : (7 : ℤ)^4 ∣ y-15) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1250 15 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes88 constantC constantD certificatesC88 certificatesD88 1
