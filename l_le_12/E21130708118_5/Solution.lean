without_editor_info theorem checks75 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes75 i) pi rho 13 1160 1036 2 (values 11 143 i) (certificatesC75 i) (certificatesD75 i) := by decide +kernel

without_editor_info theorem linear75 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes75 i).directions j)
      (graphStar edges (fun i => (envelopes75 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes75 i).directions j = 0 ∨
      tameForm ((envelopes75 i).directions j)
        (graphStar edges (fun i => (envelopes75 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross75 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes75 (edges e).src).directions j) ((envelopes75 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes75 e.src).directions = 0 ∨
      (envelopes75 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes75 e.src).directions j) ((envelopes75 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes75 (edges e).src).directions = 0 ∨
    (envelopes75 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes75 (edges e).src).directions j) ((envelopes75 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value75 : vectorGraph edges (fun i => (envelopes75 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell75 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-11) (hy : (13 : ℤ)^2 ∣ y-143) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 11 143 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes75 constantC constantD certificatesC75 certificatesD75 2
