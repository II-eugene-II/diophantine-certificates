without_editor_info theorem checks176 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes176 i) pi rho 7 1353 1047 4 (values 37 361 i) (certificatesC176 i) (certificatesD176 i) := by decide +kernel

without_editor_info theorem linear176 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes176 i).directions j)
      (graphStar edges (fun i => (envelopes176 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes176 i).directions j = 0 ∨
      tameForm ((envelopes176 i).directions j)
        (graphStar edges (fun i => (envelopes176 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross176 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes176 (edges e).src).directions j) ((envelopes176 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes176 e.src).directions = 0 ∨
      (envelopes176 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes176 e.src).directions j) ((envelopes176 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes176 (edges e).src).directions = 0 ∨
    (envelopes176 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes176 (edges e).src).directions j) ((envelopes176 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

