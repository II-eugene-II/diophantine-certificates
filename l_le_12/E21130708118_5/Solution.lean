without_editor_info theorem checks144 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes144 i) pi rho 7 1353 1047 3 (values 282 291 i) (certificatesC144 i) (certificatesD144 i) := by decide +kernel

without_editor_info theorem zeroDirections144 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes144 i).directions j=0 := by decide +kernel

without_editor_info theorem linear144 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes144 i).directions j)
      (graphStar edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections144 i k]
  simp [tameForm]

without_editor_info theorem cross144 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes144 (edges e).src).directions j) ((envelopes144 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections144 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value144 : vectorGraph edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell144 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-282) (hy : (7 : ℤ)^3 ∣ y-291) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 282 291 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes144 constantC constantD certificatesC144 certificatesD144 1
