    (envelopes261 i).directions j=0 := by decide +kernel

without_editor_info theorem linear261 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes261 i).directions j)
      (graphStar edges (fun i => (envelopes261 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections261 i k]
  simp [tameForm]

without_editor_info theorem cross261 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes261 (edges e).src).directions j) ((envelopes261 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections261 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value261 : vectorGraph edges (fun i => (envelopes261 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
