without_editor_info theorem checks113 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes113 i) pi rho 7 1353 1047 2 (values 37 48 i) (certificatesC113 i) (certificatesD113 i) := by decide +kernel

without_editor_info theorem linear113 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes113 i).directions j)
      (graphStar edges (fun i => (envelopes113 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes113 i).directions j = 0 ∨
      tameForm ((envelopes113 i).directions j)
        (graphStar edges (fun i => (envelopes113 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross113 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes113 (edges e).src).directions j) ((envelopes113 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes113 e.src).directions = 0 ∨
      (envelopes113 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes113 e.src).directions j) ((envelopes113 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes113 (edges e).src).directions = 0 ∨
    (envelopes113 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes113 (edges e).src).directions j) ((envelopes113 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

