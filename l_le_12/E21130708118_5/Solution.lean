without_editor_info theorem zeroDirections59 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes59 i).directions j=0 := by decide +kernel

without_editor_info theorem linear59 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes59 i).directions j)
      (graphStar edges (fun i => (envelopes59 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections59 i k]
  simp [tameForm]

without_editor_info theorem cross59 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes59 (edges e).src).directions j) ((envelopes59 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections59 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value59 : vectorGraph edges (fun i => (envelopes59 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
