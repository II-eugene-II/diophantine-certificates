    tameForm ((envelopes173 i).directions j)
      (graphStar edges (fun i => (envelopes173 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections173 i k]
  simp [tameForm]

