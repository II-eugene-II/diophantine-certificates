without_editor_info theorem checks82 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes82 i) pi rho 13 1160 1036 2 (values 88 141 i) (certificatesC82 i) (certificatesD82 i) := by decide +kernel

without_editor_info theorem fixedDirections82 : ∀ i : Fin 55,
    i=15 ∨ (envelopes82 i).directions=0 := by decide +kernel

without_editor_info theorem linear82 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes82 i).directions j)
      (graphStar edges (fun i => (envelopes82 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes82 15).directions k)
      (graphStar edges (fun i => (envelopes82 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 15)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections82 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross82 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes82 (edges e).src).directions j) ((envelopes82 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections82 (edges e).src with hs | hz
  · rcases fixedDirections82 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value82 : vectorGraph edges (fun i => (envelopes82 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell82 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-88) (hy : (13 : ℤ)^2 ∣ y-141) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 88 141 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes82 constantC constantD certificatesC82 certificatesD82 2
