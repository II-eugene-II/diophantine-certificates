    i=42 ∨ (envelopes248 i).directions=0 := by decide +kernel

without_editor_info theorem linear248 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes248 i).directions j)
      (graphStar edges (fun i => (envelopes248 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes248 42).directions k)
      (graphStar edges (fun i => (envelopes248 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 42)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections248 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross248 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes248 (edges e).src).directions j) ((envelopes248 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections248 (edges e).src with hs | hz
  · rcases fixedDirections248 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

