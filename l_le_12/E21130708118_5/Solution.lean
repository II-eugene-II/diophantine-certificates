without_editor_info theorem checks4 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes4 i) pi rho 7 1353 1047 3 (values 145 89 i) (certificatesC4 i) (certificatesD4 i) := by decide +kernel

without_editor_info theorem fixedDirections4 : ∀ i : Fin 55,
    i=12 ∨ (envelopes4 i).directions=0 := by decide +kernel

without_editor_info theorem linear4 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes4 i).directions j)
      (graphStar edges (fun i => (envelopes4 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes4 12).directions k)
      (graphStar edges (fun i => (envelopes4 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 12)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections4 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross4 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes4 (edges e).src).directions j) ((envelopes4 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections4 (edges e).src with hs | hz
  · rcases fixedDirections4 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value4 : vectorGraph edges (fun i => (envelopes4 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell4 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-145) (hy : (7 : ℤ)^3 ∣ y-89) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 145 89 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes4 constantC constantD certificatesC4 certificatesD4 1
