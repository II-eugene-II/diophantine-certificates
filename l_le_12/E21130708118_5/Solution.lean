    (envelopes73 i).directions j=0 := by decide +kernel

without_editor_info theorem linear73 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes73 i).directions j)
      (graphStar edges (fun i => (envelopes73 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections73 i k]
  simp [tameForm]

without_editor_info theorem cross73 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes73 (edges e).src).directions j) ((envelopes73 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections73 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value73 : vectorGraph edges (fun i => (envelopes73 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
