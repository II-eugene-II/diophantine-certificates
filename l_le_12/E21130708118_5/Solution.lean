without_editor_info theorem checks181 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes181 i) pi rho 13 1160 1036 2 (values 145 138 i) (certificatesC181 i) (certificatesD181 i) := by decide +kernel

without_editor_info theorem fixedDirections181 : ∀ i : Fin 55,
    i=16 ∨ (envelopes181 i).directions=0 := by decide +kernel

without_editor_info theorem linear181 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes181 i).directions j)
      (graphStar edges (fun i => (envelopes181 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes181 16).directions k)
      (graphStar edges (fun i => (envelopes181 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 16)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections181 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross181 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes181 (edges e).src).directions j) ((envelopes181 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections181 (edges e).src with hs | hz
  · rcases fixedDirections181 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value181 : vectorGraph edges (fun i => (envelopes181 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell181 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-145) (hy : (13 : ℤ)^2 ∣ y-138) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 145 138 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes181 constantC constantD certificatesC181 certificatesD181 2
