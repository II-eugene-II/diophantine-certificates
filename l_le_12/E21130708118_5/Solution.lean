without_editor_info theorem checks77 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes77 i) pi rho 7 1353 1047 3 (values 208 57 i) (certificatesC77 i) (certificatesD77 i) := by decide +kernel

without_editor_info theorem linear77 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes77 i).directions j)
      (graphStar edges (fun i => (envelopes77 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes77 i).directions j = 0 ∨
      tameForm ((envelopes77 i).directions j)
        (graphStar edges (fun i => (envelopes77 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross77 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes77 (edges e).src).directions j) ((envelopes77 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes77 e.src).directions = 0 ∨
      (envelopes77 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes77 e.src).directions j) ((envelopes77 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes77 (edges e).src).directions = 0 ∨
    (envelopes77 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes77 (edges e).src).directions j) ((envelopes77 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value77 : vectorGraph edges (fun i => (envelopes77 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell77 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-208) (hy : (7 : ℤ)^3 ∣ y-57) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 208 57 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes77 constantC constantD certificatesC77 certificatesD77 1
