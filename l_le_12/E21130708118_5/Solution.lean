without_editor_info theorem checks155 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes155 i) pi rho 13 1160 1036 2 (values 147 113 i) (certificatesC155 i) (certificatesD155 i) := by decide +kernel

without_editor_info theorem linear155 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes155 i).directions j)
      (graphStar edges (fun i => (envelopes155 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes155 i).directions j = 0 ∨
      tameForm ((envelopes155 i).directions j)
        (graphStar edges (fun i => (envelopes155 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross155 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes155 (edges e).src).directions j) ((envelopes155 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes155 e.src).directions = 0 ∨
      (envelopes155 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes155 e.src).directions j) ((envelopes155 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes155 (edges e).src).directions = 0 ∨
    (envelopes155 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes155 (edges e).src).directions j) ((envelopes155 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value155 : vectorGraph edges (fun i => (envelopes155 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell155 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-147) (hy : (13 : ℤ)^2 ∣ y-113) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 147 113 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes155 constantC constantD certificatesC155 certificatesD155 2
