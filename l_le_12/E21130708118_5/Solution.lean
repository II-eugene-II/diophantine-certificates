without_editor_info theorem checks171 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes171 i) pi rho 13 1160 1036 2 (values 95 139 i) (certificatesC171 i) (certificatesD171 i) := by decide +kernel

without_editor_info theorem linear171 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes171 i).directions j)
      (graphStar edges (fun i => (envelopes171 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes171 i).directions j = 0 ∨
      tameForm ((envelopes171 i).directions j)
        (graphStar edges (fun i => (envelopes171 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross171 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes171 (edges e).src).directions j) ((envelopes171 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes171 e.src).directions = 0 ∨
      (envelopes171 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes171 e.src).directions j) ((envelopes171 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes171 (edges e).src).directions = 0 ∨
    (envelopes171 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes171 (edges e).src).directions j) ((envelopes171 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

