without_editor_info theorem linear172 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes172 i).directions j)
      (graphStar edges (fun i => (envelopes172 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections172 i k]
  simp [tameForm]

