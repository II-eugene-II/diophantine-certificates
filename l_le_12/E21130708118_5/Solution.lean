without_editor_info theorem checks178 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes178 i) pi rho 7 1353 1047 2 (values 37 11 i) (certificatesC178 i) (certificatesD178 i) := by decide +kernel

without_editor_info theorem fixedDirections178 : ∀ i : Fin 55,
    i=7 ∨ (envelopes178 i).directions=0 := by decide +kernel

without_editor_info theorem linear178 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes178 i).directions j)
      (graphStar edges (fun i => (envelopes178 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes178 7).directions k)
      (graphStar edges (fun i => (envelopes178 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections178 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross178 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes178 (edges e).src).directions j) ((envelopes178 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections178 (edges e).src with hs | hz
  · rcases fixedDirections178 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value178 : vectorGraph edges (fun i => (envelopes178 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

