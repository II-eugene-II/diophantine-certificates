without_editor_info theorem checks37 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes37 i) pi rho 13 1160 1036 2 (values 11 139 i) (certificatesC37 i) (certificatesD37 i) := by decide +kernel

without_editor_info theorem linear37 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes37 i).directions j)
      (graphStar edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes37 i).directions j = 0 ∨
      tameForm ((envelopes37 i).directions j)
        (graphStar edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross37 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes37 (edges e).src).directions j) ((envelopes37 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes37 e.src).directions = 0 ∨
      (envelopes37 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes37 e.src).directions j) ((envelopes37 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes37 (edges e).src).directions = 0 ∨
    (envelopes37 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes37 (edges e).src).directions j) ((envelopes37 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value37 : vectorGraph edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell37 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-11) (hy : (13 : ℤ)^2 ∣ y-139) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 11 139 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes37 constantC constantD certificatesC37 certificatesD37 2
