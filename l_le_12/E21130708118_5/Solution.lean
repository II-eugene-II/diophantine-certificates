without_editor_info theorem checks179 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes179 i) pi rho 7 1353 1047 2 (values 37 4 i) (certificatesC179 i) (certificatesD179 i) := by decide +kernel

without_editor_info theorem fixedDirections179 : ∀ i : Fin 55,
    i=8 ∨ (envelopes179 i).directions=0 := by decide +kernel

without_editor_info theorem linear179 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes179 i).directions j)
      (graphStar edges (fun i => (envelopes179 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes179 8).directions k)
      (graphStar edges (fun i => (envelopes179 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 8)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections179 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross179 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes179 (edges e).src).directions j) ((envelopes179 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections179 (edges e).src with hs | hz
  · rcases fixedDirections179 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value179 : vectorGraph edges (fun i => (envelopes179 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell179 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-37) (hy : (7 : ℤ)^2 ∣ y-4) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 37 4 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes179 constantC constantD certificatesC179 certificatesD179 1
