without_editor_info theorem checks143 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes143 i) pi rho 7 1353 1047 3 (values 282 340 i) (certificatesC143 i) (certificatesD143 i) := by decide +kernel

without_editor_info theorem zeroDirections143 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes143 i).directions j=0 := by decide +kernel

without_editor_info theorem linear143 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes143 i).directions j)
      (graphStar edges (fun i => (envelopes143 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections143 i k]
  simp [tameForm]

without_editor_info theorem cross143 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes143 (edges e).src).directions j) ((envelopes143 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections143 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value143 : vectorGraph edges (fun i => (envelopes143 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell143 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-282) (hy : (7 : ℤ)^3 ∣ y-340) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 282 340 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes143 constantC constantD certificatesC143 certificatesD143 1
