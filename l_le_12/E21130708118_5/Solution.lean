without_editor_info theorem zeroDirections16 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes16 i).directions j=0 := by decide +kernel

without_editor_info theorem linear16 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes16 i).directions j)
      (graphStar edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections16 i k]
  simp [tameForm]

without_editor_info theorem cross16 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes16 (edges e).src).directions j) ((envelopes16 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections16 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value16 : vectorGraph edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

