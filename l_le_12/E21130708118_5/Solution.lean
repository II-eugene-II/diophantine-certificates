    (hx : (7 : ℤ)^4 ∣ x-2077) (hy : (7 : ℤ)^4 ∣ y-1356) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 2077 1356 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes16 constantC constantD certificatesC16 certificatesD16 1
