  simp [tameForm]

without_editor_info theorem cross134 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes134 (edges e).src).directions j) ((envelopes134 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections134 ((edges e).src) i]
  simp [tameForm]

