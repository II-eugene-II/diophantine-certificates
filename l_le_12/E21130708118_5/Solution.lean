without_editor_info theorem checks135 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes135 i) pi rho 13 1160 1036 2 (values 61 11 i) (certificatesC135 i) (certificatesD135 i) := by decide +kernel

without_editor_info theorem linear135 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes135 i).directions j)
      (graphStar edges (fun i => (envelopes135 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes135 i).directions j = 0 ∨
      tameForm ((envelopes135 i).directions j)
        (graphStar edges (fun i => (envelopes135 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross135 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes135 (edges e).src).directions j) ((envelopes135 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes135 e.src).directions = 0 ∨
      (envelopes135 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes135 e.src).directions j) ((envelopes135 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes135 (edges e).src).directions = 0 ∨
    (envelopes135 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes135 (edges e).src).directions j) ((envelopes135 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value135 : vectorGraph edges (fun i => (envelopes135 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
