without_editor_info theorem checks207 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes207 i) pi rho 13 1160 1036 2 (values 157 149 i) (certificatesC207 i) (certificatesD207 i) := by decide +kernel

without_editor_info theorem fixedDirections207 : ∀ i : Fin 55,
    i=42 ∨ (envelopes207 i).directions=0 := by decide +kernel

without_editor_info theorem linear207 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes207 i).directions j)
      (graphStar edges (fun i => (envelopes207 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes207 42).directions k)
      (graphStar edges (fun i => (envelopes207 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 42)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections207 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross207 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes207 (edges e).src).directions j) ((envelopes207 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections207 (edges e).src with hs | hz
  · rcases fixedDirections207 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value207 : vectorGraph edges (fun i => (envelopes207 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

