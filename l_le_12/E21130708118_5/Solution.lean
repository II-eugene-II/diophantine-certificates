without_editor_info theorem checks127 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes127 i) pi rho 7 1353 1047 3 (values 23 321 i) (certificatesC127 i) (certificatesD127 i) := by decide +kernel

without_editor_info theorem fixedDirections127 : ∀ i : Fin 55,
    i=35 ∨ (envelopes127 i).directions=0 := by decide +kernel

without_editor_info theorem linear127 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes127 i).directions j)
      (graphStar edges (fun i => (envelopes127 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes127 35).directions k)
      (graphStar edges (fun i => (envelopes127 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 35)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections127 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross127 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes127 (edges e).src).directions j) ((envelopes127 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections127 (edges e).src with hs | hz
  · rcases fixedDirections127 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value127 : vectorGraph edges (fun i => (envelopes127 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell127 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-23) (hy : (7 : ℤ)^3 ∣ y-321) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 23 321 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes127 constantC constantD certificatesC127 certificatesD127 1
