without_editor_info theorem checks58 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes58 i) pi rho 7 1353 1047 4 (values 649 2038 i) (certificatesC58 i) (certificatesD58 i) := by decide +kernel

without_editor_info theorem fixedDirections58 : ∀ i : Fin 55,
    i=37 ∨ (envelopes58 i).directions=0 := by decide +kernel

without_editor_info theorem linear58 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes58 i).directions j)
      (graphStar edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes58 37).directions k)
      (graphStar edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 37)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections58 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross58 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes58 (edges e).src).directions j) ((envelopes58 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections58 (edges e).src with hs | hz
  · rcases fixedDirections58 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value58 : vectorGraph edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

