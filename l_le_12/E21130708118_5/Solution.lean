    (envelopes260 i).directions j=0 := by decide +kernel

without_editor_info theorem linear260 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes260 i).directions j)
      (graphStar edges (fun i => (envelopes260 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections260 i k]
  simp [tameForm]

without_editor_info theorem cross260 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes260 (edges e).src).directions j) ((envelopes260 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections260 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value260 : vectorGraph edges (fun i => (envelopes260 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
