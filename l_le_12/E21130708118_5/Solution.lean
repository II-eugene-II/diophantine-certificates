without_editor_info theorem checks100 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes100 i) pi rho 7 1353 1047 3 (values 116 43 i) (certificatesC100 i) (certificatesD100 i) := by decide +kernel

without_editor_info theorem fixedDirections100 : ∀ i : Fin 55,
    i=54 ∨ (envelopes100 i).directions=0 := by decide +kernel

without_editor_info theorem linear100 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes100 i).directions j)
      (graphStar edges (fun i => (envelopes100 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes100 54).directions k)
      (graphStar edges (fun i => (envelopes100 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 54)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections100 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross100 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes100 (edges e).src).directions j) ((envelopes100 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections100 (edges e).src with hs | hz
  · rcases fixedDirections100 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value100 : vectorGraph edges (fun i => (envelopes100 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell100 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-116) (hy : (7 : ℤ)^3 ∣ y-43) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 116 43 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes100 constantC constantD certificatesC100 certificatesD100 1
