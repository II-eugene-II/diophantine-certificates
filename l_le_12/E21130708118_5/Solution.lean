without_editor_info theorem checks85 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes85 i) pi rho 13 1160 1036 3 (values 1921 1519 i) (certificatesC85 i) (certificatesD85 i) := by decide +kernel

without_editor_info theorem zeroDirections85 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes85 i).directions j=0 := by decide +kernel

without_editor_info theorem linear85 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes85 i).directions j)
      (graphStar edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections85 i k]
  simp [tameForm]

without_editor_info theorem cross85 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes85 (edges e).src).directions j) ((envelopes85 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections85 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value85 : vectorGraph edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell85 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1921) (hy : (13 : ℤ)^3 ∣ y-1519) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1921 1519 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes85 constantC constantD certificatesC85 certificatesD85 2
