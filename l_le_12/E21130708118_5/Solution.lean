  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross184 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes184 (edges e).src).directions j) ((envelopes184 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections184 (edges e).src with hs | hz
  · rcases fixedDirections184 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

