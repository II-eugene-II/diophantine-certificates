  simp [tameForm]

without_editor_info theorem cross96 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes96 (edges e).src).directions j) ((envelopes96 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections96 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value96 : vectorGraph edges (fun i => (envelopes96 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
