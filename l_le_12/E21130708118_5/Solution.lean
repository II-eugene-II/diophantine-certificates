    tameForm ((envelopes178 i).directions j)
      (graphStar edges (fun i => (envelopes178 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections178 i k]
  simp [tameForm]

without_editor_info theorem cross178 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes178 (edges e).src).directions j) ((envelopes178 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections178 ((edges e).src) i]
  simp [tameForm]

