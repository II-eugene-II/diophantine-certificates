without_editor_info theorem checks245 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes245 i) pi rho 13 1160 1036 3 (values 2185 288 i) (certificatesC245 i) (certificatesD245 i) := by decide +kernel

without_editor_info theorem fixedDirections245 : ∀ i : Fin 55,
    i=16 ∨ (envelopes245 i).directions=0 := by decide +kernel

without_editor_info theorem linear245 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes245 i).directions j)
      (graphStar edges (fun i => (envelopes245 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes245 16).directions k)
      (graphStar edges (fun i => (envelopes245 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 16)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections245 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross245 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes245 (edges e).src).directions j) ((envelopes245 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections245 (edges e).src with hs | hz
  · rcases fixedDirections245 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value245 : vectorGraph edges (fun i => (envelopes245 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell245 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-2185) (hy : (13 : ℤ)^3 ∣ y-288) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 2185 288 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes245 constantC constantD certificatesC245 certificatesD245 2
