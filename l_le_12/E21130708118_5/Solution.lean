without_editor_info theorem zeroDirections75 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes75 i).directions j=0 := by decide +kernel

without_editor_info theorem linear75 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes75 i).directions j)
      (graphStar edges (fun i => (envelopes75 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections75 i k]
  simp [tameForm]

without_editor_info theorem cross75 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes75 (edges e).src).directions j) ((envelopes75 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections75 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value75 : vectorGraph edges (fun i => (envelopes75 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

