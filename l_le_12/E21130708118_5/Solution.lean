without_editor_info theorem checks219 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes219 i) pi rho 13 1160 1036 2 (values 1 162 i) (certificatesC219 i) (certificatesD219 i) := by decide +kernel

without_editor_info theorem fixedDirections219 : ∀ i : Fin 55,
    i=24 ∨ (envelopes219 i).directions=0 := by decide +kernel

without_editor_info theorem linear219 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes219 i).directions j)
      (graphStar edges (fun i => (envelopes219 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes219 24).directions k)
      (graphStar edges (fun i => (envelopes219 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 24)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections219 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross219 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes219 (edges e).src).directions j) ((envelopes219 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections219 (edges e).src with hs | hz
  · rcases fixedDirections219 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value219 : vectorGraph edges (fun i => (envelopes219 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell219 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-1) (hy : (13 : ℤ)^2 ∣ y-162) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1 162 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes219 constantC constantD certificatesC219 certificatesD219 2
