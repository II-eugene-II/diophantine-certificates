without_editor_info theorem checks141 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes141 i) pi rho 7 1353 1047 4 (values 9 1868 i) (certificatesC141 i) (certificatesD141 i) := by decide +kernel

without_editor_info theorem zeroDirections141 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes141 i).directions j=0 := by decide +kernel

without_editor_info theorem linear141 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes141 i).directions j)
      (graphStar edges (fun i => (envelopes141 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections141 i k]
  simp [tameForm]

without_editor_info theorem cross141 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes141 (edges e).src).directions j) ((envelopes141 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections141 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value141 : vectorGraph edges (fun i => (envelopes141 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell141 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-9) (hy : (7 : ℤ)^4 ∣ y-1868) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 9 1868 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes141 constantC constantD certificatesC141 certificatesD141 1
