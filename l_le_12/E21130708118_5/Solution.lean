without_editor_info theorem checks162 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes162 i) pi rho 7 1353 1047 3 (values 135 123 i) (certificatesC162 i) (certificatesD162 i) := by decide +kernel

without_editor_info theorem zeroDirections162 : ∀ i : Fin 55, ∀ j : Fin 4,
    (envelopes162 i).directions j=0 := by decide +kernel

without_editor_info theorem linear162 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes162 i).directions j)
      (graphStar edges (fun i => (envelopes162 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections162 i k]
  simp [tameForm]

without_editor_info theorem cross162 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes162 (edges e).src).directions j) ((envelopes162 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections162 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value162 : vectorGraph edges (fun i => (envelopes162 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell162 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-135) (hy : (7 : ℤ)^3 ∣ y-123) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 135 123 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes162 constantC constantD certificatesC162 certificatesD162 1
