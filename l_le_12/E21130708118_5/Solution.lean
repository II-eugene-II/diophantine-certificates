    (envelopes51 i).directions j=0 := by decide +kernel

without_editor_info theorem linear51 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes51 i).directions j)
      (graphStar edges (fun i => (envelopes51 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections51 i k]
  simp [tameForm]

without_editor_info theorem cross51 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes51 (edges e).src).directions j) ((envelopes51 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections51 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value51 : vectorGraph edges (fun i => (envelopes51 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
