without_editor_info theorem linear154 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes154 i).directions j)
      (graphStar edges (fun i => (envelopes154 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 55, ∀ j : Fin 4, (envelopes154 i).directions j = 0 ∨
      tameForm ((envelopes154 i).directions j)
        (graphStar edges (fun i => (envelopes154 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross154 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes154 (edges e).src).directions j) ((envelopes154 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 249) edgeList (by decide)
    (fun e => (envelopes154 e.src).directions = 0 ∨
      (envelopes154 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes154 e.src).directions j) ((envelopes154 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes154 (edges e).src).directions = 0 ∨
    (envelopes154 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes154 (edges e).src).directions j) ((envelopes154 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

