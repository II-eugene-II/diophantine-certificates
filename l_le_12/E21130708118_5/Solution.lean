without_editor_info theorem checks201 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes201 i) pi rho 13 1160 1036 3 (values 509 1906 i) (certificatesC201 i) (certificatesD201 i) := by decide +kernel

without_editor_info theorem fixedDirections201 : ∀ i : Fin 55,
    i=12 ∨ (envelopes201 i).directions=0 := by decide +kernel

without_editor_info theorem linear201 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes201 i).directions j)
      (graphStar edges (fun i => (envelopes201 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes201 12).directions k)
      (graphStar edges (fun i => (envelopes201 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 12)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections201 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross201 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes201 (edges e).src).directions j) ((envelopes201 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections201 (edges e).src with hs | hz
  · rcases fixedDirections201 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value201 : vectorGraph edges (fun i => (envelopes201 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 2 := by
