without_editor_info theorem checks91 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes91 i) pi rho 7 1353 1047 4 (values 221 1730 i) (certificatesC91 i) (certificatesD91 i) := by decide +kernel

without_editor_info theorem fixedDirections91 : ∀ i : Fin 55,
    i=8 ∨ (envelopes91 i).directions=0 := by decide +kernel

without_editor_info theorem linear91 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes91 i).directions j)
      (graphStar edges (fun i => (envelopes91 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes91 8).directions k)
      (graphStar edges (fun i => (envelopes91 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 8)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections91 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross91 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes91 (edges e).src).directions j) ((envelopes91 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections91 (edges e).src with hs | hz
  · rcases fixedDirections91 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value91 : vectorGraph edges (fun i => (envelopes91 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell91 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-221) (hy : (7 : ℤ)^4 ∣ y-1730) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 221 1730 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes91 constantC constantD certificatesC91 certificatesD91 1
