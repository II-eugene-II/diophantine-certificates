without_editor_info theorem checks104 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes104 i) pi rho 7 1353 1047 2 (values 4 1 i) (certificatesC104 i) (certificatesD104 i) := by decide +kernel

without_editor_info theorem fixedDirections104 : ∀ i : Fin 55,
    i=0 ∨ (envelopes104 i).directions=0 := by decide +kernel

without_editor_info theorem linear104 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes104 i).directions j)
      (graphStar edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes104 0).directions k)
      (graphStar edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 0)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections104 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross104 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes104 (edges e).src).directions j) ((envelopes104 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections104 (edges e).src with hs | hz
  · rcases fixedDirections104 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value104 : vectorGraph edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 1 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell104 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-4) (hy : (7 : ℤ)^2 ∣ y-1) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 1 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 4 1 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes104 constantC constantD certificatesC104 certificatesD104 1
