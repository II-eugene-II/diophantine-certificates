    (hx : (13 : ℤ)^3 ∣ x-1245) (hy : (13 : ℤ)^3 ∣ y-2195) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 2 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1245 2195 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes89 constantC constantD certificatesC89 certificatesD89 2
