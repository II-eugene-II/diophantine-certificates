without_editor_info theorem checks130 : ∀ i : Fin 55, jointEnvelopeFastCheck (envelopes130 i) pi rho 13 1160 1036 2 (values 126 50 i) (certificatesC130 i) (certificatesD130 i) := by decide +kernel

without_editor_info theorem fixedDirections130 : ∀ i : Fin 55,
    i=43 ∨ (envelopes130 i).directions=0 := by decide +kernel

without_editor_info theorem linear130 : ∀ i : Fin 55, ∀ j : Fin 4,
    tameForm ((envelopes130 i).directions j)
      (graphStar edges (fun i => (envelopes130 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes130 43).directions k)
      (graphStar edges (fun i => (envelopes130 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 43)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections130 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross130 : ∀ e : Fin 249, ∀ j k : Fin 4,
    tameForm ((envelopes130 (edges e).src).directions j) ((envelopes130 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections130 (edges e).src with hs | hz
  · rcases fixedDirections130 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

