without_editor_info theorem checks65 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes65 i) pi rho 31 439 521 2 (values 261 840 i) (certificatesC65 i) (certificatesD65 i) := by decide +kernel

without_editor_info theorem fixedDirections65 : ∀ i : Fin 75,
    i=57 ∨ (envelopes65 i).directions=0 := by decide +kernel

without_editor_info theorem linear65 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes65 i).directions j)
      (graphStar edges (fun i => (envelopes65 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes65 57).directions k)
      (graphStar edges (fun i => (envelopes65 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 57)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections65 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross65 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes65 (edges e).src).directions j) ((envelopes65 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections65 (edges e).src with hs | hz
  · rcases fixedDirections65 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value65 : vectorGraph edges (fun i => (envelopes65 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell65 {x y : ℤ} (hf : equation x y = 0)
    (hx : (31 : ℤ)^2 ∣ x-261) (hy : (31 : ℤ)^2 ∣ y-840) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 439 521 261 840 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes65 constantC constantD certificatesC65 certificatesD65 0
