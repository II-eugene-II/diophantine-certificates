without_editor_info theorem checks256 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes256 i) pi rho 13 1160 1036 3 (values 499 491 i) (certificatesC256 i) (certificatesD256 i) := by decide +kernel

without_editor_info theorem linear256 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes256 i).directions j)
      (graphStar edges (fun i => (envelopes256 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 75, ∀ j : Fin 4, (envelopes256 i).directions j = 0 ∨
      tameForm ((envelopes256 i).directions j)
        (graphStar edges (fun i => (envelopes256 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross256 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes256 (edges e).src).directions j) ((envelopes256 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 382) edgeList (by decide)
    (fun e => (envelopes256 e.src).directions = 0 ∨
      (envelopes256 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes256 e.src).directions j) ((envelopes256 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes256 (edges e).src).directions = 0 ∨
    (envelopes256 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes256 (edges e).src).directions j) ((envelopes256 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value256 : vectorGraph edges (fun i => (envelopes256 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell256 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-499) (hy : (13 : ℤ)^3 ∣ y-491) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 499 491 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes256 constantC constantD certificatesC256 certificatesD256 0
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks256 i))
    linear256 cross256 value256 hx hy

