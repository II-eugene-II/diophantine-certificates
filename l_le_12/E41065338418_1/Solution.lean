    (hx : (19 : ℤ)^3 ∣ x-756) (hy : (19 : ℤ)^3 ∣ y-4744) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
