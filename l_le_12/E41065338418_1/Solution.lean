without_editor_info theorem checks216 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes216 i) pi rho 13 1160 1036 3 (values 2088 86 i) (certificatesC216 i) (certificatesD216 i) := by decide +kernel

without_editor_info theorem fixedDirections216 : ∀ i : Fin 75,
    i=55 ∨ (envelopes216 i).directions=0 := by decide +kernel

without_editor_info theorem linear216 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes216 i).directions j)
      (graphStar edges (fun i => (envelopes216 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes216 55).directions k)
      (graphStar edges (fun i => (envelopes216 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 55)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections216 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross216 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes216 (edges e).src).directions j) ((envelopes216 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections216 (edges e).src with hs | hz
  · rcases fixedDirections216 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value216 : vectorGraph edges (fun i => (envelopes216 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

