without_editor_info theorem checks11 : ∀ i : Fin 75, inertEnvelopeCheck (envelopes11 i) 5 (residueE (5^1) (values 0 3 i)) 1 (real i) (certificates11 i) := by decide +kernel

without_editor_info theorem fixedDirections11 : ∀ i : Fin 75,
    i=7 ∨ (envelopes11 i).directions=0 := by decide +kernel

without_editor_info theorem linear11 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes11 i).directions j)
      (graphStar edges (fun i => (envelopes11 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes11 7).directions k)
      (graphStar edges (fun i => (envelopes11 i).base) (fun i => (constantCertificates i).vector) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections11 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross11 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes11 (edges e).src).directions j) ((envelopes11 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections11 (edges e).src with hs | hz
  · rcases fixedDirections11 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

