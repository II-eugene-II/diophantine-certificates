    i=11 ∨ (envelopes309 i).directions=0 := by decide +kernel

without_editor_info theorem linear309 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes309 i).directions j)
      (graphStar edges (fun i => (envelopes309 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes309 11).directions k)
      (graphStar edges (fun i => (envelopes309 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 11)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections309 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross309 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes309 (edges e).src).directions j) ((envelopes309 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections309 (edges e).src with hs | hz
  · rcases fixedDirections309 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value309 : vectorGraph edges (fun i => (envelopes309 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

