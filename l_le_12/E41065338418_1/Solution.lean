without_editor_info theorem checks71 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes71 i) pi rho 31 439 521 2 (values 75 127 i) (certificatesC71 i) (certificatesD71 i) := by decide +kernel

without_editor_info theorem fixedDirections71 : ∀ i : Fin 75,
    i=55 ∨ (envelopes71 i).directions=0 := by decide +kernel

without_editor_info theorem linear71 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes71 i).directions j)
      (graphStar edges (fun i => (envelopes71 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes71 55).directions k)
      (graphStar edges (fun i => (envelopes71 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 55)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections71 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross71 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes71 (edges e).src).directions j) ((envelopes71 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections71 (edges e).src with hs | hz
  · rcases fixedDirections71 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value71 : vectorGraph edges (fun i => (envelopes71 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell71 {x y : ℤ} (hf : equation x y = 0)
    (hx : (31 : ℤ)^2 ∣ x-75) (hy : (31 : ℤ)^2 ∣ y-127) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 439 521 75 127 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes71 constantC constantD certificatesC71 certificatesD71 0
