    (hx : (19 : ℤ)^3 ∣ x-6319) (hy : (19 : ℤ)^3 ∣ y-3464) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 2819 4039 6319 3464 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes48 constantC constantD certificatesC48 certificatesD48 0
