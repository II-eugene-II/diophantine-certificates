without_editor_info theorem checks48 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes48 i) pi rho 19 2819 4039 3 (values 6319 3464 i) (certificatesC48 i) (certificatesD48 i) := by decide +kernel

without_editor_info theorem zeroDirections48 : ∀ i : Fin 75, ∀ j : Fin 4,
    (envelopes48 i).directions j=0 := by decide +kernel

without_editor_info theorem linear48 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes48 i).directions j)
      (graphStar edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections48 i k]
  simp [tameForm]

without_editor_info theorem cross48 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes48 (edges e).src).directions j) ((envelopes48 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections48 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value48 : vectorGraph edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

