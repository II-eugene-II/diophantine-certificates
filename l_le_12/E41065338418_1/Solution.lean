    (fun e => (envelopes50 e.src).directions = 0 ∨
      (envelopes50 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes50 e.src).directions j) ((envelopes50 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes50 (edges e).src).directions = 0 ∨
    (envelopes50 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes50 (edges e).src).directions j) ((envelopes50 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

