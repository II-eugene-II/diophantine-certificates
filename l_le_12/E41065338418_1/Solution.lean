without_editor_info theorem checks49 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes49 i) pi rho 7 1353 1047 4 (values 1426 524 i) (certificatesC49 i) (certificatesD49 i) := by decide +kernel

without_editor_info theorem linear49 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes49 i).directions j)
      (graphStar edges (fun i => (envelopes49 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 75, ∀ j : Fin 4, (envelopes49 i).directions j = 0 ∨
      tameForm ((envelopes49 i).directions j)
        (graphStar edges (fun i => (envelopes49 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross49 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes49 (edges e).src).directions j) ((envelopes49 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 382) edgeList (by decide)
    (fun e => (envelopes49 e.src).directions = 0 ∨
      (envelopes49 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes49 e.src).directions j) ((envelopes49 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes49 (edges e).src).directions = 0 ∨
    (envelopes49 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes49 (edges e).src).directions j) ((envelopes49 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

