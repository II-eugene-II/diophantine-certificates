without_editor_info theorem checks71 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes71 i) pi rho 19 2819 4039 2 (values 68 329 i) (certificatesC71 i) (certificatesD71 i) := by decide +kernel

without_editor_info theorem linear71 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes71 i).directions j)
      (graphStar edges (fun i => (envelopes71 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 75, ∀ j : Fin 4, (envelopes71 i).directions j = 0 ∨
      tameForm ((envelopes71 i).directions j)
        (graphStar edges (fun i => (envelopes71 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross71 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes71 (edges e).src).directions j) ((envelopes71 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 382) edgeList (by decide)
    (fun e => (envelopes71 e.src).directions = 0 ∨
      (envelopes71 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes71 e.src).directions j) ((envelopes71 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes71 (edges e).src).directions = 0 ∨
    (envelopes71 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes71 (edges e).src).directions j) ((envelopes71 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

