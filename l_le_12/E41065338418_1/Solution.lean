    (hx : (31 : ℤ)^2 ∣ x-453) (hy : (31 : ℤ)^2 ∣ y-60) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 439 521 453 60 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes24 constantC constantD certificatesC24 certificatesD24 0
