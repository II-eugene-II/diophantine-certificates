without_editor_info theorem linear109 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes109 i).directions j)
      (graphStar edges (fun i => (envelopes109 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 75, ∀ j : Fin 4, (envelopes109 i).directions j = 0 ∨
      tameForm ((envelopes109 i).directions j)
        (graphStar edges (fun i => (envelopes109 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross109 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes109 (edges e).src).directions j) ((envelopes109 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 382) edgeList (by decide)
    (fun e => (envelopes109 e.src).directions = 0 ∨
      (envelopes109 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes109 e.src).directions j) ((envelopes109 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes109 (edges e).src).directions = 0 ∨
    (envelopes109 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes109 (edges e).src).directions j) ((envelopes109 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

