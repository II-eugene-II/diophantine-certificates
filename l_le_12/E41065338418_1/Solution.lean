without_editor_info theorem checks24 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes24 i) pi rho 19 2819 4039 3 (values 4005 6188 i) (certificatesC24 i) (certificatesD24 i) := by decide +kernel

without_editor_info theorem fixedDirections24 : ∀ i : Fin 75,
    i=54 ∨ (envelopes24 i).directions=0 := by decide +kernel

without_editor_info theorem linear24 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes24 i).directions j)
      (graphStar edges (fun i => (envelopes24 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes24 54).directions k)
      (graphStar edges (fun i => (envelopes24 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 54)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections24 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross24 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes24 (edges e).src).directions j) ((envelopes24 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections24 (edges e).src with hs | hz
  · rcases fixedDirections24 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value24 : vectorGraph edges (fun i => (envelopes24 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
