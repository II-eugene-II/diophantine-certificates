without_editor_info theorem checks15 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes15 i) pi rho 7 1353 1047 3 (values 278 321 i) (certificatesC15 i) (certificatesD15 i) := by decide +kernel

without_editor_info theorem fixedDirections15 : ∀ i : Fin 75,
    i=51 ∨ (envelopes15 i).directions=0 := by decide +kernel

without_editor_info theorem linear15 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes15 i).directions j)
      (graphStar edges (fun i => (envelopes15 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes15 51).directions k)
      (graphStar edges (fun i => (envelopes15 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections15 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross15 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes15 (edges e).src).directions j) ((envelopes15 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections15 (edges e).src with hs | hz
  · rcases fixedDirections15 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value15 : vectorGraph edges (fun i => (envelopes15 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell15 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-278) (hy : (7 : ℤ)^3 ∣ y-321) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 278 321 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes15 constantC constantD certificatesC15 certificatesD15 0
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks15 i))
