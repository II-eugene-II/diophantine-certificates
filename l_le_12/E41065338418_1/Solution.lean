without_editor_info theorem checks223 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes223 i) pi rho 19 2819 4039 3 (values 1466 4790 i) (certificatesC223 i) (certificatesD223 i) := by decide +kernel

without_editor_info theorem fixedDirections223 : ∀ i : Fin 75,
    i=35 ∨ (envelopes223 i).directions=0 := by decide +kernel

without_editor_info theorem linear223 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes223 i).directions j)
      (graphStar edges (fun i => (envelopes223 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes223 35).directions k)
      (graphStar edges (fun i => (envelopes223 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 35)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections223 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross223 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes223 (edges e).src).directions j) ((envelopes223 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections223 (edges e).src with hs | hz
  · rcases fixedDirections223 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value223 : vectorGraph edges (fun i => (envelopes223 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
