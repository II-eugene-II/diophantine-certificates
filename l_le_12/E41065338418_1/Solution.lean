  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1 32 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes309 constantC constantD certificatesC309 certificatesD309 0
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks309 i))
    linear309 cross309 value309 hx hy

