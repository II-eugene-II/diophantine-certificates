without_editor_info theorem checks222 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes222 i) pi rho 19 2819 4039 3 (values 1827 5512 i) (certificatesC222 i) (certificatesD222 i) := by decide +kernel

without_editor_info theorem fixedDirections222 : ∀ i : Fin 75,
    i=6 ∨ (envelopes222 i).directions=0 := by decide +kernel

without_editor_info theorem linear222 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes222 i).directions j)
      (graphStar edges (fun i => (envelopes222 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes222 6).directions k)
      (graphStar edges (fun i => (envelopes222 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 6)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections222 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross222 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes222 (edges e).src).directions j) ((envelopes222 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections222 (edges e).src with hs | hz
  · rcases fixedDirections222 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

