    tameForm ((envelopes144 (edges e).src).directions j) ((envelopes144 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 382) edgeList (by decide)
    (fun e => (envelopes144 e.src).directions = 0 ∨
      (envelopes144 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes144 e.src).directions j) ((envelopes144 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes144 (edges e).src).directions = 0 ∨
    (envelopes144 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes144 (edges e).src).directions j) ((envelopes144 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

