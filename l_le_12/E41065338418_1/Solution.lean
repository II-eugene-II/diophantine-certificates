without_editor_info theorem linear293 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes293 i).directions j)
      (graphStar edges (fun i => (envelopes293 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes293 59).directions k)
      (graphStar edges (fun i => (envelopes293 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 59)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections293 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross293 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes293 (edges e).src).directions j) ((envelopes293 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections293 (edges e).src with hs | hz
  · rcases fixedDirections293 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

