without_editor_info theorem checks33 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes33 i) pi rho 19 2819 4039 3 (values 756 4744 i) (certificatesC33 i) (certificatesD33 i) := by decide +kernel

without_editor_info theorem linear33 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes33 i).directions j)
      (graphStar edges (fun i => (envelopes33 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 75, ∀ j : Fin 4, (envelopes33 i).directions j = 0 ∨
      tameForm ((envelopes33 i).directions j)
        (graphStar edges (fun i => (envelopes33 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross33 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes33 (edges e).src).directions j) ((envelopes33 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 382) edgeList (by decide)
    (fun e => (envelopes33 e.src).directions = 0 ∨
      (envelopes33 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes33 e.src).directions j) ((envelopes33 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes33 (edges e).src).directions = 0 ∨
    (envelopes33 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes33 (edges e).src).directions j) ((envelopes33 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

