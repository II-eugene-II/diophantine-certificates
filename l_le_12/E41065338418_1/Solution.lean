  split_cell edges values constants values_congr pi rho away_pi away_rho 37 787 581 1 5 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤2)).trans root_rho)
    envelopes192 constantC constantD certificatesC192 certificatesD192 0
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks192 i))
    linear192 cross192 value192 hx hy

