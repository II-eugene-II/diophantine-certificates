without_editor_info theorem linear47 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes47 i).directions j)
      (graphStar edges (fun i => (envelopes47 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 75, ∀ j : Fin 4, (envelopes47 i).directions j = 0 ∨
      tameForm ((envelopes47 i).directions j)
        (graphStar edges (fun i => (envelopes47 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

