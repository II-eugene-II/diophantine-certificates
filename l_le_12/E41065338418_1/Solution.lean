without_editor_info theorem zeroDirections52 : ∀ i : Fin 75, ∀ j : Fin 4,
    (envelopes52 i).directions j=0 := by decide +kernel

without_editor_info theorem linear52 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes52 i).directions j)
      (graphStar edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections52 i k]
  simp [tameForm]

without_editor_info theorem cross52 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes52 (edges e).src).directions j) ((envelopes52 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections52 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value52 : vectorGraph edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
