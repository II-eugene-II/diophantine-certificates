without_editor_info theorem checks45 : ∀ i : Fin 75, jointEnvelopeFastCheck (envelopes45 i) pi rho 19 2819 4039 2 (values 220 177 i) (certificatesC45 i) (certificatesD45 i) := by decide +kernel

without_editor_info theorem linear45 : ∀ i : Fin 75, ∀ j : Fin 4,
    tameForm ((envelopes45 i).directions j)
      (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 75, ∀ j : Fin 4, (envelopes45 i).directions j = 0 ∨
      tameForm ((envelopes45 i).directions j)
        (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross45 : ∀ e : Fin 382, ∀ j k : Fin 4,
    tameForm ((envelopes45 (edges e).src).directions j) ((envelopes45 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 382) edgeList (by decide)
    (fun e => (envelopes45 e.src).directions = 0 ∨
      (envelopes45 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes45 e.src).directions j) ((envelopes45 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes45 (edges e).src).directions = 0 ∨
    (envelopes45 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes45 (edges e).src).directions j) ((envelopes45 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

