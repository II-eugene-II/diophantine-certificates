without_editor_info def unpackWild (a : ℕ) : WildVector :=
  ![(a : ZMod 3),((a/3 : ℕ) : ZMod 3),((a/9 : ℕ) : ZMod 3),((a/27 : ℕ) : ZMod 3)]
