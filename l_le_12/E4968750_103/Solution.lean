  intro e j k
  have h := h e
  change (envelopes87 (edges e).src).directions = 0 ∨
    (envelopes87 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes87 (edges e).src).directions j) ((envelopes87 (edges e).dst).directions k) = 0) at h
