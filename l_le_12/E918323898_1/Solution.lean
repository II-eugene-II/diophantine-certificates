    (hx : (2 : ℤ)^2 ∣ x-0) (hy : (2 : ℤ)^2 ∣ y-1) : ∃ i : Fin 8, (2 : ℤ)^(residues i).2.2 ∣ x-(residues i).1 ∧ (2 : ℤ)^(residues i).2.2 ∣ y-(residues i).2.1 := by
  apply CompactResidueCover.cover equation (@equation_congr) (fun x y => ∃ i : Fin 8, (2 : ℤ)^(residues i).2.2 ∣ x-(residues i).1 ∧ (2 : ℤ)^(residues i).2.2 ∣ y-(residues i).2.1)
    2 (by decide) 4 0 1 [(0,5),(4,1)] (by decide +kernel) ?_ hf hx hy
  intro q hq
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl
  · intro X Y hF hX hY
    apply covered7 hF
    · convert hX using 1 <;> norm_num
    · convert hY using 1 <;> norm_num
  · intro X Y hF hX hY
    apply covered6 hF
