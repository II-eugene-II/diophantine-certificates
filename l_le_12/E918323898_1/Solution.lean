    (hx : (2 : ℤ)^3 ∣ x-5) (hy : (2 : ℤ)^3 ∣ y-2) : graphSum edges (values x y) constants (tame (2 : Eisenstein) away_three) = 0 :=
  inert_cell edges values constants real values_congr values_real 2 away_three (by decide) 5 2 3 envelopes1 constantCertificates certificates1 0 constants_checked checks1 linear1 cross1 value1 (all_nonzero hf) hx hy

