without_editor_info theorem linear48 : ∀ i : Fin 42, ∀ j : Fin 4,
    tameForm ((envelopes48 i).directions j)
      (graphStar edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes48 11).directions k)
      (graphStar edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 11)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections48 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross48 : ∀ e : Fin 167, ∀ j k : Fin 4,
    tameForm ((envelopes48 (edges e).src).directions j) ((envelopes48 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections48 (edges e).src with hs | hz
  · rcases fixedDirections48 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

