without_editor_info theorem checks7 : ∀ i : Fin 42, inertEnvelopeCheck (envelopes7 i) 2 (residueE (2^3) (values 0 5 i)) 3 (real i) (certificates7 i) := by decide +kernel

without_editor_info theorem noLoops : ∀ e : Fin 167, (edges e).src ≠ (edges e).dst := by
  exact listEdges_all (m := 167) edgeList (by decide)
    (fun e => e.src ≠ e.dst) (by decide +kernel)

without_editor_info theorem fixedDirections7 : ∀ i : Fin 42,
    i=35 ∨ (envelopes7 i).directions=0 := by decide +kernel

without_editor_info theorem linear7 : ∀ i : Fin 42, ∀ j : Fin 4,
    tameForm ((envelopes7 i).directions j)
      (graphStar edges (fun i => (envelopes7 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes7 35).directions k)
      (graphStar edges (fun i => (envelopes7 i).base) (fun i => (constantCertificates i).vector) 35)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections7 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross7 : ∀ e : Fin 167, ∀ j k : Fin 4,
    tameForm ((envelopes7 (edges e).src).directions j) ((envelopes7 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections7 (edges e).src with hs | hz
  · rcases fixedDirections7 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value7 : vectorGraph edges (fun i => (envelopes7 i).base) (fun i => (constantCertificates i).vector) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell7 {x y : ℤ} (hf : equation x y = 0)
    (hx : (2 : ℤ)^3 ∣ x-0) (hy : (2 : ℤ)^3 ∣ y-5) : graphSum edges (values x y) constants (tame (2 : Eisenstein) away_three) = 0 :=
  inert_cell edges values constants real values_congr values_real 2 away_three (by decide) 0 5 3 envelopes7 constantCertificates certificates7 0 constants_checked checks7 linear7 cross7 value7 (all_nonzero hf) hx hy

