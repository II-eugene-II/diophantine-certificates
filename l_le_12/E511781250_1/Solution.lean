  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross39 : ∀ e : Fin 196, ∀ j k : Fin 4,
    tameForm ((envelopes39 (edges e).src).directions j) ((envelopes39 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections39 (edges e).src with hs | hz
  · rcases fixedDirections39 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

