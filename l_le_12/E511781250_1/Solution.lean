    tameForm ((envelopes76 (edges e).src).directions j) ((envelopes76 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections76 (edges e).src with hs | hz
  · rcases fixedDirections76 (edges e).dst with ht | hz
