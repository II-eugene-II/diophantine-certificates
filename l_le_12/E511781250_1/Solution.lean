without_editor_info theorem cross51 : ∀ e : Fin 196, ∀ j k : Fin 4,
    tameForm ((envelopes51 (edges e).src).directions j) ((envelopes51 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections51 (edges e).src with hs | hz
  · rcases fixedDirections51 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

