      split_ifs <;> omega
  · have hd:(5:ℤ)^4∣a := (padicValInt_dvd_iff (p:=5) 4 a).mpr (Or.inr (by omega))
    have hz:(a:ZMod 625).val=0:=by norm_num at hd; omega
    simp [Compatible5,hz]
end PrimeClasses

