without_editor_info theorem cell1 {x y : ℤ} (hf : equation x y = 0)
    (hx : (2 : ℤ)^2 ∣ x-1) (hy : (2 : ℤ)^2 ∣ y-3) : graphSum edges (values x y) constants (tame (2 : Eisenstein) away_three) = 1 :=
  inert_cell edges values constants real values_congr values_real 2 away_three (by decide) 1 3 2 envelopes1 constantCertificates certificates1 1 constants_checked checks1 linear1 cross1 value1 (all_nonzero hf) hx hy

