without_editor_info theorem nonzero_26 {x y : ℤ} (hf : equation x y=0) : values x y 26 ≠ 0 := by
  have hfR : QuadraticNorm.eval ([(0,0,-2),(0,3,4),(1,1,1),(4,0,1)] : QuadraticNorm.Coeffs) x y=0 := by
    convert hf using 1 <;> simp [equation,F,GraphCert.Quartic.Polynomial.value,GraphCert.Quartic.Polynomial.eval,GraphCert.Quartic.Dense.eval,QuadraticNorm.eval] <;> ring
  have hn : QuadraticNorm.eval ([(0,0,-1),(1,0,1)] : QuadraticNorm.Coeffs) x y≠0 := by
    let F : QuadraticNorm.Coeffs := [(0,0,-2),(0,3,4),(1,1,1),(4,0,1)]
    let H26 : QuadraticNorm.Coeffs := [(0,0,-1),(1,0,1)]
    let equation (x y : ℤ) := QuadraticNorm.eval F x y
    have hf : equation x y=0 := hfR
    change QuadraticNorm.eval H26 x y≠0
    let P : QuadraticNorm.Coeffs := [(0,0,-1),(0,1,1),(0,3,4)]
    let A : QuadraticNorm.Coeffs := [(0,0,1)]
    let B : QuadraticNorm.Coeffs := [(0,0,-1),(0,1,-1),(1,0,-1),(2,0,-1),(3,0,-1)]
    have he : (1:ℤ)*QuadraticNorm.eval P x y=equation x y*QuadraticNorm.eval A x y+QuadraticNorm.eval H26 x y*QuadraticNorm.eval B x y := by simp [equation,F,H26,P,A,B,QuadraticNorm.eval] <;> ring
    have hp : QuadraticNorm.eval P x y≠0 := by
      by_cases hx : 1≤y
      · have ha : 0≤(y-1) := by omega
        have hid : (1:ℤ)*QuadraticNorm.eval P x y=(4:ℤ)*(y-1)^3+(12:ℤ)*(y-1)^2+(13:ℤ)*(y-1)^1+(4:ℤ)*(y-1)^0 := by norm_polynomial
        have hpos : 0<(1:ℤ)*QuadraticNorm.eval P x y := by rw [hid]; positivity
        intro hz
        rw [hz,mul_zero] at hpos
        exact (lt_irrefl _ hpos)
