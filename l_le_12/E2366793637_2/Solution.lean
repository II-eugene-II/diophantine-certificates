  have hi : (i.val:ℤ)=t % (p^precision p:ℕ) := by
    exact Int.toNat_of_nonneg (Int.emod_nonneg _ (by positivity))
  have hdb : (p:ℤ)^k ∣ (b+(p:ℤ)^k*i.val)-b := ⟨i.val,by ring⟩
