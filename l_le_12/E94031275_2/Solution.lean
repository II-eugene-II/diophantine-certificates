without_editor_info theorem checks6 : ∀ i : Fin 40, inertEnvelopeCheck (envelopes6 i) 2 (residueE (2^3) (values 0 3 i)) 3 (real i) (certificates6 i) := by decide +kernel

without_editor_info theorem fixedDirections6 : ∀ i : Fin 40,
    i=9 ∨ (envelopes6 i).directions=0 := by decide +kernel

without_editor_info theorem linear6 : ∀ i : Fin 40, ∀ j : Fin 4,
    tameForm ((envelopes6 i).directions j)
      (graphStar edges (fun i => (envelopes6 i).base) (fun i => (constantCertificates i).vector) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes6 9).directions k)
      (graphStar edges (fun i => (envelopes6 i).base) (fun i => (constantCertificates i).vector) 9)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections6 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross6 : ∀ e : Fin 163, ∀ j k : Fin 4,
    tameForm ((envelopes6 (edges e).src).directions j) ((envelopes6 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections6 (edges e).src with hs | hz
  · rcases fixedDirections6 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value6 : vectorGraph edges (fun i => (envelopes6 i).base) (fun i => (constantCertificates i).vector) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell6 {x y : ℤ} (hf : equation x y = 0)
    (hx : (2 : ℤ)^3 ∣ x-0) (hy : (2 : ℤ)^3 ∣ y-3) : graphSum edges (values x y) constants (tame (2 : Eisenstein) away_three) = 0 :=
  inert_cell edges values constants real values_congr values_real 2 away_three (by decide) 0 3 3 envelopes6 constantCertificates certificates6 0 constants_checked checks6 linear6 cross6 value6 (all_nonzero hf) hx hy

