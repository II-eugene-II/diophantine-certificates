  induction b with
  | nil => simp [scale, eval]
  | cons b bs ih => simp only [scale, List.map_cons, eval, Dense.eval_mul] at *; rw [ih]; ring

without_editor_info theorem eval_neg {R : Type*} [CommRing R] (f : ℤ →+* R)
    (a : Poly) (x y : R) : eval f (neg a) x y = -eval f a x y := by
