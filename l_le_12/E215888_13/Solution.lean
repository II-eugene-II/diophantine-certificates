without_editor_info theorem positive0 {x y : ℤ} (hf : equation x y=0) : 0 < (1:ℤ)*(eval H0 x y) := by
  dsimp [equation,F,H0,eval] at hf ⊢
  let F : QuadraticNorm.Coeffs := [(5, 0, 1), (1, 1, -1), (0, 3, 1), (0, 0, 4)]
  let H0 : QuadraticNorm.Coeffs := [(2, 0, 1), (1, 0, -1), (0, 1, -1)]
  have hf : QuadraticNorm.eval F x y = 0 := by convert hf using 1 <;> norm_polynomial
  have hs : 0 < QuadraticNorm.eval H0 x y := by
    have hd : 4 * (1 * x^4 + (-2) * x^3 + 1 * x^2 * y + 1 * x^2 + (-1) * x * y + (-1) * x + 1 * y^2) = ((1 * x^2 + (-1) * x + 2 * y))^2 + (3 * x^4 + (-6) * x^3 + 3 * x^2 + (-4) * x) := by ring
    have he : eval H0 x y * (1 * x^4 + (-2) * x^3 + 1 * x^2 * y + 1 * x^2 + (-1) * x * y + (-1) * x + 1 * y^2) = (1 * x^6 + (-2) * x^5 + 3 * x^4 + (-2) * x^3 + 1 * x^2 + 4) := by
      linear_combination (norm := norm_polynomial) ((-1)) * hf
    have hpd : (0 : ℤ) < (1 * x^6 + (-2) * x^5 + 3 * x^4 + (-2) * x^3 + 1 * x^2 + 4) ∧ (0 : ℤ) < (3 * x^4 + (-6) * x^3 + 3 * x^2 + (-4) * x) := by
      by_cases hx : x ≤ -1
      · have harg : 0 ≤ ((-1) * x + (-1)) := by omega
        constructor
        · have hz : (1 * x^6 + (-2) * x^5 + 3 * x^4 + (-2) * x^3 + 1 * x^2 + 4) = 1 * (((-1) * x + (-1)))^6 + 8 * (((-1) * x + (-1)))^5 + 28 * (((-1) * x + (-1)))^4 + 54 * (((-1) * x + (-1)))^3 + 60 * (((-1) * x + (-1)))^2 + 36 * (((-1) * x + (-1)))^1 + 13 * (((-1) * x + (-1)))^0 := by ring
          rw [hz]; positivity
        · have hz : (3 * x^4 + (-6) * x^3 + 3 * x^2 + (-4) * x) = 3 * (((-1) * x + (-1)))^4 + 18 * (((-1) * x + (-1)))^3 + 39 * (((-1) * x + (-1)))^2 + 40 * (((-1) * x + (-1)))^1 + 16 * (((-1) * x + (-1)))^0 := by ring
          rw [hz]; positivity
      by_cases hx : 2 ≤ x
      · have harg : 0 ≤ (1 * x + (-2)) := by omega
        constructor
        · have hz : (1 * x^6 + (-2) * x^5 + 3 * x^4 + (-2) * x^3 + 1 * x^2 + 4) = 1 * ((1 * x + (-2)))^6 + 10 * ((1 * x + (-2)))^5 + 43 * ((1 * x + (-2)))^4 + 102 * ((1 * x + (-2)))^3 + 141 * ((1 * x + (-2)))^2 + 108 * ((1 * x + (-2)))^1 + 40 * ((1 * x + (-2)))^0 := by ring
          rw [hz]; positivity
        · have hz : (3 * x^4 + (-6) * x^3 + 3 * x^2 + (-4) * x) = 3 * ((1 * x + (-2)))^4 + 18 * ((1 * x + (-2)))^3 + 39 * ((1 * x + (-2)))^2 + 32 * ((1 * x + (-2)))^1 + 4 * ((1 * x + (-2)))^0 := by ring
          rw [hz]; positivity
      interval_cases x
      · have hc : ∀ z : ZMod 7, eval F (0) z ≠ 0 := by decide
        have hfz : eval F ((0 : ℤ) : ZMod 7) (y : ZMod 7) = 0 := by
          rw [← cast_eval,hf,Int.cast_zero]
        exact (hc _ (by simpa using hfz)).elim
      · have hc : ∀ z : ZMod 2, eval F (1) z ≠ 0 := by decide
        have hfz : eval F ((1 : ℤ) : ZMod 2) (y : ZMod 2) = 0 := by
          rw [← cast_eval,hf,Int.cast_zero]
        exact (hc _ (by simpa using hfz)).elim
    have ht : 0 < (1 * x^4 + (-2) * x^3 + 1 * x^2 * y + 1 * x^2 + (-1) * x * y + (-1) * x + 1 * y^2) := by
      have hsum := add_pos_of_nonneg_of_pos (sq_nonneg ((1 * x^2 + (-1) * x + 2 * y))) hpd.2
      rw [← hd] at hsum
      exact (mul_pos_iff_of_pos_left (by norm_num)).mp hsum
    have hprod : 0 < eval H0 x y * (1 * x^4 + (-2) * x^3 + 1 * x^2 * y + 1 * x^2 + (-1) * x * y + (-1) * x + 1 * y^2) := by rw [he]; exact hpd.1
    exact (mul_pos_iff_of_pos_right ht).mp hprod
