  have h : ∀ k : Fin 4, tameForm ((envelopes1 21).directions k)
      (graphStar edges (fun i => (envelopes1 i).base) (fun i => (constantCertificates i).vector) 21)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
