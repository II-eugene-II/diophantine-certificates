    tameForm ((envelopes52 i).directions j)
      (graphStar edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes52 28).directions k)
      (graphStar edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 28)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections52 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross52 : ∀ e : Fin 118, ∀ j k : Fin 4,
    tameForm ((envelopes52 (edges e).src).directions j) ((envelopes52 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections52 (edges e).src with hs | hz
  · rcases fixedDirections52 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

