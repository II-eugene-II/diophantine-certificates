  let F : QuadraticNorm.Coeffs := [(4, 0, 1), (1, 0, 1), (0, 3, 1), (0, 1, 6), (0, 0, -1)]
  let H0 : QuadraticNorm.Coeffs := [(0, 1, -1), (0, 0, 1)]
  have hf : QuadraticNorm.eval F x y = 0 := by convert hf using 1 <;> norm_polynomial
  have hs : 0 < QuadraticNorm.eval H0 x y := by
    have hd : 4 * (1 * y^2 + 1 * y + 7) = ((2 * y + 1))^2 + (27) := by ring
    have he : eval H0 x y * (1 * y^2 + 1 * y + 7) = (1 * x^4 + 1 * x + 6) := by
      linear_combination (norm := norm_polynomial) ((-1)) * hf
    have hpd : (0 : ℤ) < (1 * x^4 + 1 * x + 6) ∧ (0 : ℤ) < (27) := by
      by_cases hx : x ≤ -1
      · have harg : 0 ≤ ((-1) * x + (-1)) := by omega
        constructor
        · have hz : (1 * x^4 + 1 * x + 6) = 1 * (((-1) * x + (-1)))^4 + 4 * (((-1) * x + (-1)))^3 + 6 * (((-1) * x + (-1)))^2 + 3 * (((-1) * x + (-1)))^1 + 6 * (((-1) * x + (-1)))^0 := by ring
          rw [hz]; positivity
        · have hz : (27) = 27 * (((-1) * x + (-1)))^0 := by ring
          rw [hz]; positivity
      by_cases hx : 1 ≤ x
      · have harg : 0 ≤ (1 * x + (-1)) := by omega
        constructor
        · have hz : (1 * x^4 + 1 * x + 6) = 1 * ((1 * x + (-1)))^4 + 4 * ((1 * x + (-1)))^3 + 6 * ((1 * x + (-1)))^2 + 5 * ((1 * x + (-1)))^1 + 8 * ((1 * x + (-1)))^0 := by ring
          rw [hz]; positivity
        · have hz : (27) = 27 * ((1 * x + (-1)))^0 := by ring
          rw [hz]; positivity
      interval_cases x
      · norm_num
    have ht : 0 < (1 * y^2 + 1 * y + 7) := by
      have hsum := add_pos_of_nonneg_of_pos (sq_nonneg ((2 * y + 1))) hpd.2
      rw [← hd] at hsum
      exact (mul_pos_iff_of_pos_left (by norm_num)).mp hsum
    have hprod : 0 < eval H0 x y * (1 * y^2 + 1 * y + 7) := by rw [he]; exact hpd.1
    exact (mul_pos_iff_of_pos_right ht).mp hprod
  convert hs using 1 <;> norm_polynomial

