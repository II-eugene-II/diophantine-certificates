without_editor_info theorem checks365 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes365 i) pi rho 13 1160 1036 2 (values 83 85 i) (certificatesC365 i) (certificatesD365 i) := by decide +kernel

without_editor_info theorem fixedDirections365 : ∀ i : Fin 64,
    i=33 ∨ (envelopes365 i).directions=0 := by decide +kernel

without_editor_info theorem linear365 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes365 i).directions j)
      (graphStar edges (fun i => (envelopes365 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes365 33).directions k)
      (graphStar edges (fun i => (envelopes365 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 33)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections365 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross365 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes365 (edges e).src).directions j) ((envelopes365 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections365 (edges e).src with hs | hz
  · rcases fixedDirections365 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value365 : vectorGraph edges (fun i => (envelopes365 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

