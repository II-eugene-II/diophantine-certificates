without_editor_info theorem checks305 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes305 i) pi rho 13 1160 1036 2 (values 48 28 i) (certificatesC305 i) (certificatesD305 i) := by decide +kernel

without_editor_info theorem linear305 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes305 i).directions j)
      (graphStar edges (fun i => (envelopes305 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes305 i).directions j = 0 ∨
      tameForm ((envelopes305 i).directions j)
        (graphStar edges (fun i => (envelopes305 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross305 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes305 (edges e).src).directions j) ((envelopes305 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes305 e.src).directions = 0 ∨
      (envelopes305 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes305 e.src).directions j) ((envelopes305 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes305 (edges e).src).directions = 0 ∨
    (envelopes305 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes305 (edges e).src).directions j) ((envelopes305 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

