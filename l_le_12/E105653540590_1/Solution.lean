    tameForm ((envelopes476 i).directions j)
      (graphStar edges (fun i => (envelopes476 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes476 51).directions k)
      (graphStar edges (fun i => (envelopes476 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections476 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross476 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes476 (edges e).src).directions j) ((envelopes476 (edges e).dst).directions k) = 0 := by
