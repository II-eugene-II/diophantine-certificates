without_editor_info theorem checks284 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes284 i) pi rho 13 1160 1036 2 (values 165 132 i) (certificatesC284 i) (certificatesD284 i) := by decide +kernel

without_editor_info theorem fixedDirections284 : ∀ i : Fin 64,
    i=60 ∨ (envelopes284 i).directions=0 := by decide +kernel

without_editor_info theorem linear284 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes284 i).directions j)
      (graphStar edges (fun i => (envelopes284 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes284 60).directions k)
      (graphStar edges (fun i => (envelopes284 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 60)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections284 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross284 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes284 (edges e).src).directions j) ((envelopes284 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections284 (edges e).src with hs | hz
  · rcases fixedDirections284 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value284 : vectorGraph edges (fun i => (envelopes284 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
