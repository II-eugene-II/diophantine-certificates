without_editor_info theorem checks35 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes35 i) pi rho 7 1353 1047 3 (values 311 318 i) (certificatesC35 i) (certificatesD35 i) := by decide +kernel

without_editor_info theorem zeroDirections35 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes35 i).directions j=0 := by decide +kernel

without_editor_info theorem linear35 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes35 i).directions j)
      (graphStar edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections35 i k]
  simp [tameForm]

without_editor_info theorem cross35 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes35 (edges e).src).directions j) ((envelopes35 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections35 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value35 : vectorGraph edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell35 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-311) (hy : (7 : ℤ)^3 ∣ y-318) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 311 318 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes35 constantC constantD certificatesC35 certificatesD35 0
