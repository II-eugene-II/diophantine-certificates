without_editor_info theorem checks32 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes32 i) pi rho 7 1353 1047 2 (values 38 17 i) (certificatesC32 i) (certificatesD32 i) := by decide +kernel

without_editor_info theorem linear32 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes32 i).directions j)
      (graphStar edges (fun i => (envelopes32 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes32 i).directions j = 0 ∨
      tameForm ((envelopes32 i).directions j)
        (graphStar edges (fun i => (envelopes32 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross32 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes32 (edges e).src).directions j) ((envelopes32 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes32 e.src).directions = 0 ∨
      (envelopes32 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes32 e.src).directions j) ((envelopes32 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes32 (edges e).src).directions = 0 ∨
    (envelopes32 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes32 (edges e).src).directions j) ((envelopes32 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value32 : vectorGraph edges (fun i => (envelopes32 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell32 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-38) (hy : (7 : ℤ)^2 ∣ y-17) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 38 17 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes32 constantC constantD certificatesC32 certificatesD32 0
