without_editor_info theorem checks101 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes101 i) pi rho 13 1160 1036 2 (values 11 91 i) (certificatesC101 i) (certificatesD101 i) := by decide +kernel

without_editor_info theorem linear101 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes101 i).directions j)
      (graphStar edges (fun i => (envelopes101 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes101 i).directions j = 0 ∨
      tameForm ((envelopes101 i).directions j)
        (graphStar edges (fun i => (envelopes101 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross101 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes101 (edges e).src).directions j) ((envelopes101 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes101 e.src).directions = 0 ∨
      (envelopes101 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes101 e.src).directions j) ((envelopes101 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes101 (edges e).src).directions = 0 ∨
    (envelopes101 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes101 (edges e).src).directions j) ((envelopes101 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value101 : vectorGraph edges (fun i => (envelopes101 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell101 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-11) (hy : (13 : ℤ)^2 ∣ y-91) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 11 91 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes101 constantC constantD certificatesC101 certificatesD101 0
