without_editor_info theorem checks37 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes37 i) pi rho 7 1353 1047 3 (values 213 122 i) (certificatesC37 i) (certificatesD37 i) := by decide +kernel

without_editor_info theorem linear37 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes37 i).directions j)
      (graphStar edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes37 i).directions j = 0 ∨
      tameForm ((envelopes37 i).directions j)
        (graphStar edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross37 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes37 (edges e).src).directions j) ((envelopes37 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes37 e.src).directions = 0 ∨
      (envelopes37 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes37 e.src).directions j) ((envelopes37 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes37 (edges e).src).directions = 0 ∨
    (envelopes37 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes37 (edges e).src).directions j) ((envelopes37 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

