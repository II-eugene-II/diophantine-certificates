without_editor_info theorem checks312 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes312 i) pi rho 13 1160 1036 2 (values 124 102 i) (certificatesC312 i) (certificatesD312 i) := by decide +kernel

without_editor_info theorem linear312 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes312 i).directions j)
      (graphStar edges (fun i => (envelopes312 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes312 i).directions j = 0 ∨
      tameForm ((envelopes312 i).directions j)
        (graphStar edges (fun i => (envelopes312 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross312 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes312 (edges e).src).directions j) ((envelopes312 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes312 e.src).directions = 0 ∨
      (envelopes312 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes312 e.src).directions j) ((envelopes312 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes312 (edges e).src).directions = 0 ∨
    (envelopes312 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes312 (edges e).src).directions j) ((envelopes312 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

