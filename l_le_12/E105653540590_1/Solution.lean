  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 10 10 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes42 constantC constantD certificatesC42 certificatesD42 0
