without_editor_info theorem checks303 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes303 i) pi rho 13 1160 1036 3 (values 74 1835 i) (certificatesC303 i) (certificatesD303 i) := by decide +kernel

without_editor_info theorem zeroDirections303 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes303 i).directions j=0 := by decide +kernel

without_editor_info theorem linear303 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes303 i).directions j)
      (graphStar edges (fun i => (envelopes303 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections303 i k]
  simp [tameForm]

without_editor_info theorem cross303 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes303 (edges e).src).directions j) ((envelopes303 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections303 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value303 : vectorGraph edges (fun i => (envelopes303 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

