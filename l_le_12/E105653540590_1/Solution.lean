without_editor_info theorem fixedDirections441 : ∀ i : Fin 64,
    i=16 ∨ (envelopes441 i).directions=0 := by decide +kernel

without_editor_info theorem linear441 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes441 i).directions j)
      (graphStar edges (fun i => (envelopes441 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes441 16).directions k)
      (graphStar edges (fun i => (envelopes441 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 16)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections441 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross441 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes441 (edges e).src).directions j) ((envelopes441 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections441 (edges e).src with hs | hz
  · rcases fixedDirections441 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

