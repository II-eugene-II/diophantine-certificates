without_editor_info theorem checks94 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes94 i) pi rho 13 1160 1036 2 (values 102 104 i) (certificatesC94 i) (certificatesD94 i) := by decide +kernel

without_editor_info theorem fixedDirections94 : ∀ i : Fin 64,
    i=10 ∨ (envelopes94 i).directions=0 := by decide +kernel

without_editor_info theorem linear94 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes94 i).directions j)
      (graphStar edges (fun i => (envelopes94 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes94 10).directions k)
      (graphStar edges (fun i => (envelopes94 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 10)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections94 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross94 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes94 (edges e).src).directions j) ((envelopes94 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections94 (edges e).src with hs | hz
  · rcases fixedDirections94 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

