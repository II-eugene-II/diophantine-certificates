without_editor_info theorem checks128 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes128 i) pi rho 13 1160 1036 3 (values 1426 2183 i) (certificatesC128 i) (certificatesD128 i) := by decide +kernel

without_editor_info theorem zeroDirections128 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes128 i).directions j=0 := by decide +kernel

without_editor_info theorem linear128 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes128 i).directions j)
      (graphStar edges (fun i => (envelopes128 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections128 i k]
  simp [tameForm]

without_editor_info theorem cross128 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes128 (edges e).src).directions j) ((envelopes128 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections128 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value128 : vectorGraph edges (fun i => (envelopes128 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

