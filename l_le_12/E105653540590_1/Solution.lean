without_editor_info theorem checks8 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes8 i) pi rho 13 1160 1036 2 (values 64 71 i) (certificatesC8 i) (certificatesD8 i) := by decide +kernel

without_editor_info theorem fixedDirections8 : ∀ i : Fin 64,
    i=42 ∨ (envelopes8 i).directions=0 := by decide +kernel

without_editor_info theorem linear8 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes8 i).directions j)
      (graphStar edges (fun i => (envelopes8 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes8 42).directions k)
      (graphStar edges (fun i => (envelopes8 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 42)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections8 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross8 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes8 (edges e).src).directions j) ((envelopes8 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections8 (edges e).src with hs | hz
  · rcases fixedDirections8 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value8 : vectorGraph edges (fun i => (envelopes8 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

