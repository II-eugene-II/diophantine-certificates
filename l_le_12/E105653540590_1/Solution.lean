without_editor_info theorem zeroDirections381 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes381 i).directions j=0 := by decide +kernel

without_editor_info theorem linear381 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes381 i).directions j)
      (graphStar edges (fun i => (envelopes381 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections381 i k]
  simp [tameForm]

without_editor_info theorem cross381 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes381 (edges e).src).directions j) ((envelopes381 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections381 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value381 : vectorGraph edges (fun i => (envelopes381 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell381 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-42) (hy : (13 : ℤ)^2 ∣ y-75) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 42 75 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes381 constantC constantD certificatesC381 certificatesD381 0
