without_editor_info theorem linear408 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes408 i).directions j)
      (graphStar edges (fun i => (envelopes408 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections408 i k]
  simp [tameForm]

