without_editor_info theorem linear453 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes453 i).directions j)
      (graphStar edges (fun i => (envelopes453 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes453 i).directions j = 0 ∨
      tameForm ((envelopes453 i).directions j)
        (graphStar edges (fun i => (envelopes453 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

