  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 106 137 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes403 constantC constantD certificatesC403 certificatesD403 0
