    tameForm ((envelopes367 i).directions j)
      (graphStar edges (fun i => (envelopes367 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes367 27).directions k)
      (graphStar edges (fun i => (envelopes367 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 27)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections367 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross367 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes367 (edges e).src).directions j) ((envelopes367 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections367 (edges e).src with hs | hz
  · rcases fixedDirections367 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

