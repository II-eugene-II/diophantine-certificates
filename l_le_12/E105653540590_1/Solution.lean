without_editor_info theorem checks30 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes30 i) pi rho 7 1353 1047 2 (values 4 30 i) (certificatesC30 i) (certificatesD30 i) := by decide +kernel

without_editor_info theorem linear30 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes30 i).directions j)
      (graphStar edges (fun i => (envelopes30 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes30 i).directions j = 0 ∨
      tameForm ((envelopes30 i).directions j)
        (graphStar edges (fun i => (envelopes30 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross30 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes30 (edges e).src).directions j) ((envelopes30 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes30 e.src).directions = 0 ∨
      (envelopes30 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes30 e.src).directions j) ((envelopes30 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes30 (edges e).src).directions = 0 ∨
    (envelopes30 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes30 (edges e).src).directions j) ((envelopes30 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value30 : vectorGraph edges (fun i => (envelopes30 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
