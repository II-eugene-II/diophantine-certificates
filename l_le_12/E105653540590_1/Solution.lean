without_editor_info theorem checks57 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes57 i) pi rho 13 1160 1036 3 (values 1025 1312 i) (certificatesC57 i) (certificatesD57 i) := by decide +kernel

without_editor_info theorem linear57 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes57 i).directions j)
      (graphStar edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes57 i).directions j = 0 ∨
      tameForm ((envelopes57 i).directions j)
        (graphStar edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross57 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes57 (edges e).src).directions j) ((envelopes57 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes57 e.src).directions = 0 ∨
      (envelopes57 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes57 e.src).directions j) ((envelopes57 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes57 (edges e).src).directions = 0 ∨
    (envelopes57 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes57 (edges e).src).directions j) ((envelopes57 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value57 : vectorGraph edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
