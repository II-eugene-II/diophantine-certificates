without_editor_info theorem checks60 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes60 i) pi rho 7 1353 1047 3 (values 309 284 i) (certificatesC60 i) (certificatesD60 i) := by decide +kernel

without_editor_info theorem fixedDirections60 : ∀ i : Fin 64,
    i=32 ∨ (envelopes60 i).directions=0 := by decide +kernel

without_editor_info theorem linear60 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes60 i).directions j)
      (graphStar edges (fun i => (envelopes60 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes60 32).directions k)
      (graphStar edges (fun i => (envelopes60 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 32)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections60 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross60 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes60 (edges e).src).directions j) ((envelopes60 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections60 (edges e).src with hs | hz
  · rcases fixedDirections60 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value60 : vectorGraph edges (fun i => (envelopes60 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell60 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-309) (hy : (7 : ℤ)^3 ∣ y-284) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 309 284 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes60 constantC constantD certificatesC60 certificatesD60 0
