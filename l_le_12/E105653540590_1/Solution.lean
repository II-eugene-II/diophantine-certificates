without_editor_info theorem checks52 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes52 i) pi rho 7 1353 1047 4 (values 323 53 i) (certificatesC52 i) (certificatesD52 i) := by decide +kernel

without_editor_info theorem fixedDirections52 : ∀ i : Fin 64,
    i=13 ∨ (envelopes52 i).directions=0 := by decide +kernel

without_editor_info theorem linear52 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes52 i).directions j)
      (graphStar edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes52 13).directions k)
      (graphStar edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 13)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections52 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross52 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes52 (edges e).src).directions j) ((envelopes52 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections52 (edges e).src with hs | hz
  · rcases fixedDirections52 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value52 : vectorGraph edges (fun i => (envelopes52 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell52 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-323) (hy : (7 : ℤ)^4 ∣ y-53) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 323 53 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes52 constantC constantD certificatesC52 certificatesD52 0
