without_editor_info theorem checks90 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes90 i) pi rho 13 1160 1036 2 (values 154 39 i) (certificatesC90 i) (certificatesD90 i) := by decide +kernel

without_editor_info theorem fixedDirections90 : ∀ i : Fin 64,
    i=52 ∨ (envelopes90 i).directions=0 := by decide +kernel

without_editor_info theorem linear90 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes90 i).directions j)
      (graphStar edges (fun i => (envelopes90 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes90 52).directions k)
      (graphStar edges (fun i => (envelopes90 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 52)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections90 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross90 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes90 (edges e).src).directions j) ((envelopes90 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections90 (edges e).src with hs | hz
  · rcases fixedDirections90 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value90 : vectorGraph edges (fun i => (envelopes90 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

