without_editor_info theorem checks25 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes25 i) pi rho 13 1160 1036 2 (values 12 57 i) (certificatesC25 i) (certificatesD25 i) := by decide +kernel

without_editor_info theorem fixedDirections25 : ∀ i : Fin 64,
    i=48 ∨ (envelopes25 i).directions=0 := by decide +kernel

without_editor_info theorem linear25 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes25 i).directions j)
      (graphStar edges (fun i => (envelopes25 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes25 48).directions k)
      (graphStar edges (fun i => (envelopes25 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 48)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections25 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross25 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes25 (edges e).src).directions j) ((envelopes25 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections25 (edges e).src with hs | hz
  · rcases fixedDirections25 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value25 : vectorGraph edges (fun i => (envelopes25 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

