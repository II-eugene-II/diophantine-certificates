without_editor_info theorem checks42 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes42 i) pi rho 7 1353 1047 2 (values 10 10 i) (certificatesC42 i) (certificatesD42 i) := by decide +kernel

without_editor_info theorem fixedDirections42 : ∀ i : Fin 64,
    i=48 ∨ (envelopes42 i).directions=0 := by decide +kernel

without_editor_info theorem linear42 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes42 i).directions j)
      (graphStar edges (fun i => (envelopes42 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes42 48).directions k)
      (graphStar edges (fun i => (envelopes42 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 48)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections42 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross42 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes42 (edges e).src).directions j) ((envelopes42 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections42 (edges e).src with hs | hz
  · rcases fixedDirections42 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value42 : vectorGraph edges (fun i => (envelopes42 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

