without_editor_info theorem checks162 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes162 i) pi rho 13 1160 1036 3 (values 74 805 i) (certificatesC162 i) (certificatesD162 i) := by decide +kernel

without_editor_info theorem fixedDirections162 : ∀ i : Fin 64,
    i=32 ∨ (envelopes162 i).directions=0 := by decide +kernel

without_editor_info theorem linear162 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes162 i).directions j)
      (graphStar edges (fun i => (envelopes162 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes162 32).directions k)
      (graphStar edges (fun i => (envelopes162 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 32)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections162 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross162 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes162 (edges e).src).directions j) ((envelopes162 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections162 (edges e).src with hs | hz
  · rcases fixedDirections162 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value162 : vectorGraph edges (fun i => (envelopes162 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell162 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-74) (hy : (13 : ℤ)^3 ∣ y-805) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 74 805 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes162 constantC constantD certificatesC162 certificatesD162 0
