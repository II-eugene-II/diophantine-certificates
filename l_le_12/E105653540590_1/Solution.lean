without_editor_info theorem linear445 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes445 i).directions j)
      (graphStar edges (fun i => (envelopes445 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes445 i).directions j = 0 ∨
      tameForm ((envelopes445 i).directions j)
        (graphStar edges (fun i => (envelopes445 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

