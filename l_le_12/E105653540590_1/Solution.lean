without_editor_info theorem checks39 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes39 i) pi rho 7 1353 1047 3 (values 115 269 i) (certificatesC39 i) (certificatesD39 i) := by decide +kernel

without_editor_info theorem fixedDirections39 : ∀ i : Fin 64,
    i=63 ∨ (envelopes39 i).directions=0 := by decide +kernel

without_editor_info theorem linear39 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes39 i).directions j)
      (graphStar edges (fun i => (envelopes39 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes39 63).directions k)
      (graphStar edges (fun i => (envelopes39 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 63)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections39 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross39 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes39 (edges e).src).directions j) ((envelopes39 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections39 (edges e).src with hs | hz
  · rcases fixedDirections39 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value39 : vectorGraph edges (fun i => (envelopes39 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

