without_editor_info theorem checks35 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes35 i) pi rho 13 1160 1036 2 (values 51 132 i) (certificatesC35 i) (certificatesD35 i) := by decide +kernel

without_editor_info theorem fixedDirections35 : ∀ i : Fin 64,
    i=63 ∨ (envelopes35 i).directions=0 := by decide +kernel

without_editor_info theorem linear35 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes35 i).directions j)
      (graphStar edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes35 63).directions k)
      (graphStar edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 63)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections35 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross35 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes35 (edges e).src).directions j) ((envelopes35 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections35 (edges e).src with hs | hz
  · rcases fixedDirections35 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value35 : vectorGraph edges (fun i => (envelopes35 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell35 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-51) (hy : (13 : ℤ)^2 ∣ y-132) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 51 132 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes35 constantC constantD certificatesC35 certificatesD35 0
