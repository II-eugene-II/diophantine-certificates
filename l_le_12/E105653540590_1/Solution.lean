    (envelopes82 i).directions j=0 := by decide +kernel

without_editor_info theorem linear82 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes82 i).directions j)
      (graphStar edges (fun i => (envelopes82 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections82 i k]
  simp [tameForm]

