  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 74 1819 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes156 constantC constantD certificatesC156 certificatesD156 0
