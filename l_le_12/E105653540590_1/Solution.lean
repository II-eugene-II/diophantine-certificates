without_editor_info theorem checks300 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes300 i) pi rho 13 1160 1036 3 (values 581 821 i) (certificatesC300 i) (certificatesD300 i) := by decide +kernel

without_editor_info theorem fixedDirections300 : ∀ i : Fin 64,
    i=48 ∨ (envelopes300 i).directions=0 := by decide +kernel

without_editor_info theorem linear300 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes300 i).directions j)
      (graphStar edges (fun i => (envelopes300 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes300 48).directions k)
      (graphStar edges (fun i => (envelopes300 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 48)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections300 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross300 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes300 (edges e).src).directions j) ((envelopes300 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections300 (edges e).src with hs | hz
  · rcases fixedDirections300 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value300 : vectorGraph edges (fun i => (envelopes300 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

