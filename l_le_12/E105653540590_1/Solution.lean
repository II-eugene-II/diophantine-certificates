    (hx : (7 : ℤ)^3 ∣ x-74) (hy : (7 : ℤ)^3 ∣ y-100) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
