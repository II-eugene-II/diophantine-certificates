    i=32 ∨ (envelopes318 i).directions=0 := by decide +kernel

without_editor_info theorem linear318 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes318 i).directions j)
      (graphStar edges (fun i => (envelopes318 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes318 32).directions k)
      (graphStar edges (fun i => (envelopes318 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 32)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections318 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross318 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes318 (edges e).src).directions j) ((envelopes318 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections318 (edges e).src with hs | hz
  · rcases fixedDirections318 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

