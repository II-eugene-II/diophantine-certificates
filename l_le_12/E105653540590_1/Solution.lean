    (hx : (13 : ℤ)^3 ∣ x-11) (hy : (13 : ℤ)^3 ∣ y-1819) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 11 1819 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes63 constantC constantD certificatesC63 certificatesD63 0
