without_editor_info theorem checks63 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes63 i) pi rho 13 1160 1036 3 (values 11 1819 i) (certificatesC63 i) (certificatesD63 i) := by decide +kernel

without_editor_info theorem zeroDirections63 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes63 i).directions j=0 := by decide +kernel

without_editor_info theorem linear63 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes63 i).directions j)
      (graphStar edges (fun i => (envelopes63 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections63 i k]
  simp [tameForm]

without_editor_info theorem cross63 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes63 (edges e).src).directions j) ((envelopes63 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections63 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value63 : vectorGraph edges (fun i => (envelopes63 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

