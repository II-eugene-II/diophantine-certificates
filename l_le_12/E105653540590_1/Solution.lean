  rw [zeroDirections13 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value13 : vectorGraph edges (fun i => (envelopes13 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
