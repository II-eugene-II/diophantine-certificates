    tameForm ((envelopes9 i).directions j)
      (graphStar edges (fun i => (envelopes9 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes9 51).directions k)
      (graphStar edges (fun i => (envelopes9 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections9 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross9 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes9 (edges e).src).directions j) ((envelopes9 (edges e).dst).directions k) = 0 := by
