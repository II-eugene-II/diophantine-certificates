  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross377 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes377 (edges e).src).directions j) ((envelopes377 (edges e).dst).directions k) = 0 := by
