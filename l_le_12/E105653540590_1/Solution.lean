without_editor_info theorem checks108 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes108 i) pi rho 13 1160 1036 2 (values 88 26 i) (certificatesC108 i) (certificatesD108 i) := by decide +kernel

without_editor_info theorem fixedDirections108 : ∀ i : Fin 64,
    i=42 ∨ (envelopes108 i).directions=0 := by decide +kernel

without_editor_info theorem linear108 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes108 i).directions j)
      (graphStar edges (fun i => (envelopes108 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes108 42).directions k)
      (graphStar edges (fun i => (envelopes108 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 42)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections108 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross108 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes108 (edges e).src).directions j) ((envelopes108 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections108 (edges e).src with hs | hz
  · rcases fixedDirections108 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value108 : vectorGraph edges (fun i => (envelopes108 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

