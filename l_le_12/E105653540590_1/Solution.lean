    (envelopes411 i).directions j=0 := by decide +kernel

without_editor_info theorem linear411 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes411 i).directions j)
      (graphStar edges (fun i => (envelopes411 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections411 i k]
  simp [tameForm]

