    tameForm ((envelopes382 i).directions j)
      (graphStar edges (fun i => (envelopes382 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes382 59).directions k)
      (graphStar edges (fun i => (envelopes382 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 59)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections382 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross382 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes382 (edges e).src).directions j) ((envelopes382 (edges e).dst).directions k) = 0 := by
