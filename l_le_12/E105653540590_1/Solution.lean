without_editor_info theorem checks350 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes350 i) pi rho 13 1160 1036 3 (values 890 2048 i) (certificatesC350 i) (certificatesD350 i) := by decide +kernel

without_editor_info theorem zeroDirections350 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes350 i).directions j=0 := by decide +kernel

without_editor_info theorem linear350 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes350 i).directions j)
      (graphStar edges (fun i => (envelopes350 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections350 i k]
  simp [tameForm]

without_editor_info theorem cross350 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes350 (edges e).src).directions j) ((envelopes350 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections350 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value350 : vectorGraph edges (fun i => (envelopes350 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

