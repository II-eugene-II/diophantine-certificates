    tameForm ((envelopes452 i).directions j)
      (graphStar edges (fun i => (envelopes452 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes452 0).directions k)
      (graphStar edges (fun i => (envelopes452 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 0)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections452 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross452 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes452 (edges e).src).directions j) ((envelopes452 (edges e).dst).directions k) = 0 := by
