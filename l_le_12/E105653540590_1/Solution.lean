without_editor_info theorem checks84 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes84 i) pi rho 13 1160 1036 3 (values 687 1132 i) (certificatesC84 i) (certificatesD84 i) := by decide +kernel

without_editor_info theorem linear84 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes84 i).directions j)
      (graphStar edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes84 i).directions j = 0 ∨
      tameForm ((envelopes84 i).directions j)
        (graphStar edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross84 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes84 (edges e).src).directions j) ((envelopes84 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes84 e.src).directions = 0 ∨
      (envelopes84 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes84 e.src).directions j) ((envelopes84 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes84 (edges e).src).directions = 0 ∨
    (envelopes84 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes84 (edges e).src).directions j) ((envelopes84 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value84 : vectorGraph edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell84 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-687) (hy : (13 : ℤ)^3 ∣ y-1132) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 687 1132 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes84 constantC constantD certificatesC84 certificatesD84 0
