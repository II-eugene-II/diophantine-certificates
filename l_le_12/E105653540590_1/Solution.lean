without_editor_info theorem checks232 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes232 i) pi rho 13 1160 1036 3 (values 1595 2079 i) (certificatesC232 i) (certificatesD232 i) := by decide +kernel

without_editor_info theorem zeroDirections232 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes232 i).directions j=0 := by decide +kernel

without_editor_info theorem linear232 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes232 i).directions j)
      (graphStar edges (fun i => (envelopes232 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections232 i k]
  simp [tameForm]

without_editor_info theorem cross232 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes232 (edges e).src).directions j) ((envelopes232 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections232 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value232 : vectorGraph edges (fun i => (envelopes232 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

