without_editor_info theorem checks16 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes16 i) pi rho 7 1353 1047 4 (values 1740 2109 i) (certificatesC16 i) (certificatesD16 i) := by decide +kernel

without_editor_info theorem zeroDirections16 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes16 i).directions j=0 := by decide +kernel

without_editor_info theorem linear16 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes16 i).directions j)
      (graphStar edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections16 i k]
  simp [tameForm]

without_editor_info theorem cross16 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes16 (edges e).src).directions j) ((envelopes16 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections16 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value16 : vectorGraph edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell16 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1740) (hy : (7 : ℤ)^4 ∣ y-2109) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1740 2109 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes16 constantC constantD certificatesC16 certificatesD16 0
