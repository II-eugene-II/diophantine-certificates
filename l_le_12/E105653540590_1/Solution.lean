    tameForm ((envelopes404 (edges e).src).directions j) ((envelopes404 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections404 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value404 : vectorGraph edges (fun i => (envelopes404 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
