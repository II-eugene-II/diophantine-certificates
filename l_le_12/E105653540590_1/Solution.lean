without_editor_info theorem checks18 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes18 i) pi rho 13 1160 1036 2 (values 103 5 i) (certificatesC18 i) (certificatesD18 i) := by decide +kernel

without_editor_info theorem fixedDirections18 : ∀ i : Fin 64,
    i=59 ∨ (envelopes18 i).directions=0 := by decide +kernel

without_editor_info theorem linear18 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes18 i).directions j)
      (graphStar edges (fun i => (envelopes18 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes18 59).directions k)
      (graphStar edges (fun i => (envelopes18 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 59)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections18 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross18 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes18 (edges e).src).directions j) ((envelopes18 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections18 (edges e).src with hs | hz
  · rcases fixedDirections18 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value18 : vectorGraph edges (fun i => (envelopes18 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
