      (∀ j k : Fin 4, tameForm ((envelopes372 e.src).directions j) ((envelopes372 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes372 (edges e).src).directions = 0 ∨
    (envelopes372 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes372 (edges e).src).directions j) ((envelopes372 (edges e).dst).directions k) = 0) at h
