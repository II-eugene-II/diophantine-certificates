    (hx : (7 : ℤ)^3 ∣ x-115) (hy : (7 : ℤ)^3 ∣ y-269) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 115 269 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes39 constantC constantD certificatesC39 certificatesD39 0
