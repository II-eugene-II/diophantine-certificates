    tameForm ((envelopes377 i).directions j)
      (graphStar edges (fun i => (envelopes377 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes377 28).directions k)
