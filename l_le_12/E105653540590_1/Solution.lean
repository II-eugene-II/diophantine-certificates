    (envelopes83 i).directions j=0 := by decide +kernel

without_editor_info theorem linear83 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes83 i).directions j)
      (graphStar edges (fun i => (envelopes83 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections83 i k]
  simp [tameForm]

