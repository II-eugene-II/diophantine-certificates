without_editor_info theorem checks324 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes324 i) pi rho 13 1160 1036 2 (values 136 163 i) (certificatesC324 i) (certificatesD324 i) := by decide +kernel

without_editor_info theorem fixedDirections324 : ∀ i : Fin 64,
    i=10 ∨ (envelopes324 i).directions=0 := by decide +kernel

without_editor_info theorem linear324 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes324 i).directions j)
      (graphStar edges (fun i => (envelopes324 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes324 10).directions k)
      (graphStar edges (fun i => (envelopes324 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 10)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections324 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross324 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes324 (edges e).src).directions j) ((envelopes324 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections324 (edges e).src with hs | hz
  · rcases fixedDirections324 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value324 : vectorGraph edges (fun i => (envelopes324 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
