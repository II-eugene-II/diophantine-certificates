without_editor_info theorem checks403 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes403 i) pi rho 13 1160 1036 2 (values 106 137 i) (certificatesC403 i) (certificatesD403 i) := by decide +kernel

without_editor_info theorem fixedDirections403 : ∀ i : Fin 64,
    i=7 ∨ (envelopes403 i).directions=0 := by decide +kernel

without_editor_info theorem linear403 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes403 i).directions j)
      (graphStar edges (fun i => (envelopes403 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes403 7).directions k)
      (graphStar edges (fun i => (envelopes403 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections403 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross403 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes403 (edges e).src).directions j) ((envelopes403 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections403 (edges e).src with hs | hz
  · rcases fixedDirections403 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value403 : vectorGraph edges (fun i => (envelopes403 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
