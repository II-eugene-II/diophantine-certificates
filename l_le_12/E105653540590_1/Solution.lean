    i=60 ∨ (envelopes457 i).directions=0 := by decide +kernel

without_editor_info theorem linear457 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes457 i).directions j)
      (graphStar edges (fun i => (envelopes457 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes457 60).directions k)
      (graphStar edges (fun i => (envelopes457 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 60)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections457 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross457 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes457 (edges e).src).directions j) ((envelopes457 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections457 (edges e).src with hs | hz
  · rcases fixedDirections457 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

