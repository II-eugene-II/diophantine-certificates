without_editor_info theorem zeroDirections45 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes45 i).directions j=0 := by decide +kernel

without_editor_info theorem linear45 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes45 i).directions j)
      (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections45 i k]
  simp [tameForm]

without_editor_info theorem cross45 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes45 (edges e).src).directions j) ((envelopes45 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections45 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value45 : vectorGraph edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
