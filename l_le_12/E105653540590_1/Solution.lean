without_editor_info theorem checks31 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes31 i) pi rho 13 1160 1036 2 (values 103 80 i) (certificatesC31 i) (certificatesD31 i) := by decide +kernel

without_editor_info theorem fixedDirections31 : ∀ i : Fin 64,
    i=34 ∨ (envelopes31 i).directions=0 := by decide +kernel

without_editor_info theorem linear31 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes31 i).directions j)
      (graphStar edges (fun i => (envelopes31 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes31 34).directions k)
      (graphStar edges (fun i => (envelopes31 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 34)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections31 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross31 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes31 (edges e).src).directions j) ((envelopes31 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections31 (edges e).src with hs | hz
  · rcases fixedDirections31 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value31 : vectorGraph edges (fun i => (envelopes31 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
