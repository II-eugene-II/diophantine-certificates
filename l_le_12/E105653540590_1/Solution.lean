      (∀ j k : Fin 4, tameForm ((envelopes22 e.src).directions j) ((envelopes22 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes22 (edges e).src).directions = 0 ∨
    (envelopes22 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes22 (edges e).src).directions j) ((envelopes22 (edges e).dst).directions k) = 0) at h
