  intro e j k
  have h := h e
  change (envelopes97 (edges e).src).directions = 0 ∨
    (envelopes97 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes97 (edges e).src).directions j) ((envelopes97 (edges e).dst).directions k) = 0) at h
