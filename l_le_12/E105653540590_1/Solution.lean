without_editor_info theorem checks345 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes345 i) pi rho 13 1160 1036 3 (values 1735 865 i) (certificatesC345 i) (certificatesD345 i) := by decide +kernel

without_editor_info theorem fixedDirections345 : ∀ i : Fin 64,
    i=60 ∨ (envelopes345 i).directions=0 := by decide +kernel

without_editor_info theorem linear345 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes345 i).directions j)
      (graphStar edges (fun i => (envelopes345 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes345 60).directions k)
      (graphStar edges (fun i => (envelopes345 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 60)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections345 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross345 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes345 (edges e).src).directions j) ((envelopes345 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections345 (edges e).src with hs | hz
  · rcases fixedDirections345 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value345 : vectorGraph edges (fun i => (envelopes345 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell345 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1735) (hy : (13 : ℤ)^3 ∣ y-865) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1735 865 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes345 constantC constantD certificatesC345 certificatesD345 0
