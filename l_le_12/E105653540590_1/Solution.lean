    tameForm ((envelopes258 (edges e).src).directions j) ((envelopes258 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections258 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value258 : vectorGraph edges (fun i => (envelopes258 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
