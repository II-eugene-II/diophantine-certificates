without_editor_info theorem checks361 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes361 i) pi rho 13 1160 1036 2 (values 135 59 i) (certificatesC361 i) (certificatesD361 i) := by decide +kernel

without_editor_info theorem fixedDirections361 : ∀ i : Fin 64,
    i=18 ∨ (envelopes361 i).directions=0 := by decide +kernel

without_editor_info theorem linear361 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes361 i).directions j)
      (graphStar edges (fun i => (envelopes361 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes361 18).directions k)
      (graphStar edges (fun i => (envelopes361 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 18)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections361 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross361 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes361 (edges e).src).directions j) ((envelopes361 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections361 (edges e).src with hs | hz
  · rcases fixedDirections361 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value361 : vectorGraph edges (fun i => (envelopes361 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
