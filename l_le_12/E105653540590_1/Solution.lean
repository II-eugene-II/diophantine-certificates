without_editor_info theorem zeroDirections384 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes384 i).directions j=0 := by decide +kernel

without_editor_info theorem linear384 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes384 i).directions j)
      (graphStar edges (fun i => (envelopes384 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections384 i k]
  simp [tameForm]

without_editor_info theorem cross384 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes384 (edges e).src).directions j) ((envelopes384 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections384 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value384 : vectorGraph edges (fun i => (envelopes384 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
