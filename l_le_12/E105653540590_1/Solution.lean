    tameForm ((envelopes380 i).directions j)
      (graphStar edges (fun i => (envelopes380 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes380 62).directions k)
      (graphStar edges (fun i => (envelopes380 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 62)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections380 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross380 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes380 (edges e).src).directions j) ((envelopes380 (edges e).dst).directions k) = 0 := by
