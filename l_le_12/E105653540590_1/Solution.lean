without_editor_info theorem zeroDirections410 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes410 i).directions j=0 := by decide +kernel

without_editor_info theorem linear410 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes410 i).directions j)
      (graphStar edges (fun i => (envelopes410 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections410 i k]
  simp [tameForm]

without_editor_info theorem cross410 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes410 (edges e).src).directions j) ((envelopes410 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections410 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value410 : vectorGraph edges (fun i => (envelopes410 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
