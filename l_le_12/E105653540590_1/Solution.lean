  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1 25 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes68 constantC constantD certificatesC68 certificatesD68 0
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks68 i))
    linear68 cross68 value68 hx hy

