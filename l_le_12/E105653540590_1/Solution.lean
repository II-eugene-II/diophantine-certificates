  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross424 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes424 (edges e).src).directions j) ((envelopes424 (edges e).dst).directions k) = 0 := by
