    i=27 ∨ (envelopes277 i).directions=0 := by decide +kernel

without_editor_info theorem linear277 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes277 i).directions j)
      (graphStar edges (fun i => (envelopes277 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes277 27).directions k)
      (graphStar edges (fun i => (envelopes277 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 27)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections277 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross277 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes277 (edges e).src).directions j) ((envelopes277 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections277 (edges e).src with hs | hz
  · rcases fixedDirections277 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

