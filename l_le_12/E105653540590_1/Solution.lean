without_editor_info theorem checks46 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes46 i) pi rho 7 1353 1047 4 (values 2381 2111 i) (certificatesC46 i) (certificatesD46 i) := by decide +kernel

without_editor_info theorem fixedDirections46 : ∀ i : Fin 64,
    i=60 ∨ (envelopes46 i).directions=0 := by decide +kernel

without_editor_info theorem linear46 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes46 i).directions j)
      (graphStar edges (fun i => (envelopes46 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes46 60).directions k)
      (graphStar edges (fun i => (envelopes46 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 60)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections46 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross46 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes46 (edges e).src).directions j) ((envelopes46 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections46 (edges e).src with hs | hz
  · rcases fixedDirections46 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value46 : vectorGraph edges (fun i => (envelopes46 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

