without_editor_info theorem checks85 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes85 i) pi rho 13 1160 1036 3 (values 518 287 i) (certificatesC85 i) (certificatesD85 i) := by decide +kernel

without_editor_info theorem linear85 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes85 i).directions j)
      (graphStar edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 64, ∀ j : Fin 4, (envelopes85 i).directions j = 0 ∨
      tameForm ((envelopes85 i).directions j)
        (graphStar edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross85 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes85 (edges e).src).directions j) ((envelopes85 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 286) edgeList (by decide)
    (fun e => (envelopes85 e.src).directions = 0 ∨
      (envelopes85 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes85 e.src).directions j) ((envelopes85 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes85 (edges e).src).directions = 0 ∨
    (envelopes85 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes85 (edges e).src).directions j) ((envelopes85 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value85 : vectorGraph edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell85 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-518) (hy : (13 : ℤ)^3 ∣ y-287) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 518 287 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes85 constantC constantD certificatesC85 certificatesD85 0
