without_editor_info theorem checks20 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes20 i) pi rho 7 1353 1047 4 (values 368 737 i) (certificatesC20 i) (certificatesD20 i) := by decide +kernel

without_editor_info theorem fixedDirections20 : ∀ i : Fin 64,
    i=53 ∨ (envelopes20 i).directions=0 := by decide +kernel

without_editor_info theorem linear20 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes20 i).directions j)
      (graphStar edges (fun i => (envelopes20 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes20 53).directions k)
      (graphStar edges (fun i => (envelopes20 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 53)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections20 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross20 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes20 (edges e).src).directions j) ((envelopes20 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections20 (edges e).src with hs | hz
  · rcases fixedDirections20 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value20 : vectorGraph edges (fun i => (envelopes20 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell20 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-368) (hy : (7 : ℤ)^4 ∣ y-737) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 368 737 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes20 constantC constantD certificatesC20 certificatesD20 0
