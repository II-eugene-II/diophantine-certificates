without_editor_info theorem checks159 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes159 i) pi rho 13 1160 1036 3 (values 74 1312 i) (certificatesC159 i) (certificatesD159 i) := by decide +kernel

without_editor_info theorem fixedDirections159 : ∀ i : Fin 64,
    i=15 ∨ (envelopes159 i).directions=0 := by decide +kernel

without_editor_info theorem linear159 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes159 i).directions j)
      (graphStar edges (fun i => (envelopes159 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes159 15).directions k)
      (graphStar edges (fun i => (envelopes159 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 15)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections159 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross159 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes159 (edges e).src).directions j) ((envelopes159 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections159 (edges e).src with hs | hz
  · rcases fixedDirections159 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value159 : vectorGraph edges (fun i => (envelopes159 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell159 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-74) (hy : (13 : ℤ)^3 ∣ y-1312) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 74 1312 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes159 constantC constantD certificatesC159 certificatesD159 0
