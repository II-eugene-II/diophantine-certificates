without_editor_info theorem checks40 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes40 i) pi rho 7 1353 1047 3 (values 66 171 i) (certificatesC40 i) (certificatesD40 i) := by decide +kernel

without_editor_info theorem fixedDirections40 : ∀ i : Fin 64,
    i=19 ∨ (envelopes40 i).directions=0 := by decide +kernel

without_editor_info theorem linear40 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes40 i).directions j)
      (graphStar edges (fun i => (envelopes40 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes40 19).directions k)
      (graphStar edges (fun i => (envelopes40 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 19)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections40 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross40 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes40 (edges e).src).directions j) ((envelopes40 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections40 (edges e).src with hs | hz
  · rcases fixedDirections40 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value40 : vectorGraph edges (fun i => (envelopes40 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

