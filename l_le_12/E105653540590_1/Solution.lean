    i=32 ∨ (envelopes374 i).directions=0 := by decide +kernel

without_editor_info theorem linear374 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes374 i).directions j)
      (graphStar edges (fun i => (envelopes374 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes374 32).directions k)
      (graphStar edges (fun i => (envelopes374 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 32)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections374 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross374 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes374 (edges e).src).directions j) ((envelopes374 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections374 (edges e).src with hs | hz
  · rcases fixedDirections374 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

