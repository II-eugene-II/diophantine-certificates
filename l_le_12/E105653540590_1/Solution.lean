    (envelopes66 i).directions j=0 := by decide +kernel

without_editor_info theorem linear66 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes66 i).directions j)
      (graphStar edges (fun i => (envelopes66 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections66 i k]
  simp [tameForm]

without_editor_info theorem cross66 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes66 (edges e).src).directions j) ((envelopes66 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections66 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value66 : vectorGraph edges (fun i => (envelopes66 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
