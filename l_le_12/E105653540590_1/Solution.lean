without_editor_info theorem checks334 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes334 i) pi rho 13 1160 1036 3 (values 1098 709 i) (certificatesC334 i) (certificatesD334 i) := by decide +kernel

without_editor_info theorem fixedDirections334 : ∀ i : Fin 64,
    i=44 ∨ (envelopes334 i).directions=0 := by decide +kernel

without_editor_info theorem linear334 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes334 i).directions j)
      (graphStar edges (fun i => (envelopes334 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes334 44).directions k)
      (graphStar edges (fun i => (envelopes334 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 44)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections334 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross334 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes334 (edges e).src).directions j) ((envelopes334 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections334 (edges e).src with hs | hz
  · rcases fixedDirections334 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

