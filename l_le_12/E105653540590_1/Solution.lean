without_editor_info theorem checks409 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes409 i) pi rho 13 1160 1036 3 (values 1900 1801 i) (certificatesC409 i) (certificatesD409 i) := by decide +kernel

without_editor_info theorem zeroDirections409 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes409 i).directions j=0 := by decide +kernel

without_editor_info theorem linear409 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes409 i).directions j)
      (graphStar edges (fun i => (envelopes409 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections409 i k]
  simp [tameForm]

without_editor_info theorem cross409 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes409 (edges e).src).directions j) ((envelopes409 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections409 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value409 : vectorGraph edges (fun i => (envelopes409 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell409 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1900) (hy : (13 : ℤ)^3 ∣ y-1801) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1900 1801 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes409 constantC constantD certificatesC409 certificatesD409 0
