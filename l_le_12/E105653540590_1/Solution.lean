    i=52 ∨ (envelopes421 i).directions=0 := by decide +kernel

without_editor_info theorem linear421 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes421 i).directions j)
      (graphStar edges (fun i => (envelopes421 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes421 52).directions k)
      (graphStar edges (fun i => (envelopes421 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 52)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections421 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross421 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes421 (edges e).src).directions j) ((envelopes421 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections421 (edges e).src with hs | hz
  · rcases fixedDirections421 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

