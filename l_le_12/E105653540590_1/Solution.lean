    (envelopes258 i).directions j=0 := by decide +kernel

without_editor_info theorem linear258 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes258 i).directions j)
      (graphStar edges (fun i => (envelopes258 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections258 i k]
  simp [tameForm]

