    (envelopes404 i).directions j=0 := by decide +kernel

without_editor_info theorem linear404 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes404 i).directions j)
      (graphStar edges (fun i => (envelopes404 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections404 i k]
  simp [tameForm]

