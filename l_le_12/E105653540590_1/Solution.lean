  rcases fixedDirections382 (edges e).src with hs | hz
  · rcases fixedDirections382 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

