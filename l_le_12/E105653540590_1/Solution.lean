without_editor_info theorem checks12 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes12 i) pi rho 13 1160 1036 2 (values 12 110 i) (certificatesC12 i) (certificatesD12 i) := by decide +kernel

without_editor_info theorem fixedDirections12 : ∀ i : Fin 64,
    i=48 ∨ (envelopes12 i).directions=0 := by decide +kernel

without_editor_info theorem linear12 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes12 i).directions j)
      (graphStar edges (fun i => (envelopes12 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes12 48).directions k)
      (graphStar edges (fun i => (envelopes12 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 48)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections12 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross12 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes12 (edges e).src).directions j) ((envelopes12 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections12 (edges e).src with hs | hz
  · rcases fixedDirections12 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value12 : vectorGraph edges (fun i => (envelopes12 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
