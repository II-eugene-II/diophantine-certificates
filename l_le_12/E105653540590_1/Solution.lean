    (fun e => (envelopes453 e.src).directions = 0 ∨
      (envelopes453 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes453 e.src).directions j) ((envelopes453 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes453 (edges e).src).directions = 0 ∨
    (envelopes453 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes453 (edges e).src).directions j) ((envelopes453 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

