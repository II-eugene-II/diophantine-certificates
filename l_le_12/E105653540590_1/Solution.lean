without_editor_info theorem checks15 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes15 i) pi rho 7 1353 1047 4 (values 2083 51 i) (certificatesC15 i) (certificatesD15 i) := by decide +kernel

without_editor_info theorem zeroDirections15 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes15 i).directions j=0 := by decide +kernel

without_editor_info theorem linear15 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes15 i).directions j)
      (graphStar edges (fun i => (envelopes15 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections15 i k]
  simp [tameForm]

without_editor_info theorem cross15 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes15 (edges e).src).directions j) ((envelopes15 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections15 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value15 : vectorGraph edges (fun i => (envelopes15 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell15 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-2083) (hy : (7 : ℤ)^4 ∣ y-51) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 2083 51 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes15 constantC constantD certificatesC15 certificatesD15 0
