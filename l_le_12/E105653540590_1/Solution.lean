without_editor_info theorem linear325 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes325 i).directions j)
      (graphStar edges (fun i => (envelopes325 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes325 28).directions k)
      (graphStar edges (fun i => (envelopes325 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 28)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections325 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross325 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes325 (edges e).src).directions j) ((envelopes325 (edges e).dst).directions k) = 0 := by
