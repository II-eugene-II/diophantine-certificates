without_editor_info theorem checks156 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes156 i) pi rho 13 1160 1036 3 (values 74 1819 i) (certificatesC156 i) (certificatesD156 i) := by decide +kernel

without_editor_info theorem zeroDirections156 : ∀ i : Fin 64, ∀ j : Fin 4,
    (envelopes156 i).directions j=0 := by decide +kernel

without_editor_info theorem linear156 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes156 i).directions j)
      (graphStar edges (fun i => (envelopes156 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections156 i k]
  simp [tameForm]

without_editor_info theorem cross156 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes156 (edges e).src).directions j) ((envelopes156 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections156 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value156 : vectorGraph edges (fun i => (envelopes156 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

