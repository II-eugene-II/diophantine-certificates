without_editor_info theorem checks113 : ∀ i : Fin 64, jointEnvelopeFastCheck (envelopes113 i) pi rho 13 1160 1036 2 (values 23 39 i) (certificatesC113 i) (certificatesD113 i) := by decide +kernel

without_editor_info theorem fixedDirections113 : ∀ i : Fin 64,
    i=25 ∨ (envelopes113 i).directions=0 := by decide +kernel

without_editor_info theorem linear113 : ∀ i : Fin 64, ∀ j : Fin 4,
    tameForm ((envelopes113 i).directions j)
      (graphStar edges (fun i => (envelopes113 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes113 25).directions k)
      (graphStar edges (fun i => (envelopes113 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 25)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections113 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross113 : ∀ e : Fin 286, ∀ j k : Fin 4,
    tameForm ((envelopes113 (edges e).src).directions j) ((envelopes113 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections113 (edges e).src with hs | hz
  · rcases fixedDirections113 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value113 : vectorGraph edges (fun i => (envelopes113 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
