without_editor_info theorem linear61 : ∀ i : Fin 49, ∀ j : Fin 4,
    tameForm ((envelopes61 i).directions j)
      (graphStar edges (fun i => (envelopes61 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes61 40).directions k)
      (graphStar edges (fun i => (envelopes61 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 40)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections61 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross61 : ∀ e : Fin 203, ∀ j k : Fin 4,
    tameForm ((envelopes61 (edges e).src).directions j) ((envelopes61 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections61 (edges e).src with hs | hz
  · rcases fixedDirections61 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

