without_editor_info theorem checks81 : ∀ i : Fin 49, jointEnvelopeFastCheck (envelopes81 i) pi rho 13 146 22 2 (values 1 29 i) (certificatesC81 i) (certificatesD81 i) := by decide +kernel

without_editor_info theorem fixedDirections81 : ∀ i : Fin 49,
    i=33 ∨ (envelopes81 i).directions=0 := by decide +kernel

without_editor_info theorem linear81 : ∀ i : Fin 49, ∀ j : Fin 4,
    tameForm ((envelopes81 i).directions j)
      (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes81 33).directions k)
      (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 33)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections81 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross81 : ∀ e : Fin 203, ∀ j k : Fin 4,
    tameForm ((envelopes81 (edges e).src).directions j) ((envelopes81 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections81 (edges e).src with hs | hz
  · rcases fixedDirections81 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

