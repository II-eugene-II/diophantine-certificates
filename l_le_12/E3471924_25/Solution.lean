without_editor_info theorem checks49 : ∀ i : Fin 49, jointEnvelopeFastCheck (envelopes49 i) pi rho 7 1353 1047 2 (values 5 5 i) (certificatesC49 i) (certificatesD49 i) := by decide +kernel

without_editor_info theorem fixedDirections49 : ∀ i : Fin 49,
    i=23 ∨ (envelopes49 i).directions=0 := by decide +kernel

without_editor_info theorem linear49 : ∀ i : Fin 49, ∀ j : Fin 4,
    tameForm ((envelopes49 i).directions j)
      (graphStar edges (fun i => (envelopes49 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes49 23).directions k)
      (graphStar edges (fun i => (envelopes49 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 23)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections49 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross49 : ∀ e : Fin 203, ∀ j k : Fin 4,
    tameForm ((envelopes49 (edges e).src).directions j) ((envelopes49 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections49 (edges e).src with hs | hz
  · rcases fixedDirections49 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

