without_editor_info theorem checks43 : ∀ i : Fin 49, jointEnvelopeFastCheck (envelopes43 i) pi rho 13 146 22 2 (values 160 60 i) (certificatesC43 i) (certificatesD43 i) := by decide +kernel

without_editor_info theorem linear43 : ∀ i : Fin 49, ∀ j : Fin 4,
    tameForm ((envelopes43 i).directions j)
      (graphStar edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 49, ∀ j : Fin 4, (envelopes43 i).directions j = 0 ∨
      tameForm ((envelopes43 i).directions j)
        (graphStar edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross43 : ∀ e : Fin 203, ∀ j k : Fin 4,
    tameForm ((envelopes43 (edges e).src).directions j) ((envelopes43 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 203) edgeList (by decide)
    (fun e => (envelopes43 e.src).directions = 0 ∨
      (envelopes43 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes43 e.src).directions j) ((envelopes43 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes43 (edges e).src).directions = 0 ∨
    (envelopes43 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes43 (edges e).src).directions j) ((envelopes43 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

