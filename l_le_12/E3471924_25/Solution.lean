without_editor_info theorem checks45 : ∀ i : Fin 49, jointEnvelopeFastCheck (envelopes45 i) pi rho 13 146 22 2 (values 134 164 i) (certificatesC45 i) (certificatesD45 i) := by decide +kernel

without_editor_info theorem fixedDirections45 : ∀ i : Fin 49,
    i=3 ∨ (envelopes45 i).directions=0 := by decide +kernel

without_editor_info theorem linear45 : ∀ i : Fin 49, ∀ j : Fin 4,
    tameForm ((envelopes45 i).directions j)
      (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes45 3).directions k)
      (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 3)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections45 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross45 : ∀ e : Fin 203, ∀ j k : Fin 4,
    tameForm ((envelopes45 (edges e).src).directions j) ((envelopes45 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections45 (edges e).src with hs | hz
  · rcases fixedDirections45 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value45 : vectorGraph edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell45 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-134) (hy : (13 : ℤ)^2 ∣ y-164) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 146 22 134 164 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes45 constantC constantD certificatesC45 certificatesD45 0
