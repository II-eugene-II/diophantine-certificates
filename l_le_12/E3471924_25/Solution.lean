    tameForm ((envelopes111 i).directions j)
      (graphStar edges (fun i => (envelopes111 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes111 45).directions k)
      (graphStar edges (fun i => (envelopes111 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 45)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
