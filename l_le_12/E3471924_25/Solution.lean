without_editor_info theorem checks99 : ∀ i : Fin 49, jointEnvelopeFastCheck (envelopes99 i) pi rho 7 1353 1047 2 (values 4 3 i) (certificatesC99 i) (certificatesD99 i) := by decide +kernel

without_editor_info theorem linear99 : ∀ i : Fin 49, ∀ j : Fin 4,
    tameForm ((envelopes99 i).directions j)
      (graphStar edges (fun i => (envelopes99 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 49, ∀ j : Fin 4, (envelopes99 i).directions j = 0 ∨
      tameForm ((envelopes99 i).directions j)
        (graphStar edges (fun i => (envelopes99 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross99 : ∀ e : Fin 203, ∀ j k : Fin 4,
    tameForm ((envelopes99 (edges e).src).directions j) ((envelopes99 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 203) edgeList (by decide)
    (fun e => (envelopes99 e.src).directions = 0 ∨
      (envelopes99 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes99 e.src).directions j) ((envelopes99 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes99 (edges e).src).directions = 0 ∨
    (envelopes99 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes99 (edges e).src).directions j) ((envelopes99 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

