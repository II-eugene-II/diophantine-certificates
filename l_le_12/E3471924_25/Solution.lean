without_editor_info theorem checks75 : ∀ i : Fin 49, jointEnvelopeFastCheck (envelopes75 i) pi rho 13 146 22 2 (values 79 55 i) (certificatesC75 i) (certificatesD75 i) := by decide +kernel

without_editor_info theorem fixedDirections75 : ∀ i : Fin 49,
    i=15 ∨ (envelopes75 i).directions=0 := by decide +kernel

without_editor_info theorem linear75 : ∀ i : Fin 49, ∀ j : Fin 4,
    tameForm ((envelopes75 i).directions j)
      (graphStar edges (fun i => (envelopes75 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes75 15).directions k)
      (graphStar edges (fun i => (envelopes75 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 15)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections75 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross75 : ∀ e : Fin 203, ∀ j k : Fin 4,
    tameForm ((envelopes75 (edges e).src).directions j) ((envelopes75 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections75 (edges e).src with hs | hz
  · rcases fixedDirections75 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value75 : vectorGraph edges (fun i => (envelopes75 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell75 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-79) (hy : (13 : ℤ)^2 ∣ y-55) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 146 22 79 55 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤2)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤2)).trans root_rho)
    envelopes75 constantC constantD certificatesC75 certificatesD75 0
