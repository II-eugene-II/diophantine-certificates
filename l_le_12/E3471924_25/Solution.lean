without_editor_info theorem checks85 : ∀ i : Fin 49, jointEnvelopeFastCheck (envelopes85 i) pi rho 7 1353 1047 2 (values 11 4 i) (certificatesC85 i) (certificatesD85 i) := by decide +kernel

without_editor_info theorem linear85 : ∀ i : Fin 49, ∀ j : Fin 4,
    tameForm ((envelopes85 i).directions j)
      (graphStar edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 49, ∀ j : Fin 4, (envelopes85 i).directions j = 0 ∨
      tameForm ((envelopes85 i).directions j)
        (graphStar edges (fun i => (envelopes85 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross85 : ∀ e : Fin 203, ∀ j k : Fin 4,
    tameForm ((envelopes85 (edges e).src).directions j) ((envelopes85 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 203) edgeList (by decide)
    (fun e => (envelopes85 e.src).directions = 0 ∨
      (envelopes85 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes85 e.src).directions j) ((envelopes85 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes85 (edges e).src).directions = 0 ∨
    (envelopes85 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes85 (edges e).src).directions j) ((envelopes85 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

