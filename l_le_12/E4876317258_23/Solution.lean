without_editor_info theorem checks98 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes98 i) pi rho 7 34967 82681 2 (values 4 1 i) (certificatesC98 i) (certificatesD98 i) := by decide +kernel

without_editor_info theorem fixedDirections98 : ∀ i : Fin 60,
    i=2 ∨ (envelopes98 i).directions=0 := by decide +kernel

without_editor_info theorem linear98 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes98 i).directions j)
      (graphStar edges (fun i => (envelopes98 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes98 2).directions k)
      (graphStar edges (fun i => (envelopes98 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 2)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections98 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross98 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes98 (edges e).src).directions j) ((envelopes98 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections98 (edges e).src with hs | hz
  · rcases fixedDirections98 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value98 : vectorGraph edges (fun i => (envelopes98 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell98 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-4) (hy : (7 : ℤ)^2 ∣ y-1) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 4 1 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤6)).trans root_rho)
    envelopes98 constantC constantD certificatesC98 certificatesD98 0
