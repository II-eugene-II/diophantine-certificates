  intro e j k
  have h := h e
  change (envelopes182 (edges e).src).directions = 0 ∨
    (envelopes182 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes182 (edges e).src).directions j) ((envelopes182 (edges e).dst).directions k) = 0) at h
