without_editor_info theorem zeroDirections77 : ∀ i : Fin 60, ∀ j : Fin 4,
    (envelopes77 i).directions j=0 := by decide +kernel

without_editor_info theorem linear77 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes77 i).directions j)
      (graphStar edges (fun i => (envelopes77 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections77 i k]
  simp [tameForm]

without_editor_info theorem cross77 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes77 (edges e).src).directions j) ((envelopes77 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections77 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value77 : vectorGraph edges (fun i => (envelopes77 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
