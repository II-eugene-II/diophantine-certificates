without_editor_info theorem checks48 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes48 i) pi rho 7 34967 82681 3 (values 5 141 i) (certificatesC48 i) (certificatesD48 i) := by decide +kernel

without_editor_info theorem zeroDirections48 : ∀ i : Fin 60, ∀ j : Fin 4,
    (envelopes48 i).directions j=0 := by decide +kernel

without_editor_info theorem linear48 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes48 i).directions j)
      (graphStar edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections48 i k]
  simp [tameForm]

without_editor_info theorem cross48 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes48 (edges e).src).directions j) ((envelopes48 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections48 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value48 : vectorGraph edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell48 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-5) (hy : (7 : ℤ)^3 ∣ y-141) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 5 141 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤6)).trans root_rho)
    envelopes48 constantC constantD certificatesC48 certificatesD48 0
