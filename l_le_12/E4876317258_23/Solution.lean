without_editor_info theorem checks331 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes331 i) pi rho 13 20933 7627 2 (values 106 45 i) (certificatesC331 i) (certificatesD331 i) := by decide +kernel

without_editor_info theorem fixedDirections331 : ∀ i : Fin 60,
    i=55 ∨ (envelopes331 i).directions=0 := by decide +kernel

without_editor_info theorem linear331 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes331 i).directions j)
      (graphStar edges (fun i => (envelopes331 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes331 55).directions k)
      (graphStar edges (fun i => (envelopes331 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 55)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections331 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross331 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes331 (edges e).src).directions j) ((envelopes331 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections331 (edges e).src with hs | hz
  · rcases fixedDirections331 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value331 : vectorGraph edges (fun i => (envelopes331 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
