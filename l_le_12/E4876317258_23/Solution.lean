without_editor_info theorem checks48 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes48 i) pi rho 13 20933 7627 3 (values 516 1867 i) (certificatesC48 i) (certificatesD48 i) := by decide +kernel

without_editor_info theorem fixedDirections48 : ∀ i : Fin 60,
    i=44 ∨ (envelopes48 i).directions=0 := by decide +kernel

without_editor_info theorem linear48 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes48 i).directions j)
      (graphStar edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes48 44).directions k)
      (graphStar edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 44)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections48 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross48 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes48 (edges e).src).directions j) ((envelopes48 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections48 (edges e).src with hs | hz
  · rcases fixedDirections48 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value48 : vectorGraph edges (fun i => (envelopes48 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell48 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-516) (hy : (13 : ℤ)^3 ∣ y-1867) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 516 1867 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes48 constantC constantD certificatesC48 certificatesD48 0
