    i=57 ∨ (envelopes200 i).directions=0 := by decide +kernel

without_editor_info theorem linear200 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes200 i).directions j)
      (graphStar edges (fun i => (envelopes200 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes200 57).directions k)
      (graphStar edges (fun i => (envelopes200 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 57)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections200 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross200 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes200 (edges e).src).directions j) ((envelopes200 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections200 (edges e).src with hs | hz
  · rcases fixedDirections200 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value200 : vectorGraph edges (fun i => (envelopes200 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
