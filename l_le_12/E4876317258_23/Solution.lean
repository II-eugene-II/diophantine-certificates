  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 18 153 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes200 constantC constantD certificatesC200 certificatesD200 0
