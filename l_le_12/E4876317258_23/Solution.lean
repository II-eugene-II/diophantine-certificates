    (hx : (13 : ℤ)^2 ∣ x-51) (hy : (13 : ℤ)^2 ∣ y-57) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
