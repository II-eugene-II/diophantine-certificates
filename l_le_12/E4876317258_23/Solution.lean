  intro e j k
  have h := h e
  change (envelopes139 (edges e).src).directions = 0 ∨
    (envelopes139 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes139 (edges e).src).directions j) ((envelopes139 (edges e).dst).directions k) = 0) at h
