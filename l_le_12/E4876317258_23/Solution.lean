  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 4 136 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes264 constantC constantD certificatesC264 certificatesD264 0
