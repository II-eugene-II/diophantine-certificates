without_editor_info theorem linear282 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes282 i).directions j)
      (graphStar edges (fun i => (envelopes282 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes282 14).directions k)
      (graphStar edges (fun i => (envelopes282 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 14)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections282 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross282 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes282 (edges e).src).directions j) ((envelopes282 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections282 (edges e).src with hs | hz
  · rcases fixedDirections282 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

