    tameForm ((envelopes262 (edges e).src).directions j) ((envelopes262 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections262 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value262 : vectorGraph edges (fun i => (envelopes262 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
