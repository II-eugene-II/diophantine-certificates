    (fun e => (envelopes182 e.src).directions = 0 ∨
      (envelopes182 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes182 e.src).directions j) ((envelopes182 e.dst).directions k) = 0))
