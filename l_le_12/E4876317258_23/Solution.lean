without_editor_info theorem checks105 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes105 i) pi rho 7 34967 82681 3 (values 249 42 i) (certificatesC105 i) (certificatesD105 i) := by decide +kernel

without_editor_info theorem fixedDirections105 : ∀ i : Fin 60,
    i=32 ∨ (envelopes105 i).directions=0 := by decide +kernel

without_editor_info theorem linear105 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes105 i).directions j)
      (graphStar edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes105 32).directions k)
      (graphStar edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 32)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections105 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross105 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes105 (edges e).src).directions j) ((envelopes105 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections105 (edges e).src with hs | hz
  · rcases fixedDirections105 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value105 : vectorGraph edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell105 {x y : ℤ} (hf : equation x y = 0)
