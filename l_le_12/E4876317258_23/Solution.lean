    (hx : (13 : ℤ)^3 ∣ x-1868) (hy : (13 : ℤ)^3 ∣ y-2036) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 1868 2036 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes40 constantC constantD certificatesC40 certificatesD40 0
