without_editor_info theorem zeroDirections255 : ∀ i : Fin 60, ∀ j : Fin 4,
    (envelopes255 i).directions j=0 := by decide +kernel

without_editor_info theorem linear255 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes255 i).directions j)
      (graphStar edges (fun i => (envelopes255 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections255 i k]
  simp [tameForm]

without_editor_info theorem cross255 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes255 (edges e).src).directions j) ((envelopes255 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections255 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value255 : vectorGraph edges (fun i => (envelopes255 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

