without_editor_info theorem checks3 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes3 i) pi rho 7 34967 82681 4 (values 1706 666 i) (certificatesC3 i) (certificatesD3 i) := by decide +kernel

without_editor_info theorem noLoops : ∀ e : Fin 287, (edges e).src ≠ (edges e).dst := by
  exact listEdges_all (m := 287) edgeList (by decide)
    (fun e => e.src ≠ e.dst) (by decide +kernel)

without_editor_info theorem fixedDirections3 : ∀ i : Fin 60,
    i=54 ∨ (envelopes3 i).directions=0 := by decide +kernel

without_editor_info theorem linear3 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes3 i).directions j)
      (graphStar edges (fun i => (envelopes3 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes3 54).directions k)
      (graphStar edges (fun i => (envelopes3 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 54)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections3 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross3 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes3 (edges e).src).directions j) ((envelopes3 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections3 (edges e).src with hs | hz
  · rcases fixedDirections3 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value3 : vectorGraph edges (fun i => (envelopes3 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell3 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1706) (hy : (7 : ℤ)^4 ∣ y-666) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 1706 666 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤6)).trans root_rho)
    envelopes3 constantC constantD certificatesC3 certificatesD3 0
