without_editor_info theorem checks103 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes103 i) pi rho 13 20933 7627 2 (values 150 111 i) (certificatesC103 i) (certificatesD103 i) := by decide +kernel

without_editor_info theorem fixedDirections103 : ∀ i : Fin 60,
    i=37 ∨ (envelopes103 i).directions=0 := by decide +kernel

without_editor_info theorem linear103 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes103 i).directions j)
      (graphStar edges (fun i => (envelopes103 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes103 37).directions k)
      (graphStar edges (fun i => (envelopes103 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 37)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections103 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross103 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes103 (edges e).src).directions j) ((envelopes103 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections103 (edges e).src with hs | hz
  · rcases fixedDirections103 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value103 : vectorGraph edges (fun i => (envelopes103 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell103 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-150) (hy : (13 : ℤ)^2 ∣ y-111) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 150 111 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes103 constantC constantD certificatesC103 certificatesD103 0
