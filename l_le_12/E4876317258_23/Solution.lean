    (hx : (7 : ℤ)^2 ∣ x-0) (hy : (7 : ℤ)^2 ∣ y-4) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 0 4 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤6)).trans root_rho)
    envelopes160 constantC constantD certificatesC160 certificatesD160 0
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks160 i))
    linear160 cross160 value160 hx hy

