    tameForm ((envelopes11 i).directions j)
      (graphStar edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections11 i k]
  simp [tameForm]

