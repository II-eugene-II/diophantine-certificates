without_editor_info theorem linear88 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes88 i).directions j)
      (graphStar edges (fun i => (envelopes88 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections88 i k]
  simp [tameForm]

without_editor_info theorem cross88 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes88 (edges e).src).directions j) ((envelopes88 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections88 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value88 : vectorGraph edges (fun i => (envelopes88 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
