without_editor_info theorem linear64 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes64 i).directions j)
      (graphStar edges (fun i => (envelopes64 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections64 i k]
  simp [tameForm]

without_editor_info theorem cross64 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes64 (edges e).src).directions j) ((envelopes64 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections64 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value64 : vectorGraph edges (fun i => (envelopes64 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
