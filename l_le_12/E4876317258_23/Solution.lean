without_editor_info theorem checks59 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes59 i) pi rho 7 34967 82681 3 (values 110 182 i) (certificatesC59 i) (certificatesD59 i) := by decide +kernel

without_editor_info theorem linear59 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes59 i).directions j)
      (graphStar edges (fun i => (envelopes59 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 60, ∀ j : Fin 4, (envelopes59 i).directions j = 0 ∨
      tameForm ((envelopes59 i).directions j)
        (graphStar edges (fun i => (envelopes59 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross59 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes59 (edges e).src).directions j) ((envelopes59 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 287) edgeList (by decide)
    (fun e => (envelopes59 e.src).directions = 0 ∨
      (envelopes59 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes59 e.src).directions j) ((envelopes59 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes59 (edges e).src).directions = 0 ∨
    (envelopes59 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes59 (edges e).src).directions j) ((envelopes59 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value59 : vectorGraph edges (fun i => (envelopes59 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
