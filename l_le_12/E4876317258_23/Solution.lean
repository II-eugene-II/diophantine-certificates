without_editor_info theorem checks144 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes144 i) pi rho 13 20933 7627 2 (values 58 96 i) (certificatesC144 i) (certificatesD144 i) := by decide +kernel

without_editor_info theorem fixedDirections144 : ∀ i : Fin 60,
    i=19 ∨ (envelopes144 i).directions=0 := by decide +kernel

without_editor_info theorem linear144 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes144 i).directions j)
      (graphStar edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes144 19).directions k)
      (graphStar edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 19)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections144 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross144 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes144 (edges e).src).directions j) ((envelopes144 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections144 (edges e).src with hs | hz
  · rcases fixedDirections144 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value144 : vectorGraph edges (fun i => (envelopes144 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

