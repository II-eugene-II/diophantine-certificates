without_editor_info theorem linear286 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes286 i).directions j)
      (graphStar edges (fun i => (envelopes286 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes286 43).directions k)
      (graphStar edges (fun i => (envelopes286 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 43)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections286 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross286 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes286 (edges e).src).directions j) ((envelopes286 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections286 (edges e).src with hs | hz
  · rcases fixedDirections286 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

