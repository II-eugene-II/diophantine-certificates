without_editor_info theorem fixedDirections150 : ∀ i : Fin 60,
    i=31 ∨ (envelopes150 i).directions=0 := by decide +kernel

without_editor_info theorem linear150 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes150 i).directions j)
      (graphStar edges (fun i => (envelopes150 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes150 31).directions k)
      (graphStar edges (fun i => (envelopes150 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 31)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections150 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross150 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes150 (edges e).src).directions j) ((envelopes150 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections150 (edges e).src with hs | hz
  · rcases fixedDirections150 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value150 : vectorGraph edges (fun i => (envelopes150 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell150 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-58) (hy : (13 : ℤ)^2 ∣ y-18) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 58 18 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes150 constantC constantD certificatesC150 certificatesD150 0
