without_editor_info theorem checks108 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes108 i) pi rho 13 20933 7627 2 (values 85 7 i) (certificatesC108 i) (certificatesD108 i) := by decide +kernel

without_editor_info theorem linear108 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes108 i).directions j)
      (graphStar edges (fun i => (envelopes108 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 60, ∀ j : Fin 4, (envelopes108 i).directions j = 0 ∨
      tameForm ((envelopes108 i).directions j)
        (graphStar edges (fun i => (envelopes108 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross108 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes108 (edges e).src).directions j) ((envelopes108 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 287) edgeList (by decide)
    (fun e => (envelopes108 e.src).directions = 0 ∨
      (envelopes108 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes108 e.src).directions j) ((envelopes108 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes108 (edges e).src).directions = 0 ∨
    (envelopes108 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes108 (edges e).src).directions j) ((envelopes108 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value108 : vectorGraph edges (fun i => (envelopes108 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
