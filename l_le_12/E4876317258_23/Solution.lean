without_editor_info theorem linear270 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes270 i).directions j)
      (graphStar edges (fun i => (envelopes270 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes270 35).directions k)
      (graphStar edges (fun i => (envelopes270 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 35)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections270 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross270 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes270 (edges e).src).directions j) ((envelopes270 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections270 (edges e).src with hs | hz
  · rcases fixedDirections270 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

