    (fun e => (envelopes268 e.src).directions = 0 ∨
      (envelopes268 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes268 e.src).directions j) ((envelopes268 e.dst).directions k) = 0))
