  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 121 149 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes243 constantC constantD certificatesC243 certificatesD243 0
