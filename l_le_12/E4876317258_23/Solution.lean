  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 13241 4765 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes128 constantC constantD certificatesC128 certificatesD128 0
