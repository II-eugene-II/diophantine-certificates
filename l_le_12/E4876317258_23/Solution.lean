without_editor_info theorem checks128 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes128 i) pi rho 13 20933 7627 4 (values 13241 4765 i) (certificatesC128 i) (certificatesD128 i) := by decide +kernel

without_editor_info theorem fixedDirections128 : ∀ i : Fin 60,
    i=21 ∨ (envelopes128 i).directions=0 := by decide +kernel

without_editor_info theorem linear128 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes128 i).directions j)
      (graphStar edges (fun i => (envelopes128 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes128 21).directions k)
      (graphStar edges (fun i => (envelopes128 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 21)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections128 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross128 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes128 (edges e).src).directions j) ((envelopes128 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections128 (edges e).src with hs | hz
  · rcases fixedDirections128 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value128 : vectorGraph edges (fun i => (envelopes128 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

