    (hx : (7 : ℤ)^5 ∣ x-15300) (hy : (7 : ℤ)^5 ∣ y-12026) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
