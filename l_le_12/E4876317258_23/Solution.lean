    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤6)).trans root_rho)
    envelopes97 constantC constantD certificatesC97 certificatesD97 0
