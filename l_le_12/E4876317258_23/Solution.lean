    (hx : (7 : ℤ)^4 ∣ x-2168) (hy : (7 : ℤ)^4 ∣ y-2387) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 2168 2387 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤6)).trans root_rho)
    envelopes50 constantC constantD certificatesC50 certificatesD50 0
