  change (envelopes194 (edges e).src).directions = 0 ∨
    (envelopes194 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes194 (edges e).src).directions j) ((envelopes194 (edges e).dst).directions k) = 0) at h
