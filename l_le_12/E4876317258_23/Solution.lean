without_editor_info theorem fixedDirections146 : ∀ i : Fin 60,
    i=39 ∨ (envelopes146 i).directions=0 := by decide +kernel

without_editor_info theorem linear146 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes146 i).directions j)
      (graphStar edges (fun i => (envelopes146 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes146 39).directions k)
      (graphStar edges (fun i => (envelopes146 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 39)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections146 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross146 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes146 (edges e).src).directions j) ((envelopes146 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections146 (edges e).src with hs | hz
  · rcases fixedDirections146 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value146 : vectorGraph edges (fun i => (envelopes146 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
