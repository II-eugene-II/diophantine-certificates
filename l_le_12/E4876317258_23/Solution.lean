    (hx : (7 : ℤ)^3 ∣ x-110) (hy : (7 : ℤ)^3 ∣ y-112) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 110 112 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤6)).trans root_rho)
    envelopes87 constantC constantD certificatesC87 certificatesD87 0
