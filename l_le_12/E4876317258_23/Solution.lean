without_editor_info theorem unit9_mod3_table : ∀ a b : ZMod 9, Unit9 ⟨a,b⟩ ↔
    ZMod.castHom (by decide : 3∣9) (ZMod 3) a +
      ZMod.castHom (by decide : 3∣9) (ZMod 3) b ≠ 0 := by
