without_editor_info theorem checks153 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes153 i) pi rho 13 20933 7627 2 (values 149 147 i) (certificatesC153 i) (certificatesD153 i) := by decide +kernel

without_editor_info theorem fixedDirections153 : ∀ i : Fin 60,
    i=1 ∨ (envelopes153 i).directions=0 := by decide +kernel

without_editor_info theorem linear153 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes153 i).directions j)
      (graphStar edges (fun i => (envelopes153 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes153 1).directions k)
      (graphStar edges (fun i => (envelopes153 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 1)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections153 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross153 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes153 (edges e).src).directions j) ((envelopes153 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections153 (edges e).src with hs | hz
  · rcases fixedDirections153 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value153 : vectorGraph edges (fun i => (envelopes153 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
