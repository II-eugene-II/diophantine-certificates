without_editor_info theorem linear409 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes409 i).directions j)
      (graphStar edges (fun i => (envelopes409 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes409 41).directions k)
      (graphStar edges (fun i => (envelopes409 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 41)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections409 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross409 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes409 (edges e).src).directions j) ((envelopes409 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections409 (edges e).src with hs | hz
  · rcases fixedDirections409 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

