  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 2168 329 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤6)).trans root_rho)
    envelopes56 constantC constantD certificatesC56 certificatesD56 0
