without_editor_info theorem linear122 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes122 i).directions j)
      (graphStar edges (fun i => (envelopes122 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 60, ∀ j : Fin 4, (envelopes122 i).directions j = 0 ∨
      tameForm ((envelopes122 i).directions j)
        (graphStar edges (fun i => (envelopes122 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross122 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes122 (edges e).src).directions j) ((envelopes122 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 287) edgeList (by decide)
    (fun e => (envelopes122 e.src).directions = 0 ∨
      (envelopes122 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes122 e.src).directions j) ((envelopes122 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes122 (edges e).src).directions = 0 ∨
    (envelopes122 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes122 (edges e).src).directions j) ((envelopes122 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

