    i=57 ∨ (envelopes168 i).directions=0 := by decide +kernel

without_editor_info theorem linear168 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes168 i).directions j)
      (graphStar edges (fun i => (envelopes168 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes168 57).directions k)
      (graphStar edges (fun i => (envelopes168 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 57)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections168 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross168 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes168 (edges e).src).directions j) ((envelopes168 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections168 (edges e).src with hs | hz
  · rcases fixedDirections168 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

