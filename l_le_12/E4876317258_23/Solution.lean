    tameForm ((envelopes37 i).directions j)
      (graphStar edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections37 i k]
  simp [tameForm]

without_editor_info theorem cross37 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes37 (edges e).src).directions j) ((envelopes37 (edges e).dst).directions k) = 0 := by
