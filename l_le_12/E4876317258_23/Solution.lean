without_editor_info theorem zeroDirections111 : ∀ i : Fin 60, ∀ j : Fin 4,
    (envelopes111 i).directions j=0 := by decide +kernel

without_editor_info theorem linear111 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes111 i).directions j)
      (graphStar edges (fun i => (envelopes111 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections111 i k]
  simp [tameForm]

without_editor_info theorem cross111 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes111 (edges e).src).directions j) ((envelopes111 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections111 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value111 : vectorGraph edges (fun i => (envelopes111 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
