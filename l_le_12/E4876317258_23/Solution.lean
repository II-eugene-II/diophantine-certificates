    (hx : (7 : ℤ)^4 ∣ x-306) (hy : (7 : ℤ)^4 ∣ y-2059) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 306 2059 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤6)).trans root_rho)
    envelopes35 constantC constantD certificatesC35 certificatesD35 0
