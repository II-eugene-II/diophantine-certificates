without_editor_info theorem checks63 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes63 i) pi rho 7 34967 82681 2 (values 12 28 i) (certificatesC63 i) (certificatesD63 i) := by decide +kernel

without_editor_info theorem fixedDirections63 : ∀ i : Fin 60,
    i=58 ∨ (envelopes63 i).directions=0 := by decide +kernel

without_editor_info theorem linear63 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes63 i).directions j)
      (graphStar edges (fun i => (envelopes63 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes63 58).directions k)
      (graphStar edges (fun i => (envelopes63 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 58)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections63 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross63 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes63 (edges e).src).directions j) ((envelopes63 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections63 (edges e).src with hs | hz
  · rcases fixedDirections63 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value63 : vectorGraph edges (fun i => (envelopes63 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell63 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-12) (hy : (7 : ℤ)^2 ∣ y-28) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 12 28 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤6)).trans root_rho)
    envelopes63 constantC constantD certificatesC63 certificatesD63 0
