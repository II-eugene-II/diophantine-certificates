without_editor_info theorem checks33 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes33 i) pi rho 13 20933 7627 2 (values 87 60 i) (certificatesC33 i) (certificatesD33 i) := by decide +kernel

without_editor_info theorem fixedDirections33 : ∀ i : Fin 60,
    i=57 ∨ (envelopes33 i).directions=0 := by decide +kernel

without_editor_info theorem linear33 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes33 i).directions j)
      (graphStar edges (fun i => (envelopes33 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes33 57).directions k)
      (graphStar edges (fun i => (envelopes33 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 57)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections33 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross33 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes33 (edges e).src).directions j) ((envelopes33 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections33 (edges e).src with hs | hz
  · rcases fixedDirections33 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value33 : vectorGraph edges (fun i => (envelopes33 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell33 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-87) (hy : (13 : ℤ)^2 ∣ y-60) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 87 60 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes33 constantC constantD certificatesC33 certificatesD33 0
