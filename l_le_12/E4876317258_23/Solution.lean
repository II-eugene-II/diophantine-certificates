  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 264 1689 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes230 constantC constantD certificatesC230 certificatesD230 0
