without_editor_info theorem checks89 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes89 i) pi rho 7 34967 82681 3 (values 110 14 i) (certificatesC89 i) (certificatesD89 i) := by decide +kernel

without_editor_info theorem fixedDirections89 : ∀ i : Fin 60,
    i=38 ∨ (envelopes89 i).directions=0 := by decide +kernel

without_editor_info theorem linear89 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes89 i).directions j)
      (graphStar edges (fun i => (envelopes89 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes89 38).directions k)
      (graphStar edges (fun i => (envelopes89 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 38)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections89 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross89 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes89 (edges e).src).directions j) ((envelopes89 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections89 (edges e).src with hs | hz
  · rcases fixedDirections89 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value89 : vectorGraph edges (fun i => (envelopes89 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell89 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-110) (hy : (7 : ℤ)^3 ∣ y-14) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 110 14 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤6)).trans root_rho)
    envelopes89 constantC constantD certificatesC89 certificatesD89 0
