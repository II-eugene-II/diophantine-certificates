  change (envelopes241 (edges e).src).directions = 0 ∨
    (envelopes241 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes241 (edges e).src).directions j) ((envelopes241 (edges e).dst).directions k) = 0) at h
