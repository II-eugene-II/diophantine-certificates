without_editor_info theorem linear194 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes194 i).directions j)
      (graphStar edges (fun i => (envelopes194 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 60, ∀ j : Fin 4, (envelopes194 i).directions j = 0 ∨
      tameForm ((envelopes194 i).directions j)
        (graphStar edges (fun i => (envelopes194 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

