without_editor_info theorem checks243 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes243 i) pi rho 13 20933 7627 2 (values 121 149 i) (certificatesC243 i) (certificatesD243 i) := by decide +kernel

without_editor_info theorem fixedDirections243 : ∀ i : Fin 60,
    i=37 ∨ (envelopes243 i).directions=0 := by decide +kernel

without_editor_info theorem linear243 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes243 i).directions j)
      (graphStar edges (fun i => (envelopes243 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes243 37).directions k)
      (graphStar edges (fun i => (envelopes243 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 37)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections243 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross243 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes243 (edges e).src).directions j) ((envelopes243 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections243 (edges e).src with hs | hz
  · rcases fixedDirections243 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value243 : vectorGraph edges (fun i => (envelopes243 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
