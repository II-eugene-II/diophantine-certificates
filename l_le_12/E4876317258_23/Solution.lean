without_editor_info theorem checks45 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes45 i) pi rho 7 34967 82681 3 (values 152 288 i) (certificatesC45 i) (certificatesD45 i) := by decide +kernel

without_editor_info theorem linear45 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes45 i).directions j)
      (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 60, ∀ j : Fin 4, (envelopes45 i).directions j = 0 ∨
      tameForm ((envelopes45 i).directions j)
        (graphStar edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross45 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes45 (edges e).src).directions j) ((envelopes45 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 287) edgeList (by decide)
    (fun e => (envelopes45 e.src).directions = 0 ∨
      (envelopes45 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes45 e.src).directions j) ((envelopes45 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes45 (edges e).src).directions = 0 ∨
    (envelopes45 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes45 (edges e).src).directions j) ((envelopes45 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value45 : vectorGraph edges (fun i => (envelopes45 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell45 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-152) (hy : (7 : ℤ)^3 ∣ y-288) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 152 288 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤6)).trans root_rho)
    envelopes45 constantC constantD certificatesC45 certificatesD45 0
