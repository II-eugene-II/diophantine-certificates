    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 5≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 5≤6)).trans root_rho)
    envelopes79 constantC constantD certificatesC79 certificatesD79 0
