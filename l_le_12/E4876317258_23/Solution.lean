without_editor_info theorem checks107 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes107 i) pi rho 7 34967 82681 3 (values 298 280 i) (certificatesC107 i) (certificatesD107 i) := by decide +kernel

without_editor_info theorem fixedDirections107 : ∀ i : Fin 60,
    i=41 ∨ (envelopes107 i).directions=0 := by decide +kernel

without_editor_info theorem linear107 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes107 i).directions j)
      (graphStar edges (fun i => (envelopes107 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes107 41).directions k)
      (graphStar edges (fun i => (envelopes107 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 41)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections107 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross107 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes107 (edges e).src).directions j) ((envelopes107 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections107 (edges e).src with hs | hz
  · rcases fixedDirections107 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value107 : vectorGraph edges (fun i => (envelopes107 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

