  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 151 21 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤6)).trans root_rho)
    envelopes120 constantC constantD certificatesC120 certificatesD120 0
