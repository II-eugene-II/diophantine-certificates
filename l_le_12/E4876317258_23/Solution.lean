without_editor_info theorem checks109 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes109 i) pi rho 13 20933 7627 2 (values 72 20 i) (certificatesC109 i) (certificatesD109 i) := by decide +kernel

without_editor_info theorem fixedDirections109 : ∀ i : Fin 60,
    i=55 ∨ (envelopes109 i).directions=0 := by decide +kernel

without_editor_info theorem linear109 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes109 i).directions j)
      (graphStar edges (fun i => (envelopes109 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes109 55).directions k)
      (graphStar edges (fun i => (envelopes109 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 55)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections109 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross109 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes109 (edges e).src).directions j) ((envelopes109 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections109 (edges e).src with hs | hz
  · rcases fixedDirections109 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value109 : vectorGraph edges (fun i => (envelopes109 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

