    i=6 ∨ (envelopes148 i).directions=0 := by decide +kernel

without_editor_info theorem linear148 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes148 i).directions j)
      (graphStar edges (fun i => (envelopes148 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes148 6).directions k)
      (graphStar edges (fun i => (envelopes148 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 6)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections148 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross148 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes148 (edges e).src).directions j) ((envelopes148 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections148 (edges e).src with hs | hz
  · rcases fixedDirections148 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

