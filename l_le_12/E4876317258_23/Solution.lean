    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections229 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross229 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes229 (edges e).src).directions j) ((envelopes229 (edges e).dst).directions k) = 0 := by
