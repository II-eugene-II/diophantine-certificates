without_editor_info theorem zeroDirections160 : ∀ i : Fin 60, ∀ j : Fin 4,
    (envelopes160 i).directions j=0 := by decide +kernel

without_editor_info theorem linear160 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes160 i).directions j)
      (graphStar edges (fun i => (envelopes160 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections160 i k]
  simp [tameForm]

without_editor_info theorem cross160 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes160 (edges e).src).directions j) ((envelopes160 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections160 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value160 : vectorGraph edges (fun i => (envelopes160 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

