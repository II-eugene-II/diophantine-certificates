    (envelopes199 i).directions j=0 := by decide +kernel

without_editor_info theorem linear199 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes199 i).directions j)
      (graphStar edges (fun i => (envelopes199 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections199 i k]
  simp [tameForm]

without_editor_info theorem cross199 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes199 (edges e).src).directions j) ((envelopes199 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections199 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value199 : vectorGraph edges (fun i => (envelopes199 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
