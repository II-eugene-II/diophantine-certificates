without_editor_info theorem checks104 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes104 i) pi rho 7 34967 82681 3 (values 249 91 i) (certificatesC104 i) (certificatesD104 i) := by decide +kernel

without_editor_info theorem fixedDirections104 : ∀ i : Fin 60,
    i=44 ∨ (envelopes104 i).directions=0 := by decide +kernel

without_editor_info theorem linear104 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes104 i).directions j)
      (graphStar edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes104 44).directions k)
      (graphStar edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 44)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections104 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross104 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes104 (edges e).src).directions j) ((envelopes104 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections104 (edges e).src with hs | hz
  · rcases fixedDirections104 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value104 : vectorGraph edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
