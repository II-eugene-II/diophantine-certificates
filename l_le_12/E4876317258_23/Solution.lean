  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 249 42 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤6)).trans root_rho)
    envelopes105 constantC constantD certificatesC105 certificatesD105 0
