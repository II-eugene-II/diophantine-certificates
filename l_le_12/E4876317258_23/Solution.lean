without_editor_info theorem zeroDirections87 : ∀ i : Fin 60, ∀ j : Fin 4,
    (envelopes87 i).directions j=0 := by decide +kernel

without_editor_info theorem linear87 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes87 i).directions j)
      (graphStar edges (fun i => (envelopes87 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections87 i k]
  simp [tameForm]

without_editor_info theorem cross87 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes87 (edges e).src).directions j) ((envelopes87 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections87 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value87 : vectorGraph edges (fun i => (envelopes87 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

