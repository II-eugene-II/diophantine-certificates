without_editor_info theorem checks17 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes17 i) pi rho 7 34967 82681 3 (values 180 267 i) (certificatesC17 i) (certificatesD17 i) := by decide +kernel

without_editor_info theorem fixedDirections17 : ∀ i : Fin 60,
    i=14 ∨ (envelopes17 i).directions=0 := by decide +kernel

without_editor_info theorem linear17 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes17 i).directions j)
      (graphStar edges (fun i => (envelopes17 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes17 14).directions k)
      (graphStar edges (fun i => (envelopes17 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 14)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections17 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross17 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes17 (edges e).src).directions j) ((envelopes17 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections17 (edges e).src with hs | hz
  · rcases fixedDirections17 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value17 : vectorGraph edges (fun i => (envelopes17 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell17 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-180) (hy : (7 : ℤ)^3 ∣ y-267) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 180 267 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤6)).trans root_rho)
    envelopes17 constantC constantD certificatesC17 certificatesD17 0
