without_editor_info theorem checks256 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes256 i) pi rho 13 20933 7627 3 (values 420 2060 i) (certificatesC256 i) (certificatesD256 i) := by decide +kernel

without_editor_info theorem zeroDirections256 : ∀ i : Fin 60, ∀ j : Fin 4,
    (envelopes256 i).directions j=0 := by decide +kernel

without_editor_info theorem linear256 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes256 i).directions j)
      (graphStar edges (fun i => (envelopes256 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections256 i k]
  simp [tameForm]

without_editor_info theorem cross256 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes256 (edges e).src).directions j) ((envelopes256 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections256 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value256 : vectorGraph edges (fun i => (envelopes256 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell256 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-420) (hy : (13 : ℤ)^3 ∣ y-2060) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 20933 7627 420 2060 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes256 constantC constantD certificatesC256 certificatesD256 0
