  change (envelopes268 (edges e).src).directions = 0 ∨
    (envelopes268 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes268 (edges e).src).directions j) ((envelopes268 (edges e).dst).directions k) = 0) at h
