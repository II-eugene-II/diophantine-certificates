    (hx : (13 : ℤ)^3 ∣ x-1698) (hy : (13 : ℤ)^3 ∣ y-1781) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
