without_editor_info theorem checks120 : ∀ i : Fin 60, jointEnvelopeFastCheck (envelopes120 i) pi rho 7 34967 82681 3 (values 151 21 i) (certificatesC120 i) (certificatesD120 i) := by decide +kernel

without_editor_info theorem fixedDirections120 : ∀ i : Fin 60,
    i=14 ∨ (envelopes120 i).directions=0 := by decide +kernel

without_editor_info theorem linear120 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes120 i).directions j)
      (graphStar edges (fun i => (envelopes120 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes120 14).directions k)
      (graphStar edges (fun i => (envelopes120 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 14)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections120 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross120 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes120 (edges e).src).directions j) ((envelopes120 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections120 (edges e).src with hs | hz
  · rcases fixedDirections120 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value120 : vectorGraph edges (fun i => (envelopes120 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
