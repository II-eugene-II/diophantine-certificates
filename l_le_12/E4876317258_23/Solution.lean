  split_cell edges values constants values_congr pi rho away_pi away_rho 7 34967 82681 7 32 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤6)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤6)).trans root_rho)
    envelopes159 constantC constantD certificatesC159 certificatesD159 0
