    i=59 ∨ (envelopes279 i).directions=0 := by decide +kernel

without_editor_info theorem linear279 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes279 i).directions j)
      (graphStar edges (fun i => (envelopes279 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes279 59).directions k)
      (graphStar edges (fun i => (envelopes279 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 59)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections279 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross279 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes279 (edges e).src).directions j) ((envelopes279 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections279 (edges e).src with hs | hz
  · rcases fixedDirections279 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

