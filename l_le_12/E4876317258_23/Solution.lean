    (envelopes408 i).directions j=0 := by decide +kernel

without_editor_info theorem linear408 : ∀ i : Fin 60, ∀ j : Fin 4,
    tameForm ((envelopes408 i).directions j)
      (graphStar edges (fun i => (envelopes408 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections408 i k]
  simp [tameForm]

without_editor_info theorem cross408 : ∀ e : Fin 287, ∀ j k : Fin 4,
    tameForm ((envelopes408 (edges e).src).directions j) ((envelopes408 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections408 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value408 : vectorGraph edges (fun i => (envelopes408 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
