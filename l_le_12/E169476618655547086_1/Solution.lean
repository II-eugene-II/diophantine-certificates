  refine ⟨t/(p^precision p:ℕ),?_⟩
  rw [hi,pow_add]
  have ht' := Int.emod_add_mul_ediv t ((p^precision p:ℕ):ℤ)
  push_cast at ht'
  push_cast
  linear_combination ht-(p:ℤ)^k*ht'

end GraphCert.RationalClasses

