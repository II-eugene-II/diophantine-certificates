without_editor_info theorem checks20 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes20 i) pi rho 13 1160 1036 2 (values 76 89 i) (certificatesC20 i) (certificatesD20 i) := by decide +kernel

without_editor_info theorem fixedDirections20 : ∀ i : Fin 63,
    i=58 ∨ (envelopes20 i).directions=0 := by decide +kernel

without_editor_info theorem linear20 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes20 i).directions j)
      (graphStar edges (fun i => (envelopes20 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes20 58).directions k)
      (graphStar edges (fun i => (envelopes20 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 58)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections20 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross20 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes20 (edges e).src).directions j) ((envelopes20 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections20 (edges e).src with hs | hz
  · rcases fixedDirections20 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value20 : vectorGraph edges (fun i => (envelopes20 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

