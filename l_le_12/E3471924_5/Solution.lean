    i=52 ∨ (envelopes27 i).directions=0 := by decide +kernel

without_editor_info theorem linear27 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes27 i).directions j)
      (graphStar edges (fun i => (envelopes27 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes27 52).directions k)
      (graphStar edges (fun i => (envelopes27 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 52)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections27 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross27 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes27 (edges e).src).directions j) ((envelopes27 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections27 (edges e).src with hs | hz
  · rcases fixedDirections27 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

