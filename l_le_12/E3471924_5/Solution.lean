without_editor_info theorem checks57 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes57 i) pi rho 19 2819 4039 2 (values 35 293 i) (certificatesC57 i) (certificatesD57 i) := by decide +kernel

without_editor_info theorem fixedDirections57 : ∀ i : Fin 63,
    i=28 ∨ (envelopes57 i).directions=0 := by decide +kernel

without_editor_info theorem linear57 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes57 i).directions j)
      (graphStar edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes57 28).directions k)
      (graphStar edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 28)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections57 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross57 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes57 (edges e).src).directions j) ((envelopes57 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections57 (edges e).src with hs | hz
  · rcases fixedDirections57 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value57 : vectorGraph edges (fun i => (envelopes57 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell57 {x y : ℤ} (hf : equation x y = 0)
