without_editor_info theorem checks14 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes14 i) pi rho 7 1353 1047 3 (values 40 31 i) (certificatesC14 i) (certificatesD14 i) := by decide +kernel

without_editor_info theorem fixedDirections14 : ∀ i : Fin 63,
    i=52 ∨ (envelopes14 i).directions=0 := by decide +kernel

without_editor_info theorem linear14 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes14 i).directions j)
      (graphStar edges (fun i => (envelopes14 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes14 52).directions k)
      (graphStar edges (fun i => (envelopes14 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 52)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections14 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross14 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes14 (edges e).src).directions j) ((envelopes14 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections14 (edges e).src with hs | hz
  · rcases fixedDirections14 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value14 : vectorGraph edges (fun i => (envelopes14 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

