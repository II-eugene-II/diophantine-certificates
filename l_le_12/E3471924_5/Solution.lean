without_editor_info theorem checks49 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes49 i) pi rho 7 1353 1047 3 (values 305 125 i) (certificatesC49 i) (certificatesD49 i) := by decide +kernel

without_editor_info theorem fixedDirections49 : ∀ i : Fin 63,
    i=51 ∨ (envelopes49 i).directions=0 := by decide +kernel

without_editor_info theorem linear49 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes49 i).directions j)
      (graphStar edges (fun i => (envelopes49 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes49 51).directions k)
      (graphStar edges (fun i => (envelopes49 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections49 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross49 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes49 (edges e).src).directions j) ((envelopes49 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections49 (edges e).src with hs | hz
  · rcases fixedDirections49 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value49 : vectorGraph edges (fun i => (envelopes49 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell49 {x y : ℤ} (hf : equation x y = 0)
