without_editor_info theorem fixedDirections195 : ∀ i : Fin 63,
    i=33 ∨ (envelopes195 i).directions=0 := by decide +kernel

without_editor_info theorem linear195 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes195 i).directions j)
      (graphStar edges (fun i => (envelopes195 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes195 33).directions k)
      (graphStar edges (fun i => (envelopes195 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 33)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections195 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross195 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes195 (edges e).src).directions j) ((envelopes195 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections195 (edges e).src with hs | hz
  · rcases fixedDirections195 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

