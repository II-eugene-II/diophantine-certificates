    (hx : (7 : ℤ)^2 ∣ x-26) (hy : (7 : ℤ)^2 ∣ y-31) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
