  decide +kernel

without_editor_info theorem cell24 {x y : ℤ} (hf : equation x y = 0)
    (hx : (31 : ℤ)^1 ∣ x-6) (hy : (31 : ℤ)^1 ∣ y-26) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 5 25 6 26 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤1)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤1)).trans root_rho)
    envelopes24 constantC constantD certificatesC24 certificatesD24 0
