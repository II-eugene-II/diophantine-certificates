without_editor_info theorem checks78 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes78 i) pi rho 7 1353 1047 3 (values 74 21 i) (certificatesC78 i) (certificatesD78 i) := by decide +kernel

without_editor_info theorem fixedDirections78 : ∀ i : Fin 63,
    i=45 ∨ (envelopes78 i).directions=0 := by decide +kernel

without_editor_info theorem linear78 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes78 i).directions j)
      (graphStar edges (fun i => (envelopes78 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes78 45).directions k)
      (graphStar edges (fun i => (envelopes78 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 45)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections78 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross78 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes78 (edges e).src).directions j) ((envelopes78 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections78 (edges e).src with hs | hz
  · rcases fixedDirections78 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value78 : vectorGraph edges (fun i => (envelopes78 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

