    tameForm ((envelopes196 (edges e).src).directions j) ((envelopes196 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes196 e.src).directions = 0 ∨
      (envelopes196 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes196 e.src).directions j) ((envelopes196 e.dst).directions k) = 0))
