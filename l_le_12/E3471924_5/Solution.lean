without_editor_info theorem fixedDirections42 : ∀ i : Fin 63,
    i=52 ∨ (envelopes42 i).directions=0 := by decide +kernel

without_editor_info theorem linear42 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes42 i).directions j)
      (graphStar edges (fun i => (envelopes42 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes42 52).directions k)
      (graphStar edges (fun i => (envelopes42 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 52)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections42 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross42 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes42 (edges e).src).directions j) ((envelopes42 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections42 (edges e).src with hs | hz
  · rcases fixedDirections42 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

