without_editor_info theorem ordinary_support0 {x y : ℤ} (hf : equation x y=0) (p : ℕ)
    (hp : p.Prime) (hp2 : p≠2) (hpE : p∉({3,19}:Finset ℕ)) : value (oddH p) (arguments0 x y)=1 := by
  letI : Fact p.Prime := ⟨hp⟩
  have hpZ : Prime (p:ℤ) := Int.prime_iff_natAbs_prime.mpr (by simpa using hp)
  have hN : ¬ (p:ℤ) ∣ 114 := by
    intro hd
    have hn : p∣114 := by exact_mod_cast hd
    have hm : p ∈ Nat.primeFactors 114 := Nat.mem_primeFactors.mpr ⟨hp,hn,by decide⟩
    have he : Nat.primeFactors 114 = ({2,3,19}:Finset ℕ) := by decide +kernel
    rw [he] at hm
    simp only [Finset.mem_insert,Finset.mem_singleton] at hm
    rcases hm with rfl | rfl | rfl
    · exact hp2 rfl
    · exact hpE (by simp)
    · exact hpE (by simp)
  have supported (a b : ℤ) (he : a*b=(114:ℤ)^1) : ¬(p:ℤ) ∣ a := by
    intro hd
    apply hN
    apply hpZ.dvd_of_dvd_pow
    rw [← he]
    exact dvd_mul_of_dvd_left hd _
  have hc0 : ¬(p:ℤ)∣(eval H1 x y) := by
    apply supported _ (-38:ℤ)
    norm_num [H1,eval]
  have hs0 (hi : (p:ℤ)∣(eval H0 x y)) : jacobiSym (star0_0 x y) p=1 := by
    have hn : ¬(p:ℤ)∣star0_0 x y := by
      simpa only [star0_0, hpZ.dvd_mul, not_or] using hc0
    apply LocalSymbols.jacobi_square_mod _ hn
    exact square_of_identity hf hi (supported 19 (6) (by norm_num)) (star_identity0_0 x y)
  have expand : value (oddH p) (arguments0 x y) = jacobiSym (star0_0 x y) p ^ padicValInt p (eval H0 x y) := by
    simp only [value,arguments0,List.map_cons,List.map_nil,List.prod_cons,List.prod_nil,mul_one]
    rw [odd_edge (eval H0 x y) (eval H1 x y) (fun h => hc0 h.2)]
    simp only [star0_0, jacobiSym.mul_left, mul_pow]
    simp only [padicValInt.eq_zero_of_not_dvd hc0, pow_zero, one_pow, mul_one, one_mul] <;> ring
  rw [expand]
  rw [star_term (eval H0 x y) (star0_0 x y) hs0] <;> norm_num

without_editor_info theorem ordinary0 {x y : ℤ} (hf : equation x y=0) (p : ℕ)
    (hp : p.Prime) (hp2 : p≠2) (hpE : p∉({3,5,7,13,19,31}:Finset ℕ)) : value (oddH p) (arguments0 x y)=1 := by
  apply ordinary_support0 hf p hp hp2
  intro h
  apply hpE
  simp_all only [Finset.mem_insert,Finset.mem_singleton,Finset.notMem_empty] <;> tauto

