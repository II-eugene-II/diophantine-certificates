without_editor_info theorem linear98 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes98 i).directions j)
      (graphStar edges (fun i => (envelopes98 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes98 44).directions k)
      (graphStar edges (fun i => (envelopes98 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 44)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections98 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross98 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes98 (edges e).src).directions j) ((envelopes98 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections98 (edges e).src with hs | hz
  · rcases fixedDirections98 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

