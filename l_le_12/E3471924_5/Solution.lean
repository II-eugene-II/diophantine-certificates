without_editor_info theorem checks134 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes134 i) pi rho 13 1160 1036 2 (values 131 82 i) (certificatesC134 i) (certificatesD134 i) := by decide +kernel

without_editor_info theorem fixedDirections134 : ∀ i : Fin 63,
    i=3 ∨ (envelopes134 i).directions=0 := by decide +kernel

without_editor_info theorem linear134 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes134 i).directions j)
      (graphStar edges (fun i => (envelopes134 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes134 3).directions k)
      (graphStar edges (fun i => (envelopes134 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 3)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections134 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross134 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes134 (edges e).src).directions j) ((envelopes134 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections134 (edges e).src with hs | hz
  · rcases fixedDirections134 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value134 : vectorGraph edges (fun i => (envelopes134 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell134 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-131) (hy : (13 : ℤ)^2 ∣ y-82) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 131 82 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes134 constantC constantD certificatesC134 certificatesD134 0
