  split_cell edges values constants values_congr pi rho away_pi away_rho 19 2819 4039 3158 2866 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes154 constantC constantD certificatesC154 certificatesD154 0
