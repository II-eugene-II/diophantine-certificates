without_editor_info theorem checks17 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes17 i) pi rho 7 1353 1047 2 (values 19 31 i) (certificatesC17 i) (certificatesD17 i) := by decide +kernel

without_editor_info theorem linear17 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes17 i).directions j)
      (graphStar edges (fun i => (envelopes17 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes17 i).directions j = 0 ∨
      tameForm ((envelopes17 i).directions j)
        (graphStar edges (fun i => (envelopes17 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross17 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes17 (edges e).src).directions j) ((envelopes17 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes17 e.src).directions = 0 ∨
      (envelopes17 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes17 e.src).directions j) ((envelopes17 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes17 (edges e).src).directions = 0 ∨
    (envelopes17 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes17 (edges e).src).directions j) ((envelopes17 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

