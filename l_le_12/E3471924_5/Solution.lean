    tameForm ((envelopes112 (edges e).src).directions j) ((envelopes112 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections112 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value112 : vectorGraph edges (fun i => (envelopes112 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
