    tameForm ((envelopes36 i).directions j)
      (graphStar edges (fun i => (envelopes36 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections36 i k]
  simp [tameForm]

