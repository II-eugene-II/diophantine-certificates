without_editor_info theorem checks99 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes99 i) pi rho 13 1160 1036 3 (values 1666 1565 i) (certificatesC99 i) (certificatesD99 i) := by decide +kernel

without_editor_info theorem zeroDirections99 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes99 i).directions j=0 := by decide +kernel

without_editor_info theorem linear99 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes99 i).directions j)
      (graphStar edges (fun i => (envelopes99 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections99 i k]
  simp [tameForm]

without_editor_info theorem cross99 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes99 (edges e).src).directions j) ((envelopes99 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections99 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value99 : vectorGraph edges (fun i => (envelopes99 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell99 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1666) (hy : (13 : ℤ)^3 ∣ y-1565) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1666 1565 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes99 constantC constantD certificatesC99 certificatesD99 0
