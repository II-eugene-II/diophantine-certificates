without_editor_info theorem checks19 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes19 i) pi rho 19 2819 4039 2 (values 36 328 i) (certificatesC19 i) (certificatesD19 i) := by decide +kernel

without_editor_info theorem fixedDirections19 : ∀ i : Fin 63,
    i=30 ∨ (envelopes19 i).directions=0 := by decide +kernel

without_editor_info theorem linear19 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes19 i).directions j)
      (graphStar edges (fun i => (envelopes19 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes19 30).directions k)
      (graphStar edges (fun i => (envelopes19 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 30)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections19 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross19 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes19 (edges e).src).directions j) ((envelopes19 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections19 (edges e).src with hs | hz
  · rcases fixedDirections19 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value19 : vectorGraph edges (fun i => (envelopes19 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

