    i=21 ∨ (envelopes140 i).directions=0 := by decide +kernel

without_editor_info theorem linear140 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes140 i).directions j)
      (graphStar edges (fun i => (envelopes140 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes140 21).directions k)
      (graphStar edges (fun i => (envelopes140 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 21)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections140 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross140 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes140 (edges e).src).directions j) ((envelopes140 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections140 (edges e).src with hs | hz
  · rcases fixedDirections140 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

