without_editor_info theorem checks66 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes66 i) pi rho 7 1353 1047 2 (values 25 15 i) (certificatesC66 i) (certificatesD66 i) := by decide +kernel

without_editor_info theorem linear66 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes66 i).directions j)
      (graphStar edges (fun i => (envelopes66 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes66 i).directions j = 0 ∨
      tameForm ((envelopes66 i).directions j)
        (graphStar edges (fun i => (envelopes66 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross66 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes66 (edges e).src).directions j) ((envelopes66 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes66 e.src).directions = 0 ∨
      (envelopes66 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes66 e.src).directions j) ((envelopes66 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes66 (edges e).src).directions = 0 ∨
    (envelopes66 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes66 (edges e).src).directions j) ((envelopes66 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value66 : vectorGraph edges (fun i => (envelopes66 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
