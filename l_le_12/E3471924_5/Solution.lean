without_editor_info theorem checks44 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes44 i) pi rho 13 1160 1036 2 (values 123 53 i) (certificatesC44 i) (certificatesD44 i) := by decide +kernel

without_editor_info theorem fixedDirections44 : ∀ i : Fin 63,
    i=51 ∨ (envelopes44 i).directions=0 := by decide +kernel

without_editor_info theorem linear44 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes44 i).directions j)
      (graphStar edges (fun i => (envelopes44 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes44 51).directions k)
      (graphStar edges (fun i => (envelopes44 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections44 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross44 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes44 (edges e).src).directions j) ((envelopes44 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections44 (edges e).src with hs | hz
  · rcases fixedDirections44 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value44 : vectorGraph edges (fun i => (envelopes44 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

