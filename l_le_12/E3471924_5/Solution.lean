without_editor_info theorem linear196 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes196 i).directions j)
      (graphStar edges (fun i => (envelopes196 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes196 i).directions j = 0 ∨
      tameForm ((envelopes196 i).directions j)
        (graphStar edges (fun i => (envelopes196 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

