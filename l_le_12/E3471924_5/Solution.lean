  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 45 19 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes89 constantC constantD certificatesC89 certificatesD89 0
