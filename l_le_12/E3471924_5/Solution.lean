    tameForm ((envelopes175 i).directions j)
      (graphStar edges (fun i => (envelopes175 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes175 18).directions k)
      (graphStar edges (fun i => (envelopes175 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 18)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections175 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross175 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes175 (edges e).src).directions j) ((envelopes175 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections175 (edges e).src with hs | hz
  · rcases fixedDirections175 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

