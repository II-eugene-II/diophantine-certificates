without_editor_info theorem checks13 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes13 i) pi rho 31 5 25 1 (values 17 10 i) (certificatesC13 i) (certificatesD13 i) := by decide +kernel

without_editor_info theorem linear13 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes13 i).directions j)
      (graphStar edges (fun i => (envelopes13 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes13 i).directions j = 0 ∨
      tameForm ((envelopes13 i).directions j)
        (graphStar edges (fun i => (envelopes13 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross13 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes13 (edges e).src).directions j) ((envelopes13 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes13 e.src).directions = 0 ∨
      (envelopes13 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes13 e.src).directions j) ((envelopes13 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes13 (edges e).src).directions = 0 ∨
    (envelopes13 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes13 (edges e).src).directions j) ((envelopes13 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

