without_editor_info theorem checks100 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes100 i) pi rho 7 1353 1047 4 (values 1732 362 i) (certificatesC100 i) (certificatesD100 i) := by decide +kernel

without_editor_info theorem zeroDirections100 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes100 i).directions j=0 := by decide +kernel

without_editor_info theorem linear100 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes100 i).directions j)
      (graphStar edges (fun i => (envelopes100 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections100 i k]
  simp [tameForm]

without_editor_info theorem cross100 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes100 (edges e).src).directions j) ((envelopes100 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections100 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value100 : vectorGraph edges (fun i => (envelopes100 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell100 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1732) (hy : (7 : ℤ)^4 ∣ y-362) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1732 362 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes100 constantC constantD certificatesC100 certificatesD100 0
