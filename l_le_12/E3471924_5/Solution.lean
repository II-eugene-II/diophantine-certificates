    (hx : (31 : ℤ)^1 ∣ x-0) (hy : (31 : ℤ)^1 ∣ y-4) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
