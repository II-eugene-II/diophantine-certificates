without_editor_info theorem checks111 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes111 i) pi rho 7 1353 1047 3 (values 275 296 i) (certificatesC111 i) (certificatesD111 i) := by decide +kernel

without_editor_info theorem fixedDirections111 : ∀ i : Fin 63,
    i=3 ∨ (envelopes111 i).directions=0 := by decide +kernel

without_editor_info theorem linear111 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes111 i).directions j)
      (graphStar edges (fun i => (envelopes111 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes111 3).directions k)
      (graphStar edges (fun i => (envelopes111 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 3)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections111 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross111 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes111 (edges e).src).directions j) ((envelopes111 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections111 (edges e).src with hs | hz
  · rcases fixedDirections111 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value111 : vectorGraph edges (fun i => (envelopes111 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell111 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-275) (hy : (7 : ℤ)^3 ∣ y-296) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 275 296 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes111 constantC constantD certificatesC111 certificatesD111 0
