without_editor_info theorem checks11 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes11 i) pi rho 13 1160 1036 2 (values 25 47 i) (certificatesC11 i) (certificatesD11 i) := by decide +kernel

without_editor_info theorem fixedDirections11 : ∀ i : Fin 63,
    i=30 ∨ (envelopes11 i).directions=0 := by decide +kernel

without_editor_info theorem linear11 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes11 i).directions j)
      (graphStar edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes11 30).directions k)
      (graphStar edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 30)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections11 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross11 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes11 (edges e).src).directions j) ((envelopes11 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections11 (edges e).src with hs | hz
  · rcases fixedDirections11 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value11 : vectorGraph edges (fun i => (envelopes11 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell11 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-25) (hy : (13 : ℤ)^2 ∣ y-47) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 25 47 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes11 constantC constantD certificatesC11 certificatesD11 0
