without_editor_info theorem checks2 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes2 i) pi rho 7 1353 1047 2 (values 34 11 i) (certificatesC2 i) (certificatesD2 i) := by decide +kernel

without_editor_info theorem fixedDirections2 : ∀ i : Fin 63,
    i=7 ∨ (envelopes2 i).directions=0 := by decide +kernel

without_editor_info theorem linear2 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes2 i).directions j)
      (graphStar edges (fun i => (envelopes2 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes2 7).directions k)
      (graphStar edges (fun i => (envelopes2 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections2 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross2 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes2 (edges e).src).directions j) ((envelopes2 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections2 (edges e).src with hs | hz
  · rcases fixedDirections2 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value2 : vectorGraph edges (fun i => (envelopes2 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell2 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-34) (hy : (7 : ℤ)^2 ∣ y-11) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 34 11 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes2 constantC constantD certificatesC2 certificatesD2 0
