without_editor_info theorem checks89 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes89 i) pi rho 7 1353 1047 2 (values 45 19 i) (certificatesC89 i) (certificatesD89 i) := by decide +kernel

without_editor_info theorem fixedDirections89 : ∀ i : Fin 63,
    i=28 ∨ (envelopes89 i).directions=0 := by decide +kernel

without_editor_info theorem linear89 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes89 i).directions j)
      (graphStar edges (fun i => (envelopes89 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes89 28).directions k)
      (graphStar edges (fun i => (envelopes89 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 28)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections89 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross89 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes89 (edges e).src).directions j) ((envelopes89 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections89 (edges e).src with hs | hz
  · rcases fixedDirections89 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value89 : vectorGraph edges (fun i => (envelopes89 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

