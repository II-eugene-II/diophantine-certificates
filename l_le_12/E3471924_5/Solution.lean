without_editor_info theorem checks13 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes13 i) pi rho 19 2819 4039 2 (values 150 347 i) (certificatesC13 i) (certificatesD13 i) := by decide +kernel

without_editor_info theorem fixedDirections13 : ∀ i : Fin 63,
    i=61 ∨ (envelopes13 i).directions=0 := by decide +kernel

without_editor_info theorem linear13 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes13 i).directions j)
      (graphStar edges (fun i => (envelopes13 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes13 61).directions k)
      (graphStar edges (fun i => (envelopes13 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 61)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections13 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross13 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes13 (edges e).src).directions j) ((envelopes13 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections13 (edges e).src with hs | hz
  · rcases fixedDirections13 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value13 : vectorGraph edges (fun i => (envelopes13 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
