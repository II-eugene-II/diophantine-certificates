    tameForm ((envelopes77 (edges e).src).directions j) ((envelopes77 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections77 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value77 : vectorGraph edges (fun i => (envelopes77 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
