without_editor_info theorem checks84 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes84 i) pi rho 13 1160 1036 2 (values 133 110 i) (certificatesC84 i) (certificatesD84 i) := by decide +kernel

without_editor_info theorem fixedDirections84 : ∀ i : Fin 63,
    i=30 ∨ (envelopes84 i).directions=0 := by decide +kernel

without_editor_info theorem linear84 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes84 i).directions j)
      (graphStar edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes84 30).directions k)
      (graphStar edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 30)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections84 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross84 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes84 (edges e).src).directions j) ((envelopes84 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections84 (edges e).src with hs | hz
  · rcases fixedDirections84 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value84 : vectorGraph edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell84 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-133) (hy : (13 : ℤ)^2 ∣ y-110) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 133 110 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes84 constantC constantD certificatesC84 certificatesD84 0
