without_editor_info theorem checks59 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes59 i) pi rho 7 1353 1047 3 (values 151 230 i) (certificatesC59 i) (certificatesD59 i) := by decide +kernel

without_editor_info theorem fixedDirections59 : ∀ i : Fin 63,
    i=61 ∨ (envelopes59 i).directions=0 := by decide +kernel

without_editor_info theorem linear59 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes59 i).directions j)
      (graphStar edges (fun i => (envelopes59 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes59 61).directions k)
      (graphStar edges (fun i => (envelopes59 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 61)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections59 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross59 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes59 (edges e).src).directions j) ((envelopes59 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections59 (edges e).src with hs | hz
  · rcases fixedDirections59 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value59 : vectorGraph edges (fun i => (envelopes59 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell59 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-151) (hy : (7 : ℤ)^3 ∣ y-230) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 151 230 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes59 constantC constantD certificatesC59 certificatesD59 0
