  intro e j k
  have h := h e
  change (envelopes196 (edges e).src).directions = 0 ∨
    (envelopes196 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes196 (edges e).src).directions j) ((envelopes196 (edges e).dst).directions k) = 0) at h
