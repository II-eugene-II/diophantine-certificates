without_editor_info theorem linear161 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes161 i).directions j)
      (graphStar edges (fun i => (envelopes161 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections161 i k]
  simp [tameForm]

