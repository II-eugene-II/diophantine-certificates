without_editor_info theorem zeroDirections1 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes1 i).directions j=0 := by decide +kernel

without_editor_info theorem linear1 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes1 i).directions j)
      (graphStar edges (fun i => (envelopes1 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections1 i k]
  simp [tameForm]

without_editor_info theorem cross1 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes1 (edges e).src).directions j) ((envelopes1 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections1 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value1 : vectorGraph edges (fun i => (envelopes1 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell1 {x y : ℤ} (hf : equation x y = 0)
    (hx : (31 : ℤ)^1 ∣ x-27) (hy : (31 : ℤ)^1 ∣ y-18) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 5 25 27 18 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤1)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤1)).trans root_rho)
    envelopes1 constantC constantD certificatesC1 certificatesD1 0
