without_editor_info theorem checks174 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes174 i) pi rho 7 1353 1047 3 (values 2 16 i) (certificatesC174 i) (certificatesD174 i) := by decide +kernel

without_editor_info theorem fixedDirections174 : ∀ i : Fin 63,
    i=33 ∨ (envelopes174 i).directions=0 := by decide +kernel

without_editor_info theorem linear174 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes174 i).directions j)
      (graphStar edges (fun i => (envelopes174 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes174 33).directions k)
      (graphStar edges (fun i => (envelopes174 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 33)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections174 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross174 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes174 (edges e).src).directions j) ((envelopes174 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections174 (edges e).src with hs | hz
  · rcases fixedDirections174 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value174 : vectorGraph edges (fun i => (envelopes174 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
