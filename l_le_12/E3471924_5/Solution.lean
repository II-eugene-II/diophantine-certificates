  split_cell edges values constants values_congr pi rho away_pi away_rho 19 2819 4039 130 141 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes52 constantC constantD certificatesC52 certificatesD52 0
