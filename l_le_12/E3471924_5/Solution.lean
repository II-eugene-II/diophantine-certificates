without_editor_info theorem checks155 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes155 i) pi rho 7 1353 1047 4 (values 1731 1871 i) (certificatesC155 i) (certificatesD155 i) := by decide +kernel

without_editor_info theorem zeroDirections155 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes155 i).directions j=0 := by decide +kernel

without_editor_info theorem linear155 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes155 i).directions j)
      (graphStar edges (fun i => (envelopes155 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections155 i k]
  simp [tameForm]

without_editor_info theorem cross155 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes155 (edges e).src).directions j) ((envelopes155 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections155 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value155 : vectorGraph edges (fun i => (envelopes155 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell155 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-1731) (hy : (7 : ℤ)^4 ∣ y-1871) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 1731 1871 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes155 constantC constantD certificatesC155 certificatesD155 0
