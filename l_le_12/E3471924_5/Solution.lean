without_editor_info theorem fixedDirections72 : ∀ i : Fin 63,
    i=17 ∨ (envelopes72 i).directions=0 := by decide +kernel

without_editor_info theorem linear72 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes72 i).directions j)
      (graphStar edges (fun i => (envelopes72 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes72 17).directions k)
      (graphStar edges (fun i => (envelopes72 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 17)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections72 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross72 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes72 (edges e).src).directions j) ((envelopes72 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections72 (edges e).src with hs | hz
  · rcases fixedDirections72 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

