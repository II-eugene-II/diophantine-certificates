without_editor_info theorem checks43 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes43 i) pi rho 7 1353 1047 3 (values 263 216 i) (certificatesC43 i) (certificatesD43 i) := by decide +kernel

without_editor_info theorem fixedDirections43 : ∀ i : Fin 63,
    i=5 ∨ (envelopes43 i).directions=0 := by decide +kernel

without_editor_info theorem linear43 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes43 i).directions j)
      (graphStar edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes43 5).directions k)
      (graphStar edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 5)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections43 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross43 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes43 (edges e).src).directions j) ((envelopes43 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections43 (edges e).src with hs | hz
  · rcases fixedDirections43 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value43 : vectorGraph edges (fun i => (envelopes43 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

