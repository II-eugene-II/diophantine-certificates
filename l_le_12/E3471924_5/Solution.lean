    tameForm ((envelopes168 i).directions j)
      (graphStar edges (fun i => (envelopes168 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes168 44).directions k)
      (graphStar edges (fun i => (envelopes168 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 44)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections168 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross168 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes168 (edges e).src).directions j) ((envelopes168 (edges e).dst).directions k) = 0 := by
