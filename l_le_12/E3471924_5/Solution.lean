without_editor_info theorem checks69 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes69 i) pi rho 19 2819 4039 2 (values 219 73 i) (certificatesC69 i) (certificatesD69 i) := by decide +kernel

without_editor_info theorem fixedDirections69 : ∀ i : Fin 63,
    i=50 ∨ (envelopes69 i).directions=0 := by decide +kernel

without_editor_info theorem linear69 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes69 i).directions j)
      (graphStar edges (fun i => (envelopes69 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes69 50).directions k)
      (graphStar edges (fun i => (envelopes69 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 50)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections69 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross69 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes69 (edges e).src).directions j) ((envelopes69 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections69 (edges e).src with hs | hz
  · rcases fixedDirections69 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value69 : vectorGraph edges (fun i => (envelopes69 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
