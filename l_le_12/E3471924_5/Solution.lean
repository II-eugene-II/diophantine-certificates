without_editor_info theorem checks80 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes80 i) pi rho 19 2819 4039 2 (values 10 339 i) (certificatesC80 i) (certificatesD80 i) := by decide +kernel

without_editor_info theorem fixedDirections80 : ∀ i : Fin 63,
    i=7 ∨ (envelopes80 i).directions=0 := by decide +kernel

without_editor_info theorem linear80 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes80 i).directions j)
      (graphStar edges (fun i => (envelopes80 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes80 7).directions k)
      (graphStar edges (fun i => (envelopes80 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections80 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross80 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes80 (edges e).src).directions j) ((envelopes80 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections80 (edges e).src with hs | hz
  · rcases fixedDirections80 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value80 : vectorGraph edges (fun i => (envelopes80 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell80 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-10) (hy : (19 : ℤ)^2 ∣ y-339) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 2819 4039 10 339 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes80 constantC constantD certificatesC80 certificatesD80 0
