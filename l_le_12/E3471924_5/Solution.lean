    (envelopes71 i).directions j=0 := by decide +kernel

without_editor_info theorem linear71 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes71 i).directions j)
      (graphStar edges (fun i => (envelopes71 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections71 i k]
  simp [tameForm]

without_editor_info theorem cross71 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes71 (edges e).src).directions j) ((envelopes71 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections71 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value71 : vectorGraph edges (fun i => (envelopes71 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
