without_editor_info theorem checks109 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes109 i) pi rho 19 2819 4039 2 (values 215 270 i) (certificatesC109 i) (certificatesD109 i) := by decide +kernel

without_editor_info theorem fixedDirections109 : ∀ i : Fin 63,
    i=50 ∨ (envelopes109 i).directions=0 := by decide +kernel

without_editor_info theorem linear109 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes109 i).directions j)
      (graphStar edges (fun i => (envelopes109 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes109 50).directions k)
      (graphStar edges (fun i => (envelopes109 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 50)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections109 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross109 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes109 (edges e).src).directions j) ((envelopes109 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections109 (edges e).src with hs | hz
  · rcases fixedDirections109 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value109 : vectorGraph edges (fun i => (envelopes109 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell109 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-215) (hy : (19 : ℤ)^2 ∣ y-270) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 2819 4039 215 270 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes109 constantC constantD certificatesC109 certificatesD109 0
