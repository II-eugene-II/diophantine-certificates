        · have hz : (16 * x^4 + (-8) * x^3 + 12 * x^2 + 10 * x + 13) = 16 * (((-1) * x + (-1)))^4 + 72 * (((-1) * x + (-1)))^3 + 132 * (((-1) * x + (-1)))^2 + 102 * (((-1) * x + (-1)))^1 + 39 * (((-1) * x + (-1)))^0 := by ring
