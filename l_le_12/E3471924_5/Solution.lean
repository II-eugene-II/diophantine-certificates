    (hx : (31 : ℤ)^1 ∣ x-23) (hy : (31 : ℤ)^1 ∣ y-4) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 5 25 23 4 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤1)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤1)).trans root_rho)
    envelopes8 constantC constantD certificatesC8 certificatesD8 0
