without_editor_info theorem checks104 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes104 i) pi rho 19 2819 4039 2 (values 310 270 i) (certificatesC104 i) (certificatesD104 i) := by decide +kernel

without_editor_info theorem linear104 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes104 i).directions j)
      (graphStar edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes104 i).directions j = 0 ∨
      tameForm ((envelopes104 i).directions j)
        (graphStar edges (fun i => (envelopes104 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross104 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes104 (edges e).src).directions j) ((envelopes104 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes104 e.src).directions = 0 ∨
      (envelopes104 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes104 e.src).directions j) ((envelopes104 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes104 (edges e).src).directions = 0 ∨
    (envelopes104 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes104 (edges e).src).directions j) ((envelopes104 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

