without_editor_info theorem checks60 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes60 i) pi rho 13 1160 1036 2 (values 108 6 i) (certificatesC60 i) (certificatesD60 i) := by decide +kernel

without_editor_info theorem fixedDirections60 : ∀ i : Fin 63,
    i=5 ∨ (envelopes60 i).directions=0 := by decide +kernel

without_editor_info theorem linear60 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes60 i).directions j)
      (graphStar edges (fun i => (envelopes60 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes60 5).directions k)
      (graphStar edges (fun i => (envelopes60 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 5)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections60 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross60 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes60 (edges e).src).directions j) ((envelopes60 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections60 (edges e).src with hs | hz
  · rcases fixedDirections60 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value60 : vectorGraph edges (fun i => (envelopes60 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell60 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-108) (hy : (13 : ℤ)^2 ∣ y-6) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 108 6 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes60 constantC constantD certificatesC60 certificatesD60 0
