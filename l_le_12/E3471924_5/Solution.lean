without_editor_info theorem checks115 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes115 i) pi rho 13 1160 1036 2 (values 54 44 i) (certificatesC115 i) (certificatesD115 i) := by decide +kernel

without_editor_info theorem fixedDirections115 : ∀ i : Fin 63,
    i=62 ∨ (envelopes115 i).directions=0 := by decide +kernel

without_editor_info theorem linear115 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes115 i).directions j)
      (graphStar edges (fun i => (envelopes115 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes115 62).directions k)
      (graphStar edges (fun i => (envelopes115 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 62)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections115 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross115 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes115 (edges e).src).directions j) ((envelopes115 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections115 (edges e).src with hs | hz
  · rcases fixedDirections115 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value115 : vectorGraph edges (fun i => (envelopes115 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
