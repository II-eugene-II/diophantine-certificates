without_editor_info theorem checks25 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes25 i) pi rho 31 5 25 1 (values 5 13 i) (certificatesC25 i) (certificatesD25 i) := by decide +kernel

without_editor_info theorem linear25 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes25 i).directions j)
      (graphStar edges (fun i => (envelopes25 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes25 i).directions j = 0 ∨
      tameForm ((envelopes25 i).directions j)
        (graphStar edges (fun i => (envelopes25 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross25 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes25 (edges e).src).directions j) ((envelopes25 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes25 e.src).directions = 0 ∨
      (envelopes25 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes25 e.src).directions j) ((envelopes25 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes25 (edges e).src).directions = 0 ∨
    (envelopes25 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes25 (edges e).src).directions j) ((envelopes25 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value25 : vectorGraph edges (fun i => (envelopes25 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell25 {x y : ℤ} (hf : equation x y = 0)
    (hx : (31 : ℤ)^1 ∣ x-5) (hy : (31 : ℤ)^1 ∣ y-13) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 5 25 5 13 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤1)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤1)).trans root_rho)
    envelopes25 constantC constantD certificatesC25 certificatesD25 0
