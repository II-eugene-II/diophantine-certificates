without_editor_info theorem checks154 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes154 i) pi rho 19 2819 4039 3 (values 3158 2866 i) (certificatesC154 i) (certificatesD154 i) := by decide +kernel

without_editor_info theorem fixedDirections154 : ∀ i : Fin 63,
    i=2 ∨ (envelopes154 i).directions=0 := by decide +kernel

without_editor_info theorem linear154 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes154 i).directions j)
      (graphStar edges (fun i => (envelopes154 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes154 2).directions k)
      (graphStar edges (fun i => (envelopes154 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 2)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections154 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross154 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes154 (edges e).src).directions j) ((envelopes154 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections154 (edges e).src with hs | hz
  · rcases fixedDirections154 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value154 : vectorGraph edges (fun i => (envelopes154 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
