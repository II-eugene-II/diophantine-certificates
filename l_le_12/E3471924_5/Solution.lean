    i=22 ∨ (envelopes132 i).directions=0 := by decide +kernel

without_editor_info theorem linear132 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes132 i).directions j)
      (graphStar edges (fun i => (envelopes132 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes132 22).directions k)
      (graphStar edges (fun i => (envelopes132 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 22)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections132 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross132 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes132 (edges e).src).directions j) ((envelopes132 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections132 (edges e).src with hs | hz
  · rcases fixedDirections132 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

