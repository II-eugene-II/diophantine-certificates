  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 305 42 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes81 constantC constantD certificatesC81 certificatesD81 0
