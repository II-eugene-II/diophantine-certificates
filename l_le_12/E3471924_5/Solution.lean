    tameForm ((envelopes160 (edges e).src).directions j) ((envelopes160 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections160 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value160 : vectorGraph edges (fun i => (envelopes160 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
