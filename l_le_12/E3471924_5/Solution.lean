without_editor_info theorem zeroDirections74 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes74 i).directions j=0 := by decide +kernel

without_editor_info theorem linear74 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes74 i).directions j)
      (graphStar edges (fun i => (envelopes74 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections74 i k]
  simp [tameForm]

without_editor_info theorem cross74 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes74 (edges e).src).directions j) ((envelopes74 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections74 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value74 : vectorGraph edges (fun i => (envelopes74 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

