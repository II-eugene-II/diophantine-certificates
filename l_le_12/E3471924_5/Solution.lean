without_editor_info theorem checks58 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes58 i) pi rho 7 1353 1047 3 (values 200 181 i) (certificatesC58 i) (certificatesD58 i) := by decide +kernel

without_editor_info theorem fixedDirections58 : ∀ i : Fin 63,
    i=30 ∨ (envelopes58 i).directions=0 := by decide +kernel

without_editor_info theorem linear58 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes58 i).directions j)
      (graphStar edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes58 30).directions k)
      (graphStar edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 30)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections58 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross58 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes58 (edges e).src).directions j) ((envelopes58 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections58 (edges e).src with hs | hz
  · rcases fixedDirections58 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value58 : vectorGraph edges (fun i => (envelopes58 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell58 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-200) (hy : (7 : ℤ)^3 ∣ y-181) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 200 181 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes58 constantC constantD certificatesC58 certificatesD58 0
