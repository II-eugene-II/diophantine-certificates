without_editor_info theorem checks125 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes125 i) pi rho 19 2819 4039 2 (values 271 281 i) (certificatesC125 i) (certificatesD125 i) := by decide +kernel

without_editor_info theorem fixedDirections125 : ∀ i : Fin 63,
    i=6 ∨ (envelopes125 i).directions=0 := by decide +kernel

without_editor_info theorem linear125 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes125 i).directions j)
      (graphStar edges (fun i => (envelopes125 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes125 6).directions k)
      (graphStar edges (fun i => (envelopes125 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 6)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections125 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross125 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes125 (edges e).src).directions j) ((envelopes125 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections125 (edges e).src with hs | hz
  · rcases fixedDirections125 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value125 : vectorGraph edges (fun i => (envelopes125 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell125 {x y : ℤ} (hf : equation x y = 0)
    (hx : (19 : ℤ)^2 ∣ x-271) (hy : (19 : ℤ)^2 ∣ y-281) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 2819 4039 271 281 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes125 constantC constantD certificatesC125 certificatesD125 0
