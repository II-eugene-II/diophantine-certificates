without_editor_info theorem checks3 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes3 i) pi rho 31 5 25 1 (values 26 6 i) (certificatesC3 i) (certificatesD3 i) := by decide +kernel

without_editor_info theorem linear3 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes3 i).directions j)
      (graphStar edges (fun i => (envelopes3 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes3 i).directions j = 0 ∨
      tameForm ((envelopes3 i).directions j)
        (graphStar edges (fun i => (envelopes3 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross3 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes3 (edges e).src).directions j) ((envelopes3 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes3 e.src).directions = 0 ∨
      (envelopes3 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes3 e.src).directions j) ((envelopes3 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes3 (edges e).src).directions = 0 ∨
    (envelopes3 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes3 (edges e).src).directions j) ((envelopes3 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value3 : vectorGraph edges (fun i => (envelopes3 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell3 {x y : ℤ} (hf : equation x y = 0)
    (hx : (31 : ℤ)^1 ∣ x-26) (hy : (31 : ℤ)^1 ∣ y-6) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 5 25 26 6 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤1)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤1)).trans root_rho)
    envelopes3 constantC constantD certificatesC3 certificatesD3 0
