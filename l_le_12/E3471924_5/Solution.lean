without_editor_info theorem checks138 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes138 i) pi rho 13 1160 1036 2 (values 79 56 i) (certificatesC138 i) (certificatesD138 i) := by decide +kernel

without_editor_info theorem fixedDirections138 : ∀ i : Fin 63,
    i=30 ∨ (envelopes138 i).directions=0 := by decide +kernel

without_editor_info theorem linear138 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes138 i).directions j)
      (graphStar edges (fun i => (envelopes138 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes138 30).directions k)
      (graphStar edges (fun i => (envelopes138 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 30)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections138 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross138 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes138 (edges e).src).directions j) ((envelopes138 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections138 (edges e).src with hs | hz
  · rcases fixedDirections138 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value138 : vectorGraph edges (fun i => (envelopes138 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
