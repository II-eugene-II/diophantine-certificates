    tameForm ((envelopes148 (edges e).src).directions j) ((envelopes148 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections148 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value148 : vectorGraph edges (fun i => (envelopes148 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
