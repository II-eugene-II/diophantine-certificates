without_editor_info theorem linear114 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes114 i).directions j)
      (graphStar edges (fun i => (envelopes114 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes114 i).directions j = 0 ∨
      tameForm ((envelopes114 i).directions j)
        (graphStar edges (fun i => (envelopes114 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross114 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes114 (edges e).src).directions j) ((envelopes114 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes114 e.src).directions = 0 ∨
      (envelopes114 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes114 e.src).directions j) ((envelopes114 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes114 (edges e).src).directions = 0 ∨
    (envelopes114 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes114 (edges e).src).directions j) ((envelopes114 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

