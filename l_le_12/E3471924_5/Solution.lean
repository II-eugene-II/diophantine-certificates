without_editor_info theorem checks135 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes135 i) pi rho 13 1160 1036 2 (values 118 160 i) (certificatesC135 i) (certificatesD135 i) := by decide +kernel

without_editor_info theorem fixedDirections135 : ∀ i : Fin 63,
    i=25 ∨ (envelopes135 i).directions=0 := by decide +kernel

without_editor_info theorem linear135 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes135 i).directions j)
      (graphStar edges (fun i => (envelopes135 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes135 25).directions k)
      (graphStar edges (fun i => (envelopes135 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 25)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections135 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross135 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes135 (edges e).src).directions j) ((envelopes135 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections135 (edges e).src with hs | hz
  · rcases fixedDirections135 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value135 : vectorGraph edges (fun i => (envelopes135 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell135 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-118) (hy : (13 : ℤ)^2 ∣ y-160) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 118 160 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes135 constantC constantD certificatesC135 certificatesD135 0
