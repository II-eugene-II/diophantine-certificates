without_editor_info theorem checks67 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes67 i) pi rho 13 1160 1036 3 (values 1889 500 i) (certificatesC67 i) (certificatesD67 i) := by decide +kernel

without_editor_info theorem zeroDirections67 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes67 i).directions j=0 := by decide +kernel

without_editor_info theorem linear67 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes67 i).directions j)
      (graphStar edges (fun i => (envelopes67 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections67 i k]
  simp [tameForm]

without_editor_info theorem cross67 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes67 (edges e).src).directions j) ((envelopes67 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections67 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value67 : vectorGraph edges (fun i => (envelopes67 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell67 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-1889) (hy : (13 : ℤ)^3 ∣ y-500) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 1889 500 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes67 constantC constantD certificatesC67 certificatesD67 0
