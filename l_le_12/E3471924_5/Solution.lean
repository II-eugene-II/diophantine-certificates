    (hx : (13 : ℤ)^1 ∣ x-4) (hy : (13 : ℤ)^1 ∣ y-10) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
