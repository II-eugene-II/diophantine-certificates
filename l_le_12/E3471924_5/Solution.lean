without_editor_info theorem checks10 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes10 i) pi rho 13 1160 1036 2 (values 38 151 i) (certificatesC10 i) (certificatesD10 i) := by decide +kernel

without_editor_info theorem fixedDirections10 : ∀ i : Fin 63,
    i=9 ∨ (envelopes10 i).directions=0 := by decide +kernel

without_editor_info theorem linear10 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes10 i).directions j)
      (graphStar edges (fun i => (envelopes10 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes10 9).directions k)
      (graphStar edges (fun i => (envelopes10 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 9)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections10 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross10 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes10 (edges e).src).directions j) ((envelopes10 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections10 (edges e).src with hs | hz
  · rcases fixedDirections10 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value10 : vectorGraph edges (fun i => (envelopes10 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell10 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^2 ∣ x-38) (hy : (13 : ℤ)^2 ∣ y-151) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 38 151 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes10 constantC constantD certificatesC10 certificatesD10 0
