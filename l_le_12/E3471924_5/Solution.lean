    (hx : (19 : ℤ)^2 ∣ x-302) (hy : (19 : ℤ)^2 ∣ y-252) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
