without_editor_info theorem zeroDirections150 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes150 i).directions j=0 := by decide +kernel

without_editor_info theorem linear150 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes150 i).directions j)
      (graphStar edges (fun i => (envelopes150 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections150 i k]
  simp [tameForm]

without_editor_info theorem cross150 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes150 (edges e).src).directions j) ((envelopes150 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections150 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value150 : vectorGraph edges (fun i => (envelopes150 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

