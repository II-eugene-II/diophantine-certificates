without_editor_info theorem checks6 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes6 i) pi rho 7 1353 1047 2 (values 6 11 i) (certificatesC6 i) (certificatesD6 i) := by decide +kernel

without_editor_info theorem fixedDirections6 : ∀ i : Fin 63,
    i=25 ∨ (envelopes6 i).directions=0 := by decide +kernel

without_editor_info theorem linear6 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes6 i).directions j)
      (graphStar edges (fun i => (envelopes6 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes6 25).directions k)
      (graphStar edges (fun i => (envelopes6 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 25)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections6 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross6 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes6 (edges e).src).directions j) ((envelopes6 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections6 (edges e).src with hs | hz
  · rcases fixedDirections6 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value6 : vectorGraph edges (fun i => (envelopes6 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

