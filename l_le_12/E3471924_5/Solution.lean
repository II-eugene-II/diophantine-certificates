without_editor_info theorem checks30 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes30 i) pi rho 13 1160 1036 2 (values 126 47 i) (certificatesC30 i) (certificatesD30 i) := by decide +kernel

without_editor_info theorem fixedDirections30 : ∀ i : Fin 63,
    i=45 ∨ (envelopes30 i).directions=0 := by decide +kernel

without_editor_info theorem linear30 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes30 i).directions j)
      (graphStar edges (fun i => (envelopes30 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes30 45).directions k)
      (graphStar edges (fun i => (envelopes30 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 45)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections30 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross30 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes30 (edges e).src).directions j) ((envelopes30 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections30 (edges e).src with hs | hz
  · rcases fixedDirections30 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value30 : vectorGraph edges (fun i => (envelopes30 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

