without_editor_info theorem checks180 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes180 i) pi rho 19 2819 4039 2 (values 287 238 i) (certificatesC180 i) (certificatesD180 i) := by decide +kernel

without_editor_info theorem fixedDirections180 : ∀ i : Fin 63,
    i=1 ∨ (envelopes180 i).directions=0 := by decide +kernel

without_editor_info theorem linear180 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes180 i).directions j)
      (graphStar edges (fun i => (envelopes180 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes180 1).directions k)
      (graphStar edges (fun i => (envelopes180 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 1)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections180 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross180 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes180 (edges e).src).directions j) ((envelopes180 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections180 (edges e).src with hs | hz
  · rcases fixedDirections180 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value180 : vectorGraph edges (fun i => (envelopes180 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

