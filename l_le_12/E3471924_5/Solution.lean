without_editor_info theorem checks105 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes105 i) pi rho 7 1353 1047 4 (values 17 362 i) (certificatesC105 i) (certificatesD105 i) := by decide +kernel

without_editor_info theorem linear105 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes105 i).directions j)
      (graphStar edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes105 i).directions j = 0 ∨
      tameForm ((envelopes105 i).directions j)
        (graphStar edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross105 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes105 (edges e).src).directions j) ((envelopes105 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes105 e.src).directions = 0 ∨
      (envelopes105 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes105 e.src).directions j) ((envelopes105 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes105 (edges e).src).directions = 0 ∨
    (envelopes105 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes105 (edges e).src).directions j) ((envelopes105 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value105 : vectorGraph edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell105 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^4 ∣ x-17) (hy : (7 : ℤ)^4 ∣ y-362) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 17 362 4
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 4≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 4≤4)).trans root_rho)
    envelopes105 constantC constantD certificatesC105 certificatesD105 0
