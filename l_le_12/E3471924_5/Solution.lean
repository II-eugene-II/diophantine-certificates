without_editor_info theorem zeroDirections141 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes141 i).directions j=0 := by decide +kernel

without_editor_info theorem linear141 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes141 i).directions j)
      (graphStar edges (fun i => (envelopes141 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections141 i k]
  simp [tameForm]

without_editor_info theorem cross141 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes141 (edges e).src).directions j) ((envelopes141 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections141 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value141 : vectorGraph edges (fun i => (envelopes141 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
