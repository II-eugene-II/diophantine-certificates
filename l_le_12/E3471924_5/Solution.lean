without_editor_info theorem checks131 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes131 i) pi rho 13 1160 1036 3 (values 2 1565 i) (certificatesC131 i) (certificatesD131 i) := by decide +kernel

without_editor_info theorem fixedDirections131 : ∀ i : Fin 63,
    i=33 ∨ (envelopes131 i).directions=0 := by decide +kernel

without_editor_info theorem linear131 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes131 i).directions j)
      (graphStar edges (fun i => (envelopes131 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes131 33).directions k)
      (graphStar edges (fun i => (envelopes131 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 33)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections131 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross131 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes131 (edges e).src).directions j) ((envelopes131 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections131 (edges e).src with hs | hz
  · rcases fixedDirections131 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value131 : vectorGraph edges (fun i => (envelopes131 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell131 {x y : ℤ} (hf : equation x y = 0)
    (hx : (13 : ℤ)^3 ∣ x-2) (hy : (13 : ℤ)^3 ∣ y-1565) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 13 1160 1036 2 1565 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤3)).trans root_rho)
    envelopes131 constantC constantD certificatesC131 certificatesD131 0
