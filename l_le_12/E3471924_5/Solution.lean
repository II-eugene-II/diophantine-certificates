without_editor_info theorem checks131 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes131 i) pi rho 19 2819 4039 2 (values 157 205 i) (certificatesC131 i) (certificatesD131 i) := by decide +kernel

without_editor_info theorem fixedDirections131 : ∀ i : Fin 63,
    i=18 ∨ (envelopes131 i).directions=0 := by decide +kernel

without_editor_info theorem linear131 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes131 i).directions j)
      (graphStar edges (fun i => (envelopes131 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes131 18).directions k)
      (graphStar edges (fun i => (envelopes131 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 18)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections131 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross131 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes131 (edges e).src).directions j) ((envelopes131 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections131 (edges e).src with hs | hz
  · rcases fixedDirections131 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value131 : vectorGraph edges (fun i => (envelopes131 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
