without_editor_info theorem checks81 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes81 i) pi rho 7 1353 1047 3 (values 305 42 i) (certificatesC81 i) (certificatesD81 i) := by decide +kernel

without_editor_info theorem fixedDirections81 : ∀ i : Fin 63,
    i=51 ∨ (envelopes81 i).directions=0 := by decide +kernel

without_editor_info theorem linear81 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes81 i).directions j)
      (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes81 51).directions k)
      (graphStar edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 51)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections81 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross81 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes81 (edges e).src).directions j) ((envelopes81 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections81 (edges e).src with hs | hz
  · rcases fixedDirections81 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value81 : vectorGraph edges (fun i => (envelopes81 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
