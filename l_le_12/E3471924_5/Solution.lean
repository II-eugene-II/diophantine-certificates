without_editor_info theorem checks105 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes105 i) pi rho 13 1160 1036 3 (values 652 1565 i) (certificatesC105 i) (certificatesD105 i) := by decide +kernel

without_editor_info theorem fixedDirections105 : ∀ i : Fin 63,
    i=52 ∨ (envelopes105 i).directions=0 := by decide +kernel

without_editor_info theorem linear105 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes105 i).directions j)
      (graphStar edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes105 52).directions k)
      (graphStar edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 52)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections105 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross105 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes105 (edges e).src).directions j) ((envelopes105 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections105 (edges e).src with hs | hz
  · rcases fixedDirections105 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value105 : vectorGraph edges (fun i => (envelopes105 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

