without_editor_info theorem checks61 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes61 i) pi rho 19 2819 4039 1 (values 11 4 i) (certificatesC61 i) (certificatesD61 i) := by decide +kernel

without_editor_info theorem linear61 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes61 i).directions j)
      (graphStar edges (fun i => (envelopes61 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes61 i).directions j = 0 ∨
      tameForm ((envelopes61 i).directions j)
        (graphStar edges (fun i => (envelopes61 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross61 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes61 (edges e).src).directions j) ((envelopes61 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes61 e.src).directions = 0 ∨
      (envelopes61 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes61 e.src).directions j) ((envelopes61 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes61 (edges e).src).directions = 0 ∨
    (envelopes61 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes61 (edges e).src).directions j) ((envelopes61 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

