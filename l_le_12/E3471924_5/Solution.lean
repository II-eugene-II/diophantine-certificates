    tameForm ((envelopes6 i).directions j)
      (graphStar edges (fun i => (envelopes6 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections6 i k]
  simp [tameForm]

