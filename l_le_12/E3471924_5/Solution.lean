    i=43 ∨ (envelopes86 i).directions=0 := by decide +kernel

without_editor_info theorem linear86 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes86 i).directions j)
      (graphStar edges (fun i => (envelopes86 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes86 43).directions k)
      (graphStar edges (fun i => (envelopes86 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 43)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections86 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross86 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes86 (edges e).src).directions j) ((envelopes86 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections86 (edges e).src with hs | hz
  · rcases fixedDirections86 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

