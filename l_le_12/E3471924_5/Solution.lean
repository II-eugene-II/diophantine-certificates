without_editor_info theorem checks5 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes5 i) pi rho 31 5 25 1 (values 24 8 i) (certificatesC5 i) (certificatesD5 i) := by decide +kernel

without_editor_info theorem linear5 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes5 i).directions j)
      (graphStar edges (fun i => (envelopes5 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ i : Fin 63, ∀ j : Fin 4, (envelopes5 i).directions j = 0 ∨
      tameForm ((envelopes5 i).directions j)
        (graphStar edges (fun i => (envelopes5 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i j
  rcases h i j with hz | hz
  · simp [hz, tameForm]
  · exact hz

without_editor_info theorem cross5 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes5 (edges e).src).directions j) ((envelopes5 (edges e).dst).directions k) = 0 := by
  have h := listEdges_all (m := 293) edgeList (by decide)
    (fun e => (envelopes5 e.src).directions = 0 ∨
      (envelopes5 e.dst).directions = 0 ∨
      (∀ j k : Fin 4, tameForm ((envelopes5 e.src).directions j) ((envelopes5 e.dst).directions k) = 0))
    (by decide +kernel)
  intro e j k
  have h := h e
  change (envelopes5 (edges e).src).directions = 0 ∨
    (envelopes5 (edges e).dst).directions = 0 ∨
    (∀ j k : Fin 4, tameForm ((envelopes5 (edges e).src).directions j) ((envelopes5 (edges e).dst).directions k) = 0) at h
  rcases h with hz | hz | hz
  · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]
  · exact hz j k

without_editor_info theorem value5 : vectorGraph edges (fun i => (envelopes5 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell5 {x y : ℤ} (hf : equation x y = 0)
    (hx : (31 : ℤ)^1 ∣ x-24) (hy : (31 : ℤ)^1 ∣ y-8) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 5 25 24 8 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤1)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤1)).trans root_rho)
    envelopes5 constantC constantD certificatesC5 certificatesD5 0
