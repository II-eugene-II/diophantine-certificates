without_editor_info theorem checks16 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes16 i) pi rho 31 5 25 1 (values 12 23 i) (certificatesC16 i) (certificatesD16 i) := by decide +kernel

without_editor_info theorem fixedDirections16 : ∀ i : Fin 63,
    i=7 ∨ (envelopes16 i).directions=0 := by decide +kernel

without_editor_info theorem linear16 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes16 i).directions j)
      (graphStar edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes16 7).directions k)
      (graphStar edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 7)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections16 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross16 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes16 (edges e).src).directions j) ((envelopes16 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections16 (edges e).src with hs | hz
  · rcases fixedDirections16 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value16 : vectorGraph edges (fun i => (envelopes16 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell16 {x y : ℤ} (hf : equation x y = 0)
    (hx : (31 : ℤ)^1 ∣ x-12) (hy : (31 : ℤ)^1 ∣ y-23) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 31 5 25 12 23 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤1)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤1)).trans root_rho)
    envelopes16 constantC constantD certificatesC16 certificatesD16 0
