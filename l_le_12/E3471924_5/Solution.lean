    tameForm ((envelopes70 i).directions j)
      (graphStar edges (fun i => (envelopes70 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections70 i k]
  simp [tameForm]

without_editor_info theorem cross70 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes70 (edges e).src).directions j) ((envelopes70 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections70 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value70 : vectorGraph edges (fun i => (envelopes70 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
