    (envelopes112 i).directions j=0 := by decide +kernel

without_editor_info theorem linear112 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes112 i).directions j)
      (graphStar edges (fun i => (envelopes112 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections112 i k]
  simp [tameForm]

