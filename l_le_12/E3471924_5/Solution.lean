without_editor_info theorem checks152 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes152 i) pi rho 13 1160 1036 3 (values 209 1642 i) (certificatesC152 i) (certificatesD152 i) := by decide +kernel

without_editor_info theorem fixedDirections152 : ∀ i : Fin 63,
    i=6 ∨ (envelopes152 i).directions=0 := by decide +kernel

without_editor_info theorem linear152 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes152 i).directions j)
      (graphStar edges (fun i => (envelopes152 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes152 6).directions k)
      (graphStar edges (fun i => (envelopes152 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 6)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections152 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross152 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes152 (edges e).src).directions j) ((envelopes152 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections152 (edges e).src with hs | hz
  · rcases fixedDirections152 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value152 : vectorGraph edges (fun i => (envelopes152 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
