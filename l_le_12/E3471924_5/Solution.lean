    (hx : (19 : ℤ)^1 ∣ x-17) (hy : (19 : ℤ)^1 ∣ y-12) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 19 2819 4039 17 12 1
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 1≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 1≤3)).trans root_rho)
    envelopes1 constantC constantD certificatesC1 certificatesD1 0
