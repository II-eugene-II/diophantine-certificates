without_editor_info theorem checks136 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes136 i) pi rho 19 2819 4039 2 (values 62 262 i) (certificatesC136 i) (certificatesD136 i) := by decide +kernel

without_editor_info theorem fixedDirections136 : ∀ i : Fin 63,
    i=1 ∨ (envelopes136 i).directions=0 := by decide +kernel

without_editor_info theorem linear136 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes136 i).directions j)
      (graphStar edges (fun i => (envelopes136 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes136 1).directions k)
      (graphStar edges (fun i => (envelopes136 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 1)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections136 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross136 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes136 (edges e).src).directions j) ((envelopes136 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections136 (edges e).src with hs | hz
  · rcases fixedDirections136 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value136 : vectorGraph edges (fun i => (envelopes136 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
