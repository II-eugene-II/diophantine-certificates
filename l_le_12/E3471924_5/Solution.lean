without_editor_info theorem zeroDirections120 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes120 i).directions j=0 := by decide +kernel

without_editor_info theorem linear120 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes120 i).directions j)
      (graphStar edges (fun i => (envelopes120 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections120 i k]
  simp [tameForm]

without_editor_info theorem cross120 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes120 (edges e).src).directions j) ((envelopes120 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections120 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value120 : vectorGraph edges (fun i => (envelopes120 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
