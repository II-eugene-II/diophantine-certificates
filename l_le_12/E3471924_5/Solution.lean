  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 2 16 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes174 constantC constantD certificatesC174 certificatesD174 0
    constants_c constants_d (fun i => jointEnvelopeFastCheck_sound _ _ _ _ _ _ _ _ _ _ (checks174 i))
    linear174 cross174 value174 hx hy

