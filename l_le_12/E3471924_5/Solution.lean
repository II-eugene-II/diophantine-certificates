without_editor_info theorem checks84 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes84 i) pi rho 7 1353 1047 3 (values 158 91 i) (certificatesC84 i) (certificatesD84 i) := by decide +kernel

without_editor_info theorem fixedDirections84 : ∀ i : Fin 63,
    i=31 ∨ (envelopes84 i).directions=0 := by decide +kernel

without_editor_info theorem linear84 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes84 i).directions j)
      (graphStar edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes84 31).directions k)
      (graphStar edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 31)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections84 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross84 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes84 (edges e).src).directions j) ((envelopes84 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections84 (edges e).src with hs | hz
  · rcases fixedDirections84 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value84 : vectorGraph edges (fun i => (envelopes84 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

