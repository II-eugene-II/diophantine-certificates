  split_cell edges values constants values_congr pi rho away_pi away_rho 19 2819 4039 157 205 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤3)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤3)).trans root_rho)
    envelopes131 constantC constantD certificatesC131 certificatesD131 0
