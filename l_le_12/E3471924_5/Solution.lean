    i=3 ∨ (envelopes191 i).directions=0 := by decide +kernel

without_editor_info theorem linear191 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes191 i).directions j)
      (graphStar edges (fun i => (envelopes191 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes191 3).directions k)
      (graphStar edges (fun i => (envelopes191 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 3)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections191 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross191 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes191 (edges e).src).directions j) ((envelopes191 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections191 (edges e).src with hs | hz
  · rcases fixedDirections191 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

