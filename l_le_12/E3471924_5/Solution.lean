without_editor_info theorem checks108 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes108 i) pi rho 13 1160 1036 3 (values 145 1565 i) (certificatesC108 i) (certificatesD108 i) := by decide +kernel

without_editor_info theorem zeroDirections108 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes108 i).directions j=0 := by decide +kernel

without_editor_info theorem linear108 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes108 i).directions j)
      (graphStar edges (fun i => (envelopes108 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections108 i k]
  simp [tameForm]

without_editor_info theorem cross108 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes108 (edges e).src).directions j) ((envelopes108 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections108 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value108 : vectorGraph edges (fun i => (envelopes108 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
