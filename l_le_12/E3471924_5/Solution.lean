    i=28 ∨ (envelopes106 i).directions=0 := by decide +kernel

without_editor_info theorem linear106 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes106 i).directions j)
      (graphStar edges (fun i => (envelopes106 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes106 28).directions k)
      (graphStar edges (fun i => (envelopes106 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 28)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections106 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross106 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes106 (edges e).src).directions j) ((envelopes106 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections106 (edges e).src with hs | hz
  · rcases fixedDirections106 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

