without_editor_info theorem checks129 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes129 i) pi rho 7 1353 1047 4 (values 947 205 i) (certificatesC129 i) (certificatesD129 i) := by decide +kernel

without_editor_info theorem fixedDirections129 : ∀ i : Fin 63,
    i=23 ∨ (envelopes129 i).directions=0 := by decide +kernel

without_editor_info theorem linear129 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes129 i).directions j)
      (graphStar edges (fun i => (envelopes129 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes129 23).directions k)
      (graphStar edges (fun i => (envelopes129 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 23)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections129 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross129 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes129 (edges e).src).directions j) ((envelopes129 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections129 (edges e).src with hs | hz
  · rcases fixedDirections129 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value129 : vectorGraph edges (fun i => (envelopes129 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
