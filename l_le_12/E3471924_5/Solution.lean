without_editor_info theorem checks54 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes54 i) pi rho 7 1353 1047 3 (values 60 27 i) (certificatesC54 i) (certificatesD54 i) := by decide +kernel

without_editor_info theorem fixedDirections54 : ∀ i : Fin 63,
    i=1 ∨ (envelopes54 i).directions=0 := by decide +kernel

without_editor_info theorem linear54 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes54 i).directions j)
      (graphStar edges (fun i => (envelopes54 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes54 1).directions k)
      (graphStar edges (fun i => (envelopes54 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 1)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections54 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross54 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes54 (edges e).src).directions j) ((envelopes54 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections54 (edges e).src with hs | hz
  · rcases fixedDirections54 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value54 : vectorGraph edges (fun i => (envelopes54 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell54 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^3 ∣ x-60) (hy : (7 : ℤ)^3 ∣ y-27) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 60 27 3
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 3≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 3≤4)).trans root_rho)
    envelopes54 constantC constantD certificatesC54 certificatesD54 0
