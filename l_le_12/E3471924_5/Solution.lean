without_editor_info theorem linear37 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes37 i).directions j)
      (graphStar edges (fun i => (envelopes37 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections37 i k]
  simp [tameForm]

