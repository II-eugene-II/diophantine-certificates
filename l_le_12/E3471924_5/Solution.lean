          rw [hz]; positivity
      by_cases hx : 2 ≤ x
      · have harg : 0 ≤ (1 * x + (-2)) := by omega
        constructor
        · have hz : (16 * x^4 + (-8) * x^3 + 12 * x^2 + 10 * x + 13) = 16 * ((1 * x + (-2)))^4 + 120 * ((1 * x + (-2)))^3 + 348 * ((1 * x + (-2)))^2 + 474 * ((1 * x + (-2)))^1 + 273 * ((1 * x + (-2)))^0 := by ring
          rw [hz]; positivity
        · have hz : (48 * x^2 + (-48) * x + (-52)) = 48 * ((1 * x + (-2)))^2 + 144 * ((1 * x + (-2)))^1 + 44 * ((1 * x + (-2)))^0 := by ring
          rw [hz]; positivity
      interval_cases x
      · have hc : ∀ z : ZMod 3, eval F (0) z ≠ 0 := by decide
        have hfz : eval F ((0 : ℤ) : ZMod 3) (y : ZMod 3) = 0 := by
          rw [← cast_eval,hf,Int.cast_zero]
        exact (hc _ (by simpa using hfz)).elim
      · have hc : ∀ z : ZMod 2, eval F (1) z ≠ 0 := by decide
        have hfz : eval F ((1 : ℤ) : ZMod 2) (y : ZMod 2) = 0 := by
