without_editor_info theorem zeroDirections143 : ∀ i : Fin 63, ∀ j : Fin 4,
    (envelopes143 i).directions j=0 := by decide +kernel

without_editor_info theorem linear143 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes143 i).directions j)
      (graphStar edges (fun i => (envelopes143 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  intro i k
  rw [zeroDirections143 i k]
  simp [tameForm]

without_editor_info theorem cross143 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes143 (edges e).src).directions j) ((envelopes143 (edges e).dst).directions k) = 0 := by
  intro e i k
  rw [zeroDirections143 ((edges e).src) i]
  simp [tameForm]

without_editor_info theorem value143 : vectorGraph edges (fun i => (envelopes143 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

