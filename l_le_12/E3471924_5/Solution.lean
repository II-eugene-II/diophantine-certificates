without_editor_info theorem checks1 : ∀ i : Fin 63, jointEnvelopeFastCheck (envelopes1 i) pi rho 7 1353 1047 2 (values 41 11 i) (certificatesC1 i) (certificatesD1 i) := by decide +kernel

without_editor_info theorem fixedDirections1 : ∀ i : Fin 63,
    i=40 ∨ (envelopes1 i).directions=0 := by decide +kernel

without_editor_info theorem linear1 : ∀ i : Fin 63, ∀ j : Fin 4,
    tameForm ((envelopes1 i).directions j)
      (graphStar edges (fun i => (envelopes1 i).base) (fun i => jointCertificate (constantC i) (constantD i)) i) = 0 := by
  have h : ∀ k : Fin 4, tameForm ((envelopes1 40).directions k)
      (graphStar edges (fun i => (envelopes1 i).base) (fun i => jointCertificate (constantC i) (constantD i)) 40)=0 := by
    simp only [graphStar_neighbors edges neighbors adjacency_checked]
    decide +kernel
  intro i k
  rcases fixedDirections1 i with rfl | hz
  · exact h k
  · rw [hz]; simp [tameForm]

without_editor_info theorem cross1 : ∀ e : Fin 293, ∀ j k : Fin 4,
    tameForm ((envelopes1 (edges e).src).directions j) ((envelopes1 (edges e).dst).directions k) = 0 := by
  intro e i k
  rcases fixedDirections1 (edges e).src with hs | hz
  · rcases fixedDirections1 (edges e).dst with ht | hz
    · exact False.elim (noLoops e (hs.trans ht.symm))
    · rw [hz]; simp [tameForm]
  · rw [hz]; simp [tameForm]

without_editor_info theorem value1 : vectorGraph edges (fun i => (envelopes1 i).base) (fun i => jointCertificate (constantC i) (constantD i)) tameBilinear = 0 := by
  simp only [edges, vectorGraph_listEdges]
  decide +kernel

without_editor_info theorem cell1 {x y : ℤ} (hf : equation x y = 0)
    (hx : (7 : ℤ)^2 ∣ x-41) (hy : (7 : ℤ)^2 ∣ y-11) : graphSum edges (values x y) constants (tame pi away_pi) + graphSum edges (values x y) constants (tame rho away_rho) = 0 :=
  split_cell edges values constants values_congr pi rho away_pi away_rho 7 1353 1047 41 11 2
    pi_dvd rho_dvd ((pow_dvd_pow pi (by decide : 2≤4)).trans root_pi)
    ((pow_dvd_pow rho (by decide : 2≤4)).trans root_rho)
    envelopes1 constantC constantD certificatesC1 certificatesD1 0
