theorem symbol_class (p : ℕ) [Fact p.Prime] {a b : ℤ} (ha : a≠0) (hb : b≠0) :
    (if p=2 then twoH a b else oddH p a b) =
      sign (form p (localClass p a) (localClass p b)) := by
