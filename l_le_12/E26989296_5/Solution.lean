without_editor_info theorem star_7 (x y : ℤ) :
    (1 : G)^4 * rowProduct (neighbors 7) (values x y) (constants 7) - GraphCert.Quartic.Polynomial.value root_7 x y ^ 4 =
      GraphCert.Quartic.Polynomial.value F x y * GraphCert.Quartic.Polynomial.value starA_7 x y + values x y 7 * GraphCert.Quartic.Polynomial.value starB_7 x y :=
  identity_power (neighbors 7) nodes (constants 7) F starA_7 starB_7 root_7 7 1 4 (by decide +kernel) x y

